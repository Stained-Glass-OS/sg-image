+/* Stained Glass OS: at a fractional scale, the buffer is the X window's
+ * own size -- the logical size times the scale only rounds to it */
+static void
+gdk_x11_surface_get_buffer_size (GdkSurface     *surface,
+                                 GdkDrawContext *context,
+                                 guint          *out_width,
+                                 guint          *out_height)
+{
+  GdkX11Surface *impl = GDK_X11_SURFACE (surface);
+
+  if (!gdk_x11_scale_is_whole (impl->surface_scale) && impl->unscaled_width > 0 && impl->unscaled_height > 0)
+    {
+      *out_width = impl->unscaled_width;
+      *out_height = impl->unscaled_height;
+      return;
+    }
+  *out_width = ceil (impl->surface_scale * surface->width);
+  *out_height = ceil (impl->surface_scale * surface->height);
+}
