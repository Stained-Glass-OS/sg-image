+/* Stained Glass OS: a fractional surface scale (1.75 at 175%), from the
+ * XSETTINGS manager's Gdk/SgFractionalScale (the scale in 1024ths). Sizes go
+ * up to whole pixels (ceil) and down to whole logical pixels (floor), with
+ * a margin for rounding; positions round. With a whole-number scale these
+ * are GTK's own (exact products, configure sizes rounded up). */
+static inline gboolean
+gdk_x11_scale_is_whole (double scale)
+{
+  return scale == (double) (int) scale;
+}
+static inline int
+gdk_x11_scale_size_up (int v, double scale)
+{
+  return gdk_x11_scale_is_whole (scale) ? v * (int) scale : (int) ceil (v * scale - 0.001);
+}
+static inline int
+gdk_x11_scale_size_down (int v, double scale)
+{
+  return gdk_x11_scale_is_whole (scale) ? (v + (int) scale - 1) / (int) scale : (int) floor (v / scale + 0.001);
+}
+static inline int
+gdk_x11_scale_pos_up (int v, double scale)
+{
+  return gdk_x11_scale_is_whole (scale) ? v * (int) scale : (int) floor (v * scale + 0.5);
+}
+static inline int
+gdk_x11_scale_pos_down (int v, double scale)
+{
+  return gdk_x11_scale_is_whole (scale) ? v / (int) scale : (int) floor (v / scale + 0.5);
+}
