+  /* Stained Glass OS: at a fractional window scale (1.75) the window is not
+   * a whole number of pixels per logical one: OpenGL content is drawn in
+   * through cairo (gdk_cairo_draw_from_gl's own way), not straight into
+   * the window at the whole-number scale */
+  if (window->current_paint.use_gl)
+    {
+      cairo_surface_t *impl_surface = gdk_window_ref_impl_surface (window);
+      double sx = 1, sy = 1;
+      if (impl_surface)
+        {
+          cairo_surface_get_device_scale (impl_surface, &sx, &sy);
+          cairo_surface_destroy (impl_surface);
+        }
+      if (sx != (double) (int) sx || sy != (double) (int) sy)
+        window->current_paint.use_gl = FALSE;
+    }
 
   if (window->current_paint.use_gl)
