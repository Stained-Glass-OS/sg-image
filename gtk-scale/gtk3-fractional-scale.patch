+/* Stained Glass OS: programs that draw into their X windows themselves and
+ * scale by GDK's whole-number factor (Mozilla's, Emacs, LibreOffice): at a
+ * fractional display scale they are told scale 1 and the whole DPI, and
+ * scale themselves by it (Firefox and Thunderbird take 1.75 from 168 DPI).
+ * GDK_SG_FRACTIONAL=0 makes any program one of them, =1 none (=whole: see
+ * sg_fractional_whole). */
+static gboolean
+sg_fractional_compat (void)
+{
+  static const char * const names[] = {
+    "firefox", "firefox-esr", "firefox-bin", "thunderbird", "thunderbird-bin", "librewolf",
+    "waterfox", "seamonkey", "icecat", "palemoon", "emacs", "emacs-gtk", "soffice.bin", "oosplash",
+  };
+  const char *env = g_getenv ("GDK_SG_FRACTIONAL");
+  const char *name = g_get_prgname ();
+  char comm[64] = "";
+  gsize i;
+
+  if (env) return strcmp (env, "0") == 0;
+  if (!name)
+    {
+      FILE *f = fopen ("/proc/self/comm", "r");
+      if (f)
+        {
+          if (fgets (comm, sizeof (comm), f)) comm[strcspn (comm, "\n")] = 0;
+          fclose (f);
+        }
+      name = comm;
+    }
+  for (i = 0; i < G_N_ELEMENTS (names); i++)
+    if (g_ascii_strcasecmp (name, names[i]) == 0) return TRUE;
+  return FALSE;
+}
+
+/* Stained Glass OS: programs that keep whole steps at a fractional display
+ * scale (200% at 175%, as Debian's GTK draws): they paint their own canvas
+ * from a store made at GDK's whole-number factor, which at 1.75 was not
+ * repainted when it scrolled -- Inkscape's canvas stayed black (David
+ * 2026-10-07, a Surface). GDK_SG_FRACTIONAL=whole makes any program one. */
+static gboolean
+sg_fractional_whole (void)
+{
+  static const char * const names[] = { "inkscape", "org.inkscape.Inkscape" };
+  const char *env = g_getenv ("GDK_SG_FRACTIONAL");
+  const char *name = g_get_prgname ();
+  char comm[64] = "";
+  FILE *f;
+  gsize i;
+
+  if (env) return strcmp (env, "whole") == 0;
+  if ((f = fopen ("/proc/self/comm", "r")))
+    {
+      if (fgets (comm, sizeof (comm), f)) comm[strcspn (comm, "\n")] = 0;
+      fclose (f);
+    }
+  for (i = 0; i < G_N_ELEMENTS (names); i++)
+    if ((name && g_ascii_strcasecmp (name, names[i]) == 0) || g_ascii_strcasecmp (comm, names[i]) == 0)
+      return TRUE;
+  return FALSE;
+}
