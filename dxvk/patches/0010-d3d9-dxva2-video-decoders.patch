diff --git a/src/dxvk/dxvk_video_decoder.cpp b/src/dxvk/dxvk_video_decoder.cpp
new file mode 100644
index 0000000..d6ca540
--- /dev/null
+++ b/src/dxvk/dxvk_video_decoder.cpp
@@ -0,0 +1,1852 @@
+#include <algorithm>
+#include <cstring>
+
+#include "dxvk_video_decoder.h"
+
+/* Stained Glass OS: video decoders on Vulkan Video, for D3D11VA and DXVA2 (see dxvk_video_decoder.h). */
+
+namespace dxvk {
+
+  static std::mutex g_decodeQueueMutex;   // the device's one decode queue, for every decoder
+
+  static VkDeviceSize alignUp(VkDeviceSize v, VkDeviceSize a) {
+    return a > 1u ? (v + a - 1u) / a * a : v;
+  }
+
+
+  /* A slice header's first fields, read from the NAL unit after its start code (emulation
+   * prevention bytes skipped). The device parses the slice headers itself and finds the picture
+   * parameter set by the id they name, so the one made from DXVA's picture parameters carries it. */
+  class SliceHeaderReader {
+  public:
+    SliceHeaderReader(const uint8_t* data, size_t size)
+    : m_data(data), m_size(size) { }
+
+    bool readBits(uint32_t count, uint32_t& value) {
+      value = 0u;
+      for (uint32_t i = 0; i < count; i++) {
+        int b = readBit();
+        if (b < 0) return false;
+        value = (value << 1) | uint32_t(b);
+      }
+      return true;
+    }
+
+    bool readUe(uint32_t& value) {
+      uint32_t zeros = 0;
+      while (true) {
+        int b = readBit();
+        if (b < 0 || zeros > 31) return false;
+        if (b) break;
+        zeros++;
+      }
+      uint32_t rest = 0;
+      if (!readBits(zeros, rest)) return false;
+      value = (1u << zeros) - 1u + rest;
+      return true;
+    }
+
+  private:
+    const uint8_t* m_data;
+    size_t         m_size;
+    size_t         m_byte = 0;
+    uint32_t       m_bit = 0;
+    uint32_t       m_zeros = 0;
+
+    int readBit() {
+      if (m_bit == 0) {
+        /* 00 00 03: the 03 is not data */
+        if (m_zeros >= 2 && m_byte < m_size && m_data[m_byte] == 3) {
+          m_byte++;
+          m_zeros = 0;
+        }
+        if (m_byte >= m_size) return -1;
+      }
+      int b = (m_data[m_byte] >> (7u - m_bit)) & 1;
+      if (++m_bit == 8u) {
+        m_zeros = m_data[m_byte] ? 0 : m_zeros + 1;
+        m_bit = 0;
+        m_byte++;
+      }
+      return b;
+    }
+  };
+
+
+  /* the first NAL unit at or after Offset: its payload start (after the start code), or ~0u */
+  static uint32_t findNalUnit(const uint8_t* b, uint32_t size, uint32_t offset) {
+    while (offset + 3u < size && !(b[offset] == 0 && b[offset + 1] == 0 && b[offset + 2] == 1))
+      offset++;
+    return offset + 3u < size ? offset + 3u : ~0u;
+  }
+
+
+  /* ---- profiles ------------------------------------------------------------------------------- */
+
+  void DxvkVideoProfileInfo::Fill(DxvkVideoCodec Codec) {
+    profile.chromaSubsampling = VK_VIDEO_CHROMA_SUBSAMPLING_420_BIT_KHR;
+    profile.lumaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR;
+    profile.chromaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR;
+
+    switch (Codec) {
+      case DxvkVideoCodec::H264:
+        h264.stdProfileIdc = STD_VIDEO_H264_PROFILE_IDC_HIGH;
+        h264.pictureLayout = VK_VIDEO_DECODE_H264_PICTURE_LAYOUT_PROGRESSIVE_KHR;
+        profile.pNext = &h264;
+        profile.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR;
+        break;
+
+      case DxvkVideoCodec::HevcMain:
+      case DxvkVideoCodec::HevcMain10:
+        h265.stdProfileIdc = Codec == DxvkVideoCodec::HevcMain10
+          ? STD_VIDEO_H265_PROFILE_IDC_MAIN_10 : STD_VIDEO_H265_PROFILE_IDC_MAIN;
+        profile.pNext = &h265;
+        profile.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR;
+        if (Codec == DxvkVideoCodec::HevcMain10) {
+          profile.lumaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR;
+          profile.chromaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR;
+        }
+        break;
+
+      case DxvkVideoCodec::Av1Main8:
+      case DxvkVideoCodec::Av1Main10:
+        av1.stdProfile = STD_VIDEO_AV1_PROFILE_MAIN;
+        /* film grain is not applied (the DPB and the output are one picture) */
+        av1.filmGrainSupport = VK_FALSE;
+        profile.pNext = &av1;
+        profile.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_AV1_BIT_KHR;
+        if (Codec == DxvkVideoCodec::Av1Main10) {
+          profile.lumaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR;
+          profile.chromaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR;
+        }
+        break;
+
+      case DxvkVideoCodec::Vp9Profile0:
+      case DxvkVideoCodec::Vp9Profile2:
+        vp9.stdProfile = Codec == DxvkVideoCodec::Vp9Profile2 ? STD_VIDEO_VP9_PROFILE_2 : STD_VIDEO_VP9_PROFILE_0;
+        profile.pNext = &vp9;
+        profile.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_VP9_BIT_KHR;
+        if (Codec == DxvkVideoCodec::Vp9Profile2) {
+          profile.lumaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR;
+          profile.chromaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR;
+        }
+        break;
+    }
+
+    list.profileCount = 1u;
+    list.pProfiles = &profile;
+  }
+
+
+  DxvkVideoDecodeSupport::DxvkVideoDecodeSupport(const Rc<DxvkDevice>& Device, Tristate Policy) {
+#ifdef SG_MUTANT_NO_VIDEO_DECODE
+    return;
+#endif
+    if (!Device->queues().decode.queueHandle)
+      return;
+
+    /* only where it was proven (bit-exact against software decode): a program that is offered a
+     * decoder trusts it, and garbled pictures are worse than decoding on the CPU. d3d11.videoDecode
+     * = True offers it on any driver, for testing. */
+    if (Policy == Tristate::False)
+      return;
+    if (Policy == Tristate::Auto && !Device->adapter()->matchesDriver(VK_DRIVER_ID_NVIDIA_PROPRIETARY))
+      return;
+
+    auto vki = Device->vki();
+    VkPhysicalDevice adapter = Device->adapter()->handle();
+
+    const DxvkVideoDecodeProfile candidates[] = {
+      { DxvkVideoCodec::H264,       DXVK_DECODER_PROFILE_H264_VLD_NOFGT,  8u, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM },
+      { DxvkVideoCodec::HevcMain,   DXVK_DECODER_PROFILE_HEVC_VLD_MAIN,   8u, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM },
+      { DxvkVideoCodec::HevcMain10, DXVK_DECODER_PROFILE_HEVC_VLD_MAIN10, 10u, VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16 },
+      { DxvkVideoCodec::Av1Main8,   DXVK_DECODER_PROFILE_AV1_VLD_PROFILE0, 8u, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM },
+      { DxvkVideoCodec::Av1Main10,  DXVK_DECODER_PROFILE_AV1_VLD_PROFILE0, 10u, VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16 },
+      { DxvkVideoCodec::Vp9Profile0, DXVK_DECODER_PROFILE_VP9_VLD_PROFILE0, 8u, VK_FORMAT_G8_B8R8_2PLANE_420_UNORM },
+      { DxvkVideoCodec::Vp9Profile2, DXVK_DECODER_PROFILE_VP9_VLD_10BIT_PROFILE2, 10u, VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16 },
+    };
+
+    for (const auto& c : candidates) {
+      if (c.codec == DxvkVideoCodec::H264 && !Device->features().khrVideoDecodeH264)
+        continue;
+      bool hevc = c.codec == DxvkVideoCodec::HevcMain || c.codec == DxvkVideoCodec::HevcMain10;
+      bool av1 = c.codec == DxvkVideoCodec::Av1Main8 || c.codec == DxvkVideoCodec::Av1Main10;
+      if (hevc && !Device->features().khrVideoDecodeH265)
+        continue;
+      if (av1 && !Device->features().khrVideoDecodeAV1)
+        continue;
+      bool vp9 = c.codec == DxvkVideoCodec::Vp9Profile0 || c.codec == DxvkVideoCodec::Vp9Profile2;
+      if (vp9 && !Device->features().khrVideoDecodeVP9.videoDecodeVP9)
+        continue;
+
+      DxvkVideoDecodeProfile p = c;
+      DxvkVideoProfileInfo info;
+      info.Fill(p.codec);
+
+      p.caps.pNext = &p.decodeCaps;
+      p.decodeCaps.pNext = p.codec == DxvkVideoCodec::H264 ? static_cast<void*>(&p.h264Caps)
+                         : hevc ? static_cast<void*>(&p.h265Caps) : av1 ? static_cast<void*>(&p.av1Caps)
+                         : static_cast<void*>(&p.vp9Caps);
+
+      if (vki->vkGetPhysicalDeviceVideoCapabilitiesKHR(adapter, &info.profile, &p.caps))
+        continue;
+
+      /* the decoded picture is copied out of its DPB slot: the DPB and the output are one image */
+      if (!(p.decodeCaps.flags & VK_VIDEO_DECODE_CAPABILITY_DPB_AND_OUTPUT_COINCIDE_BIT_KHR))
+        continue;
+
+      VkPhysicalDeviceVideoFormatInfoKHR formatInfo = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR };
+      formatInfo.pNext = &info.list;
+      formatInfo.imageUsage = VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR | VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR;
+
+      uint32_t count = 0u;
+      if (vki->vkGetPhysicalDeviceVideoFormatPropertiesKHR(adapter, &formatInfo, &count, nullptr) || !count)
+        continue;
+
+      std::vector<VkVideoFormatPropertiesKHR> formats(count, { VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR });
+      if (vki->vkGetPhysicalDeviceVideoFormatPropertiesKHR(adapter, &formatInfo, &count, formats.data()))
+        continue;
+
+      for (const auto& f : formats) {
+        if (f.format == p.vkFormat && f.imageTiling == VK_IMAGE_TILING_OPTIMAL)
+          p.supported = true;
+      }
+
+      if (!p.supported)
+        continue;
+
+      /* the chains point into the copy, not into this loop's */
+      p.caps.pNext = nullptr;
+      p.decodeCaps.pNext = nullptr;
+      m_profiles.push_back(p);
+    }
+
+    static bool s_logged = false;
+    if (!m_profiles.empty() && !std::exchange(s_logged, true)) {
+      for (const auto& p : m_profiles) {
+        Logger::info(str::format("Video decode ",
+          p.codec == DxvkVideoCodec::H264 ? "H.264" : p.codec == DxvkVideoCodec::HevcMain ? "HEVC Main"
+          : p.codec == DxvkVideoCodec::HevcMain10 ? "HEVC Main10" : p.codec == DxvkVideoCodec::Av1Main8 ? "AV1 Main 8-bit"
+          : p.codec == DxvkVideoCodec::Av1Main10 ? "AV1 Main 10-bit" : p.codec == DxvkVideoCodec::Vp9Profile0 ? "VP9 profile 0" : "VP9 profile 2",
+          ": up to ", p.caps.maxCodedExtent.width, "x", p.caps.maxCodedExtent.height,
+          ", ", p.caps.maxDpbSlots, " DPB slots"));
+      }
+    }
+  }
+
+
+  const DxvkVideoDecodeProfile* DxvkVideoDecodeSupport::Find(const GUID& Guid, uint32_t BitDepth) const {
+    for (const auto& p : m_profiles) {
+      if (p.guid == Guid && (!BitDepth || p.bitDepth == BitDepth))
+        return &p;
+    }
+    return nullptr;
+  }
+
+
+  std::vector<GUID> DxvkVideoDecodeSupport::Guids() const {
+    std::vector<GUID> guids;
+    for (const auto& p : m_profiles) {
+      if (std::find(guids.begin(), guids.end(), p.guid) == guids.end())
+        guids.push_back(p.guid);
+    }
+    return guids;
+  }
+
+
+  /* ---- decoder -------------------------------------------------------------------------------------- */
+
+  DxvkVideoDecoder::DxvkVideoDecoder(
+    const Rc<DxvkDevice>&           Device,
+    const DxvkVideoDecodeProfile&   Profile,
+          uint32_t                  Width,
+          uint32_t                  Height,
+          uint32_t                  ConfigBitstreamRaw)
+  : m_device(Device), m_support(Profile), m_width(Width), m_height(Height),
+    m_configBitstreamRaw(ConfigBitstreamRaw) {
+    m_profile.Fill(m_support.codec);
+
+    if (!CreateSession() || !CreateDpb() || !CreateFrames()) {
+      Logger::err("Video decoder: could not create the Vulkan video objects");
+      DestroyObjects();
+      return;
+    }
+
+    m_decodeFence = m_device->createFence(DxvkFenceCreateInfo { 0u });
+    m_copyFence = m_device->createFence(DxvkFenceCreateInfo { 0u });
+  }
+
+
+  DxvkVideoDecoder::~DxvkVideoDecoder() {
+    DestroyObjects();
+  }
+
+
+  HRESULT DxvkVideoDecoder::GetBuffer(
+          uint32_t                  Type,
+          UINT*                     pBufferSize,
+          void**                    ppBuffer) {
+    if (Type > DxvkVideoBufferFilmGrain || !pBufferSize || !ppBuffer)
+      return E_INVALIDARG;
+
+    auto& b = m_buffers[Type];
+    size_t size = Type == DxvkVideoBufferBitstream ? size_t(m_bitstreamSize)
+                : Type == DxvkVideoBufferSliceControl ? size_t(256u << 10)
+                : size_t(64u << 10);
+    if (b.data.size() < size)
+      b.data.resize(size);
+
+    *pBufferSize = UINT(b.data.size());
+    *ppBuffer = b.data.data();
+    return S_OK;
+  }
+
+
+  HRESULT DxvkVideoDecoder::ReleaseBuffer(
+          uint32_t                  Type) {
+    return Type > DxvkVideoBufferFilmGrain ? E_INVALIDARG : S_OK;
+  }
+
+
+  void DxvkVideoDecoder::BeginFrame() {
+    for (auto& b : m_buffers) {
+      b.submitted = false;
+      b.size = 0u;
+    }
+  }
+
+
+  HRESULT DxvkVideoDecoder::SubmitBuffer(
+          uint32_t                  Type,
+          UINT                      Offset,
+          UINT                      Size) {
+    if (Type > DxvkVideoBufferFilmGrain || Offset)
+      return E_INVALIDARG;
+
+    auto& b = m_buffers[Type];
+    if (Size > b.data.size())
+      return E_INVALIDARG;
+
+    b.size = Size;
+    b.submitted = true;
+    return S_OK;
+  }
+
+
+  HRESULT DxvkVideoDecoder::EndFrame(
+          DxvkVideoDecodeOutput&    Output) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    switch (m_support.codec) {
+      case DxvkVideoCodec::H264:        return DecodeH264(Output);
+      case DxvkVideoCodec::Av1Main8:
+      case DxvkVideoCodec::Av1Main10:   return DecodeAv1(Output);
+      case DxvkVideoCodec::Vp9Profile0:
+      case DxvkVideoCodec::Vp9Profile2: return DecodeVp9(Output);
+      default:                          return DecodeHevc(Output);
+    }
+  }
+
+
+  uint32_t DxvkVideoDecoder::FindMemoryType(uint32_t TypeBits, VkMemoryPropertyFlags Flags) const {
+    VkPhysicalDeviceMemoryProperties props = { };
+    m_device->vki()->vkGetPhysicalDeviceMemoryProperties(m_device->adapter()->handle(), &props);
+
+    for (uint32_t i = 0; i < props.memoryTypeCount; i++) {
+      if ((TypeBits & (1u << i)) && (props.memoryTypes[i].propertyFlags & Flags) == Flags)
+        return i;
+    }
+
+    for (uint32_t i = 0; i < props.memoryTypeCount; i++) {
+      if ((TypeBits & (1u << i)) && !(Flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+        return i;
+    }
+
+    return ~0u;
+  }
+
+
+  bool DxvkVideoDecoder::CreateSession() {
+    auto vkd = m_device->vkd();
+    const auto& caps = m_support.caps;
+
+    m_codedExtent.width  = alignUp(std::max(m_width,  caps.minCodedExtent.width),  16u);
+    m_codedExtent.height = alignUp(std::max(m_height, caps.minCodedExtent.height), 16u);
+
+    if (m_codedExtent.width > caps.maxCodedExtent.width || m_codedExtent.height > caps.maxCodedExtent.height) {
+      Logger::err(str::format("Video decoder: ", m_width, "x", m_height, " is larger than the device decodes"));
+      return false;
+    }
+
+    /* the current picture and up to 16 references; DXVA surfaces are mapped to these */
+    m_slotCount = std::min(caps.maxDpbSlots, 17u);
+    m_bitstreamAlign = std::max<VkDeviceSize>(caps.minBitstreamBufferSizeAlignment, caps.minBitstreamBufferOffsetAlignment);
+
+    /* the version of the standard's headers this was built with */
+    static const VkExtensionProperties h264Header = { VK_STD_VULKAN_VIDEO_CODEC_H264_DECODE_EXTENSION_NAME,
+      VK_STD_VULKAN_VIDEO_CODEC_H264_DECODE_SPEC_VERSION };
+    static const VkExtensionProperties h265Header = { VK_STD_VULKAN_VIDEO_CODEC_H265_DECODE_EXTENSION_NAME,
+      VK_STD_VULKAN_VIDEO_CODEC_H265_DECODE_SPEC_VERSION };
+    static const VkExtensionProperties av1Header = { VK_STD_VULKAN_VIDEO_CODEC_AV1_DECODE_EXTENSION_NAME,
+      VK_STD_VULKAN_VIDEO_CODEC_AV1_DECODE_SPEC_VERSION };
+    static const VkExtensionProperties vp9Header = { VK_STD_VULKAN_VIDEO_CODEC_VP9_DECODE_EXTENSION_NAME,
+      VK_STD_VULKAN_VIDEO_CODEC_VP9_DECODE_SPEC_VERSION };
+
+    VkVideoSessionCreateInfoKHR info = { VK_STRUCTURE_TYPE_VIDEO_SESSION_CREATE_INFO_KHR };
+    info.queueFamilyIndex = m_device->queues().decode.queueFamily;
+    info.pVideoProfile = &m_profile.profile;
+    info.pictureFormat = m_support.vkFormat;
+    /* the device's largest: NVIDIA's driver refused every picture (INVALID_VIDEO_STD_PARAMETERS at
+     * vkEndCommandBuffer) of a session whose largest was the stream's own size */
+    info.maxCodedExtent = caps.maxCodedExtent;
+    info.referencePictureFormat = m_support.vkFormat;
+    info.maxDpbSlots = m_slotCount;
+    info.maxActiveReferencePictures = std::min(caps.maxActiveReferencePictures, 16u);
+    switch (m_support.codec) {
+      case DxvkVideoCodec::H264:      info.pStdHeaderVersion = &h264Header; break;
+      case DxvkVideoCodec::Av1Main8:
+      case DxvkVideoCodec::Av1Main10: info.pStdHeaderVersion = &av1Header; break;
+      case DxvkVideoCodec::Vp9Profile0:
+      case DxvkVideoCodec::Vp9Profile2: info.pStdHeaderVersion = &vp9Header; break;
+      default:                         info.pStdHeaderVersion = &h265Header; break;
+    }
+
+    if (vkd->vkCreateVideoSessionKHR(vkd->device(), &info, nullptr, &m_session)) {
+      m_session = VK_NULL_HANDLE;
+      return false;
+    }
+
+    uint32_t count = 0u;
+    vkd->vkGetVideoSessionMemoryRequirementsKHR(vkd->device(), m_session, &count, nullptr);
+    std::vector<VkVideoSessionMemoryRequirementsKHR> reqs(count, { VK_STRUCTURE_TYPE_VIDEO_SESSION_MEMORY_REQUIREMENTS_KHR });
+    vkd->vkGetVideoSessionMemoryRequirementsKHR(vkd->device(), m_session, &count, reqs.data());
+
+    std::vector<VkBindVideoSessionMemoryInfoKHR> binds;
+
+    for (const auto& r : reqs) {
+      VkMemoryAllocateInfo alloc = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+      alloc.allocationSize = r.memoryRequirements.size;
+      alloc.memoryTypeIndex = FindMemoryType(r.memoryRequirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+      VkDeviceMemory memory = VK_NULL_HANDLE;
+      if (alloc.memoryTypeIndex == ~0u || vkd->vkAllocateMemory(vkd->device(), &alloc, nullptr, &memory))
+        return false;
+      m_sessionMemory.push_back(memory);
+
+      VkBindVideoSessionMemoryInfoKHR bind = { VK_STRUCTURE_TYPE_BIND_VIDEO_SESSION_MEMORY_INFO_KHR };
+      bind.memoryBindIndex = r.memoryBindIndex;
+      bind.memory = memory;
+      bind.memorySize = r.memoryRequirements.size;
+      binds.push_back(bind);
+    }
+
+    if (!binds.empty() && vkd->vkBindVideoSessionMemoryKHR(vkd->device(), m_session, binds.size(), binds.data()))
+      return false;
+
+    return true;
+  }
+
+
+  bool DxvkVideoDecoder::CreateDpb() {
+    auto vkd = m_device->vkd();
+    const auto& queues = m_device->queues();
+    uint32_t families[2] = { queues.graphics.queueFamily, queues.decode.queueFamily };
+
+    VkImageCreateInfo info = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    info.pNext = &m_profile.list;
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = m_support.vkFormat;
+    info.extent = { m_codedExtent.width, m_codedExtent.height, 1u };
+    info.mipLevels = 1u;
+    info.arrayLayers = m_slotCount;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR | VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+    /* decoded on the decode queue, copied out by DXVK on the graphics queue */
+    if (families[0] != families[1]) {
+      info.sharingMode = VK_SHARING_MODE_CONCURRENT;
+      info.queueFamilyIndexCount = 2u;
+      info.pQueueFamilyIndices = families;
+    } else {
+      info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    }
+
+    if (vkd->vkCreateImage(vkd->device(), &info, nullptr, &m_dpbImage)) {
+      m_dpbImage = VK_NULL_HANDLE;
+      return false;
+    }
+
+    VkMemoryRequirements req = { };
+    vkd->vkGetImageMemoryRequirements(vkd->device(), m_dpbImage, &req);
+
+    VkMemoryAllocateInfo alloc = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    alloc.allocationSize = req.size;
+    alloc.memoryTypeIndex = FindMemoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    if (alloc.memoryTypeIndex == ~0u
+     || vkd->vkAllocateMemory(vkd->device(), &alloc, nullptr, &m_dpbMemory)
+     || vkd->vkBindImageMemory(vkd->device(), m_dpbImage, m_dpbMemory, 0u))
+      return false;
+
+    /* each slot's picture through a view of its own layer (a picture resource's base layer in an
+     * array view is not taken by every driver) */
+    VkImageViewUsageCreateInfo viewUsage = { VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO };
+    viewUsage.usage = VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR | VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR;
+
+    m_slotViews.assign(m_slotCount, VK_NULL_HANDLE);
+    for (uint32_t s = 0; s < m_slotCount; s++) {
+      VkImageViewCreateInfo view = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+      view.pNext = &viewUsage;
+      view.image = m_dpbImage;
+      view.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view.format = m_support.vkFormat;
+      view.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, s, 1u };
+      if (vkd->vkCreateImageView(vkd->device(), &view, nullptr, &m_slotViews[s]))
+        return false;
+    }
+
+    /* the same image for DXVK, which copies decoded pictures out of it: kept in TRANSFER_SRC
+     * between decodes (our command buffers move it to the DPB layout and back) */
+    DxvkImageCreateInfo dxvkInfo;
+    dxvkInfo.type = VK_IMAGE_TYPE_2D;
+    dxvkInfo.format = m_support.vkFormat;
+    dxvkInfo.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    dxvkInfo.extent = info.extent;
+    dxvkInfo.numLayers = m_slotCount;
+    dxvkInfo.mipLevels = 1u;
+    dxvkInfo.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    dxvkInfo.stages = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    dxvkInfo.access = VK_ACCESS_TRANSFER_READ_BIT;
+    dxvkInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    dxvkInfo.layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    dxvkInfo.initialLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    dxvkInfo.shared = VK_TRUE;
+    dxvkInfo.debugName = "Video decoder DPB";
+
+    m_dpb = m_device->importImage(dxvkInfo, m_dpbImage, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    m_surfaceSlot.assign(128u, -1);
+    m_slotSurface.assign(m_slotCount, -1);
+    return true;
+  }
+
+
+  bool DxvkVideoDecoder::CreateFrames() {
+    auto vkd = m_device->vkd();
+
+    VkCommandPoolCreateInfo pool = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pool.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pool.queueFamilyIndex = m_device->queues().decode.queueFamily;
+
+    if (vkd->vkCreateCommandPool(vkd->device(), &pool, nullptr, &m_cmdPool)) {
+      m_cmdPool = VK_NULL_HANDLE;
+      return false;
+    }
+
+    m_bitstreamSize = alignUp(std::max<VkDeviceSize>(4u << 20,
+      VkDeviceSize(m_codedExtent.width) * m_codedExtent.height * 3u / 2u), std::max<VkDeviceSize>(m_bitstreamAlign, 4096u));
+
+    for (auto& f : m_frames) {
+      VkBufferCreateInfo info = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+      info.pNext = &m_profile.list;
+      info.size = m_bitstreamSize;
+      info.usage = VK_BUFFER_USAGE_VIDEO_DECODE_SRC_BIT_KHR;
+      info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+
+      if (vkd->vkCreateBuffer(vkd->device(), &info, nullptr, &f.bitstream)) {
+        f.bitstream = VK_NULL_HANDLE;
+        return false;
+      }
+
+      VkMemoryRequirements req = { };
+      vkd->vkGetBufferMemoryRequirements(vkd->device(), f.bitstream, &req);
+
+      VkMemoryAllocateInfo alloc = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+      alloc.allocationSize = req.size;
+      alloc.memoryTypeIndex = FindMemoryType(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+
+      if (alloc.memoryTypeIndex == ~0u
+       || vkd->vkAllocateMemory(vkd->device(), &alloc, nullptr, &f.memory)
+       || vkd->vkBindBufferMemory(vkd->device(), f.bitstream, f.memory, 0u)
+       || vkd->vkMapMemory(vkd->device(), f.memory, 0u, VK_WHOLE_SIZE, 0u, reinterpret_cast<void**>(&f.map)))
+        return false;
+
+      VkCommandBufferAllocateInfo cmd = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+      cmd.commandPool = m_cmdPool;
+      cmd.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      cmd.commandBufferCount = 1u;
+
+      if (vkd->vkAllocateCommandBuffers(vkd->device(), &cmd, &f.cmd))
+        return false;
+
+      VkFenceCreateInfo fence = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+      if (vkd->vkCreateFence(vkd->device(), &fence, nullptr, &f.fence)) {
+        f.fence = VK_NULL_HANDLE;
+        return false;
+      }
+    }
+
+    return true;
+  }
+
+
+  void DxvkVideoDecoder::DestroyObjects() {
+    auto vkd = m_device->vkd();
+
+    for (auto& f : m_frames) {
+      if (f.submitted && f.fence)
+        vkd->vkWaitForFences(vkd->device(), 1u, &f.fence, VK_TRUE, ~0ull);
+    }
+
+    /* DXVK may still copy out of the DPB */
+    if (m_copyFence != nullptr && m_copyValue)
+      m_copyFence->wait(m_copyValue);
+
+    m_dpb = nullptr;
+
+    for (auto& f : m_frames) {
+      if (f.fence) vkd->vkDestroyFence(vkd->device(), f.fence, nullptr);
+      if (f.params) vkd->vkDestroyVideoSessionParametersKHR(vkd->device(), f.params, nullptr);
+      if (f.bitstream) vkd->vkDestroyBuffer(vkd->device(), f.bitstream, nullptr);
+      if (f.memory) vkd->vkFreeMemory(vkd->device(), f.memory, nullptr);
+      f = Frame();
+    }
+
+    if (m_cmdPool) vkd->vkDestroyCommandPool(vkd->device(), m_cmdPool, nullptr);
+    if (m_session) vkd->vkDestroyVideoSessionKHR(vkd->device(), m_session, nullptr);
+    for (auto m : m_sessionMemory) vkd->vkFreeMemory(vkd->device(), m, nullptr);
+    for (auto v : m_slotViews) if (v) vkd->vkDestroyImageView(vkd->device(), v, nullptr);
+    if (m_dpbImage) vkd->vkDestroyImage(vkd->device(), m_dpbImage, nullptr);
+    if (m_dpbMemory) vkd->vkFreeMemory(vkd->device(), m_dpbMemory, nullptr);
+
+    m_cmdPool = VK_NULL_HANDLE;
+    m_session = VK_NULL_HANDLE;
+    m_sessionMemory.clear();
+    m_slotViews.clear();
+    m_dpbImage = VK_NULL_HANDLE;
+    m_dpbMemory = VK_NULL_HANDLE;
+  }
+
+
+  int32_t DxvkVideoDecoder::AcquireSlot(uint32_t Surface, const std::vector<uint32_t>& Referenced) {
+    if (Surface >= m_surfaceSlot.size())
+      return -1;
+
+    /* slots whose surface no reference of this picture names are free again */
+    for (uint32_t s = 0; s < m_slotCount; s++) {
+      int32_t surf = m_slotSurface[s];
+      if (surf >= 0 && uint32_t(surf) != Surface
+       && std::find(Referenced.begin(), Referenced.end(), uint32_t(surf)) == Referenced.end()) {
+        m_surfaceSlot[surf] = -1;
+        m_slotSurface[s] = -1;
+      }
+    }
+
+    if (m_surfaceSlot[Surface] >= 0)
+      return m_surfaceSlot[Surface];
+
+    for (uint32_t s = 0; s < m_slotCount; s++) {
+      if (m_slotSurface[s] < 0) {
+        m_slotSurface[s] = int32_t(Surface);
+        m_surfaceSlot[Surface] = int32_t(s);
+        return int32_t(s);
+      }
+    }
+
+    return -1;
+  }
+
+
+  DxvkVideoDecoder::Frame& DxvkVideoDecoder::NextFrame() {
+    auto vkd = m_device->vkd();
+    Frame& f = m_frames[m_nextFrame];
+    m_nextFrame = (m_nextFrame + 1u) % FrameCount;
+
+    /* only a frame FrameCount pictures back is waited for: decodes run ahead of the program */
+    if (f.submitted) {
+      vkd->vkWaitForFences(vkd->device(), 1u, &f.fence, VK_TRUE, ~0ull);
+      vkd->vkResetFences(vkd->device(), 1u, &f.fence);
+      f.submitted = false;
+    }
+
+    if (f.params) {
+      vkd->vkDestroyVideoSessionParametersKHR(vkd->device(), f.params, nullptr);
+      f.params = VK_NULL_HANDLE;
+    }
+
+    return f;
+  }
+
+
+  bool DxvkVideoDecoder::CreateParams(Frame& F, const void* pCodecCreateInfo) {
+    auto vkd = m_device->vkd();
+
+    VkVideoSessionParametersCreateInfoKHR info = { VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    info.pNext = pCodecCreateInfo;
+    info.videoSession = m_session;
+
+    if (vkd->vkCreateVideoSessionParametersKHR(vkd->device(), &info, nullptr, &F.params)) {
+      F.params = VK_NULL_HANDLE;
+      return false;
+    }
+
+    return true;
+  }
+
+
+  HRESULT DxvkVideoDecoder::Record(Frame& F, const Picture& Pic, DxvkVideoDecodeOutput& Output) {
+    auto vkd = m_device->vkd();
+
+    if (Pic.bitstreamSize > m_bitstreamSize)
+      return E_INVALIDARG;
+
+    VkDeviceSize range = alignUp(Pic.bitstreamSize, m_bitstreamAlign);
+    std::memcpy(F.map, Pic.bitstream->data(), Pic.bitstreamSize);
+    std::memset(F.map + Pic.bitstreamSize, 0, range - Pic.bitstreamSize);
+
+    std::array<VkVideoPictureResourceInfoKHR, 17> resources;
+    std::array<VkVideoReferenceSlotInfoKHR, 17>   slots;
+
+    for (uint32_t i = 0; i < Pic.refCount; i++) {
+      resources[i] = { VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR };
+      resources[i].codedExtent = Pic.extent;
+      resources[i].imageViewBinding = m_slotViews[Pic.refSlots[i]];
+
+      slots[i] = { VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR };
+      slots[i].pNext = Pic.refInfos[i];
+      slots[i].slotIndex = Pic.refSlots[i];
+      slots[i].pPictureResource = &resources[i];
+    }
+
+    VkVideoPictureResourceInfoKHR curResource = { VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR };
+    curResource.codedExtent = Pic.extent;
+    curResource.imageViewBinding = m_slotViews[Pic.currentSlot];
+
+    VkVideoReferenceSlotInfoKHR setupSlot = { VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR };
+    setupSlot.pNext = Pic.setupInfo;
+    setupSlot.slotIndex = Pic.currentSlot;
+    setupSlot.pPictureResource = &curResource;
+
+    /* bound in begin coding, the set-up picture without a slot yet */
+    slots[Pic.refCount] = setupSlot;
+    slots[Pic.refCount].slotIndex = -1;
+
+    VkVideoDecodeInfoKHR decode = { VK_STRUCTURE_TYPE_VIDEO_DECODE_INFO_KHR };
+    decode.pNext = Pic.pictureInfo;
+    decode.srcBuffer = F.bitstream;
+    decode.srcBufferOffset = 0u;
+    decode.srcBufferRange = range;
+    decode.dstPictureResource = curResource;
+    decode.pSetupReferenceSlot = &setupSlot;
+    decode.referenceSlotCount = Pic.refCount;
+    decode.pReferenceSlots = slots.data();
+
+    VkVideoBeginCodingInfoKHR begin = { VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR };
+    begin.videoSession = m_session;
+    begin.videoSessionParameters = F.params;
+    begin.referenceSlotCount = Pic.refCount + 1u;
+    begin.pReferenceSlots = slots.data();
+
+    VkVideoEndCodingInfoKHR end = { VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR };
+
+    VkCommandBufferBeginInfo cmdBegin = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    cmdBegin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+
+    VkResult cr = vkd->vkResetCommandBuffer(F.cmd, 0u);
+    if (!cr) cr = vkd->vkBeginCommandBuffer(F.cmd, &cmdBegin);
+    if (cr) {
+      Logger::err(str::format("Video decoder: command buffer: ", cr));
+      return E_FAIL;
+    }
+
+    VkImageMemoryBarrier2 toDpb = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    toDpb.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    toDpb.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    toDpb.dstStageMask = VK_PIPELINE_STAGE_2_VIDEO_DECODE_BIT_KHR;
+    toDpb.dstAccessMask = VK_ACCESS_2_VIDEO_DECODE_READ_BIT_KHR | VK_ACCESS_2_VIDEO_DECODE_WRITE_BIT_KHR;
+    toDpb.oldLayout = m_dpbInitialized ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED;
+    toDpb.newLayout = VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR;
+    toDpb.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toDpb.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toDpb.image = m_dpbImage;
+    toDpb.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, m_slotCount };
+
+    VkDependencyInfo dep = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    dep.imageMemoryBarrierCount = 1u;
+    dep.pImageMemoryBarriers = &toDpb;
+    vkd->vkCmdPipelineBarrier2(F.cmd, &dep);
+
+    /* a new session is reset first, in a coding scope of its own with no picture bound */
+    if (!m_reset) {
+      VkVideoBeginCodingInfoKHR resetBegin = { VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR };
+      resetBegin.videoSession = m_session;
+      resetBegin.videoSessionParameters = F.params;
+      VkVideoCodingControlInfoKHR control = { VK_STRUCTURE_TYPE_VIDEO_CODING_CONTROL_INFO_KHR };
+      control.flags = VK_VIDEO_CODING_CONTROL_RESET_BIT_KHR;
+      vkd->vkCmdBeginVideoCodingKHR(F.cmd, &resetBegin);
+      vkd->vkCmdControlVideoCodingKHR(F.cmd, &control);
+      vkd->vkCmdEndVideoCodingKHR(F.cmd, &end);
+    }
+
+    vkd->vkCmdBeginVideoCodingKHR(F.cmd, &begin);
+    vkd->vkCmdDecodeVideoKHR(F.cmd, &decode);
+    vkd->vkCmdEndVideoCodingKHR(F.cmd, &end);
+
+    VkImageMemoryBarrier2 toSrc = toDpb;
+    toSrc.srcStageMask = VK_PIPELINE_STAGE_2_VIDEO_DECODE_BIT_KHR;
+    toSrc.srcAccessMask = VK_ACCESS_2_VIDEO_DECODE_WRITE_BIT_KHR;
+    toSrc.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    toSrc.dstAccessMask = 0u;
+    toSrc.oldLayout = VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR;
+    toSrc.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    dep.pImageMemoryBarriers = &toSrc;
+    vkd->vkCmdPipelineBarrier2(F.cmd, &dep);
+
+    if ((cr = vkd->vkEndCommandBuffer(F.cmd))) {
+      Logger::err(str::format("Video decoder: recording failed: ", cr));
+      return E_FAIL;
+    }
+
+    /* waits for DXVK's last copy out of the DPB; DXVK's copy of this picture waits for it */
+    VkSemaphoreSubmitInfo wait = { VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO };
+    wait.semaphore = m_copyFence->handle();
+    wait.value = m_copyValue;
+    wait.stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkSemaphoreSubmitInfo signal = { VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO };
+    signal.semaphore = m_decodeFence->handle();
+    signal.value = m_decodeValue + 1u;
+    signal.stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkCommandBufferSubmitInfo cmdInfo = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO };
+    cmdInfo.commandBuffer = F.cmd;
+
+    VkSubmitInfo2 submit = { VK_STRUCTURE_TYPE_SUBMIT_INFO_2 };
+    submit.waitSemaphoreInfoCount = 1u;
+    submit.pWaitSemaphoreInfos = &wait;
+    submit.commandBufferInfoCount = 1u;
+    submit.pCommandBufferInfos = &cmdInfo;
+    submit.signalSemaphoreInfoCount = 1u;
+    submit.pSignalSemaphoreInfos = &signal;
+
+    VkResult vr;
+    { std::lock_guard<std::mutex> queueLock(g_decodeQueueMutex);
+      vr = vkd->vkQueueSubmit2(m_device->queues().decode.queueHandle, 1u, &submit, F.fence);
+    }
+
+    if (vr) {
+      Logger::err(str::format("Video decoder: decode submission failed: ", vr));
+      return E_FAIL;
+    }
+
+    F.submitted = true;
+    m_reset = true;
+    m_dpbInitialized = true;
+    m_decodeValue++;
+
+    /* the picture to the program's surface, on DXVK's queue after the decode; the next decode waits
+     * for that copy (the API's side flushes it to the GPU) */
+    Output.Output(m_dpb, uint32_t(Pic.currentSlot), Pic.extent, m_decodeFence, m_decodeValue, m_copyFence, ++m_copyValue);
+    return S_OK;
+  }
+
+
+  /* ---- H.264 ------------------------------------------------------------------------------------------ */
+
+  HRESULT DxvkVideoDecoder::DecodeH264(DxvkVideoDecodeOutput& Output) {
+    const auto& ppBuf = m_buffers[DxvkVideoBufferPictureParameters];
+    const auto& qmBuf = m_buffers[DxvkVideoBufferInverseQuantizationMatrix];
+    const auto& slBuf = m_buffers[DxvkVideoBufferSliceControl];
+    const auto& bsBuf = m_buffers[DxvkVideoBufferBitstream];
+
+    if (!ppBuf.submitted || ppBuf.size < sizeof(DXVA_PicParams_H264)
+     || !slBuf.submitted || slBuf.size < sizeof(DXVA_Slice_H264_Short) || !bsBuf.submitted || !bsBuf.size)
+      return E_INVALIDARG;
+
+    const auto& pp = *reinterpret_cast<const DXVA_PicParams_H264*>(ppBuf.data.data());
+    size_t sliceSize = m_configBitstreamRaw == 1 ? sizeof(DXVA_Slice_H264_Long) : sizeof(DXVA_Slice_H264_Short);
+    uint32_t sliceCount = slBuf.size / sliceSize;
+
+    if (pp.field_pic_flag || pp.MbaffFrameFlag || !pp.frame_mbs_only_flag || pp.chroma_format_idc != 1
+     || pp.bit_depth_luma_minus8 || pp.bit_depth_chroma_minus8) {
+      Logger::warn("Video decoder: interlaced or non-4:2:0 8-bit H.264 is not decoded yet");
+      return E_NOTIMPL;
+    }
+
+    /* the slices (the short form is the long one's start) */
+    std::vector<uint32_t> sliceOffsets(sliceCount);
+    for (uint32_t i = 0; i < sliceCount; i++)
+      sliceOffsets[i] = reinterpret_cast<const DXVA_Slice_H264_Short*>(slBuf.data.data() + i * sliceSize)->BSNALunitDataLocation;
+
+    /* an IDR picture (the first slice's NAL unit type, 5), and the PPS its slices name */
+    bool idr = false;
+    uint32_t ppsId = 0u;
+    if (sliceCount) {
+      uint32_t at = findNalUnit(bsBuf.data.data(), bsBuf.size, sliceOffsets[0]);
+      if (at != ~0u) {
+        idr = (bsBuf.data[at] & 0x1f) == 5;
+        SliceHeaderReader reader(bsBuf.data.data() + at + 1u, bsBuf.size - at - 1u);
+        uint32_t firstMb = 0, sliceType = 0, id = 0;
+        if (reader.readUe(firstMb) && reader.readUe(sliceType) && reader.readUe(id) && id < 256u)
+          ppsId = id;
+      }
+    }
+
+    /* the DPB: the surfaces the references are in, and a slot for this picture */
+    std::vector<uint32_t> referenced;
+    for (uint32_t i = 0; i < 16u; i++) {
+      if (pp.RefFrameList[i].bPicEntry != 0xff)
+        referenced.push_back(pp.RefFrameList[i].Index7Bits);
+    }
+
+    uint32_t current = pp.CurrPic.Index7Bits;
+    int32_t currentSlot = AcquireSlot(current, referenced);
+
+    if (currentSlot < 0) {
+      Logger::err("Video decoder: no free DPB slot");
+      return E_FAIL;
+    }
+
+    Frame& f = NextFrame();
+
+    /* the parameter sets, from the picture parameters (the PPS by the slices' id, its SPS id 0);
+     * every pointer set, as drivers read them: lists not present, no VUI, no POC cycle */
+    StdVideoH264ScalingLists spsScaling = { };
+    StdVideoH264HrdParameters hrd = { };
+    StdVideoH264SequenceParameterSetVui vui = { };
+    vui.pHrdParameters = &hrd;
+    int32_t offsetForRefFrame[256] = { };
+
+    StdVideoH264SequenceParameterSet sps = { };
+    sps.flags.direct_8x8_inference_flag = pp.direct_8x8_inference_flag;
+    sps.flags.frame_mbs_only_flag = pp.frame_mbs_only_flag;
+    sps.flags.delta_pic_order_always_zero_flag = pp.delta_pic_order_always_zero_flag;
+    sps.flags.qpprime_y_zero_transform_bypass_flag = pp.residual_colour_transform_flag;
+    sps.profile_idc = STD_VIDEO_H264_PROFILE_IDC_HIGH;
+    sps.level_idc = m_support.h264Caps.maxLevelIdc;
+    sps.chroma_format_idc = STD_VIDEO_H264_CHROMA_FORMAT_IDC_420;
+    sps.seq_parameter_set_id = 0;
+    sps.bit_depth_luma_minus8 = pp.bit_depth_luma_minus8;
+    sps.bit_depth_chroma_minus8 = pp.bit_depth_chroma_minus8;
+    sps.log2_max_frame_num_minus4 = pp.log2_max_frame_num_minus4;
+    sps.pic_order_cnt_type = StdVideoH264PocType(pp.pic_order_cnt_type);
+    sps.log2_max_pic_order_cnt_lsb_minus4 = pp.pic_order_cnt_type ? 0 : pp.log2_max_pic_order_cnt_lsb_minus4;
+    sps.max_num_ref_frames = pp.num_ref_frames;
+    sps.pic_width_in_mbs_minus1 = pp.wFrameWidthInMbsMinus1;
+    sps.pic_height_in_map_units_minus1 = pp.wFrameHeightInMbsMinus1;
+    sps.pScalingLists = &spsScaling;
+    sps.pSequenceParameterSetVui = &vui;
+    sps.pOffsetForRefFrame = offsetForRefFrame;
+
+    StdVideoH264ScalingLists scaling = { };
+    StdVideoH264PictureParameterSet pps = { };
+    pps.flags.transform_8x8_mode_flag = pp.transform_8x8_mode_flag;
+    pps.flags.redundant_pic_cnt_present_flag = pp.redundant_pic_cnt_present_flag;
+    pps.flags.constrained_intra_pred_flag = pp.constrained_intra_pred_flag;
+    pps.flags.deblocking_filter_control_present_flag = pp.deblocking_filter_control_present_flag;
+    pps.flags.weighted_pred_flag = pp.weighted_pred_flag;
+    pps.flags.bottom_field_pic_order_in_frame_present_flag = pp.pic_order_present_flag;
+    pps.flags.entropy_coding_mode_flag = pp.entropy_coding_mode_flag;
+    pps.seq_parameter_set_id = 0;
+    pps.pic_parameter_set_id = uint8_t(ppsId);
+    pps.num_ref_idx_l0_default_active_minus1 = pp.num_ref_idx_l0_active_minus1;
+    pps.num_ref_idx_l1_default_active_minus1 = pp.num_ref_idx_l1_active_minus1;
+    pps.weighted_bipred_idc = StdVideoH264WeightedBipredIdc(pp.weighted_bipred_idc);
+    pps.pic_init_qp_minus26 = pp.pic_init_qp_minus26;
+    pps.pic_init_qs_minus26 = pp.pic_init_qs_minus26;
+    pps.chroma_qp_index_offset = pp.chroma_qp_index_offset;
+    pps.second_chroma_qp_index_offset = pp.second_chroma_qp_index_offset;
+    pps.pScalingLists = &scaling;
+
+    /* the scaling lists, in the order they are coded (DXVA's order), when not flat */
+    bool flat = true;
+    if (qmBuf.submitted && qmBuf.size >= sizeof(DXVA_Qmatrix_H264)) {
+      const auto& qm = *reinterpret_cast<const DXVA_Qmatrix_H264*>(qmBuf.data.data());
+      for (uint32_t i = 0; i < 6u; i++) for (uint32_t j = 0; j < 16u; j++) flat &= qm.bScalingLists4x4[i][j] == 16;
+      for (uint32_t i = 0; i < 2u; i++) for (uint32_t j = 0; j < 64u; j++) flat &= qm.bScalingLists8x8[i][j] == 16;
+
+      if (!flat) {
+        pps.flags.pic_scaling_matrix_present_flag = 1;
+        scaling.scaling_list_present_mask = 0xffu;
+        for (uint32_t i = 0; i < 6u; i++)
+          std::memcpy(scaling.ScalingList4x4[i], qm.bScalingLists4x4[i], 16u);
+        for (uint32_t i = 0; i < 2u; i++)
+          std::memcpy(scaling.ScalingList8x8[i], qm.bScalingLists8x8[i], 64u);
+      }
+    }
+
+    VkVideoDecodeH264SessionParametersAddInfoKHR add = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_ADD_INFO_KHR };
+    add.stdSPSCount = 1u;
+    add.pStdSPSs = &sps;
+    add.stdPPSCount = 1u;
+    add.pStdPPSs = &pps;
+
+    VkVideoDecodeH264SessionParametersCreateInfoKHR paramsInfo = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    paramsInfo.maxStdSPSCount = 1u;
+    paramsInfo.maxStdPPSCount = 1u;
+    paramsInfo.pParametersAddInfo = &add;
+
+    if (!CreateParams(f, &paramsInfo))
+      return E_FAIL;
+
+    /* the references */
+    std::array<StdVideoDecodeH264ReferenceInfo, 16>  stdRefs = { };
+    std::array<VkVideoDecodeH264DpbSlotInfoKHR, 16>  dpbInfos;
+    Picture pic;
+
+    for (uint32_t i = 0; i < 16u; i++) {
+      const auto& e = pp.RefFrameList[i];
+      if (e.bPicEntry == 0xff)
+        continue;
+
+      int32_t slot = e.Index7Bits < m_surfaceSlot.size() ? m_surfaceSlot[e.Index7Bits] : -1;
+      if (slot < 0 || slot == currentSlot) {
+        Logger::warn(str::format("Video decoder: reference surface ", uint32_t(e.Index7Bits), " was never decoded"));
+        continue;
+      }
+
+      auto& r = stdRefs[pic.refCount];
+      r.flags.used_for_long_term_reference = e.AssociatedFlag;
+      r.flags.is_non_existing = (pp.NonExistingFrameFlags >> i) & 1u;
+      r.FrameNum = pp.FrameNumList[i];
+      r.PicOrderCnt[0] = pp.FieldOrderCntList[i][0];
+      r.PicOrderCnt[1] = pp.FieldOrderCntList[i][1];
+
+      dpbInfos[pic.refCount] = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR };
+      dpbInfos[pic.refCount].pStdReferenceInfo = &r;
+
+      pic.refInfos[pic.refCount] = &dpbInfos[pic.refCount];
+      pic.refSlots[pic.refCount] = slot;
+      pic.refCount++;
+    }
+
+    /* the picture decoded, and the slot it is set up in */
+    StdVideoDecodeH264ReferenceInfo cur = { };
+    cur.FrameNum = pp.frame_num;
+    cur.PicOrderCnt[0] = pp.CurrFieldOrderCnt[0];
+    cur.PicOrderCnt[1] = pp.CurrFieldOrderCnt[1];
+
+    VkVideoDecodeH264DpbSlotInfoKHR curDpb = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR };
+    curDpb.pStdReferenceInfo = &cur;
+
+    StdVideoDecodeH264PictureInfo stdPic = { };
+    stdPic.flags.is_intra = pp.IntraPicFlag;
+    stdPic.flags.IdrPicFlag = idr;
+    stdPic.flags.is_reference = pp.RefPicFlag;
+    stdPic.seq_parameter_set_id = 0;
+    stdPic.pic_parameter_set_id = uint8_t(ppsId);
+    stdPic.frame_num = pp.frame_num;
+    stdPic.idr_pic_id = 0;
+    stdPic.PicOrderCnt[0] = pp.CurrFieldOrderCnt[0];
+    stdPic.PicOrderCnt[1] = pp.CurrFieldOrderCnt[1];
+
+    VkVideoDecodeH264PictureInfoKHR h264Pic = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PICTURE_INFO_KHR };
+    h264Pic.pStdPictureInfo = &stdPic;
+    h264Pic.sliceCount = sliceCount;
+    h264Pic.pSliceOffsets = sliceOffsets.data();
+
+    pic.pictureInfo = &h264Pic;
+    pic.setupInfo = &curDpb;
+    pic.currentSlot = currentSlot;
+    pic.extent = { std::min((pp.wFrameWidthInMbsMinus1 + 1u) * 16u, m_codedExtent.width),
+                   std::min((pp.wFrameHeightInMbsMinus1 + 1u) * 16u, m_codedExtent.height) };
+    pic.bitstream = &bsBuf.data;
+    pic.bitstreamSize = bsBuf.size;
+
+    return Record(f, pic, Output);
+  }
+
+
+  /* ---- HEVC -------------------------------------------------------------------------------------------- */
+
+  HRESULT DxvkVideoDecoder::DecodeHevc(DxvkVideoDecodeOutput& Output) {
+    const auto& ppBuf = m_buffers[DxvkVideoBufferPictureParameters];
+    const auto& qmBuf = m_buffers[DxvkVideoBufferInverseQuantizationMatrix];
+    const auto& slBuf = m_buffers[DxvkVideoBufferSliceControl];
+    const auto& bsBuf = m_buffers[DxvkVideoBufferBitstream];
+
+    if (!ppBuf.submitted || ppBuf.size < sizeof(DXVA_PicParams_HEVC)
+     || !slBuf.submitted || slBuf.size < sizeof(DXVA_Slice_HEVC_Short) || !bsBuf.submitted || !bsBuf.size)
+      return E_INVALIDARG;
+
+    const auto& pp = *reinterpret_cast<const DXVA_PicParams_HEVC*>(ppBuf.data.data());
+    uint32_t sliceCount = slBuf.size / sizeof(DXVA_Slice_HEVC_Short);
+    const auto* slices = reinterpret_cast<const DXVA_Slice_HEVC_Short*>(slBuf.data.data());
+
+    uint32_t bitDepth = m_support.codec == DxvkVideoCodec::HevcMain10 ? 2u : 0u;
+    if (pp.chroma_format_idc != 1 || pp.separate_colour_plane_flag
+     || pp.bit_depth_luma_minus8 > bitDepth || pp.bit_depth_chroma_minus8 > bitDepth) {
+      Logger::warn("Video decoder: this HEVC format is not decoded");
+      return E_NOTIMPL;
+    }
+
+    std::vector<uint32_t> sliceOffsets(sliceCount);
+    for (uint32_t i = 0; i < sliceCount; i++)
+      sliceOffsets[i] = slices[i].BSNALunitDataLocation;
+
+    /* the first slice's NAL unit type (whether the picture is a reference) and the PPS it names:
+     * first_slice_segment_in_pic_flag, no_output_of_prior_pics_flag (IRAP), slice_pic_parameter_set_id */
+    uint32_t nalType = 1u, ppsId = 0u;
+    if (sliceCount) {
+      uint32_t at = findNalUnit(bsBuf.data.data(), bsBuf.size, sliceOffsets[0]);
+      if (at != ~0u && at + 2u < bsBuf.size) {
+        nalType = (bsBuf.data[at] >> 1) & 0x3f;
+        SliceHeaderReader reader(bsBuf.data.data() + at + 2u, bsBuf.size - at - 2u);
+        uint32_t first = 0, noOutput = 0, id = 0;
+        if (reader.readBits(1, first) && (nalType < 16u || nalType > 23u || reader.readBits(1, noOutput))
+         && reader.readUe(id) && id < 64u)
+          ppsId = id;
+      }
+    }
+
+    /* the DPB */
+    std::vector<uint32_t> referenced;
+    for (uint32_t i = 0; i < 15u; i++) {
+      if (pp.RefPicList[i].bPicEntry != 0xff)
+        referenced.push_back(pp.RefPicList[i].Index7Bits);
+    }
+
+    uint32_t current = pp.CurrPic.Index7Bits;
+    int32_t currentSlot = AcquireSlot(current, referenced);
+
+    if (currentSlot < 0) {
+      Logger::err("Video decoder: no free DPB slot");
+      return E_FAIL;
+    }
+
+    Frame& f = NextFrame();
+
+    uint32_t log2MinCb = pp.log2_min_luma_coding_block_size_minus3 + 3u;
+    uint32_t width  = uint32_t(pp.PicWidthInMinCbsY) << log2MinCb;
+    uint32_t height = uint32_t(pp.PicHeightInMinCbsY) << log2MinCb;
+
+    /* the parameter sets, from the picture parameters: the VPS and SPS id 0, the PPS by the slices'
+     * id. The SPS's short-term reference picture sets are not in DXVA's parameters: the picture's
+     * own references are given whole (RefPicSet*), as with DXVA */
+    StdVideoH265ProfileTierLevel ptl = { };
+    ptl.flags.general_progressive_source_flag = 1;
+    ptl.flags.general_frame_only_constraint_flag = 1;
+    ptl.general_profile_idc = m_support.codec == DxvkVideoCodec::HevcMain10 ? STD_VIDEO_H265_PROFILE_IDC_MAIN_10 : STD_VIDEO_H265_PROFILE_IDC_MAIN;
+    ptl.general_level_idc = m_support.h265Caps.maxLevelIdc;
+
+    StdVideoH265DecPicBufMgr dpbMgr = { };
+    dpbMgr.max_dec_pic_buffering_minus1[0] = pp.sps_max_dec_pic_buffering_minus1;
+    dpbMgr.max_num_reorder_pics[0] = pp.sps_max_dec_pic_buffering_minus1;
+
+    StdVideoH265HrdParameters hrd = { };
+
+    StdVideoH265VideoParameterSet vps = { };
+    vps.flags.vps_temporal_id_nesting_flag = 1;
+    vps.vps_video_parameter_set_id = 0;
+    vps.pDecPicBufMgr = &dpbMgr;
+    vps.pHrdParameters = &hrd;
+    vps.pProfileTierLevel = &ptl;
+
+    StdVideoH265ScalingLists scaling = { };
+    bool lists = pp.scaling_list_enabled_flag && qmBuf.submitted && qmBuf.size >= sizeof(DXVA_Qmatrix_HEVC);
+    if (lists) {
+      const auto& qm = *reinterpret_cast<const DXVA_Qmatrix_HEVC*>(qmBuf.data.data());
+      std::memcpy(scaling.ScalingList4x4, qm.ucScalingLists0, sizeof(qm.ucScalingLists0));
+      std::memcpy(scaling.ScalingList8x8, qm.ucScalingLists1, sizeof(qm.ucScalingLists1));
+      std::memcpy(scaling.ScalingList16x16, qm.ucScalingLists2, sizeof(qm.ucScalingLists2));
+      std::memcpy(scaling.ScalingList32x32, qm.ucScalingLists3, sizeof(qm.ucScalingLists3));
+      std::memcpy(scaling.ScalingListDCCoef16x16, qm.ucScalingListDCCoefSizeID2, sizeof(qm.ucScalingListDCCoefSizeID2));
+      std::memcpy(scaling.ScalingListDCCoef32x32, qm.ucScalingListDCCoefSizeID3, sizeof(qm.ucScalingListDCCoefSizeID3));
+    }
+
+    std::vector<StdVideoH265ShortTermRefPicSet> stRps(std::max<uint32_t>(pp.num_short_term_ref_pic_sets, 1u));
+    StdVideoH265LongTermRefPicsSps ltSps = { };
+    StdVideoH265SequenceParameterSetVui vui = { };
+    vui.pHrdParameters = &hrd;
+    StdVideoH265PredictorPaletteEntries palette = { };
+
+    StdVideoH265SequenceParameterSet sps = { };
+    sps.flags.sps_temporal_id_nesting_flag = 1;
+    sps.flags.scaling_list_enabled_flag = pp.scaling_list_enabled_flag;
+    sps.flags.amp_enabled_flag = pp.amp_enabled_flag;
+    sps.flags.sample_adaptive_offset_enabled_flag = pp.sample_adaptive_offset_enabled_flag;
+    sps.flags.pcm_enabled_flag = pp.pcm_enabled_flag;
+    sps.flags.pcm_loop_filter_disabled_flag = pp.pcm_loop_filter_disabled_flag;
+    sps.flags.long_term_ref_pics_present_flag = pp.long_term_ref_pics_present_flag;
+    sps.flags.sps_temporal_mvp_enabled_flag = pp.sps_temporal_mvp_enabled_flag;
+    sps.flags.strong_intra_smoothing_enabled_flag = pp.strong_intra_smoothing_enabled_flag;
+    sps.chroma_format_idc = STD_VIDEO_H265_CHROMA_FORMAT_IDC_420;
+    sps.pic_width_in_luma_samples = width;
+    sps.pic_height_in_luma_samples = height;
+    sps.sps_video_parameter_set_id = 0;
+    sps.sps_seq_parameter_set_id = 0;
+    sps.bit_depth_luma_minus8 = pp.bit_depth_luma_minus8;
+    sps.bit_depth_chroma_minus8 = pp.bit_depth_chroma_minus8;
+    sps.log2_max_pic_order_cnt_lsb_minus4 = pp.log2_max_pic_order_cnt_lsb_minus4;
+    sps.log2_min_luma_coding_block_size_minus3 = pp.log2_min_luma_coding_block_size_minus3;
+    sps.log2_diff_max_min_luma_coding_block_size = pp.log2_diff_max_min_luma_coding_block_size;
+    sps.log2_min_luma_transform_block_size_minus2 = pp.log2_min_transform_block_size_minus2;
+    sps.log2_diff_max_min_luma_transform_block_size = pp.log2_diff_max_min_transform_block_size;
+    sps.max_transform_hierarchy_depth_inter = pp.max_transform_hierarchy_depth_inter;
+    sps.max_transform_hierarchy_depth_intra = pp.max_transform_hierarchy_depth_intra;
+    sps.num_short_term_ref_pic_sets = pp.num_short_term_ref_pic_sets;
+    sps.num_long_term_ref_pics_sps = pp.num_long_term_ref_pics_sps;
+    sps.pcm_sample_bit_depth_luma_minus1 = pp.pcm_sample_bit_depth_luma_minus1;
+    sps.pcm_sample_bit_depth_chroma_minus1 = pp.pcm_sample_bit_depth_chroma_minus1;
+    sps.log2_min_pcm_luma_coding_block_size_minus3 = pp.log2_min_pcm_luma_coding_block_size_minus3;
+    sps.log2_diff_max_min_pcm_luma_coding_block_size = pp.log2_diff_max_min_pcm_luma_coding_block_size;
+    sps.pProfileTierLevel = &ptl;
+    sps.pDecPicBufMgr = &dpbMgr;
+    sps.pScalingLists = &scaling;
+    sps.pShortTermRefPicSet = stRps.data();
+    sps.pLongTermRefPicsSps = &ltSps;
+    sps.pSequenceParameterSetVui = &vui;
+    sps.pPredictorPaletteEntries = &palette;
+
+    StdVideoH265PictureParameterSet pps = { };
+    pps.flags.dependent_slice_segments_enabled_flag = pp.dependent_slice_segments_enabled_flag;
+    pps.flags.output_flag_present_flag = pp.output_flag_present_flag;
+    pps.flags.sign_data_hiding_enabled_flag = pp.sign_data_hiding_enabled_flag;
+    pps.flags.cabac_init_present_flag = pp.cabac_init_present_flag;
+    pps.flags.constrained_intra_pred_flag = pp.constrained_intra_pred_flag;
+    pps.flags.transform_skip_enabled_flag = pp.transform_skip_enabled_flag;
+    pps.flags.cu_qp_delta_enabled_flag = pp.cu_qp_delta_enabled_flag;
+    pps.flags.pps_slice_chroma_qp_offsets_present_flag = pp.pps_slice_chroma_qp_offsets_present_flag;
+    pps.flags.weighted_pred_flag = pp.weighted_pred_flag;
+    pps.flags.weighted_bipred_flag = pp.weighted_bipred_flag;
+    pps.flags.transquant_bypass_enabled_flag = pp.transquant_bypass_enabled_flag;
+    pps.flags.tiles_enabled_flag = pp.tiles_enabled_flag;
+    pps.flags.entropy_coding_sync_enabled_flag = pp.entropy_coding_sync_enabled_flag;
+    pps.flags.uniform_spacing_flag = pp.uniform_spacing_flag;
+    pps.flags.loop_filter_across_tiles_enabled_flag = pp.loop_filter_across_tiles_enabled_flag;
+    pps.flags.pps_loop_filter_across_slices_enabled_flag = pp.pps_loop_filter_across_slices_enabled_flag;
+    /* not one of DXVA's: present whenever what it governs is */
+    pps.flags.deblocking_filter_control_present_flag = pp.deblocking_filter_override_enabled_flag
+      || pp.pps_deblocking_filter_disabled_flag || pp.pps_beta_offset_div2 || pp.pps_tc_offset_div2;
+    pps.flags.deblocking_filter_override_enabled_flag = pp.deblocking_filter_override_enabled_flag;
+    pps.flags.pps_deblocking_filter_disabled_flag = pp.pps_deblocking_filter_disabled_flag;
+    pps.flags.pps_scaling_list_data_present_flag = lists;
+    pps.flags.lists_modification_present_flag = pp.lists_modification_present_flag;
+    pps.flags.slice_segment_header_extension_present_flag = pp.slice_segment_header_extension_present_flag;
+    pps.pps_pic_parameter_set_id = uint8_t(ppsId);
+    pps.pps_seq_parameter_set_id = 0;
+    pps.sps_video_parameter_set_id = 0;
+    pps.num_extra_slice_header_bits = pp.num_extra_slice_header_bits;
+    pps.num_ref_idx_l0_default_active_minus1 = pp.num_ref_idx_l0_default_active_minus1;
+    pps.num_ref_idx_l1_default_active_minus1 = pp.num_ref_idx_l1_default_active_minus1;
+    pps.init_qp_minus26 = pp.init_qp_minus26;
+    pps.diff_cu_qp_delta_depth = pp.diff_cu_qp_delta_depth;
+    pps.pps_cb_qp_offset = pp.pps_cb_qp_offset;
+    pps.pps_cr_qp_offset = pp.pps_cr_qp_offset;
+    pps.pps_beta_offset_div2 = pp.pps_beta_offset_div2;
+    pps.pps_tc_offset_div2 = pp.pps_tc_offset_div2;
+    pps.log2_parallel_merge_level_minus2 = pp.log2_parallel_merge_level_minus2;
+    pps.num_tile_columns_minus1 = pp.num_tile_columns_minus1;
+    pps.num_tile_rows_minus1 = pp.num_tile_rows_minus1;
+    for (uint32_t i = 0; i < 19u; i++)
+      pps.column_width_minus1[i] = pp.column_width_minus1[i];
+    for (uint32_t i = 0; i < 21u; i++)
+      pps.row_height_minus1[i] = pp.row_height_minus1[i];
+    pps.pScalingLists = &scaling;
+    pps.pPredictorPaletteEntries = &palette;
+
+    VkVideoDecodeH265SessionParametersAddInfoKHR add = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR };
+    add.stdVPSCount = 1u;
+    add.pStdVPSs = &vps;
+    add.stdSPSCount = 1u;
+    add.pStdSPSs = &sps;
+    add.stdPPSCount = 1u;
+    add.pStdPPSs = &pps;
+
+    VkVideoDecodeH265SessionParametersCreateInfoKHR paramsInfo = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    paramsInfo.maxStdVPSCount = 1u;
+    paramsInfo.maxStdSPSCount = 1u;
+    paramsInfo.maxStdPPSCount = 1u;
+    paramsInfo.pParametersAddInfo = &add;
+
+    if (!CreateParams(f, &paramsInfo))
+      return E_FAIL;
+
+    /* the references, and where each of RefPicList's is in the DPB */
+    std::array<StdVideoDecodeH265ReferenceInfo, 16> stdRefs = { };
+    std::array<VkVideoDecodeH265DpbSlotInfoKHR, 16> dpbInfos;
+    std::array<int32_t, 15> listSlot;
+    listSlot.fill(-1);
+    Picture pic;
+
+    for (uint32_t i = 0; i < 15u; i++) {
+      const auto& e = pp.RefPicList[i];
+      if (e.bPicEntry == 0xff)
+        continue;
+
+      int32_t slot = e.Index7Bits < m_surfaceSlot.size() ? m_surfaceSlot[e.Index7Bits] : -1;
+      if (slot < 0 || slot == currentSlot) {
+        Logger::warn(str::format("Video decoder: reference surface ", uint32_t(e.Index7Bits), " was never decoded"));
+        continue;
+      }
+
+      listSlot[i] = slot;
+
+      auto& r = stdRefs[pic.refCount];
+      r.flags.used_for_long_term_reference = e.AssociatedFlag;
+      r.PicOrderCntVal = pp.PicOrderCntValList[i];
+
+      dpbInfos[pic.refCount] = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_DPB_SLOT_INFO_KHR };
+      dpbInfos[pic.refCount].pStdReferenceInfo = &r;
+
+      pic.refInfos[pic.refCount] = &dpbInfos[pic.refCount];
+      pic.refSlots[pic.refCount] = slot;
+      pic.refCount++;
+    }
+
+    StdVideoDecodeH265ReferenceInfo cur = { };
+    cur.PicOrderCntVal = pp.CurrPicOrderCntVal;
+
+    VkVideoDecodeH265DpbSlotInfoKHR curDpb = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_DPB_SLOT_INFO_KHR };
+    curDpb.pStdReferenceInfo = &cur;
+
+    StdVideoDecodeH265PictureInfo stdPic = { };
+    stdPic.flags.IrapPicFlag = pp.IrapPicFlag;
+    stdPic.flags.IdrPicFlag = pp.IdrPicFlag;
+    stdPic.flags.IsReference = nalType < 16u ? (nalType & 1u) : 1u;
+    /* the slice took its short-term set from the SPS when it coded none itself */
+    stdPic.flags.short_term_ref_pic_set_sps_flag = !pp.IdrPicFlag && !pp.wNumBitsForShortTermRPSInSlice;
+    stdPic.sps_video_parameter_set_id = 0;
+    stdPic.pps_seq_parameter_set_id = 0;
+    stdPic.pps_pic_parameter_set_id = uint8_t(ppsId);
+    stdPic.NumDeltaPocsOfRefRpsIdx = pp.ucNumDeltaPocsOfRefRpsIdx;
+    stdPic.PicOrderCntVal = pp.CurrPicOrderCntVal;
+    stdPic.NumBitsForSTRefPicSetInSlice = pp.wNumBitsForShortTermRPSInSlice;
+
+    /* DXVA's sets index RefPicList; Vulkan's name DPB slots */
+    auto mapSet = [&] (uint8_t* dst, const UCHAR* src) {
+      for (uint32_t i = 0; i < 8u; i++)
+        dst[i] = src[i] < 15u && listSlot[src[i]] >= 0 ? uint8_t(listSlot[src[i]]) : 0xffu;
+    };
+    mapSet(stdPic.RefPicSetStCurrBefore, pp.RefPicSetStCurrBefore);
+    mapSet(stdPic.RefPicSetStCurrAfter, pp.RefPicSetStCurrAfter);
+    mapSet(stdPic.RefPicSetLtCurr, pp.RefPicSetLtCurr);
+
+    VkVideoDecodeH265PictureInfoKHR h265Pic = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PICTURE_INFO_KHR };
+    h265Pic.pStdPictureInfo = &stdPic;
+    h265Pic.sliceSegmentCount = sliceCount;
+    h265Pic.pSliceSegmentOffsets = sliceOffsets.data();
+
+    pic.pictureInfo = &h265Pic;
+    pic.setupInfo = &curDpb;
+    pic.currentSlot = currentSlot;
+    pic.extent = { std::min(width, m_codedExtent.width), std::min(height, m_codedExtent.height) };
+    pic.bitstream = &bsBuf.data;
+    pic.bitstreamSize = bsBuf.size;
+
+    return Record(f, pic, Output);
+  }
+
+  /* ---- AV1 ----------------------------------------------------------------------------------------- */
+
+  /* the AV1 specification's get_relative_dist */
+  static int av1RelativeDist(uint32_t bits, int a, int b) {
+    if (!bits)
+      return 0;
+    int diff = a - b;
+    int m = 1 << (bits - 1);
+    return (diff & (m - 1)) - (diff & m);
+  }
+
+
+  HRESULT DxvkVideoDecoder::DecodeAv1(DxvkVideoDecodeOutput& Output) {
+    const auto& ppBuf = m_buffers[DxvkVideoBufferPictureParameters];
+    const auto& tlBuf = m_buffers[DxvkVideoBufferSliceControl];
+    const auto& bsBuf = m_buffers[DxvkVideoBufferBitstream];
+
+    if (!ppBuf.submitted || ppBuf.size < sizeof(DXVA_PicParams_AV1)
+     || !tlBuf.submitted || tlBuf.size < sizeof(DXVA_Tile_AV1) || !bsBuf.submitted || !bsBuf.size)
+      return E_INVALIDARG;
+
+    const auto& pp = *reinterpret_cast<const DXVA_PicParams_AV1*>(ppBuf.data.data());
+    const auto* tiles = reinterpret_cast<const DXVA_Tile_AV1*>(tlBuf.data.data());
+    uint32_t tileCount = tlBuf.size / sizeof(DXVA_Tile_AV1);
+
+    uint32_t bitDepth = m_support.codec == DxvkVideoCodec::Av1Main10 ? 10u : 8u;
+    if (pp.seq_profile != 0 || pp.format.mono_chrome || !pp.format.subsampling_x || !pp.format.subsampling_y
+     || pp.bitdepth > bitDepth) {
+      Logger::warn("Video decoder: this AV1 format is not decoded");
+      return E_NOTIMPL;
+    }
+
+    static bool s_grainWarned = false;
+    if (pp.film_grain.apply_grain && !std::exchange(s_grainWarned, true))
+      Logger::warn("Video decoder: AV1 film grain is not applied");
+
+    /* the DPB: every surface the reference map holds stays */
+    std::vector<uint32_t> referenced;
+    for (uint32_t i = 0; i < 8u; i++) {
+      if (pp.RefFrameMapTextureIndex[i] != 0xff)
+        referenced.push_back(pp.RefFrameMapTextureIndex[i]);
+    }
+
+    int32_t currentSlot = AcquireSlot(pp.CurrPicTextureIndex, referenced);
+    if (currentSlot < 0) {
+      Logger::err("Video decoder: no free DPB slot");
+      return E_FAIL;
+    }
+
+    Frame& f = NextFrame();
+
+    uint32_t orderHintBits = pp.order_hint_bits;
+    auto bits = [] (uint32_t v) { uint32_t n = 1; while (n < 16 && (1u << n) <= v) n++; return n; };
+
+    /* the sequence header, from what the picture parameters say of it */
+    StdVideoAV1ColorConfig color = { };
+    color.flags.mono_chrome = 0;
+    color.flags.separate_uv_delta_q = pp.quantization.u_dc_delta_q != pp.quantization.v_dc_delta_q
+                                   || pp.quantization.u_ac_delta_q != pp.quantization.v_ac_delta_q;
+    color.BitDepth = pp.bitdepth;
+    color.subsampling_x = 1;
+    color.subsampling_y = 1;
+    color.color_primaries = STD_VIDEO_AV1_COLOR_PRIMARIES_UNSPECIFIED;
+    color.transfer_characteristics = STD_VIDEO_AV1_TRANSFER_CHARACTERISTICS_UNSPECIFIED;
+    color.matrix_coefficients = STD_VIDEO_AV1_MATRIX_COEFFICIENTS_UNSPECIFIED;
+
+    StdVideoAV1SequenceHeader seq = { };
+    seq.flags.use_128x128_superblock = pp.coding.use_128x128_superblock;
+    seq.flags.enable_filter_intra = pp.coding.filter_intra;
+    seq.flags.enable_intra_edge_filter = pp.coding.intra_edge_filter;
+    seq.flags.enable_interintra_compound = pp.coding.interintra_compound;
+    seq.flags.enable_masked_compound = pp.coding.masked_compound;
+    seq.flags.enable_warped_motion = 1;
+    seq.flags.enable_dual_filter = pp.coding.dual_filter;
+    seq.flags.enable_order_hint = orderHintBits != 0;
+    seq.flags.enable_jnt_comp = pp.coding.jnt_comp;
+    seq.flags.enable_ref_frame_mvs = pp.coding.enable_ref_frame_mvs;
+    seq.flags.enable_superres = pp.coding.superres;
+    seq.flags.enable_cdef = pp.coding.cdef;
+    seq.flags.enable_restoration = pp.coding.restoration;
+    seq.flags.film_grain_params_present = pp.coding.film_grain;
+    seq.seq_profile = STD_VIDEO_AV1_PROFILE_MAIN;
+    seq.max_frame_width_minus_1 = uint16_t(std::max(pp.max_width, pp.width) - 1u);
+    seq.max_frame_height_minus_1 = uint16_t(std::max(pp.max_height, pp.height) - 1u);
+    seq.frame_width_bits_minus_1 = uint8_t(bits(seq.max_frame_width_minus_1) - 1u);
+    seq.frame_height_bits_minus_1 = uint8_t(bits(seq.max_frame_height_minus_1) - 1u);
+    seq.order_hint_bits_minus_1 = orderHintBits ? uint8_t(orderHintBits - 1u) : 0u;
+    seq.seq_force_integer_mv = 2;            /* SELECT_INTEGER_MV: the frame says */
+    seq.seq_force_screen_content_tools = 2;  /* SELECT_SCREEN_CONTENT_TOOLS */
+    seq.pColorConfig = &color;
+
+    VkVideoDecodeAV1SessionParametersCreateInfoKHR paramsInfo = { VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    paramsInfo.pStdSequenceHeader = &seq;
+
+    if (!CreateParams(f, &paramsInfo))
+      return E_FAIL;
+
+    /* the references: each reference name's surface, its DPB slot and what its own decode was */
+    int32_t nameSlot[7];
+    uint8_t refHint[7] = { };
+    bool    refValid[7] = { };
+    std::array<StdVideoDecodeAV1ReferenceInfo, 8> stdRefs = { };
+    std::array<VkVideoDecodeAV1DpbSlotInfoKHR, 8> dpbInfos;
+    Picture pic;
+
+    for (uint32_t i = 0; i < 7u; i++) {
+      nameSlot[i] = -1;
+      uint32_t idx = pp.frame_refs[i].Index;
+      if (idx >= 8u || pp.RefFrameMapTextureIndex[idx] == 0xff)
+        continue;
+      uint32_t surface = pp.RefFrameMapTextureIndex[idx];
+      int32_t slot = surface < m_surfaceSlot.size() ? m_surfaceSlot[surface] : -1;
+      if (slot < 0 || slot == currentSlot) {
+        Logger::warn(str::format("Video decoder: reference surface ", surface, " was never decoded"));
+        continue;
+      }
+      nameSlot[i] = slot;
+      refHint[i] = m_av1Slots[slot].orderHint;
+      refValid[i] = true;
+
+      bool listed = false;
+      for (uint32_t j = 0; j < pic.refCount; j++)
+        listed |= pic.refSlots[j] == slot;
+      if (listed)
+        continue;
+
+      const auto& info = m_av1Slots[slot];
+      auto& r = stdRefs[pic.refCount];
+      r.flags.disable_frame_end_update_cdf = info.disableFrameEndUpdateCdf;
+      r.flags.segmentation_enabled = info.segmentationEnabled;
+      r.frame_type = info.frameType;
+      r.RefFrameSignBias = info.signBias;
+      r.OrderHint = info.orderHint;
+      std::memcpy(r.SavedOrderHints, info.orderHints, 8u);
+
+      dpbInfos[pic.refCount] = { VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_DPB_SLOT_INFO_KHR };
+      dpbInfos[pic.refCount].pStdReferenceInfo = &r;
+      pic.refInfos[pic.refCount] = &dpbInfos[pic.refCount];
+      pic.refSlots[pic.refCount] = slot;
+      pic.refCount++;
+    }
+
+    /* the order hints of the references (by reference name, 0 being the frame itself's intra), and
+     * which lie after this picture */
+    Av1SlotInfo cur;
+    cur.frameType = pp.format.frame_type;
+    cur.orderHint = pp.order_hint;
+    cur.disableFrameEndUpdateCdf = pp.coding.disable_frame_end_update_cdf;
+    cur.segmentationEnabled = pp.segmentation.enabled;
+    for (uint32_t i = 0; i < 7u; i++) {
+      cur.orderHints[i + 1] = refHint[i];
+      if (refValid[i] && orderHintBits && av1RelativeDist(orderHintBits, refHint[i], pp.order_hint) > 0)
+        cur.signBias |= 1u << (i + 1);
+    }
+
+    /* skip mode's two references (the specification's, from the order hints) */
+    uint8_t skipModeFrame[2] = { 0, 0 };
+    bool intra = pp.format.frame_type == 0 || pp.format.frame_type == 2;
+    if (pp.coding.skip_mode && !intra && pp.coding.reference_mode && orderHintBits) {
+      int fwd = -1, bwd = -1, fwdHint = 0, bwdHint = 0;
+      for (int i = 0; i < 7; i++) {
+        if (!refValid[i]) continue;
+        int dist = av1RelativeDist(orderHintBits, refHint[i], pp.order_hint);
+        if (dist < 0) {
+          if (fwd < 0 || av1RelativeDist(orderHintBits, refHint[i], fwdHint) > 0) { fwd = i; fwdHint = refHint[i]; }
+        } else if (dist > 0) {
+          if (bwd < 0 || av1RelativeDist(orderHintBits, refHint[i], bwdHint) < 0) { bwd = i; bwdHint = refHint[i]; }
+        }
+      }
+      if (fwd >= 0 && bwd >= 0) {
+        skipModeFrame[0] = uint8_t(1 + std::min(fwd, bwd));
+        skipModeFrame[1] = uint8_t(1 + std::max(fwd, bwd));
+      } else if (fwd >= 0) {
+        int fwd2 = -1, fwd2Hint = 0;
+        for (int i = 0; i < 7; i++) {
+          if (!refValid[i]) continue;
+          if (av1RelativeDist(orderHintBits, refHint[i], fwdHint) < 0) {
+            if (fwd2 < 0 || av1RelativeDist(orderHintBits, refHint[i], fwd2Hint) > 0) { fwd2 = i; fwd2Hint = refHint[i]; }
+          }
+        }
+        if (fwd2 >= 0) {
+          skipModeFrame[0] = uint8_t(1 + std::min(fwd, fwd2));
+          skipModeFrame[1] = uint8_t(1 + std::max(fwd, fwd2));
+        }
+      }
+    }
+
+    /* tiles: sizes in superblocks, and where each starts */
+    uint16_t widthSbsM1[64] = { }, heightSbsM1[64] = { }, colStarts[65] = { }, rowStarts[65] = { };
+    uint32_t cols = std::min<uint32_t>(pp.tiles.cols, 64u), rows = std::min<uint32_t>(pp.tiles.rows, 64u);
+    for (uint32_t i = 0; i < cols; i++) {
+      widthSbsM1[i] = uint16_t(pp.tiles.widths[i] - 1u);
+      colStarts[i + 1] = uint16_t(colStarts[i] + pp.tiles.widths[i]);
+    }
+    for (uint32_t i = 0; i < rows; i++) {
+      heightSbsM1[i] = uint16_t(pp.tiles.heights[i] - 1u);
+      rowStarts[i + 1] = uint16_t(rowStarts[i] + pp.tiles.heights[i]);
+    }
+
+    StdVideoAV1TileInfo tileInfo = { };
+    tileInfo.TileCols = uint8_t(cols);
+    tileInfo.TileRows = uint8_t(rows);
+    tileInfo.context_update_tile_id = pp.tiles.context_update_id;
+    tileInfo.tile_size_bytes_minus_1 = 3;
+    tileInfo.pMiColStarts = colStarts;
+    tileInfo.pMiRowStarts = rowStarts;
+    tileInfo.pWidthInSbsMinus1 = widthSbsM1;
+    tileInfo.pHeightInSbsMinus1 = heightSbsM1;
+
+    StdVideoAV1Quantization quant = { };
+    quant.flags.using_qmatrix = pp.quantization.qm_y != 0xff;
+    quant.flags.diff_uv_delta = color.flags.separate_uv_delta_q;
+    quant.base_q_idx = pp.quantization.base_qindex;
+    quant.DeltaQYDc = pp.quantization.y_dc_delta_q;
+    quant.DeltaQUDc = pp.quantization.u_dc_delta_q;
+    quant.DeltaQUAc = pp.quantization.u_ac_delta_q;
+    quant.DeltaQVDc = pp.quantization.v_dc_delta_q;
+    quant.DeltaQVAc = pp.quantization.v_ac_delta_q;
+    quant.qm_y = quant.flags.using_qmatrix ? pp.quantization.qm_y : 0;
+    quant.qm_u = quant.flags.using_qmatrix ? pp.quantization.qm_u : 0;
+    quant.qm_v = quant.flags.using_qmatrix ? pp.quantization.qm_v : 0;
+
+    StdVideoAV1Segmentation seg = { };
+    for (uint32_t i = 0; i < 8u; i++) {
+      seg.FeatureEnabled[i] = pp.segmentation.feature_mask[i].mask;
+      for (uint32_t j = 0; j < 8u; j++)
+        seg.FeatureData[i][j] = pp.segmentation.feature_data[i][j];
+    }
+
+    StdVideoAV1LoopFilter lf = { };
+    lf.flags.loop_filter_delta_enabled = pp.loop_filter.mode_ref_delta_enabled;
+    lf.flags.loop_filter_delta_update = pp.loop_filter.mode_ref_delta_update;
+    lf.loop_filter_level[0] = pp.loop_filter.filter_level[0];
+    lf.loop_filter_level[1] = pp.loop_filter.filter_level[1];
+    lf.loop_filter_level[2] = pp.loop_filter.filter_level_u;
+    lf.loop_filter_level[3] = pp.loop_filter.filter_level_v;
+    lf.loop_filter_sharpness = pp.loop_filter.sharpness_level;
+    for (uint32_t i = 0; i < 8u; i++)
+      lf.loop_filter_ref_deltas[i] = pp.loop_filter.ref_deltas[i];
+    lf.loop_filter_mode_deltas[0] = pp.loop_filter.mode_deltas[0];
+    lf.loop_filter_mode_deltas[1] = pp.loop_filter.mode_deltas[1];
+
+    StdVideoAV1CDEF cdef = { };
+    cdef.cdef_damping_minus_3 = pp.cdef.damping;
+    cdef.cdef_bits = pp.cdef.bits;
+    for (uint32_t i = 0; i < 8u; i++) {
+      cdef.cdef_y_pri_strength[i] = pp.cdef.y_strengths[i].primary;
+      cdef.cdef_y_sec_strength[i] = pp.cdef.y_strengths[i].secondary;
+      cdef.cdef_uv_pri_strength[i] = pp.cdef.uv_strengths[i].primary;
+      cdef.cdef_uv_sec_strength[i] = pp.cdef.uv_strengths[i].secondary;
+    }
+
+    /* DXVA gives the restoration unit sizes as log2 (6 + lr_unit_shift); Vulkan as 1 + lr_unit_shift */
+    StdVideoAV1LoopRestoration lr = { };
+    bool usesLr = false, usesChromaLr = false;
+    for (uint32_t i = 0; i < 3u; i++) {
+      lr.FrameRestorationType[i] = StdVideoAV1FrameRestorationType(pp.loop_filter.frame_restoration_type[i]);
+      usesLr |= pp.loop_filter.frame_restoration_type[i] != 0;
+      usesChromaLr |= i && pp.loop_filter.frame_restoration_type[i] != 0;
+    }
+    for (uint32_t i = 0; i < 3u; i++)
+      lr.LoopRestorationSize[i] = usesLr ? uint16_t(std::max<int>(1, int(pp.loop_filter.log2_restoration_unit_size[i]) - 5)) : 1u;
+
+    StdVideoAV1GlobalMotion gm = { };
+    for (uint32_t i = 0; i < 7u; i++) {
+      gm.GmType[i + 1] = pp.frame_refs[i].wmtype;
+      for (uint32_t j = 0; j < 6u; j++)
+        gm.gm_params[i + 1][j] = pp.frame_refs[i].wmmat[j];
+    }
+
+    StdVideoDecodeAV1PictureInfo stdPic = { };
+    stdPic.flags.disable_cdf_update = pp.coding.disable_cdf_update;
+    stdPic.flags.use_superres = pp.coding.superres;
+    stdPic.flags.allow_screen_content_tools = pp.coding.screen_content_tools;
+    stdPic.flags.is_filter_switchable = pp.interp_filter == 4;
+    stdPic.flags.force_integer_mv = pp.coding.integer_mv;
+    stdPic.flags.allow_intrabc = pp.coding.intrabc;
+    stdPic.flags.allow_high_precision_mv = pp.coding.high_precision_mv;
+    stdPic.flags.is_motion_mode_switchable = pp.coding.switchable_motion_mode;
+    stdPic.flags.use_ref_frame_mvs = pp.coding.use_ref_frame_mvs;
+    stdPic.flags.disable_frame_end_update_cdf = pp.coding.disable_frame_end_update_cdf;
+    stdPic.flags.allow_warped_motion = pp.coding.warped_motion;
+    stdPic.flags.reduced_tx_set = pp.coding.reduced_tx_set;
+    stdPic.flags.reference_select = pp.coding.reference_mode;
+    stdPic.flags.skip_mode_present = pp.coding.skip_mode;
+    stdPic.flags.delta_q_present = pp.quantization.delta_q_present;
+    stdPic.flags.delta_lf_present = pp.loop_filter.delta_lf_present;
+    stdPic.flags.delta_lf_multi = pp.loop_filter.delta_lf_multi;
+    stdPic.flags.segmentation_enabled = pp.segmentation.enabled;
+    stdPic.flags.segmentation_update_map = pp.segmentation.update_map;
+    stdPic.flags.segmentation_temporal_update = pp.segmentation.temporal_update;
+    stdPic.flags.segmentation_update_data = pp.segmentation.update_data;
+    stdPic.flags.UsesLr = usesLr;
+    stdPic.flags.usesChromaLr = usesChromaLr;
+    stdPic.flags.apply_grain = 0;
+    stdPic.frame_type = StdVideoAV1FrameType(pp.format.frame_type);
+    stdPic.OrderHint = pp.order_hint;
+    stdPic.primary_ref_frame = pp.primary_ref_frame;
+    stdPic.refresh_frame_flags = pp.coding.reference_frame_update ? 0xffu : 0u;
+    stdPic.interpolation_filter = StdVideoAV1InterpolationFilter(pp.interp_filter);
+    stdPic.TxMode = StdVideoAV1TxMode(pp.coding.tx_mode);
+    stdPic.delta_q_res = pp.quantization.delta_q_res;
+    stdPic.delta_lf_res = pp.loop_filter.delta_lf_res;
+    stdPic.SkipModeFrame[0] = skipModeFrame[0];
+    stdPic.SkipModeFrame[1] = skipModeFrame[1];
+    stdPic.coded_denom = pp.coding.superres ? uint8_t(pp.superres_denom - 9u) : 0u;
+    std::memcpy(stdPic.OrderHints, cur.orderHints, 8u);
+    stdPic.pTileInfo = &tileInfo;
+    stdPic.pQuantization = &quant;
+    stdPic.pSegmentation = &seg;
+    stdPic.pLoopFilter = &lf;
+    stdPic.pCDEF = &cdef;
+    stdPic.pLoopRestoration = &lr;
+    stdPic.pGlobalMotion = &gm;
+
+    /* the tiles' data: DXVA's offsets are into the bitstream buffer, as Vulkan's */
+    std::vector<uint32_t> tileOffsets(tileCount), tileSizes(tileCount);
+    for (uint32_t i = 0; i < tileCount; i++) {
+      if (uint64_t(tiles[i].DataOffset) + tiles[i].DataSize > bsBuf.size)
+        return E_INVALIDARG;
+      tileOffsets[i] = tiles[i].DataOffset;
+      tileSizes[i] = tiles[i].DataSize;
+    }
+
+    VkVideoDecodeAV1PictureInfoKHR av1Pic = { VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_PICTURE_INFO_KHR };
+    av1Pic.pStdPictureInfo = &stdPic;
+    for (uint32_t i = 0; i < 7u; i++)
+      av1Pic.referenceNameSlotIndices[i] = nameSlot[i];
+#ifdef SG_MUTANT_AV1_REF_NAMES_SWAPPED
+    std::swap(av1Pic.referenceNameSlotIndices[0], av1Pic.referenceNameSlotIndices[3]);
+#endif
+    av1Pic.frameHeaderOffset = 0;
+    av1Pic.tileCount = tileCount;
+    av1Pic.pTileOffsets = tileOffsets.data();
+    av1Pic.pTileSizes = tileSizes.data();
+
+    StdVideoDecodeAV1ReferenceInfo curRef = { };
+    curRef.flags.disable_frame_end_update_cdf = cur.disableFrameEndUpdateCdf;
+    curRef.flags.segmentation_enabled = cur.segmentationEnabled;
+    curRef.frame_type = cur.frameType;
+    curRef.RefFrameSignBias = cur.signBias;
+    curRef.OrderHint = cur.orderHint;
+    std::memcpy(curRef.SavedOrderHints, cur.orderHints, 8u);
+
+    VkVideoDecodeAV1DpbSlotInfoKHR curDpb = { VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_DPB_SLOT_INFO_KHR };
+    curDpb.pStdReferenceInfo = &curRef;
+
+    pic.pictureInfo = &av1Pic;
+    pic.setupInfo = &curDpb;
+    pic.currentSlot = currentSlot;
+    pic.extent = { std::min(pp.width, m_codedExtent.width), std::min(pp.height, m_codedExtent.height) };
+    pic.bitstream = &bsBuf.data;
+    pic.bitstreamSize = bsBuf.size;
+
+    HRESULT hr = Record(f, pic, Output);
+    if (SUCCEEDED(hr))
+      m_av1Slots[currentSlot] = cur;
+    return hr;
+  }
+
+  /* ---- VP9 ----------------------------------------------------------------------------------------- */
+
+  HRESULT DxvkVideoDecoder::DecodeVp9(DxvkVideoDecodeOutput& Output) {
+    const auto& ppBuf = m_buffers[DxvkVideoBufferPictureParameters];
+    const auto& slBuf = m_buffers[DxvkVideoBufferSliceControl];
+    const auto& bsBuf = m_buffers[DxvkVideoBufferBitstream];
+
+    if (!ppBuf.submitted || ppBuf.size < sizeof(DXVA_PicParams_VP9)
+     || !slBuf.submitted || slBuf.size < sizeof(DXVA_Slice_VPx_Short) || !bsBuf.submitted || !bsBuf.size)
+      return E_INVALIDARG;
+
+    const auto& pp = *reinterpret_cast<const DXVA_PicParams_VP9*>(ppBuf.data.data());
+    const auto& slice = *reinterpret_cast<const DXVA_Slice_VPx_Short*>(slBuf.data.data());
+
+    bool tenBit = m_support.codec == DxvkVideoCodec::Vp9Profile2;
+    if (pp.profile != (tenBit ? 2u : 0u) || !pp.subsampling_x || !pp.subsampling_y
+     || pp.BitDepthMinus8Luma != (tenBit ? 2u : 0u)) {
+      Logger::warn("Video decoder: this VP9 format is not decoded");
+      return E_NOTIMPL;
+    }
+
+    uint32_t frameStart = slice.BSNALunitDataLocation;
+    if (uint64_t(frameStart) + pp.uncompressed_header_size_byte_aligned + pp.first_partition_size > bsBuf.size)
+      return E_INVALIDARG;
+
+    /* the DPB: every surface the reference map holds stays */
+    std::vector<uint32_t> referenced;
+    for (uint32_t i = 0; i < 8u; i++) {
+      if (pp.ref_frame_map[i].bPicEntry != 0xff)
+        referenced.push_back(pp.ref_frame_map[i].Index7Bits);
+    }
+
+    int32_t currentSlot = AcquireSlot(pp.CurrPic.Index7Bits, referenced);
+    if (currentSlot < 0) {
+      Logger::err("Video decoder: no free DPB slot");
+      return E_FAIL;
+    }
+
+    /* VP9 has no session parameters: everything comes with the picture */
+    Frame& f = NextFrame();
+    Picture pic;
+    int32_t nameSlot[3];
+
+    for (uint32_t i = 0; i < 3u; i++) {
+      nameSlot[i] = -1;
+      const auto& e = pp.frame_refs[i];
+      if (e.bPicEntry == 0xff || pp.frame_type == 0 || pp.intra_only)
+        continue;
+      int32_t slot = e.Index7Bits < m_surfaceSlot.size() ? m_surfaceSlot[e.Index7Bits] : -1;
+      if (slot < 0 || slot == currentSlot) {
+        Logger::warn(str::format("Video decoder: reference surface ", uint32_t(e.Index7Bits), " was never decoded"));
+        continue;
+      }
+      nameSlot[i] = slot;
+
+      bool listed = false;
+      for (uint32_t j = 0; j < pic.refCount; j++)
+        listed |= pic.refSlots[j] == slot;
+      if (listed)
+        continue;
+
+      pic.refInfos[pic.refCount] = nullptr;
+      pic.refSlots[pic.refCount] = slot;
+      pic.refCount++;
+    }
+
+    StdVideoVP9ColorConfig color = { };
+    color.BitDepth = uint8_t(8u + pp.BitDepthMinus8Luma);
+    color.subsampling_x = 1;
+    color.subsampling_y = 1;
+    color.color_space = STD_VIDEO_VP9_COLOR_SPACE_UNKNOWN;
+
+    /* DXVA gives the deltas in force; marking them all updated hands them over as they are */
+    StdVideoVP9LoopFilter lf = { };
+    lf.flags.loop_filter_delta_enabled = pp.mode_ref_delta_enabled;
+    lf.flags.loop_filter_delta_update = pp.mode_ref_delta_update;
+    lf.loop_filter_level = uint8_t(pp.filter_level);
+    lf.loop_filter_sharpness = uint8_t(pp.sharpness_level);
+    lf.update_ref_delta = pp.mode_ref_delta_update ? 0xfu : 0u;
+    lf.update_mode_delta = pp.mode_ref_delta_update ? 0x3u : 0u;
+    for (uint32_t i = 0; i < 4u; i++)
+      lf.loop_filter_ref_deltas[i] = pp.ref_deltas[i];
+    for (uint32_t i = 0; i < 2u; i++)
+      lf.loop_filter_mode_deltas[i] = pp.mode_deltas[i];
+
+    StdVideoVP9Segmentation seg = { };
+    seg.flags.segmentation_update_map = pp.stVP9Segments.update_map;
+    seg.flags.segmentation_temporal_update = pp.stVP9Segments.temporal_update;
+    seg.flags.segmentation_update_data = 1;
+    seg.flags.segmentation_abs_or_delta_update = pp.stVP9Segments.abs_delta;
+    for (uint32_t i = 0; i < 7u; i++)
+      seg.segmentation_tree_probs[i] = pp.stVP9Segments.tree_probs[i];
+    for (uint32_t i = 0; i < 3u; i++)
+      seg.segmentation_pred_prob[i] = pp.stVP9Segments.pred_probs[i];
+    for (uint32_t i = 0; i < 8u; i++) {
+      seg.FeatureEnabled[i] = pp.stVP9Segments.feature_mask[i] & 0xfu;
+      for (uint32_t j = 0; j < 4u; j++)
+        seg.FeatureData[i][j] = pp.stVP9Segments.feature_data[i][j];
+    }
+
+    StdVideoDecodeVP9PictureInfo stdPic = { };
+    stdPic.flags.error_resilient_mode = pp.error_resilient_mode;
+    stdPic.flags.intra_only = pp.intra_only;
+    stdPic.flags.allow_high_precision_mv = pp.allow_high_precision_mv;
+    stdPic.flags.refresh_frame_context = pp.refresh_frame_context;
+    stdPic.flags.frame_parallel_decoding_mode = pp.frame_parallel_decoding_mode;
+    stdPic.flags.segmentation_enabled = pp.stVP9Segments.enabled;
+    stdPic.flags.show_frame = pp.show_frame;
+    stdPic.flags.UsePrevFrameMvs = pp.use_prev_in_find_mv_refs;
+    stdPic.profile = StdVideoVP9Profile(pp.profile);
+    stdPic.frame_type = StdVideoVP9FrameType(pp.frame_type);
+    stdPic.frame_context_idx = pp.frame_context_idx;
+    stdPic.reset_frame_context = pp.reset_frame_context;
+    stdPic.refresh_frame_flags = pp.frame_type == 0 ? 0xffu : 0u;
+    for (uint32_t i = 1; i < 4u; i++)
+      stdPic.ref_frame_sign_bias_mask |= (pp.ref_frame_sign_bias[i] ? 1u : 0u) << i;
+    stdPic.interpolation_filter = StdVideoVP9InterpolationFilter(pp.interp_filter);
+    stdPic.base_q_idx = uint8_t(pp.base_qindex);
+    stdPic.delta_q_y_dc = pp.y_dc_delta_q;
+    stdPic.delta_q_uv_dc = pp.uv_dc_delta_q;
+    stdPic.delta_q_uv_ac = pp.uv_ac_delta_q;
+    stdPic.tile_cols_log2 = pp.log2_tile_cols;
+    stdPic.tile_rows_log2 = pp.log2_tile_rows;
+    stdPic.pColorConfig = &color;
+    stdPic.pLoopFilter = &lf;
+    stdPic.pSegmentation = &seg;
+
+    /* the frame in the bitstream buffer: its uncompressed header, compressed header and tiles */
+    VkVideoDecodeVP9PictureInfoKHR vp9Pic = { VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PICTURE_INFO_KHR };
+    vp9Pic.pStdPictureInfo = &stdPic;
+    for (uint32_t i = 0; i < 3u; i++)
+      vp9Pic.referenceNameSlotIndices[i] = nameSlot[i];
+#ifdef SG_MUTANT_VP9_NO_COMPRESSED_HEADER_OFFSET
+    vp9Pic.uncompressedHeaderOffset = frameStart;
+    vp9Pic.compressedHeaderOffset = frameStart;
+#else
+    vp9Pic.uncompressedHeaderOffset = frameStart;
+    vp9Pic.compressedHeaderOffset = frameStart + pp.uncompressed_header_size_byte_aligned;
+#endif
+    vp9Pic.tilesOffset = frameStart + pp.uncompressed_header_size_byte_aligned + pp.first_partition_size;
+
+    pic.pictureInfo = &vp9Pic;
+    pic.setupInfo = nullptr;
+    pic.currentSlot = currentSlot;
+    pic.extent = { std::min(pp.width, m_codedExtent.width), std::min(pp.height, m_codedExtent.height) };
+    pic.bitstream = &bsBuf.data;
+    pic.bitstreamSize = bsBuf.size;
+
+    return Record(f, pic, Output);
+  }
+
+}
