+#include "d3d9_video.h"
+
+#include "d3d9_device.h"
+#include "d3d9_surface.h"
+
+/* Stained Glass OS: DXVA2 video decoders on Vulkan Video (see d3d9_video.h). */
+
+namespace dxvk {
+
+  /* what DXVA2 hands out is the caller's to free with CoTaskMemFree */
+  static void* taskAlloc(size_t Size) {
+    static void* (WINAPI *s_alloc)(SIZE_T) = nullptr;
+    if (!s_alloc) {
+      HMODULE ole = LoadLibraryA("ole32.dll");
+      if (ole)
+        s_alloc = reinterpret_cast<void* (WINAPI *)(SIZE_T)>(reinterpret_cast<void*>(GetProcAddress(ole, "CoTaskMemAlloc")));
+    }
+    return s_alloc ? s_alloc(Size) : nullptr;
+  }
+
+
+  static constexpr D3DFORMAT FormatNV12 = D3DFORMAT(MAKEFOURCC('N', 'V', '1', '2'));
+
+  /* an output surface format's bit depth for DxvkVideoDecodeSupport::Find; NV12 only: this D3D9
+   * makes no P010 surfaces, so 10-bit decoders are not offered */
+  static uint32_t d3d9VideoDepth(D3DFORMAT Format) {
+    return Format == FormatNV12 ? 8u : 99u;
+  }
+
+
+  /* the decoded picture into the program's surface: its system memory copy (what LockRect gives),
+   * as NV12/P010 lays it out -- the Y plane, then the interleaved chroma at pitch x height -- and from
+   * there, through DXVK's format converter, into what it is drawn from */
+  class D3D9VideoDecodeOutput : public DxvkVideoDecodeOutput {
+
+  public:
+
+    D3D9VideoDecodeOutput(D3D9DeviceEx* pDevice, D3D9Surface* pSurface)
+    : m_device(pDevice), m_surface(pSurface) { }
+
+    void Output(
+      const Rc<DxvkImage>&            Dpb,
+            uint32_t                  Layer,
+            VkExtent2D                Extent,
+      const Rc<DxvkFence>&            DecodeFence,
+            uint64_t                  DecodeValue,
+      const Rc<DxvkFence>&            CopyFence,
+            uint64_t                  CopyValue) {
+      m_device->VideoDecodeOutput(m_surface, Dpb, Layer, Extent, DecodeFence, DecodeValue, CopyFence, CopyValue);
+    }
+
+  private:
+
+    D3D9DeviceEx* m_device;
+    D3D9Surface*  m_surface;
+
+  };
+
+
+  /* ---- the service ------------------------------------------------------------------------------- */
+
+  D3D9VideoDecoderService::D3D9VideoDecoderService(D3D9DeviceEx* pDevice)
+  : m_device(pDevice), m_support(pDevice->GetDXVKDevice(), pDevice->GetOptions()->videoDecode) {
+
+  }
+
+
+  D3D9VideoDecoderService::~D3D9VideoDecoderService() {
+
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoderService::QueryInterface(REFIID riid, void** ppvObject) {
+    if (!ppvObject)
+      return E_POINTER;
+
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown)
+     || riid == __uuidof(IDirectXVideoAccelerationService)
+     || riid == __uuidof(IDirectXVideoDecoderService)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoderService::CreateSurface(UINT Width, UINT Height, UINT BackBuffers,
+    D3DFORMAT Format, D3DPOOL Pool, DWORD Usage, DWORD DxvaType, IDirect3DSurface9** ppSurface, HANDLE* pSharedHandle) {
+    if (!ppSurface)
+      return E_POINTER;
+
+    for (UINT i = 0; i <= BackBuffers; i++) {
+      HRESULT hr = m_device->CreateOffscreenPlainSurface(Width, Height, Format, Pool, &ppSurface[i], pSharedHandle);
+      if (FAILED(hr)) {
+        while (i--) {
+          ppSurface[i]->Release();
+          ppSurface[i] = nullptr;
+        }
+        return hr;
+      }
+    }
+
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoderService::GetDecoderDeviceGuids(UINT* pCount, GUID** pGuids) {
+    if (!pCount || !pGuids)
+      return E_POINTER;
+
+    std::vector<GUID> guids;
+    for (const auto& p : m_support.Profiles()) {
+      if (p.bitDepth == 8u && std::find(guids.begin(), guids.end(), p.guid) == guids.end())
+        guids.push_back(p.guid);
+    }
+    *pCount = 0u;
+    *pGuids = nullptr;
+
+    if (guids.empty())
+      return S_OK;
+
+    if (!(*pGuids = static_cast<GUID*>(taskAlloc(guids.size() * sizeof(GUID)))))
+      return E_OUTOFMEMORY;
+
+    std::copy(guids.begin(), guids.end(), *pGuids);
+    *pCount = UINT(guids.size());
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoderService::GetDecoderRenderTargets(REFGUID Guid, UINT* pCount, D3DFORMAT** pFormats) {
+    if (!pCount || !pFormats)
+      return E_POINTER;
+
+    std::vector<D3DFORMAT> formats;
+    for (const auto& p : m_support.Profiles()) {
+      if (p.guid == Guid && p.bitDepth == 8u)
+        formats.push_back(FormatNV12);
+    }
+
+    *pCount = 0u;
+    *pFormats = nullptr;
+
+    if (formats.empty())
+      return E_INVALIDARG;
+
+    if (!(*pFormats = static_cast<D3DFORMAT*>(taskAlloc(formats.size() * sizeof(D3DFORMAT)))))
+      return E_OUTOFMEMORY;
+
+    std::copy(formats.begin(), formats.end(), *pFormats);
+    *pCount = UINT(formats.size());
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoderService::GetDecoderConfigurations(REFGUID Guid, const DXVA2_VideoDesc* pVideoDesc,
+    void* pReserved, UINT* pCount, DXVA2_ConfigPictureDecode** pConfigs) {
+    if (!pVideoDesc || !pCount || !pConfigs)
+      return E_POINTER;
+
+    *pCount = 0u;
+    *pConfigs = nullptr;
+
+    const DxvkVideoDecodeProfile* profile = m_support.Find(Guid, d3d9VideoDepth(pVideoDesc->Format));
+    if (!profile)
+      return E_INVALIDARG;
+
+    if (pVideoDesc->SampleWidth > profile->caps.maxCodedExtent.width || pVideoDesc->SampleHeight > profile->caps.maxCodedExtent.height)
+      return S_OK;
+
+    auto* config = static_cast<DXVA2_ConfigPictureDecode*>(taskAlloc(sizeof(DXVA2_ConfigPictureDecode)));
+    if (!config)
+      return E_OUTOFMEMORY;
+
+    /* the short slice format: whole NAL units, the device parses the slice headers (H.264's is 2,
+     * the others' 1) */
+    *config = DXVA2_ConfigPictureDecode();
+    config->guidConfigBitstreamEncryption = DXVA_NoEncrypt;
+    config->guidConfigMBcontrolEncryption = DXVA_NoEncrypt;
+    config->guidConfigResidDiffEncryption = DXVA_NoEncrypt;
+    config->ConfigBitstreamRaw = profile->codec == DxvkVideoCodec::H264 ? 2u : 1u;
+
+    *pConfigs = config;
+    *pCount = 1u;
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoderService::CreateVideoDecoder(REFGUID Guid, const DXVA2_VideoDesc* pVideoDesc,
+    const DXVA2_ConfigPictureDecode* pConfig, IDirect3DSurface9** ppDecoderRenderTargets,
+    UINT NumRenderTargets, IDirectXVideoDecoder** ppDecode) {
+    if (!pVideoDesc || !pConfig || !ppDecoderRenderTargets || !NumRenderTargets || !ppDecode)
+      return E_POINTER;
+
+    *ppDecode = nullptr;
+
+    const DxvkVideoDecodeProfile* profile = m_support.Find(Guid, d3d9VideoDepth(pVideoDesc->Format));
+    bool h264 = profile && profile->codec == DxvkVideoCodec::H264;
+
+    if (!profile || (h264 ? (pConfig->ConfigBitstreamRaw != 1 && pConfig->ConfigBitstreamRaw != 2) : pConfig->ConfigBitstreamRaw != 1))
+      return E_INVALIDARG;
+
+    /* the DPB as large as the largest surface: the decoded picture is copied out whole */
+    uint32_t width = pVideoDesc->SampleWidth, height = pVideoDesc->SampleHeight;
+    for (UINT i = 0; i < NumRenderTargets; i++) {
+      D3DSURFACE_DESC desc = { };
+      if (!ppDecoderRenderTargets[i] || FAILED(ppDecoderRenderTargets[i]->GetDesc(&desc)) || desc.Format != pVideoDesc->Format)
+        return E_INVALIDARG;
+      width = std::max<uint32_t>(width, desc.Width);
+      height = std::max<uint32_t>(height, desc.Height);
+    }
+
+    try {
+      Com<D3D9VideoDecoder> decoder = new D3D9VideoDecoder(this, Guid, *pVideoDesc, *pConfig,
+        ppDecoderRenderTargets, NumRenderTargets, *profile, width, height);
+      if (!decoder->IsValid())
+        return E_FAIL;
+      *ppDecode = decoder.ref();
+      return S_OK;
+    } catch (const DxvkError& e) {
+      Logger::err(e.message());
+      return E_FAIL;
+    }
+  }
+
+
+  /* ---- the decoder ------------------------------------------------------------------------------- */
+
+  D3D9VideoDecoder::D3D9VideoDecoder(D3D9VideoDecoderService* pService, REFGUID Guid, const DXVA2_VideoDesc& Desc,
+    const DXVA2_ConfigPictureDecode& Config, IDirect3DSurface9** ppRenderTargets, UINT NumRenderTargets,
+    const DxvkVideoDecodeProfile& Profile, uint32_t Width, uint32_t Height)
+  : m_service(pService), m_guid(Guid), m_desc(Desc), m_config(Config) {
+    for (UINT i = 0; i < NumRenderTargets; i++)
+      m_renderTargets.push_back(ppRenderTargets[i]);
+
+    m_core = std::make_unique<DxvkVideoDecoder>(pService->GetDevice()->GetDXVKDevice(), Profile,
+      Width, Height, Config.ConfigBitstreamRaw);
+  }
+
