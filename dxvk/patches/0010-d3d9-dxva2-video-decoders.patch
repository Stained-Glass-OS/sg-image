   /* ---- decoder -------------------------------------------------------------------------------------- */
 
+  /* the decoded picture into the program's texture, on DXVK's queue after the decode */
+  class D3D11VideoDecodeOutput : public DxvkVideoDecodeOutput {
+
+  public:
+
+    D3D11VideoDecodeOutput(D3D11ImmediateContext* pContext, D3D11VideoDecoderOutputView* pView)
+    : m_context(pContext), m_view(pView) { }
+
+    void Output(
+      const Rc<DxvkImage>&            Dpb,
+            uint32_t                  Layer,
+            VkExtent2D                Extent,
+      const Rc<DxvkFence>&            DecodeFence,
+            uint64_t                  DecodeValue,
+      const Rc<DxvkFence>&            CopyFence,
+            uint64_t                  CopyValue) {
+      Rc<DxvkImage> dstImage = m_view->GetImage();
+      VkExtent3D dstExtent = dstImage->mipLevelExtent(0u);
+      VkExtent3D extent = { std::min(dstExtent.width, Extent.width), std::min(dstExtent.height, Extent.height), 1u };
+
+      VkImageSubresourceLayers dstLayers = { VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT, 0u, m_view->GetArraySlice(), 1u };
+      VkImageSubresourceLayers srcLayers = { VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT, 0u, Layer, 1u };
+
+      m_context->EmitCs([
+        cDecodeFence  = DecodeFence,
+        cDecodeValue  = DecodeValue,
+        cCopyFence    = CopyFence,
+        cCopyValue    = CopyValue,
+        cDst          = std::move(dstImage),
+        cDstLayers    = dstLayers,
+        cSrc          = Dpb,
+        cSrcLayers    = srcLayers,
+        cExtent       = extent
+      ] (DxvkContext* ctx) {
+        ctx->waitFence(cDecodeFence, cDecodeValue);
+        ctx->copyImage(cDst, cDstLayers, VkOffset3D(), cSrc, cSrcLayers, VkOffset3D(), cExtent);
+        ctx->signalFence(cCopyFence, cCopyValue);
+      });
+
+      /* the next decode waits for this copy: it must reach the GPU */
+      m_context->Flush();
+    }
+
+  private:
+
+    D3D11ImmediateContext*        m_context;
+    D3D11VideoDecoderOutputView*  m_view;
+
+  };
