+#pragma once
+
+/* Stained Glass OS: video decoders on Vulkan Video, for D3D11's video decoders (D3D11VA, d3d11) and
+ * DXVA2's (d3d9, through Wine's dxva2.dll).
+ *
+ * Programs that decode video themselves -- Chromium and Electron programs, Firefox, VLC, mpv, Kodi,
+ * MPC-HC -- hand a decoder DXVA buffers: picture parameters, the inverse quantization matrices, slice
+ * control and the bitstream. Both APIs carry the same DXVA structures and number their buffers the
+ * same way. They are turned into the Vulkan Video standard headers' structures, decoded into a DPB of
+ * our own, and the picture handed to the API's side to put into the program's surface
+ * (DxvkVideoDecodeOutput). Written from the DXVA and Vulkan specifications.
+ *
+ * H.264 (VLD, no film grain), 8-bit 4:2:0, progressive; HEVC Main and Main10; AV1 Main (profile 0),
+ * 8- and 10-bit; VP9 profile 0 and profile 2 (10-bit). Offered only on drivers it was proven on
+ * (d3d11.videoDecode). */
+
+#include <array>
+#include <mutex>
+#include <vector>
+
+#include "dxvk_device.h"
+
+#include <dxva.h>
+
+namespace dxvk {
+
+  enum class DxvkVideoCodec : uint32_t {
+    H264,
+    HevcMain,
+    HevcMain10,
+    Av1Main8,
+    Av1Main10,
+    Vp9Profile0,
+    Vp9Profile2,
+  };
+
+  /* DXVA's buffer types, numbered alike in D3D11 and DXVA2 */
+  enum DxvkVideoBufferType : uint32_t {
+    DxvkVideoBufferPictureParameters          = 0,
+    DxvkVideoBufferMacroblockControl          = 1,
+    DxvkVideoBufferResidualDifference         = 2,
+    DxvkVideoBufferDeblockingControl          = 3,
+    DxvkVideoBufferInverseQuantizationMatrix  = 4,
+    DxvkVideoBufferSliceControl               = 5,
+    DxvkVideoBufferBitstream                  = 6,
+    DxvkVideoBufferMotionVector               = 7,
+    DxvkVideoBufferFilmGrain                  = 8,
+  };
+
+  /* DXVA's decoder GUIDs (the same in D3D11 and DXVA2) */
+  static constexpr GUID DXVK_DECODER_PROFILE_H264_VLD_NOFGT =
+    { 0x1b81be68, 0xa0c7, 0x11d3, { 0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5 } };
+  static constexpr GUID DXVK_DECODER_PROFILE_HEVC_VLD_MAIN =
+    { 0x5b11d51b, 0x2f4c, 0x4452, { 0xbc, 0xc3, 0x09, 0xf2, 0xa1, 0x16, 0x0c, 0xc0 } };
+  static constexpr GUID DXVK_DECODER_PROFILE_HEVC_VLD_MAIN10 =
+    { 0x107af0e0, 0xef1a, 0x4d19, { 0xab, 0xa8, 0x67, 0xa1, 0x63, 0x07, 0x3d, 0x13 } };
+  static constexpr GUID DXVK_DECODER_PROFILE_AV1_VLD_PROFILE0 =
+    { 0xb8be4ccb, 0xcf53, 0x46ba, { 0x8d, 0x59, 0xd6, 0xb8, 0xa6, 0xda, 0x5d, 0x2a } };
+  static constexpr GUID DXVK_DECODER_PROFILE_VP9_VLD_PROFILE0 =
+    { 0x463707f8, 0xa1d0, 0x4585, { 0x87, 0x6d, 0x83, 0xaa, 0x6d, 0x60, 0xb8, 0x9e } };
+  static constexpr GUID DXVK_DECODER_PROFILE_VP9_VLD_10BIT_PROFILE2 =
+    { 0xa4c749ef, 0x6ecf, 0x48aa, { 0x84, 0x48, 0x50, 0xa7, 0xa1, 0x16, 0x5f, 0xf7 } };
+
+
+  /**
+   * \brief A decoder profile and what the device does of it
+   */
+  struct DxvkVideoDecodeProfile {
+    DxvkVideoCodec                    codec;
+    GUID                              guid;
+    uint32_t                          bitDepth;   // of the output: 8 (NV12) or 10 (P010)
+    VkFormat                          vkFormat;
+    bool                              supported = false;
+    VkVideoCapabilitiesKHR            caps        = { VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR };
+    VkVideoDecodeCapabilitiesKHR      decodeCaps  = { VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR };
+    VkVideoDecodeH264CapabilitiesKHR  h264Caps    = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_CAPABILITIES_KHR };
+    VkVideoDecodeH265CapabilitiesKHR  h265Caps    = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_CAPABILITIES_KHR };
+    VkVideoDecodeAV1CapabilitiesKHR   av1Caps     = { VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_CAPABILITIES_KHR };
+    VkVideoDecodeVP9CapabilitiesKHR   vp9Caps     = { VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_CAPABILITIES_KHR };
+  };
+
+
+  /**
+   * \brief The Vulkan profile structures of a codec, kept together (the chain points into itself)
+   */
+  struct DxvkVideoProfileInfo {
+    VkVideoProfileInfoKHR             profile     = { VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR };
+    VkVideoDecodeH264ProfileInfoKHR   h264        = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PROFILE_INFO_KHR };
+    VkVideoDecodeH265ProfileInfoKHR   h265        = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PROFILE_INFO_KHR };
+    VkVideoDecodeAV1ProfileInfoKHR    av1         = { VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_PROFILE_INFO_KHR };
+    VkVideoDecodeVP9ProfileInfoKHR    vp9         = { VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PROFILE_INFO_KHR };
+    VkVideoProfileListInfoKHR         list        = { VK_STRUCTURE_TYPE_VIDEO_PROFILE_LIST_INFO_KHR };
+
+    void Fill(DxvkVideoCodec Codec);
+  };
+
+
+  /**
+   * \brief What the device's video decode queue can do
+   */
+  class DxvkVideoDecodeSupport {
+
+  public:
+
+    /* Policy: d3d11.videoDecode (Auto: NVIDIA's driver only) */
+    DxvkVideoDecodeSupport(const Rc<DxvkDevice>& Device, Tristate Policy);
+
+    /* the supported profiles, in the order they are listed to programs */
+    const std::vector<DxvkVideoDecodeProfile>& Profiles() const {
+      return m_profiles;
+    }
+
+    /* the decoder profiles (GUIDs) offered, each once: a GUID may decode to more than one format */
+    std::vector<GUID> Guids() const;
+
+    /* a profile by GUID and output bit depth (0: its first) */
+    const DxvkVideoDecodeProfile* Find(const GUID& Guid, uint32_t BitDepth = 0u) const;
+
+  private:
+
+    std::vector<DxvkVideoDecodeProfile> m_profiles;
+
+  };
+
+
+  /**
+   * \brief Where a decoded picture goes: the API's side copies it out of the DPB, on DXVK's queue,
+   * after waiting for the decode (DecodeFence), and signals CopyFence when done
+   */
+  class DxvkVideoDecodeOutput {
+
+  public:
+
+    virtual ~DxvkVideoDecodeOutput() { }
+
+    virtual void Output(
+      const Rc<DxvkImage>&            Dpb,
+            uint32_t                  Layer,
+            VkExtent2D                Extent,
+      const Rc<DxvkFence>&            DecodeFence,
+            uint64_t                  DecodeValue,
+      const Rc<DxvkFence>&            CopyFence,
+            uint64_t                  CopyValue) = 0;
+
+  };
+
+
+  /**
+   * \brief A video decoder on a Vulkan video session
+   */
+  class DxvkVideoDecoder {
+
+  public:
+
+    DxvkVideoDecoder(
+      const Rc<DxvkDevice>&           Device,
+      const DxvkVideoDecodeProfile&   Profile,
+            uint32_t                  Width,
+            uint32_t                  Height,
+            uint32_t                  ConfigBitstreamRaw);
+
+    ~DxvkVideoDecoder();
+
+    /* whether the Vulkan objects were made */
+    bool IsValid() const {
+      return m_session != VK_NULL_HANDLE;
+    }
+
+    HRESULT GetBuffer(
+            uint32_t                  Type,
+            UINT*                     pBufferSize,
+            void**                    ppBuffer);
+
+    HRESULT ReleaseBuffer(
+            uint32_t                  Type);
+
+    void BeginFrame();
+
+    HRESULT SubmitBuffer(
+            uint32_t                  Type,
+            UINT                      Offset,
+            UINT                      Size);
+
+    /* decodes what was submitted; the picture goes to Output */
+    HRESULT EndFrame(
+            DxvkVideoDecodeOutput&    Output);
+
+  private:
+
+    /* frames in flight: a bitstream buffer, a command buffer and the parameters each, reused only
+     * once the decode that used them is done */
+    static constexpr uint32_t FrameCount = 4u;
+
+    struct Frame {
+      VkBuffer                    bitstream = VK_NULL_HANDLE;
+      VkDeviceMemory              memory = VK_NULL_HANDLE;
+      uint8_t*                    map = nullptr;
+      VkCommandBuffer             cmd = VK_NULL_HANDLE;
+      VkFence                     fence = VK_NULL_HANDLE;
+      VkVideoSessionParametersKHR params = VK_NULL_HANDLE;
+      bool                        submitted = false;
+    };
+
+    struct Buffer {
+      std::vector<uint8_t> data;
+      UINT                 size = 0;     // what was submitted
+      bool                 submitted = false;
+    };
+
+    /* what a codec's preparation hands to the common recording */
+    struct Picture {
+      const void*                               pictureInfo = nullptr;    // VkVideoDecodeH26xPictureInfoKHR
+      const void*                               setupInfo = nullptr;      // the current picture's DPB slot info
+      std::array<const void*, 16>               refInfos = { };           // references' DPB slot infos
+      std::array<int32_t, 16>                   refSlots = { };
+      uint32_t                                  refCount = 0u;
+      int32_t                                   currentSlot = -1;
+      VkExtent2D                                extent = { };
+      const std::vector<uint8_t>*               bitstream = nullptr;
+      uint32_t                                  bitstreamSize = 0u;
+    };
+
+    Rc<DxvkDevice>              m_device;
+    DxvkVideoDecodeProfile      m_support;
+    DxvkVideoProfileInfo        m_profile;
+    uint32_t                    m_width;
+    uint32_t                    m_height;
+    uint32_t                    m_configBitstreamRaw;
+
+    std::mutex                  m_mutex;
+
+    VkExtent2D                  m_codedExtent = { };
+    uint32_t                    m_slotCount = 0u;
+    VkDeviceSize                m_bitstreamAlign = 1u;
+    VkDeviceSize                m_bitstreamSize = 0u;
+
+    VkVideoSessionKHR           m_session = VK_NULL_HANDLE;
+    std::vector<VkDeviceMemory> m_sessionMemory;
+
+    VkImage                     m_dpbImage = VK_NULL_HANDLE;
+    VkDeviceMemory              m_dpbMemory = VK_NULL_HANDLE;
+    std::vector<VkImageView>    m_slotViews;   // one 2D view per DPB slot
+    Rc<DxvkImage>               m_dpb;         // the same image, for DXVK's copies
+
+    VkCommandPool               m_cmdPool = VK_NULL_HANDLE;
+    std::array<Frame, FrameCount> m_frames;
+    uint32_t                    m_nextFrame = 0u;
+    bool                        m_reset = false;
+    bool                        m_dpbInitialized = false;
+
+    /* the decode queue signals m_decodeFence; DXVK's copy out of a slot waits for it and signals
+     * m_copyFence, which the next decode waits for */
+    Rc<DxvkFence>               m_decodeFence;
+    uint64_t                    m_decodeValue = 0u;
+    Rc<DxvkFence>               m_copyFence;
+    uint64_t                    m_copyValue = 0u;
+
+    /* DXVA surface index (D3D11: output view array slice; DXVA2: render target index) -> DPB slot, and what is in each slot */
+    std::vector<int32_t>        m_surfaceSlot;
+    std::vector<int32_t>        m_slotSurface;
+
+    Buffer                      m_buffers[DxvkVideoBufferFilmGrain + 1];
+
+    /* AV1: what the references' own decodes were, which DXVA does not repeat (by DPB slot) */
+    struct Av1SlotInfo {
+      uint8_t frameType = 0;
+      uint8_t orderHint = 0;
+      uint8_t signBias = 0;
+      uint8_t orderHints[8] = { };
+      bool    disableFrameEndUpdateCdf = false;
+      bool    segmentationEnabled = false;
+    };
+    std::array<Av1SlotInfo, 17> m_av1Slots;
+
+    bool CreateSession();
+    bool CreateDpb();
+    bool CreateFrames();
+    void DestroyObjects();
+
+    uint32_t FindMemoryType(uint32_t TypeBits, VkMemoryPropertyFlags Flags) const;
+
+    /* a DPB slot for the surface decoded into, freeing those no reference names any more */
+    int32_t AcquireSlot(uint32_t Surface, const std::vector<uint32_t>& Referenced);
+
+    Frame& NextFrame();
+
+    bool CreateParams(Frame& F, const void* pCodecCreateInfo);
+
+    HRESULT Record(Frame& F, const Picture& Pic, DxvkVideoDecodeOutput& Output);
+
+    HRESULT DecodeH264(DxvkVideoDecodeOutput& Output);
+
+    HRESULT DecodeHevc(DxvkVideoDecodeOutput& Output);
+
+    HRESULT DecodeAv1(DxvkVideoDecodeOutput& Output);
+
+    HRESULT DecodeVp9(DxvkVideoDecodeOutput& Output);
+
+  };
