new file mode 100644
index 0000000..4116765
--- /dev/null
+++ b/src/d3d9/d3d9_video.h
@@ -0,0 +1,112 @@
+#pragma once
+
+/* Stained Glass OS: DXVA2 video decoders (IDirectXVideoDecoderService, IDirectXVideoDecoder) on
+ * Vulkan Video, the same decoders as D3D11's (dxvk_video_decoder.h).
+ *
+ * Programs that decode through DXVA2 -- MPC-HC, VLC's and mpv's dxva2 modes, older players, FFmpeg's
+ * dxva2 hwaccel -- get the decoder service from dxva2.dll (DXVA2CreateVideoService,
+ * IDirect3DDeviceManager9::GetVideoService), which on Windows asks the D3D9 driver. Wine's dxva2.dll
+ * asks the D3D9 device for this service by a private interface id (IID_ISgD3D9VideoDecoderService,
+ * wine-sg) and hands its decoder calls on. Decoded pictures go into the program's NV12 surfaces'
+ * system memory copy -- what LockRect returns -- and from there into what is drawn. 8-bit only: this
+ * D3D9 makes no P010 surfaces, so the 10-bit decoders are not offered here. */
+
+#include <vector>
+
+#include "d3d9_include.h"
+
+#include <dxva2api.h>
+
+#include "../dxvk/dxvk_video_decoder.h"
+
+namespace dxvk {
+
+  class D3D9DeviceEx;
+
+  /* the private interface id Wine's dxva2.dll asks the device for: answered with an
+   * IDirectXVideoDecoderService */
+  static constexpr GUID IID_ISgD3D9VideoDecoderService =
+    { 0x1f6b2c7e, 0x3a8d, 0x4f05, { 0x9c, 0x21, 0x5e, 0x4d, 0x7b, 0x9a, 0x0c, 0x13 } };
+
+
+  class D3D9VideoDecoderService : public ComObject<IDirectXVideoDecoderService> {
+
+  public:
+
+    D3D9VideoDecoderService(D3D9DeviceEx* pDevice);
+
+    ~D3D9VideoDecoderService();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    HRESULT STDMETHODCALLTYPE CreateSurface(UINT Width, UINT Height, UINT BackBuffers, D3DFORMAT Format,
+      D3DPOOL Pool, DWORD Usage, DWORD DxvaType, IDirect3DSurface9** ppSurface, HANDLE* pSharedHandle);
+
+    HRESULT STDMETHODCALLTYPE GetDecoderDeviceGuids(UINT* pCount, GUID** pGuids);
+
+    HRESULT STDMETHODCALLTYPE GetDecoderRenderTargets(REFGUID Guid, UINT* pCount, D3DFORMAT** pFormats);
+
+    HRESULT STDMETHODCALLTYPE GetDecoderConfigurations(REFGUID Guid, const DXVA2_VideoDesc* pVideoDesc,
+      void* pReserved, UINT* pCount, DXVA2_ConfigPictureDecode** pConfigs);
+
+    HRESULT STDMETHODCALLTYPE CreateVideoDecoder(REFGUID Guid, const DXVA2_VideoDesc* pVideoDesc,
+      const DXVA2_ConfigPictureDecode* pConfig, IDirect3DSurface9** ppDecoderRenderTargets,
+      UINT NumRenderTargets, IDirectXVideoDecoder** ppDecode);
+
+    D3D9DeviceEx* GetDevice() const {
+      return m_device.ptr();
+    }
+
+  private:
+
+    Com<D3D9DeviceEx>       m_device;
+
+    DxvkVideoDecodeSupport  m_support;
+
+  };
+
+
+  class D3D9VideoDecoder : public ComObject<IDirectXVideoDecoder> {
+
+  public:
+
+    D3D9VideoDecoder(D3D9VideoDecoderService* pService, REFGUID Guid, const DXVA2_VideoDesc& Desc,
+      const DXVA2_ConfigPictureDecode& Config, IDirect3DSurface9** ppRenderTargets, UINT NumRenderTargets,
+      const DxvkVideoDecodeProfile& Profile, uint32_t Width, uint32_t Height);
+
+    ~D3D9VideoDecoder();
+
+    bool IsValid() const {
+      return m_core && m_core->IsValid();
+    }
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    HRESULT STDMETHODCALLTYPE GetVideoDecoderService(IDirectXVideoDecoderService** ppService);
+
+    HRESULT STDMETHODCALLTYPE GetCreationParameters(GUID* pDeviceGuid, DXVA2_VideoDesc* pVideoDesc,
+      DXVA2_ConfigPictureDecode* pConfig, IDirect3DSurface9*** pDecoderRenderTargets, UINT* pNumSurfaces);
+
+    HRESULT STDMETHODCALLTYPE GetBuffer(UINT BufferType, void** ppBuffer, UINT* pBufferSize);
+
+    HRESULT STDMETHODCALLTYPE ReleaseBuffer(UINT BufferType);
+
+    HRESULT STDMETHODCALLTYPE BeginFrame(IDirect3DSurface9* pRenderTarget, void* pvPVPData);
+
+    HRESULT STDMETHODCALLTYPE EndFrame(HANDLE* pHandleComplete);
+
+    HRESULT STDMETHODCALLTYPE Execute(const DXVA2_DecodeExecuteParams* pExecuteParams);
+
+  private:
+
+    Com<D3D9VideoDecoderService>          m_service;
+    GUID                                  m_guid;
+    DXVA2_VideoDesc                       m_desc;
+    DXVA2_ConfigPictureDecode             m_config;
+    std::vector<Com<IDirect3DSurface9>>   m_renderTargets;
+    std::unique_ptr<DxvkVideoDecoder>     m_core;
+    Com<IDirect3DSurface9>                m_target;
+
+  };
+
+}
