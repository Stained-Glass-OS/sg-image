+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::QueryInterface(REFIID riid, void** ppvObject) {
+    if (!ppvObject)
+      return E_POINTER;
+
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown) || riid == __uuidof(IDirectXVideoDecoder)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::GetVideoDecoderService(IDirectXVideoDecoderService** ppService) {
+    if (!ppService)
+      return E_POINTER;
+    *ppService = m_service.ref();
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::GetCreationParameters(GUID* pDeviceGuid, DXVA2_VideoDesc* pVideoDesc,
+    DXVA2_ConfigPictureDecode* pConfig, IDirect3DSurface9*** pDecoderRenderTargets, UINT* pNumSurfaces) {
+    if (!pDeviceGuid && !pVideoDesc && !pConfig && !pDecoderRenderTargets)
+      return E_INVALIDARG;
+
+    if (pDeviceGuid) *pDeviceGuid = m_guid;
+    if (pVideoDesc) *pVideoDesc = m_desc;
+    if (pConfig) *pConfig = m_config;
+
+    if (pDecoderRenderTargets) {
+      if (!pNumSurfaces)
+        return E_INVALIDARG;
+      auto** targets = static_cast<IDirect3DSurface9**>(taskAlloc(m_renderTargets.size() * sizeof(IDirect3DSurface9*)));
+      if (!targets)
+        return E_OUTOFMEMORY;
+      for (size_t i = 0; i < m_renderTargets.size(); i++)
+        targets[i] = m_renderTargets[i].ref();
+      *pDecoderRenderTargets = targets;
+      *pNumSurfaces = UINT(m_renderTargets.size());
+    }
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::GetBuffer(UINT BufferType, void** ppBuffer, UINT* pBufferSize) {
+    return m_core->GetBuffer(BufferType, pBufferSize, ppBuffer);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::ReleaseBuffer(UINT BufferType) {
+    return m_core->ReleaseBuffer(BufferType);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::BeginFrame(IDirect3DSurface9* pRenderTarget, void* pvPVPData) {
+    if (!pRenderTarget)
+      return E_INVALIDARG;
+
+    m_target = pRenderTarget;
+    m_core->BeginFrame();
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::Execute(const DXVA2_DecodeExecuteParams* pExecuteParams) {
+    if (!pExecuteParams)
+      return E_INVALIDARG;
+
+    for (UINT i = 0; i < pExecuteParams->NumCompBuffers; i++) {
+      const auto& b = pExecuteParams->pCompressedBuffers[i];
+      HRESULT hr = m_core->SubmitBuffer(b.CompressedBufferType, b.DataOffset, b.DataSize);
+      if (FAILED(hr))
+        return hr;
+    }
+    return S_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9VideoDecoder::EndFrame(HANDLE* pHandleComplete) {
+    if (m_target == nullptr)
+      return E_INVALIDARG;
+
+    if (pHandleComplete)
+      *pHandleComplete = nullptr;
+
+    D3D9VideoDecodeOutput output(m_service->GetDevice(), static_cast<D3D9Surface*>(m_target.ptr()));
+    HRESULT hr = m_core->EndFrame(output);
+
+    m_target = nullptr;
+    return hr;
+  }
+
+}
