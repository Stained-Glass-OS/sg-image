+  void D3D9DeviceEx::VideoDecodeOutput(
+          D3D9Surface*            pSurface,
+    const Rc<DxvkImage>&          Dpb,
+          uint32_t                Layer,
+          VkExtent2D              Extent,
+    const Rc<DxvkFence>&          DecodeFence,
+          uint64_t                DecodeValue,
+    const Rc<DxvkFence>&          CopyFence,
+          uint64_t                CopyValue) {
+    D3D9DeviceLock lock = LockDevice();
+
+    D3D9CommonTexture* texture = pSurface->GetCommonTexture();
+    UINT subresource = pSurface->GetSubresource();
+    const auto& desc = *texture->Desc();
+
+    // The system memory copy, laid out as LockRect gives it: the luma rows, then the interleaved
+    // chroma rows from pitch x height on
+    texture->CreateBuffer(false, texture->GetTotalSize());
+    DxvkBufferSlice slice = texture->GetBufferSlice(subresource);
+
+    uint32_t elementSize = desc.Format == D3D9Format::P010 ? 2u : 1u;
+    VkDeviceSize pitch = align(VkDeviceSize(desc.Width) * elementSize, 4u);
+    VkExtent3D dpbExtent = Dpb->mipLevelExtent(0u);
+    VkExtent3D extent = { std::min(desc.Width, dpbExtent.width) & ~1u, std::min(desc.Height, dpbExtent.height) & ~1u, 1u };
+
+    static bool s_warned = false;
+    if (extent.width != desc.Width && !std::exchange(s_warned, true))
+      Logger::warn("D3D9: a video surface wider than its decoder; its rows are not copied whole");
+
+    EmitCs([
+      cDecodeFence  = DecodeFence,
+      cDecodeValue  = DecodeValue,
+      cCopyFence    = CopyFence,
+      cCopyValue    = CopyValue,
+      cDpb          = Dpb,
+      cLayer        = Layer,
+      cBuffer       = slice.buffer(),
+      cOffset       = slice.offset(),
+      cChroma       = slice.offset() + pitch * desc.Height,
+      cExtent       = extent
+    ] (DxvkContext* ctx) {
+      ctx->waitFence(cDecodeFence, cDecodeValue);
+      ctx->copyImageToBuffer(cBuffer, cOffset, 4u, 0u, VK_FORMAT_UNDEFINED, cDpb,
+        { VK_IMAGE_ASPECT_PLANE_0_BIT, 0u, cLayer, 1u }, VkOffset3D(), cExtent);
+#ifndef SG_MUTANT_DXVA2_NO_CHROMA
+      ctx->copyImageToBuffer(cBuffer, cChroma, 4u, 0u, VK_FORMAT_UNDEFINED, cDpb,
+        { VK_IMAGE_ASPECT_PLANE_1_BIT, 0u, cLayer, 1u }, VkOffset3D(), cExtent);
+#endif
+      ctx->signalFence(cCopyFence, cCopyValue);
+    });
+
+    TrackTextureMappingBufferSequenceNumber(texture, subresource);
+    texture->SetNeedsReadback(subresource, false);
+    texture->SetVideoDecoded(true);
+
+    // ...and what it is drawn from (StretchRect, a texture), through the format converter
+    if (texture->GetImage() != nullptr) {
+      texture->AddDirtyBox(nullptr, 0u);
+      FlushImage(texture, subresource);
+    }
+
+    // The next decode waits for the copy: it must reach the GPU
+    Flush();
+  }
