+  };
+
+
+  /**
+   * \brief D3D11 video decoder on a Vulkan video session
+   */
+  class D3D11VideoDecoder : public D3D11DeviceChild<ID3D11VideoDecoder> {
+
+  public:
+
+    D3D11VideoDecoder(
+            D3D11Device*                    pDevice,
+      const D3D11_VIDEO_DECODER_DESC&       Desc,
+      const D3D11_VIDEO_DECODER_CONFIG&     Config);
+
+    ~D3D11VideoDecoder();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(
+            REFIID                  riid,
+            void**                  ppvObject);
+
+    HRESULT STDMETHODCALLTYPE GetCreationParameters(
+            D3D11_VIDEO_DECODER_DESC*   pVideoDesc,
+            D3D11_VIDEO_DECODER_CONFIG* pConfig);
+
+    HRESULT STDMETHODCALLTYPE GetDriverHandle(
+            HANDLE*                     pDriverHandle);
+
+    /* whether the Vulkan objects were made */
+    bool IsValid() const {
+      return m_session != VK_NULL_HANDLE;
+    }
+
+    /* the D3D11VideoContext's calls */
+    HRESULT GetBuffer(
+            D3D11_VIDEO_DECODER_BUFFER_TYPE Type,
+            UINT*                       pBufferSize,
+            void**                      ppBuffer);
+
+    HRESULT ReleaseBuffer(
+            D3D11_VIDEO_DECODER_BUFFER_TYPE Type);
+
+    HRESULT BeginFrame(
+            D3D11VideoDecoderOutputView* pView);
+
+    HRESULT SubmitBuffers(
+            UINT                        NumBuffers,
+      const D3D11_VIDEO_DECODER_BUFFER_DESC* pBufferDescs);
+
+    HRESULT EndFrame(
+            D3D11ImmediateContext*      pContext);
+
+  private:
+
+    struct Buffer {
+      std::vector<uint8_t> data;
+      UINT                 size = 0;     // what was submitted
+      bool                 submitted = false;
+    };
+
+    Rc<DxvkDevice>              m_device;
+    Tristate                    m_policy;
+    D3D11_VIDEO_DECODER_DESC    m_desc;
+    D3D11_VIDEO_DECODER_CONFIG  m_config;
+
+    std::mutex                  m_mutex;
+
+    VkVideoProfileInfoKHR             m_profile     = { VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR };
+    VkVideoDecodeH264ProfileInfoKHR   m_h264Profile = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PROFILE_INFO_KHR };
+    VkVideoProfileListInfoKHR         m_profileList = { VK_STRUCTURE_TYPE_VIDEO_PROFILE_LIST_INFO_KHR };
+
+    VkExtent2D                  m_codedExtent = { };
+    uint32_t                    m_slotCount = 0u;
+    StdVideoH264LevelIdc        m_maxLevel = STD_VIDEO_H264_LEVEL_IDC_5_2;
+    VkDeviceSize                m_bitstreamAlign = 1u;
+    VkDeviceSize                m_bitstreamSize = 0u;
+
+    VkVideoSessionKHR           m_session = VK_NULL_HANDLE;
+    std::vector<VkDeviceMemory> m_sessionMemory;
+    VkVideoSessionParametersKHR m_params = VK_NULL_HANDLE;
+
+    VkImage                     m_dpbImage = VK_NULL_HANDLE;
+    VkDeviceMemory              m_dpbMemory = VK_NULL_HANDLE;
+    VkImageView                 m_dpbView = VK_NULL_HANDLE;
+    std::vector<VkImageView>    m_slotViews;   // one 2D view per DPB slot
+    Rc<DxvkImage>               m_dpb;        // the same image, for DXVK's copies
+
+    VkBuffer                    m_bitstream = VK_NULL_HANDLE;
+    VkDeviceMemory              m_bitstreamMemory = VK_NULL_HANDLE;
+    uint8_t*                    m_bitstreamMap = nullptr;
+
+    VkCommandPool               m_cmdPool = VK_NULL_HANDLE;
+    VkCommandBuffer             m_cmd = VK_NULL_HANDLE;
+    VkFence                     m_fence = VK_NULL_HANDLE;
+    bool                        m_submitted = false;
+    bool                        m_reset = false;
+
+    /* DXK copies a slot out after its decode; the next decode into a slot waits for that */
+    Rc<DxvkFence>               m_copyFence;
+    uint64_t                    m_copyValue = 0u;
+
+    /* DXVA surface index (output view array slice) -> DPB slot, and what is in each slot */
+    std::vector<int32_t>        m_surfaceSlot;
+    std::vector<int32_t>        m_slotSurface;
+
+    Buffer                      m_buffers[D3D11_VIDEO_DECODER_BUFFER_FILM_GRAIN + 1];
+    Rc<DxvkFence>               m_decodeFence;
+    uint64_t                    m_decodeValue = 0u;
+    Com<D3D11VideoDecoderOutputView> m_target;
+
+    bool CreateSession();
+    bool CreateDpb();
+    bool CreateBitstream();
+    bool CreateCommands();
+    void DestroyObjects();
+
+    uint32_t FindMemoryType(uint32_t TypeBits, VkMemoryPropertyFlags Flags) const;
+
+    int32_t SlotForSurface(uint32_t Surface, uint32_t CurrentSurface, const DXVA_PicParams_H264& Pp);
+
+    HRESULT DecodeH264(D3D11ImmediateContext* pContext);
+
+  };
+
+}
