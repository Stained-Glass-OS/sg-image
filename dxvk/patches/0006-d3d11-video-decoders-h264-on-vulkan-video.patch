+
+  /* A DPB slot for the DXVA surface the picture is decoded into: its own if it has one, else a slot
+   * no reference of this picture is in. */
+  int32_t D3D11VideoDecoder::SlotForSurface(uint32_t Surface, uint32_t CurrentSurface, const DXVA_PicParams_H264& Pp) {
+    if (Surface >= m_surfaceSlot.size())
+      return -1;
+
+    if (Surface != CurrentSurface)
+      return m_surfaceSlot[Surface];
+
+    /* slots whose surface is no longer referenced are free again */
+    std::vector<bool> referenced(m_surfaceSlot.size(), false);
+    for (uint32_t i = 0; i < 16u; i++) {
+      if (Pp.RefFrameList[i].bPicEntry != 0xff && Pp.RefFrameList[i].Index7Bits < referenced.size())
+        referenced[Pp.RefFrameList[i].Index7Bits] = true;
+    }
+
+    for (uint32_t s = 0; s < m_slotCount; s++) {
+      int32_t surf = m_slotSurface[s];
+      if (surf >= 0 && !referenced[surf] && uint32_t(surf) != CurrentSurface) {
+        m_surfaceSlot[surf] = -1;
+        m_slotSurface[s] = -1;
+      }
+    }
+
+    if (m_surfaceSlot[Surface] >= 0)
+      return m_surfaceSlot[Surface];
+
+    for (uint32_t s = 0; s < m_slotCount; s++) {
+      if (m_slotSurface[s] < 0) {
+        m_slotSurface[s] = int32_t(Surface);
+        m_surfaceSlot[Surface] = int32_t(s);
+        return int32_t(s);
+      }
+    }
+
+    return -1;
+  }
+
+
+  HRESULT D3D11VideoDecoder::DecodeH264(D3D11ImmediateContext* pContext) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto vkd = m_device->vkd();
+
+    const auto& ppBuf = m_buffers[D3D11_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS];
+    const auto& qmBuf = m_buffers[D3D11_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX];
+    const auto& slBuf = m_buffers[D3D11_VIDEO_DECODER_BUFFER_SLICE_CONTROL];
+    const auto& bsBuf = m_buffers[D3D11_VIDEO_DECODER_BUFFER_BITSTREAM];
+
+    if (!ppBuf.submitted || ppBuf.size < sizeof(DXVA_PicParams_H264)
+     || !slBuf.submitted || slBuf.size < sizeof(DXVA_Slice_H264_Short) || !bsBuf.submitted || !bsBuf.size)
+      return E_INVALIDARG;
+
+    const auto& pp = *reinterpret_cast<const DXVA_PicParams_H264*>(ppBuf.data.data());
+    const auto* slices = reinterpret_cast<const DXVA_Slice_H264_Short*>(slBuf.data.data());
+    uint32_t sliceCount = slBuf.size / (m_config.ConfigBitstreamRaw == 1 ? sizeof(DXVA_Slice_H264_Long) : sizeof(DXVA_Slice_H264_Short));
+
+    if (pp.field_pic_flag || pp.MbaffFrameFlag || !pp.frame_mbs_only_flag || pp.chroma_format_idc != 1
+     || pp.bit_depth_luma_minus8 || pp.bit_depth_chroma_minus8) {
+      Logger::warn("D3D11VideoDecoder: interlaced or non-4:2:0 8-bit H.264 is not decoded yet");
+      return E_NOTIMPL;
+    }
+
+    if (bsBuf.size > m_bitstreamSize)
+      return E_INVALIDARG;
+
+    /* the previous picture's commands are done before its buffer and command buffer are reused */
+    if (m_submitted) {
+      vkd->vkWaitForFences(vkd->device(), 1u, &m_fence, VK_TRUE, ~0ull);
+      vkd->vkResetFences(vkd->device(), 1u, &m_fence);
+      m_submitted = false;
+    }
+
+    VkDeviceSize range = alignUp(bsBuf.size, m_bitstreamAlign);
+    std::memcpy(m_bitstreamMap, bsBuf.data.data(), bsBuf.size);
+    std::memset(m_bitstreamMap + bsBuf.size, 0, range - bsBuf.size);
+
+    std::vector<uint32_t> sliceOffsets(sliceCount);
+    for (uint32_t i = 0; i < sliceCount; i++) {
+      const auto& s = m_config.ConfigBitstreamRaw == 1
+        ? *reinterpret_cast<const DXVA_Slice_H264_Short*>(&reinterpret_cast<const DXVA_Slice_H264_Long*>(slBuf.data.data())[i])
+        : slices[i];
+      sliceOffsets[i] = s.BSNALunitDataLocation;
+    }
+
+    /* an IDR picture (the first slice's NAL unit type, 5), and the picture parameter set its
+     * slices name */
+    bool idr = false;
+    uint32_t ppsId = 0u;
+    if (sliceCount) {
+      uint32_t at = sliceOffsets[0];
+      const uint8_t* b = bsBuf.data.data();
+      while (at + 3u < bsBuf.size && !(b[at] == 0 && b[at + 1] == 0 && b[at + 2] == 1)) at++;
+      if (at + 3u < bsBuf.size) {
+        idr = (b[at + 3] & 0x1f) == 5;
+        SliceHeaderReader reader(b + at + 4u, bsBuf.size - at - 4u);
+        uint32_t firstMb = 0, sliceType = 0, id = 0;
+        if (reader.readUe(firstMb) && reader.readUe(sliceType) && reader.readUe(id) && id < 256u)
+          ppsId = id;
+      }
+    }
+
+    uint32_t current = pp.CurrPic.Index7Bits;
+    int32_t currentSlot = SlotForSurface(current, current, pp);
+
+    if (currentSlot < 0) {
+      Logger::err("D3D11VideoDecoder: no free DPB slot");
+      return E_FAIL;
+    }
+
+    /* the parameter sets, from the picture parameters (the PPS by the slices' id, its SPS id 0) */
+    StdVideoH264SequenceParameterSet sps = { };
+    sps.flags.direct_8x8_inference_flag = pp.direct_8x8_inference_flag;
+    sps.flags.frame_mbs_only_flag = pp.frame_mbs_only_flag;
+    sps.flags.delta_pic_order_always_zero_flag = pp.delta_pic_order_always_zero_flag;
+    sps.flags.qpprime_y_zero_transform_bypass_flag = pp.residual_colour_transform_flag;
+    sps.profile_idc = STD_VIDEO_H264_PROFILE_IDC_HIGH;
+    sps.level_idc = m_maxLevel;
+    sps.chroma_format_idc = STD_VIDEO_H264_CHROMA_FORMAT_IDC_420;
+    sps.seq_parameter_set_id = 0;
+    sps.bit_depth_luma_minus8 = pp.bit_depth_luma_minus8;
+    sps.bit_depth_chroma_minus8 = pp.bit_depth_chroma_minus8;
+    sps.log2_max_frame_num_minus4 = pp.log2_max_frame_num_minus4;
+    sps.pic_order_cnt_type = StdVideoH264PocType(pp.pic_order_cnt_type);
+    sps.log2_max_pic_order_cnt_lsb_minus4 = pp.log2_max_pic_order_cnt_lsb_minus4;
+    sps.max_num_ref_frames = pp.num_ref_frames;
+    sps.pic_width_in_mbs_minus1 = pp.wFrameWidthInMbsMinus1;
+    sps.pic_height_in_map_units_minus1 = pp.wFrameHeightInMbsMinus1;
+    if (sps.pic_order_cnt_type)
+      sps.log2_max_pic_order_cnt_lsb_minus4 = 0;
+
+    /* every pointer set, as drivers read them: lists not present, no VUI, no POC cycle */
+    StdVideoH264ScalingLists spsScaling = { };
+    StdVideoH264HrdParameters hrd = { };
+    StdVideoH264SequenceParameterSetVui vui = { };
+    vui.pHrdParameters = &hrd;
+    int32_t offsetForRefFrame[256] = { };
+    sps.pScalingLists = &spsScaling;
+    sps.pSequenceParameterSetVui = &vui;
+
+    sps.pOffsetForRefFrame = offsetForRefFrame;
+
+    StdVideoH264ScalingLists scaling = { };
+    StdVideoH264PictureParameterSet pps = { };
+    pps.flags.transform_8x8_mode_flag = pp.transform_8x8_mode_flag;
+    pps.flags.redundant_pic_cnt_present_flag = pp.redundant_pic_cnt_present_flag;
+    pps.flags.constrained_intra_pred_flag = pp.constrained_intra_pred_flag;
+    pps.flags.deblocking_filter_control_present_flag = pp.deblocking_filter_control_present_flag;
+    pps.flags.weighted_pred_flag = pp.weighted_pred_flag;
+    pps.flags.bottom_field_pic_order_in_frame_present_flag = pp.pic_order_present_flag;
+    pps.flags.entropy_coding_mode_flag = pp.entropy_coding_mode_flag;
+    pps.seq_parameter_set_id = 0;
+    pps.pic_parameter_set_id = uint8_t(ppsId);
+    pps.num_ref_idx_l0_default_active_minus1 = pp.num_ref_idx_l0_active_minus1;
+    pps.num_ref_idx_l1_default_active_minus1 = pp.num_ref_idx_l1_active_minus1;
+    pps.weighted_bipred_idc = StdVideoH264WeightedBipredIdc(pp.weighted_bipred_idc);
+    pps.pic_init_qp_minus26 = pp.pic_init_qp_minus26;
+    pps.pic_init_qs_minus26 = pp.pic_init_qs_minus26;
+    pps.chroma_qp_index_offset = pp.chroma_qp_index_offset;
+    pps.second_chroma_qp_index_offset = pp.second_chroma_qp_index_offset;
+    pps.pScalingLists = &scaling;
+
+    /* the scaling lists, in the order they are coded (DXVA's order) */
+    bool flat = true;
+    if (qmBuf.submitted && qmBuf.size >= sizeof(DXVA_Qmatrix_H264)) {
+      const auto& qm = *reinterpret_cast<const DXVA_Qmatrix_H264*>(qmBuf.data.data());
+      for (uint32_t i = 0; i < 6u; i++) for (uint32_t j = 0; j < 16u; j++) flat &= qm.bScalingLists4x4[i][j] == 16;
+      for (uint32_t i = 0; i < 2u; i++) for (uint32_t j = 0; j < 64u; j++) flat &= qm.bScalingLists8x8[i][j] == 16;
+    }
+
+    if (!flat) {
+      const auto& qm = *reinterpret_cast<const DXVA_Qmatrix_H264*>(qmBuf.data.data());
+      pps.flags.pic_scaling_matrix_present_flag = 1;
+      scaling.scaling_list_present_mask = 0xffu;
+      scaling.use_default_scaling_matrix_mask = 0u;
+      for (uint32_t i = 0; i < 6u; i++)
+        std::memcpy(scaling.ScalingList4x4[i], qm.bScalingLists4x4[i], 16u);
+      for (uint32_t i = 0; i < 2u; i++)
+        std::memcpy(scaling.ScalingList8x8[i], qm.bScalingLists8x8[i], 64u);
+      pps.pScalingLists = &scaling;
+    }
+
+    VkVideoDecodeH264SessionParametersAddInfoKHR add = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_ADD_INFO_KHR };
+    add.stdSPSCount = 1u;
+    add.pStdSPSs = &sps;
+    add.stdPPSCount = 1u;
+    add.pStdPPSs = &pps;
+
+    VkVideoDecodeH264SessionParametersCreateInfoKHR h264Params = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    h264Params.maxStdSPSCount = 1u;
+    h264Params.maxStdPPSCount = 1u;
+    h264Params.pParametersAddInfo = &add;
+
+    VkVideoSessionParametersCreateInfoKHR paramsInfo = { VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR };
+    paramsInfo.pNext = &h264Params;
+    paramsInfo.videoSession = m_session;
+
+    if (m_params)
+      vkd->vkDestroyVideoSessionParametersKHR(vkd->device(), m_params, nullptr);
+    m_params = VK_NULL_HANDLE;
+
+    if (vkd->vkCreateVideoSessionParametersKHR(vkd->device(), &paramsInfo, nullptr, &m_params)) {
+      m_params = VK_NULL_HANDLE;
+      return E_FAIL;
+    }
+
+    VkExtent2D picExtent = { (pp.wFrameWidthInMbsMinus1 + 1u) * 16u, (pp.wFrameHeightInMbsMinus1 + 1u) * 16u };
+    picExtent.width = std::min(picExtent.width, m_codedExtent.width);
+    picExtent.height = std::min(picExtent.height, m_codedExtent.height);
+
+    /* the references */
+    std::array<StdVideoDecodeH264ReferenceInfo, 17>     stdRefs = { };
+    std::array<VkVideoDecodeH264DpbSlotInfoKHR, 17>     dpbInfos;
+    std::array<VkVideoPictureResourceInfoKHR, 17>       resources;
+    std::array<VkVideoReferenceSlotInfoKHR, 17>         slots;
+    uint32_t refCount = 0u;
+
+    for (uint32_t i = 0; i < 16u; i++) {
+      const auto& e = pp.RefFrameList[i];
+      if (e.bPicEntry == 0xff)
+        continue;
+
+      int32_t slot = SlotForSurface(e.Index7Bits, current, pp);
+      if (slot < 0 || slot == currentSlot) {
+        Logger::warn(str::format("D3D11VideoDecoder: reference surface ", uint32_t(e.Index7Bits), " was never decoded"));
+        continue;
+      }
+
+      auto& r = stdRefs[refCount];
+      r.flags.used_for_long_term_reference = e.AssociatedFlag;
+      r.flags.is_non_existing = (pp.NonExistingFrameFlags >> i) & 1u;
+      r.FrameNum = pp.FrameNumList[i];
+      r.PicOrderCnt[0] = pp.FieldOrderCntList[i][0];
+      r.PicOrderCnt[1] = pp.FieldOrderCntList[i][1];
+
+      dpbInfos[refCount] = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR };
+      dpbInfos[refCount].pStdReferenceInfo = &r;
+
+      resources[refCount] = { VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR };
+      resources[refCount].codedExtent = picExtent;
+      resources[refCount].baseArrayLayer = 0u;
+      resources[refCount].imageViewBinding = m_slotViews[slot];
+
+      slots[refCount] = { VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR };
+      slots[refCount].pNext = &dpbInfos[refCount];
+      slots[refCount].slotIndex = slot;
+      slots[refCount].pPictureResource = &resources[refCount];
+      refCount++;
+    }
+
+    /* the picture decoded, and the slot it is set up in */
+    auto& cur = stdRefs[16];
+    cur.FrameNum = pp.frame_num;
+    cur.PicOrderCnt[0] = pp.CurrFieldOrderCnt[0];
+    cur.PicOrderCnt[1] = pp.CurrFieldOrderCnt[1];
+
+    VkVideoDecodeH264DpbSlotInfoKHR curDpb = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR };
+    curDpb.pStdReferenceInfo = &cur;
+
+    VkVideoPictureResourceInfoKHR curResource = { VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR };
+    curResource.codedExtent = picExtent;
+    curResource.baseArrayLayer = 0u;
+    curResource.imageViewBinding = m_slotViews[currentSlot];
+
+    VkVideoReferenceSlotInfoKHR setupSlot = { VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR };
+    setupSlot.pNext = &curDpb;
+    setupSlot.slotIndex = currentSlot;
+    setupSlot.pPictureResource = &curResource;
+
+    /* bound in begin coding, the set-up picture without a slot yet */
+    slots[refCount] = setupSlot;
+    slots[refCount].slotIndex = -1;
+
+    StdVideoDecodeH264PictureInfo stdPic = { };
+    stdPic.flags.field_pic_flag = 0;
+    stdPic.flags.is_intra = pp.IntraPicFlag;
+    stdPic.flags.IdrPicFlag = idr;
+    stdPic.flags.bottom_field_flag = 0;
+    stdPic.flags.is_reference = pp.RefPicFlag;
+    stdPic.flags.complementary_field_pair = 0;
+    stdPic.seq_parameter_set_id = 0;
+    stdPic.pic_parameter_set_id = uint8_t(ppsId);
+    stdPic.frame_num = pp.frame_num;
+    stdPic.idr_pic_id = 0;
+    stdPic.PicOrderCnt[0] = pp.CurrFieldOrderCnt[0];
+    stdPic.PicOrderCnt[1] = pp.CurrFieldOrderCnt[1];
+
+    VkVideoDecodeH264PictureInfoKHR h264Pic = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PICTURE_INFO_KHR };
+    h264Pic.pStdPictureInfo = &stdPic;
+    h264Pic.sliceCount = sliceCount;
+    h264Pic.pSliceOffsets = sliceOffsets.data();
+
+    VkVideoDecodeInfoKHR decode = { VK_STRUCTURE_TYPE_VIDEO_DECODE_INFO_KHR };
+    decode.pNext = &h264Pic;
+    decode.srcBuffer = m_bitstream;
+    decode.srcBufferOffset = 0u;
+    decode.srcBufferRange = range;
+    decode.dstPictureResource = curResource;
+    decode.pSetupReferenceSlot = &setupSlot;
+    decode.referenceSlotCount = refCount;
+    decode.pReferenceSlots = slots.data();
+
+    VkVideoBeginCodingInfoKHR begin = { VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR };
+    begin.videoSession = m_session;
+    begin.videoSessionParameters = m_params;
+    begin.referenceSlotCount = refCount + 1u;
+    begin.pReferenceSlots = slots.data();
+
+    VkVideoEndCodingInfoKHR end = { VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR };
+
+    /* commands */
+    VkCommandBufferBeginInfo cmdBegin = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    cmdBegin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    VkResult cr = vkd->vkResetCommandBuffer(m_cmd, 0u);
+    if (!cr) cr = vkd->vkBeginCommandBuffer(m_cmd, &cmdBegin);
+    if (cr) {
+      Logger::err(str::format("D3D11VideoDecoder: command buffer: ", cr));
+      return E_FAIL;
+    }
+
+    VkImageMemoryBarrier2 toDpb = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2 };
+    toDpb.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    toDpb.srcAccessMask = 0u;
+    toDpb.dstStageMask = VK_PIPELINE_STAGE_2_VIDEO_DECODE_BIT_KHR;
+    toDpb.dstAccessMask = VK_ACCESS_2_VIDEO_DECODE_READ_BIT_KHR | VK_ACCESS_2_VIDEO_DECODE_WRITE_BIT_KHR;
+    toDpb.oldLayout = m_reset ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED;
+    toDpb.newLayout = VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR;
+    toDpb.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toDpb.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toDpb.image = m_dpbImage;
+    toDpb.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, m_slotCount };
+
+    VkDependencyInfo dep = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    dep.imageMemoryBarrierCount = 1u;
+    dep.pImageMemoryBarriers = &toDpb;
+    vkd->vkCmdPipelineBarrier2(m_cmd, &dep);
+
+    /* a new session is reset first, in a coding scope of its own with no picture bound */
+    if (!m_reset) {
+      VkVideoBeginCodingInfoKHR resetBegin = { VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR };
+      resetBegin.videoSession = m_session;
+      resetBegin.videoSessionParameters = m_params;
+      VkVideoCodingControlInfoKHR control = { VK_STRUCTURE_TYPE_VIDEO_CODING_CONTROL_INFO_KHR };
+      control.flags = VK_VIDEO_CODING_CONTROL_RESET_BIT_KHR;
+      vkd->vkCmdBeginVideoCodingKHR(m_cmd, &resetBegin);
+      vkd->vkCmdControlVideoCodingKHR(m_cmd, &control);
+      vkd->vkCmdEndVideoCodingKHR(m_cmd, &end);
+    }
+
+    vkd->vkCmdBeginVideoCodingKHR(m_cmd, &begin);
+
+    vkd->vkCmdDecodeVideoKHR(m_cmd, &decode);
+    vkd->vkCmdEndVideoCodingKHR(m_cmd, &end);
+
+    VkImageMemoryBarrier2 toSrc = toDpb;
+    toSrc.srcStageMask = VK_PIPELINE_STAGE_2_VIDEO_DECODE_BIT_KHR;
+    toSrc.srcAccessMask = VK_ACCESS_2_VIDEO_DECODE_WRITE_BIT_KHR;
+    toSrc.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    toSrc.dstAccessMask = 0u;
+    toSrc.oldLayout = VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR;
+    toSrc.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    dep.pImageMemoryBarriers = &toSrc;
+    vkd->vkCmdPipelineBarrier2(m_cmd, &dep);
+
+    if ((cr = vkd->vkEndCommandBuffer(m_cmd))) {
+      Logger::err(str::format("D3D11VideoDecoder: recording failed: ", cr));
+
+      return E_FAIL;
+    }
+
+    /* waits for DXVK's last copy out of the DPB; DXVK's copy of this picture waits for it */
+    VkSemaphoreSubmitInfo wait = { VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO };
+    wait.semaphore = m_copyFence->handle();
+    wait.value = m_copyValue;
+    wait.stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkSemaphoreSubmitInfo signal = { VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO };
+    signal.semaphore = m_decodeFence->handle();
+    signal.value = ++m_decodeValue;
+    signal.stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+
+    VkCommandBufferSubmitInfo cmdInfo = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO };
+    cmdInfo.commandBuffer = m_cmd;
+
+    VkSubmitInfo2 submit = { VK_STRUCTURE_TYPE_SUBMIT_INFO_2 };
+    submit.waitSemaphoreInfoCount = 1u;
+    submit.pWaitSemaphoreInfos = &wait;
+    submit.commandBufferInfoCount = 1u;
+    submit.pCommandBufferInfos = &cmdInfo;
+    submit.signalSemaphoreInfoCount = 1u;
+    submit.pSignalSemaphoreInfos = &signal;
+
+    VkResult vr;
+    { std::lock_guard<std::mutex> queueLock(g_decodeQueueMutex);
+      vr = vkd->vkQueueSubmit2(m_device->queues().decode.queueHandle, 1u, &submit, m_fence);
+    }
+
+    if (vr) {
+      Logger::err(str::format("D3D11VideoDecoder: decode submission failed: ", vr));
+      return E_FAIL;
+    }
+
+    m_submitted = true;
+    m_reset = true;
+
+
+    /* the picture into the program's texture, on DXVK's queue after the decode */
+    Rc<DxvkImage> dstImage = m_target->GetImage();
+    uint32_t dstLayer = m_target->GetArraySlice();
+    VkExtent3D dstExtent = dstImage->mipLevelExtent(0u);
+    VkExtent3D extent = { std::min(dstExtent.width, picExtent.width), std::min(dstExtent.height, picExtent.height), 1u };
+
+    VkImageSubresourceLayers dstLayers = { VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT, 0u, dstLayer, 1u };
+    VkImageSubresourceLayers srcLayers = { VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT, 0u, uint32_t(currentSlot), 1u };
+
+    pContext->EmitCs([
+      cDecodeFence  = m_decodeFence,
+      cDecodeValue  = m_decodeValue,
+      cCopyFence    = m_copyFence,
+      cCopyValue    = ++m_copyValue,
+      cDst          = std::move(dstImage),
+      cDstLayers    = dstLayers,
+      cSrc          = m_dpb,
+      cSrcLayers    = srcLayers,
+      cExtent       = extent
+    ] (DxvkContext* ctx) {
+      ctx->waitFence(cDecodeFence, cDecodeValue);
+      ctx->copyImage(cDst, cDstLayers, VkOffset3D(), cSrc, cSrcLayers, VkOffset3D(), cExtent);
+      ctx->signalFence(cCopyFence, cCopyValue);
+    });
+
+    /* the next decode waits for this copy: it must reach the GPU */
+    pContext->Flush();
+    return S_OK;
+  }
+
+}
diff --git a/src/d3d11/d3d11_video_decoder.h b/src/d3d11/d3d11_video_decoder.h
new file mode 100644
index 0000000..c99fbfe
--- /dev/null
+++ b/src/d3d11/d3d11_video_decoder.h
@@ -0,0 +1,230 @@
+#pragma once
+
+/* Stained Glass OS: D3D11 video decoders (D3D11VA) on Vulkan Video.
+ *
+ * Programs that decode video themselves through D3D11 -- Chromium and Electron programs, Firefox,
+ * VLC, mpv, Kodi -- create an ID3D11VideoDecoder and hand it DXVA buffers: picture parameters, the
+ * inverse quantization matrices, slice control and the bitstream. DXVK had none (E_NOTIMPL), so all
+ * of them decoded on the CPU. This decodes them on the GPU's video decode queue: the DXVA
+ * structures (public DXVA specifications) are turned into the Vulkan Video standard headers' ones,
+ * decoded into a DPB of our own, and the picture copied into the program's output texture. Written
+ * from the DXVA and Vulkan specifications.
+ *
+ * H.264 (VLD, no film grain), 8-bit 4:2:0, progressive, short slice mode. */
+
+#include <mutex>
+#include <vector>
+
+#include "d3d11_device.h"
+
+#include <dxva.h>
+
+namespace dxvk {
+
+  class D3D11Device;
+  class D3D11ImmediateContext;
+
+  /**
+   * \brief What the device's video decode queue can do for D3D11
+   */
+  class D3D11VideoDecodeSupport {
+
+  public:
+
+    D3D11VideoDecodeSupport(const Rc<DxvkDevice>& Device, Tristate Policy);
+
+    bool SupportsH264() const {
+      return m_h264;
+    }
+
+    const VkVideoCapabilitiesKHR& H264Caps() const {
+      return m_h264Caps;
+    }
+
+    const VkVideoDecodeCapabilitiesKHR& H264DecodeCaps() const {
+      return m_h264DecodeCaps;
+    }
+
+    const VkVideoDecodeH264CapabilitiesKHR& H264CodecCaps() const {
+      return m_h264CodecCaps;
+    }
+
+    static void FillH264Profile(
+            VkVideoProfileInfoKHR*            pProfile,
+            VkVideoDecodeH264ProfileInfoKHR*  pH264);
+
+  private:
+
+    bool                              m_h264 = false;
+    VkVideoCapabilitiesKHR            m_h264Caps        = { VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR };
+    VkVideoDecodeCapabilitiesKHR      m_h264DecodeCaps  = { VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR };
+    VkVideoDecodeH264CapabilitiesKHR  m_h264CodecCaps   = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_CAPABILITIES_KHR };
+
+  };
+
+
+  /**
+   * \brief Decoder output view: a slice of the program's texture array
+   */
+  class D3D11VideoDecoderOutputView : public D3D11DeviceChild<ID3D11VideoDecoderOutputView> {
