+    const D3D11_VIDEO_DECODER_CONFIG&     Config)
+  : D3D11DeviceChild<ID3D11VideoDecoder>(pDevice),
+    m_device(pDevice->GetDXVKDevice()), m_policy(pDevice->GetOptions()->videoDecode), m_desc(Desc), m_config(Config) {
+    D3D11VideoDecodeSupport::FillH264Profile(&m_profile, &m_h264Profile);
+    m_profileList.profileCount = 1u;
