diff --git a/src/d3d11/d3d11_video_decoder.cpp b/src/d3d11/d3d11_video_decoder.cpp
new file mode 100644
index 0000000..54f6b71
--- /dev/null
+++ b/src/d3d11/d3d11_video_decoder.cpp
@@ -0,0 +1,1067 @@
+#include <algorithm>
+#include <cstring>
+#include <iomanip>
+
+#include "d3d11_context_imm.h"
+#include "d3d11_video_decoder.h"
+
+/* Stained Glass OS: D3D11 video decoders on Vulkan Video (see d3d11_video_decoder.h). */
+
+namespace dxvk {
+
+  static std::mutex g_decodeQueueMutex;   // the device's one decode queue, for every decoder
+
+  static VkDeviceSize alignUp(VkDeviceSize v, VkDeviceSize a) {
+    return a > 1u ? (v + a - 1u) / a * a : v;
+  }
+
+
+  /* The slice header's first fields (H.264 7.3.3): first_mb_in_slice, slice_type and
+   * pic_parameter_set_id, read from the NAL unit after its start code (emulation prevention bytes
+   * skipped). The device parses the slice headers itself and finds the picture parameter set by
+   * this id, so the one made from DXVA's picture parameters carries it. */
+  class SliceHeaderReader {
+  public:
+    SliceHeaderReader(const uint8_t* data, size_t size)
+    : m_data(data), m_size(size) { }
+
+    bool readUe(uint32_t& value) {
+      uint32_t zeros = 0;
+      while (true) {
+        int b = readBit();
+        if (b < 0 || zeros > 31) return false;
+        if (b) break;
+        zeros++;
+      }
+      uint32_t rest = 0;
+      for (uint32_t i = 0; i < zeros; i++) {
+        int b = readBit();
+        if (b < 0) return false;
+        rest = (rest << 1) | uint32_t(b);
+      }
+      value = (1u << zeros) - 1u + rest;
+      return true;
+    }
+
+  private:
+    const uint8_t* m_data;
+    size_t         m_size;
+    size_t         m_byte = 0;
+    uint32_t       m_bit = 0;
+    uint32_t       m_zeros = 0;
+
+    int readBit() {
+      if (m_bit == 0) {
+        /* 00 00 03: the 03 is not data */
+        if (m_zeros >= 2 && m_byte < m_size && m_data[m_byte] == 3) {
+          m_byte++;
+          m_zeros = 0;
+        }
+        if (m_byte >= m_size) return -1;
+      }
+      int b = (m_data[m_byte] >> (7u - m_bit)) & 1;
+      if (++m_bit == 8u) {
+        m_zeros = m_data[m_byte] ? 0 : m_zeros + 1;
+        m_bit = 0;
+        m_byte++;
+      }
+      return b;
+    }
+  };
+
+
+  /* ---- what the decode queue can do ------------------------------------------------------------ */
+
+  void D3D11VideoDecodeSupport::FillH264Profile(
+          VkVideoProfileInfoKHR*            pProfile,
+          VkVideoDecodeH264ProfileInfoKHR*  pH264) {
+    *pH264 = { VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PROFILE_INFO_KHR };
+    pH264->stdProfileIdc = STD_VIDEO_H264_PROFILE_IDC_HIGH;
+    pH264->pictureLayout = VK_VIDEO_DECODE_H264_PICTURE_LAYOUT_PROGRESSIVE_KHR;
+
+    *pProfile = { VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR };
+    pProfile->pNext = pH264;
+    pProfile->videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR;
+    pProfile->chromaSubsampling = VK_VIDEO_CHROMA_SUBSAMPLING_420_BIT_KHR;
+    pProfile->lumaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR;
+    pProfile->chromaBitDepth = VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR;
+  }
+
+
+  D3D11VideoDecodeSupport::D3D11VideoDecodeSupport(const Rc<DxvkDevice>& Device, Tristate Policy) {
+#ifdef SG_MUTANT_NO_VIDEO_DECODE
+    return;
+#endif
+    if (!Device->features().khrVideoDecodeH264 || !Device->queues().decode.queueHandle)
+      return;
+
+    /* only where it was proven (bit-exact against software decode): a program that is offered a
+     * decoder trusts it, and garbled pictures are worse than decoding on the CPU. d3d11.videoDecode
+     * = True offers it on any driver, for testing. */
+    if (Policy == Tristate::False)
+      return;
+    if (Policy == Tristate::Auto && !Device->adapter()->matchesDriver(VK_DRIVER_ID_NVIDIA_PROPRIETARY))
+      return;
+
+    auto vki = Device->vki();
+    VkPhysicalDevice adapter = Device->adapter()->handle();
+
+    VkVideoProfileInfoKHR profile;
+    VkVideoDecodeH264ProfileInfoKHR h264;
+    FillH264Profile(&profile, &h264);
+
+    m_h264Caps.pNext = &m_h264DecodeCaps;
+    m_h264DecodeCaps.pNext = &m_h264CodecCaps;
+
+    if (vki->vkGetPhysicalDeviceVideoCapabilitiesKHR(adapter, &profile, &m_h264Caps)) {
+      Logger::info("D3D11: no H.264 video decode on this device");
+      return;
+    }
+
+    /* the decoded picture is copied out of its DPB slot: the DPB and the output are one image */
+    if (!(m_h264DecodeCaps.flags & VK_VIDEO_DECODE_CAPABILITY_DPB_AND_OUTPUT_COINCIDE_BIT_KHR)) {
+      Logger::info("D3D11: H.264 video decode needs distinct output images, not done yet");
+      return;
+    }
+
+    VkVideoProfileListInfoKHR profileList = { VK_STRUCTURE_TYPE_VIDEO_PROFILE_LIST_INFO_KHR };
+    profileList.profileCount = 1u;
+    profileList.pProfiles = &profile;
+
+    VkPhysicalDeviceVideoFormatInfoKHR formatInfo = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR };
+    formatInfo.pNext = &profileList;
+    formatInfo.imageUsage = VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR | VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR;
+
+    uint32_t count = 0u;
+    if (vki->vkGetPhysicalDeviceVideoFormatPropertiesKHR(adapter, &formatInfo, &count, nullptr) || !count)
+      return;
+
+    std::vector<VkVideoFormatPropertiesKHR> formats(count, { VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR });
+    if (vki->vkGetPhysicalDeviceVideoFormatPropertiesKHR(adapter, &formatInfo, &count, formats.data()))
+      return;
+
+    for (const auto& f : formats) {
+      if (f.format == VK_FORMAT_G8_B8R8_2PLANE_420_UNORM && f.imageTiling == VK_IMAGE_TILING_OPTIMAL)
+        m_h264 = true;
+    }
+
+    static bool s_logged = false;
+    if (m_h264 && !std::exchange(s_logged, true)) {
+      Logger::info(str::format("D3D11: H.264 video decode: up to ",
+        m_h264Caps.maxCodedExtent.width, "x", m_h264Caps.maxCodedExtent.height,
+        ", ", m_h264Caps.maxDpbSlots, " DPB slots, ", m_h264Caps.maxActiveReferencePictures, " references"));
+    }
+  }
+
+
+  /* ---- output view ------------------------------------------------------------------------------- */
+
+  D3D11VideoDecoderOutputView::D3D11VideoDecoderOutputView(
+          D3D11Device*            pDevice,
+          ID3D11Resource*         pResource,
+    const D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC& Desc)
+  : D3D11DeviceChild<ID3D11VideoDecoderOutputView>(pDevice),
+    m_resource(pResource), m_image(GetCommonTexture(pResource)->GetImage()),
+    m_desc(Desc), m_destructionNotifier(this) {
+
+  }
