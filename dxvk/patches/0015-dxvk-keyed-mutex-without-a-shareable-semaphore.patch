From: Stained Glass OS <ke7oxh@gmail.com>
Subject: [PATCH] dxvk: keyed mutexes on devices that cannot share a timeline semaphore

A keyed mutex orders the two processes' GPU work with a timeline semaphore
both hold (VK_KHR_external_semaphore_win32). A device that cannot export and
import one -- llvmpipe, and so most virtual machines -- created a semaphore
of its own: ReleaseSync's signal failed (DXGI_ERROR_INVALID_CALL), the device
was lost, and the opening process waited forever on a semaphore that never
advanced; Qt WebEngine's page in Sigil stayed black. Such a device now keeps
the keyed mutex (D3DKMT) without the semaphore and synchronizes on the CPU:
ReleaseSync already waits for the image's work, so the next owner finds it
done. CreateSharedHandle shares the texture and the mutex without a sync
object, and an opener does not import one it cannot. Devices that can share
the semaphore take the same path as before.

---
diff --git a/src/d3d11/d3d11_device.cpp b/src/d3d11/d3d11_device.cpp
index 308af06..3076fe5 100644
--- a/src/d3d11/d3d11_device.cpp
+++ b/src/d3d11/d3d11_device.cpp
@@ -1489,7 +1489,7 @@ namespace dxvk {
         D3DKMTDestroyAllocation(&destroy);
 
         Rc<DxvkFence> fence;
-        if (d3dkmt.dxgi.sync_handle) {
+        if (d3dkmt.dxgi.sync_handle && DxvkKeyedMutex::canShareFence(m_dxvkDevice, false)) {
           DxvkFenceCreateInfo fenceInfo = { };
           fenceInfo.sharedType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT;
           fenceInfo.sharedHandle = reinterpret_cast<HANDLE>(d3dkmt.dxgi.sync_handle);
@@ -1580,7 +1580,11 @@ namespace dxvk {
         D3DKMTDestroyAllocation(&destroy);
 
         Rc<DxvkFence> fence;
-        if (open.hSyncObject) {
+        if (open.hSyncObject && !DxvkKeyedMutex::canShareFence(m_dxvkDevice, true)) {
+          D3DKMT_DESTROYSYNCHRONIZATIONOBJECT destroySync = { };
+          destroySync.hSyncObject = open.hSyncObject;
+          D3DKMTDestroySynchronizationObject(&destroySync);
+        } else if (open.hSyncObject) {
 #ifdef _WIN32
           DxvkFenceCreateInfo fenceInfo = { };
 
diff --git a/src/d3d11/d3d11_resource.cpp b/src/d3d11/d3d11_resource.cpp
index cef720d..aa74d9d 100644
--- a/src/d3d11/d3d11_resource.cpp
+++ b/src/d3d11/d3d11_resource.cpp
@@ -335,8 +335,9 @@ namespace dxvk {
     D3DKMT_HANDLE local = texture->GetImage()->storage()->kmtLocal();
     auto keyedMutex = texture->GetImage()->getKeyedMutex();
     if (keyedMutex) {
-      D3DKMT_HANDLE handles[] = {local, keyedMutex->kmtLocal(), keyedMutex->getSyncObject()->kmtLocal()};
-      if (!D3DKMTShareObjects(3, handles, &attr, dwAccess, pHandle))
+      auto syncObject = keyedMutex->getSyncObject();
+      D3DKMT_HANDLE handles[] = {local, keyedMutex->kmtLocal(), syncObject != nullptr ? syncObject->kmtLocal() : 0};
+      if (!D3DKMTShareObjects(syncObject != nullptr ? 3 : 2, handles, &attr, dwAccess, pHandle))
         return S_OK;
     } else if (!D3DKMTShareObjects(1, &local, &attr, dwAccess, pHandle)) {
       return S_OK;
diff --git a/src/dxvk/dxvk_image.cpp b/src/dxvk/dxvk_image.cpp
index 4af5565..44716d1 100644
--- a/src/dxvk/dxvk_image.cpp
+++ b/src/dxvk/dxvk_image.cpp
@@ -9,14 +9,16 @@ namespace dxvk {
             uint64_t        initialValue,
             bool            ntShared)
   : m_vkd(device->vkd()) {
-    DxvkFenceCreateInfo fenceInfo;
-    fenceInfo.initialValue = 0;
-    fenceInfo.sharedType = ntShared
-      ? VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT
-      : VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT;
-    m_fence = device->createFence(fenceInfo);
-    if (!m_fence)
-      throw DxvkError("DxvkKeyedMutex: Failed to create fence");
+    if (canShareFence(device, ntShared)) {
+      DxvkFenceCreateInfo fenceInfo;
+      fenceInfo.initialValue = 0;
+      fenceInfo.sharedType = ntShared
+        ? VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT
+        : VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT;
+      m_fence = device->createFence(fenceInfo);
+      if (!m_fence)
+        throw DxvkError("DxvkKeyedMutex: Failed to create fence");
+    }
 
     D3DKMT_CREATEKEYEDMUTEX2 create = { };
     create.Flags.NtSecuritySharing = ntShared;
@@ -38,10 +40,44 @@ namespace dxvk {
     m_fence(fence),
     m_kmtLocal(kmtLocal),
     m_kmtGlobal(kmtGlobal) {
-    if (!fence)
+    if (!m_fence && canShareFence(device, !kmtGlobal))
       Logger::err("DxvkKeyedMutex::DxvkKeyedMutex: No fence provided");
   }
 
+
+  bool DxvkKeyedMutex::canShareFence(const Rc<DxvkDevice>& device, bool ntShared) {
+#ifdef SG_MUTANT_KEYEDMUTEX_NO_FALLBACK
+    return true;
+#endif
+    /* Stained Glass OS (dxvk/patches/0005): a keyed mutex orders the two processes' GPU work
+     * with a timeline semaphore both of them hold. A device that cannot export and import one
+     * (llvmpipe; most virtual machines) made a semaphore of its own that the other process
+     * never saw: ReleaseSync failed, the device was lost and the opener waited forever (Qt
+     * WebEngine's page stayed black). Such a device keeps the keyed mutex without the
+     * semaphore: ReleaseSync already waits on the CPU for the image's work, so the next owner
+     * finds it done. Devices that can share the semaphore are unchanged. */
+    VkSemaphoreTypeCreateInfo typeInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO };
+    typeInfo.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+
+    VkPhysicalDeviceExternalSemaphoreInfo externalInfo = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_SEMAPHORE_INFO, &typeInfo };
+    externalInfo.handleType = ntShared
+      ? VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT
+      : VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT;
+
+    VkExternalSemaphoreProperties externalProperties = { VK_STRUCTURE_TYPE_EXTERNAL_SEMAPHORE_PROPERTIES };
+    device->adapter()->vki()->vkGetPhysicalDeviceExternalSemaphoreProperties(
+      device->adapter()->handle(), &externalInfo, &externalProperties);
+
+    VkExternalSemaphoreFeatureFlags needed = VK_EXTERNAL_SEMAPHORE_FEATURE_EXPORTABLE_BIT
+                                           | VK_EXTERNAL_SEMAPHORE_FEATURE_IMPORTABLE_BIT;
+    bool result = (externalProperties.externalSemaphoreFeatures & needed) == needed;
+
+    static bool s_logged = false;
+    if (!result && !std::exchange(s_logged, true))
+      Logger::info("DxvkKeyedMutex: device cannot share timeline semaphores, keyed mutexes synchronize on the CPU");
+    return result;
+  }
+
     
   DxvkKeyedMutex::~DxvkKeyedMutex() {
     if (m_kmtLocal) {
@@ -70,6 +106,13 @@ namespace dxvk {
     if (status)
       return DXGI_ERROR_INVALID_CALL;
 
+    if (!m_fence) {
+      /* no shared semaphore (patch 0005): the owner released only after its work was done */
+      m_fenceValue = acquire.FenceValue;
+      m_owned.store(true, std::memory_order_release);
+      return S_OK;
+    }
+
     VkSemaphore semaphore = m_fence->handle();
     VkSemaphoreWaitInfo info = { VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO };
     info.semaphoreCount = 1;
@@ -92,10 +135,10 @@ namespace dxvk {
       return DXGI_ERROR_INVALID_CALL;
 
     VkSemaphoreSignalInfo info = { VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO };
-    info.semaphore = m_fence->handle();
+    info.semaphore = m_fence != nullptr ? m_fence->handle() : VK_NULL_HANDLE;
     info.value = m_fenceValue + 1;
 
-    if (m_vkd->vkSignalSemaphore(m_vkd->device(), &info)) {
+    if (m_fence != nullptr && m_vkd->vkSignalSemaphore(m_vkd->device(), &info)) {
       Logger::warn("D3D11DXGIKeyedMutex::ReleaseSync: Failed to signal semaphore");
       return DXGI_ERROR_INVALID_CALL;
     }
diff --git a/src/dxvk/dxvk_image.h b/src/dxvk/dxvk_image.h
index 5dac215..fff46fe 100644
--- a/src/dxvk/dxvk_image.h
+++ b/src/dxvk/dxvk_image.h
@@ -358,6 +358,14 @@ namespace dxvk {
             D3DKMT_HANDLE   kmtGlobal);
     
     ~DxvkKeyedMutex();
+
+    /**
+     * \brief Whether the device can share the keyed mutex's timeline semaphore
+     *
+     * Stained Glass OS (dxvk/patches/0005): without it (llvmpipe, most VMs) the
+     * keyed mutex has no fence and synchronizes on the CPU.
+     */
+    static bool canShareFence(const Rc<DxvkDevice>& device, bool ntShared);
     
     /**
      * \brief D3DKMT keyed mutex local handle
