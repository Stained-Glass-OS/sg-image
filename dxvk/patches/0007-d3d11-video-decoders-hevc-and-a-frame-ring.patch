-      for (uint32_t i = 0; i < zeros; i++) {
-        int b = readBit();
-        if (b < 0) return false;
-        rest = (rest << 1) | uint32_t(b);
-      }
+      if (!readBits(zeros, rest)) return false;
       value = (1u << zeros) - 1u + rest;
       return true;
     }
