[Unit]
Description=Stained Glass OS problem report receiver (behind Caddy, /api/report)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/sg-report-receiver/report-receiver.py
User=sgreports
Group=sgreports
StateDirectory=sg-reports
StateDirectoryMode=0750
Environment=SG_REPORT_LISTEN=127.0.0.1:8091 SG_REPORT_PUBLIC=/srv/www/reports
# the website's Debug Reports: the only place it may write besides its state
ReadWritePaths=/srv/www/reports
Environment=SG_GEOIP_DB=/var/lib/sg-geoip/dbip-city-lite.mmdb SG_GEO_CITIES=/var/lib/sg-geoip/cities15000.txt
Restart=on-failure
MemoryMax=96M
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
