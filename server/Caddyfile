# freesoft.page (the project server): the website, the apt repository, the
# ISOs, and the problem report receiver (reports/). Installed by
# server/reports/deploy.sh; edit here, not on the server.
#
# What the server keeps is in server/PRIVACY.md: the only access log is
# the ISO downloads' (no address, no headers), which server/stats/
# sg-iso-count turns into a daily count of downloads every hour.
freesoft.page, www.freesoft.page {
	encode gzip
	# The only access log: ISO downloads, with the time, the file, the
	# status and the bytes sent -- the address, port and headers deleted
	# before anything is written. Everything else is not logged at all.
	@notiso not path /iso/*.iso
	skip_log @notiso
	log {
		output file /var/log/caddy/iso.log {
			roll_size 50MiB
			roll_keep 1
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				request>host delete
				request>proto delete
				resp_headers delete
				user_id delete
			}
		}
	}
	# Report a problem: plain-text reports, at most 512 KB (the receiver
	# limits them per address); the client's address goes with them
	handle /api/report {
		request_body {
			max_size 512KB
		}
		reverse_proxy 127.0.0.1:8091 {
			header_up X-Sg-Client-Ip {remote_host}
		}
	}
	# Set time zone automatically: the caller's zone by its address
	handle /api/timezone {
		reverse_proxy 127.0.0.1:8091 {
			header_up X-Sg-Client-Ip {remote_host}
		}
	}
	handle {
		root * /srv/www
		@listings path /apt/* /iso/*
		file_server @listings browse
		file_server
	}
}
