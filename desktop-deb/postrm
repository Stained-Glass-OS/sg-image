#!/bin/sh
# stained-glass-desktop: purge gives the machine back its previous display
# manager, its gettys on tty1 and Debian's os-release. The packages this one
# brought stay until apt autoremove; the Windows system's data
# (/var/lib/stained-glass) and people's own files are never touched.
set -e
STATE=/var/lib/stained-glass-desktop

case "$1" in
remove|purge)
    prev=$(cat "$STATE/previous-display-manager" 2>/dev/null || true)
    if [ -n "$prev" ] && [ -x "$prev" ]; then
        systemctl disable greetd.service >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/display-manager.service
        systemctl enable "$(basename "$prev").service" >/dev/null 2>&1 || true
        printf '%s\n' "$prev" > /etc/X11/default-display-manager
    fi
    # the homes' bind mounts on their profiles: unmounted, out of /etc/fstab
    if grep -q '^# stained-glass-desktop: ' /etc/fstab 2>/dev/null; then
        grep -A1 '^# stained-glass-desktop: ' /etc/fstab | grep -v '^#' | grep -v '^--$' | while read -r _ target _; do
            umount "$target" 2>/dev/null || true
            rmdir "$target" 2>/dev/null || true
        done
        sed -i '/^# stained-glass-desktop: /{N;d;}' /etc/fstab
        [ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    systemctl unmask getty@tty1.service autovt@tty1.service >/dev/null 2>&1 || true
    if [ -f /usr/lib/os-release.debian ]; then
        rm -f /usr/lib/os-release
        dpkg-divert --package stained-glass-desktop --remove --rename \
            --divert /usr/lib/os-release.debian /usr/lib/os-release >/dev/null
    fi
    ;;
esac
case "$1" in
remove|purge|abort-install)
    rm -f /etc/greetd/config.toml
    dpkg-divert --package stained-glass-desktop --remove --rename \
        --divert /etc/greetd/config.toml.debian /etc/greetd/config.toml >/dev/null
    ;;
esac
[ "$1" = purge ] && rm -rf "$STATE"
exit 0
