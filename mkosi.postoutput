#!/bin/sh
# Add a "live" twin of every boot entry: the same kernel and initrds, with the
# root file system mounted read-only under a tmpfs overlay
# (systemd.volatile=overlay). Booted that way from a USB stick, Stained Glass
# runs without changing the stick -- and the installer (sg-install) can copy
# the root partition block for block, because nothing is writing to it.
#
# Post-output, on the finished image, because mkosi writes the boot entries
# after its finalize scripts have run. The ESP is edited in place with mtools:
# no loop device, no root.
set -eu
IMG="$OUTPUTDIR/sg-image.raw"
[ -f "$IMG" ] || { echo "mkosi.postoutput: no $IMG" >&2; exit 1; }
start=$(/usr/sbin/sfdisk -d "$IMG" | awk -F'[ ,=]+' 'toupper($0) ~ /TYPE=C12A7328-F81F-11D2-BA4B-00A0C93EC93B/ {
    for (i = 1; i <= NF; i++) if ($i == "start") { print $(i + 1); exit } }')
[ -n "$start" ] || { echo "mkosi.postoutput: the image has no ESP" >&2; exit 1; }
ESP="$IMG@@$((start * 512))"
export MTOOLS_SKIP_CHECK=1

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# --- the splash in the initrd ---------------------------------------------------
# Plymouth itself is in the default initrd (mkosi.conf InitrdPackages); our theme
# and plymouthd.conf ride in a small initrd of their own, loaded after mkosi's
# (a later archive's files win), so the Stained Glass splash shows from the
# first second instead of text until the root file system is up.
S="$tmp/splash"
mkdir -p "$S/usr/share/plymouth/themes/stained-glass" "$S/etc/plymouth"
# The picture is generated into the extra tree, which lives in the output
# directory: reached as $OUTPUTDIR -- $SRCDIR/build may be a symlink the
# sandbox cannot follow (the release worktrees'), and then the initrd had the
# script but no diamond.png: a blank splash.
for tree in "$SRCDIR/mkosi.extra" "$SRCDIR/build/extra-tree" "${OUTPUTDIR:-/nonexistent}/extra-tree"; do
    [ -d "$tree/usr/share/plymouth/themes/stained-glass" ] && cp -r "$tree/usr/share/plymouth/themes/stained-glass/." "$S/usr/share/plymouth/themes/stained-glass/"
    [ -f "$tree/etc/plymouth/plymouthd.conf" ] && cp "$tree/etc/plymouth/plymouthd.conf" "$S/etc/plymouth/"
done
# ... and when no tree is reachable here (the sandbox shows neither), draw it:
# the picture is made by our own script from the source, as the Makefile does.
[ -f "$S/usr/share/plymouth/themes/stained-glass/diamond.png" ] \
    || python3 "$SRCDIR/splash/make-splash.py" "$S/usr/share/plymouth/themes/stained-glass/diamond.png" 192 \
    || echo "mkosi.postoutput: could not draw diamond.png" >&2
[ -f "$S/usr/share/plymouth/themes/stained-glass/stained-glass.plymouth" ] && [ -f "$S/etc/plymouth/plymouthd.conf" ] \
    && [ -f "$S/usr/share/plymouth/themes/stained-glass/diamond.png" ] \
    || { echo "mkosi.postoutput: the splash theme is missing" >&2; exit 1; }
ln -s stained-glass/stained-glass.plymouth "$S/usr/share/plymouth/themes/default.plymouth"
# Its name must not contain "splash" (or "rhgb"): Plymouth looks for the
# "splash" argument with strstr and checks only the first match, so
# initrd=\...\sg-splash.initrd on the command line hid the real "splash"
# after it -- Plymouth showed text all through the boot (found 2026-09-30).
(cd "$S" && find . -mindepth 1 | LC_ALL=C sort | cpio -o -H newc --quiet --owner=0:0) > "$tmp/sg-theme.initrd"
# beside the entry's own initrds, in its entry-token directory: sg-install copies
# that directory (not loader/) and rewrites its paths for the installed disk
for e in $(mdir -b -i "$ESP" ::/loader/entries); do
    case "$e" in *.conf) ;; *) continue ;; esac
    case "$e" in *-live.conf) continue ;; esac
    mtype -i "$ESP" "$e" | tr -d '\r' > "$tmp/entry"
    tok=$(sed -n 's#^linux /\([^/]*\)/.*#\1#p' "$tmp/entry" | head -1)
    [ -n "$tok" ] || { echo "mkosi.postoutput: $e has no linux line" >&2; exit 1; }
    mcopy -o -i "$ESP" "$tmp/sg-theme.initrd" "::/$tok/sg-theme.initrd"
    grep -q "^initrd /$tok/sg-theme.initrd" "$tmp/entry" || echo "initrd /$tok/sg-theme.initrd" >> "$tmp/entry"
    mcopy -o -i "$ESP" "$tmp/entry" "$e"
    echo "mkosi.postoutput: splash initrd in ${e##*/} (/$tok)"
done

n=0
for e in $(mdir -b -i "$ESP" ::/loader/entries); do
    case "$e" in *.conf) ;; *) continue ;; esac
    case "$e" in *-live.conf) continue ;; esac
    base=${e##*/}
    live="${base%.conf}-live.conf"
    mtype -i "$ESP" "$e" | tr -d '\r' | sed \
        -e 's/^title \(.*\)$/title \1 (live: try or install, changes are not kept)/' \
        -e 's/^options \(.*\)$/options \1 systemd.volatile=overlay/' > "$tmp/$live"
    grep -q '^options .*systemd.volatile=overlay' "$tmp/$live" || { echo "mkosi.postoutput: $e has no options line" >&2; exit 1; }
    mcopy -o -i "$ESP" "$tmp/$live" "::/loader/entries/$live"
    echo "mkosi.postoutput: added $live"
    n=$((n + 1))
done
[ "$n" -gt 0 ] || { echo "mkosi.postoutput: no boot entries to make live" >&2; exit 1; }
