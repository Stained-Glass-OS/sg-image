+/* .NET answers QueryInterface only for COM-visible interfaces: a managed interface marked
+ * [ComVisible(false)] (such as the service id marker interfaces Visual Studio declares) gets
+ * E_NOINTERFACE, not a CCW whose vtable has no methods. Imported interfaces are always visible. */
+static gboolean
+cominterop_iface_com_invisible (MonoClass *ic)
+{
+	ERROR_DECL (error);
+	MonoCustomAttrInfo *cinfo;
+	gboolean invisible = FALSE;
+
+	if (MONO_CLASS_IS_IMPORT (ic))
+		return FALSE;
+	cinfo = mono_custom_attrs_from_class_checked (ic, error);
+	mono_error_assert_ok (error);
+	if (cinfo) {
+		MonoReflectionComVisibleAttribute *attr = (MonoReflectionComVisibleAttribute *)mono_custom_attrs_get_attr_checked (cinfo, mono_class_get_com_visible_attribute_class (), error);
+		mono_error_assert_ok (error);
+		if (attr)
+			invisible = !attr->visible;
+		if (!cinfo->cached)
+			mono_custom_attrs_free (cinfo);
+	}
+	return invisible;
+}
