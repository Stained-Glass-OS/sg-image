+/* Stained Glass OS: a dynamic assembly carrying
+ * [IgnoresAccessChecksTo("Name")] may reach anything in assembly Name, as
+ * .NET Framework allows (StreamJsonRpc's and ServiceHub's proxies, generated
+ * with Reflection.Emit, call the framework's internal helpers: Visual
+ * Studio's brokered services stopped with MethodAccessException). */
+static gboolean
+ignores_access_checks_to (MonoAssembly *accessing, MonoAssembly *accessed)
+{
+	ERROR_DECL (error);
+	MonoCustomAttrInfo *attrs;
+	gboolean found = FALSE;
+	int i;
+
+	if (!accessing || !accessed || accessing == accessed || !accessed->aname.name)
+		return FALSE;
+	if (!accessing->image || !image_is_dynamic (accessing->image))
+		return FALSE;
+	attrs = mono_custom_attrs_from_assembly_checked (accessing, TRUE, error);
+	mono_error_cleanup (error);
+	if (!attrs)
+		return FALSE;
+	for (i = 0; i < attrs->num_attrs && !found; ++i) {
+		MonoCustomAttrEntry *attr = &attrs->attrs [i];
+		const char *data;
+		guint32 len;
+		if (!attr->ctor || strcmp (m_class_get_name (attr->ctor->klass), "IgnoresAccessChecksToAttribute") ||
+		    strcmp (m_class_get_name_space (attr->ctor->klass), "System.Runtime.CompilerServices"))
+			continue;
+		if (attr->data_size < 4)
+			continue;
+		data = (const char *)attr->data;
+		/* prolog 0x0001, then the string; 0xFF is a null string */
+		if (data [0] != 1 || data [1] != 0 || (data [2] & 0xFF) == 0xFF)
+			continue;
+		len = mono_metadata_decode_value (data + 2, &data);
+		if (strlen (accessed->aname.name) == len && !g_ascii_strncasecmp (data, accessed->aname.name, len))
+			found = TRUE;
+	}
+	mono_custom_attrs_free (attrs);
+	return found;
+}
