+/* Marshal.CreateAggregatedObject (pOuter, o): o's CCW aggregated by the COM object pOuter, as
+ * .NET's: the interfaces of o answer QueryInterface/AddRef/Release as pOuter, and the result is
+ * the inner (non-delegating) IUnknown, with one reference, which pOuter keeps and releases.
+ * Visual Studio's DTE.Solution wraps its managed solution object so (ComWrapperFactory.
+ * CreateAggregatedObject); Mono threw NotImplementedException. */
+gpointer
+ves_icall_System_Runtime_InteropServices_Marshal_CreateAggregatedObjectInternal (gpointer outer, MonoObjectHandle object, MonoError *error)
+{
+#ifndef DISABLE_COM
+	static gpointer inner_vtable [3];
+	MonoCCWInterface *ccwe, *inner;
+	MonoCCW *ccw;
+
+	if (!outer) {
+		mono_error_set_argument_null (error, "pOuter", "");
+		return NULL;
+	}
+	if (MONO_HANDLE_IS_NULL (object)) {
+		mono_error_set_argument_null (error, "o", "");
+		return NULL;
+	}
+	MonoRealProxyHandle real_proxy;
+	if (cominterop_object_is_rcw_handle (object, &real_proxy)) {
+		mono_error_set_argument (error, "o", "A COM object cannot be aggregated.");
+		return NULL;
+	}
+	ccwe = (MonoCCWInterface *)cominterop_get_ccw_checked (object, mono_class_get_iunknown_class (), error);
+	return_val_if_nok (error, NULL);
+	ccw = ccwe->ccw;
+
+	mono_cominterop_lock ();
+	if (ccw->outer && ccw->outer != outer) {
+		mono_cominterop_unlock ();
+		mono_error_set_argument (error, "o", "The object is already aggregated by another COM object.");
+		return NULL;
+	}
+	if (!ccw->inner) {
+		inner_vtable [0] = (gpointer)cominterop_ccw_queryinterface;
+		inner_vtable [1] = (gpointer)cominterop_ccw_addref;
+		inner_vtable [2] = (gpointer)cominterop_ccw_release;
+		inner = g_new0 (MonoCCWInterface, 1);
+		inner->vtable = inner_vtable;
+		inner->ccw = ccw;
+		ccw->inner = inner;
+	}
+	/* not AddRef'd: the outer object controls this object's lifetime, not the other way */
+	ccw->outer = (MonoIUnknown *)outer;
+	mono_cominterop_unlock ();
+
+	cominterop_ccw_addref_impl ((MonoCCWInterface *)ccw->inner);
+	return ccw->inner;
+#else
+	g_assert_not_reached ();
+#endif
+}
