 #endif
+			g_free (ccw_iter->inner);
 			g_free (ccw_iter);
 		}
 		else
@@ -3499,6 +3566,9 @@
 cominterop_ccw_addref (MonoCCWInterface* ccwe)
 {
 	int result;
+	/* an aggregated object's interfaces count the outer object's references */
+	if (ccwe->ccw->outer && (gpointer)ccwe != ccwe->ccw->inner)
+		return mono_IUnknown_AddRef (ccwe->ccw->outer);
 	MONO_CCW_CALL_ENTER;
 	result = cominterop_ccw_addref_impl (ccwe);
 	MONO_CCW_CALL_EXIT;
@@ -3530,6 +3600,8 @@
 cominterop_ccw_release (MonoCCWInterface* ccwe)
 {
 	int result;
+	if (ccwe->ccw->outer && (gpointer)ccwe != ccwe->ccw->inner)
+		return mono_IUnknown_Release (ccwe->ccw->outer);
 	MONO_CCW_CALL_ENTER;
 	result = cominterop_ccw_release_impl (ccwe);
 	MONO_CCW_CALL_EXIT;
@@ -3592,8 +3664,35 @@
 cominterop_ccw_queryinterface (MonoCCWInterface* ccwe, const guint8* riid, gpointer* ppv)
 {
 	int result;
+	MonoCCW *ccw = ccwe->ccw;
+	/* an aggregated object's interfaces answer as the outer object (COM aggregation) */
+	if (ccw->outer && (gpointer)ccwe != ccw->inner)
+		return mono_IUnknown_QueryInterface (ccw->outer, riid, ppv);
 	MONO_CCW_CALL_ENTER;
-	result = cominterop_ccw_queryinterface_impl (ccwe, riid, ppv);
+	if (ccw->outer && cominterop_class_guid_equal (riid, mono_class_get_iunknown_class ())) {
+		/* the inner IUnknown's own: itself */
+		*ppv = ccw->inner;
+		cominterop_ccw_addref_impl ((MonoCCWInterface *)ccw->inner);
+		result = MONO_S_OK;
+#ifdef HOST_WIN32
+	} else if (ccw->outer && 0 == memcmp (riid, &MONO_IID_IMarshal, sizeof (IID))) {
+		/* the free-threaded marshaler, aggregated by the outer object as this one is
+		 * (the CCW's own marshaler answers as the CCW: not a CCW interface entry) */
+		*ppv = NULL;
+		if (!ccw->outer_free_marshaler)
+			CoCreateFreeThreadedMarshaler ((LPUNKNOWN)ccw->outer, (LPUNKNOWN*)&ccw->outer_free_marshaler);
+		result = ccw->outer_free_marshaler ? mono_IUnknown_QueryInterface (ccw->outer_free_marshaler, &MONO_IID_IMarshal, ppv)
+						   : MONO_E_NOINTERFACE;
+#endif
+	} else {
+		result = cominterop_ccw_queryinterface_impl (ccwe, riid, ppv);
+		if (ccw->outer && result == MONO_S_OK && *ppv && *ppv != ccw->inner) {
+			/* what the inner IUnknown hands out is the outer object's reference:
+			 * its Release goes to the outer object */
+			cominterop_ccw_release_impl ((MonoCCWInterface *)*ppv);
+			mono_IUnknown_AddRef (ccw->outer);
+		}
+	}
 	MONO_CCW_CALL_EXIT;
 	return result;
 }
