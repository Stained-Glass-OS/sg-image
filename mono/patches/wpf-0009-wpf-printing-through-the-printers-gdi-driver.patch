+	internal static void CancelManagerAsync(PackageSerializationManager manager)
+	{
+		var xps = manager as XpsSerializationManagerAsync;
+		if (xps != null) { xps.CancelAsync(); return; }
+		var ngc = manager as NgcSerializationManagerAsync;
+		if (ngc != null) ngc.CancelAsync();
+	}
