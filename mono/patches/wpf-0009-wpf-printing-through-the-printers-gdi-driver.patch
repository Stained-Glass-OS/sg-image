+	/* ---- the event plumbing ---- */
+
+	void ForwardUserPrintTicket(object sender, XpsSerializationPrintTicketRequiredEventArgs args)
+	{
+		if (currentWriteLevel == args.PrintTicketLevel)
+		{
+			args.PrintTicket = currentUserPrintTicket;
+			return;
+		}
+		int level = (int)args.PrintTicketLevel;
+		var forwardArgs = new WritingPrintTicketRequiredEventArgs(args.PrintTicketLevel, (int)_printTicketSequences[level]);
+		switch (args.PrintTicketLevel)
+		{
+		case PrintTicketLevel.FixedDocumentSequencePrintTicket:
+			_printTicketSequences[(int)PrintTicketLevel.FixedDocumentPrintTicket] = 1;
+			_printTicketSequences[(int)PrintTicketLevel.FixedPagePrintTicket] = 1;
+			break;
+		case PrintTicketLevel.FixedDocumentPrintTicket:
+			_printTicketSequences[(int)PrintTicketLevel.FixedPagePrintTicket] = 1;
+			break;
+		}
+		_printTicketSequences[level] = (int)_printTicketSequences[level] + 1;
+		raise_WritingPrintTicketRequired(this, forwardArgs);
+		args.PrintTicket = forwardArgs.CurrentPrintTicket;
+	}
+
+	/* writing an XPS file: each level's ticket is the one the file has */
+	void CloneSourcePrintTicket(object sender, XpsSerializationPrintTicketRequiredEventArgs args)
+	{
+		PrintTicket cloned = null;
+		int level = (int)args.PrintTicketLevel;
+		switch (args.PrintTicketLevel)
+		{
+		case PrintTicketLevel.FixedDocumentSequencePrintTicket:
+			_printTicketSequences[(int)PrintTicketLevel.FixedDocumentPrintTicket] = 1;
+			_printTicketSequences[(int)PrintTicketLevel.FixedPagePrintTicket] = 1;
+			cloned = _sourceXpsFixedDocumentSequenceReader.PrintTicket;
+			break;
+		case PrintTicketLevel.FixedDocumentPrintTicket:
+			_printTicketSequences[(int)PrintTicketLevel.FixedPagePrintTicket] = 1;
+			cloned = _sourceXpsFixedDocumentSequenceReader.FixedDocuments[(int)_printTicketSequences[level] - 1].PrintTicket;
+			break;
+		case PrintTicketLevel.FixedPagePrintTicket:
+			cloned = _sourceXpsFixedDocumentSequenceReader
+				.FixedDocuments[(int)_printTicketSequences[(int)PrintTicketLevel.FixedDocumentPrintTicket] - 2]
+				.FixedPages[(int)_printTicketSequences[level] - 1].PrintTicket;
+			break;
+		}
+		_printTicketSequences[level] = (int)_printTicketSequences[level] + 1;
+		args.PrintTicket = cloned;
+	}
+
+	void ForwardWriteCompletedEvent(object sender, XpsSerializationCompletedEventArgs args)
+	{
+		bool cancelled = args.Cancelled;
+		if (!cancelled && args.Error != null && args.Error is PrintingCanceledException)
+			cancelled = true;
+		Exception exception = args.Error;
+		if (destinationPrintQueue != null)
+		{
+			try
+			{
+				destinationPrintQueue.DisposeSerializationManager(cancelled || args.Error != null);
+			}
+			catch (PrintingCanceledException e)
+			{
+				cancelled = true;
+				exception = e;
+			}
+			catch (PrintJobException e)
+			{
+				cancelled = false;
+				exception = e;
+			}
+		}
+		else
+		{
+			destinationDocument.DisposeSerializationManager();
+		}
+		if (_isDocumentCloned && _sourceXpsDocument != null)
+			_sourceXpsDocument.Close();
+		raise_WritingCompleted(this, new WritingCompletedEventArgs(cancelled, _currentUserState, exception));
+	}
+
+	void ForwardProgressChangedEvent(object sender, XpsSerializationProgressChangedEventArgs args)
+	{
+		int level = (int)args.WritingLevel;
+		var forwardArgs = new WritingProgressChangedEventArgs((WritingProgressChangeLevel)args.WritingLevel,
+			(int)_writingProgressSequences[level], args.ProgressPercentage, _currentUserState);
+		switch (args.WritingLevel)
+		{
+		case XpsWritingProgressChangeLevel.FixedDocumentSequenceWritingProgress:
+			_writingProgressSequences[(int)XpsWritingProgressChangeLevel.FixedDocumentWritingProgress] = 1;
+			_writingProgressSequences[(int)XpsWritingProgressChangeLevel.FixedPageWritingProgress] = 1;
+			break;
+		case XpsWritingProgressChangeLevel.FixedDocumentWritingProgress:
+			_writingProgressSequences[(int)XpsWritingProgressChangeLevel.FixedPageWritingProgress] = 1;
+			break;
+		}
+		_writingProgressSequences[level] = (int)_writingProgressSequences[level] + 1;
+		raise_WritingProgressChanged(this, forwardArgs);
+	}
