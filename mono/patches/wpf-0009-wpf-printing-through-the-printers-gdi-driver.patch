+using System;
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Windows;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+
+namespace System.Printing {
+
+/* Stained Glass OS (sg40): the GDI device ReachFramework's NGC serialization
+   manager prints a WPF page on (System.Printing's GDIExporter, the
+   ILegacyDevice of PrintQueue.GetLegacyDevice). A document is a GDI print
+   job on the printer's DC (CreateDC with the ticket's DEVMODE, StartDoc,
+   ResetDC per page ticket), as GDIExporter's. Where GDIExporter turns each
+   flattened primitive into GDI paths, brushes and font glyphs, this one
+   draws the page's primitives with WPF itself and sends the page to the
+   printer as an image at the printer's resolution (at most RasterDpi), band
+   by band, white bands left out. Same pages, same coordinates (WPF's 1/96
+   inch from the paper's corner; GDI's from the printable area). */
+internal sealed class SgGdiDevice : ILegacyDevice
+{
+	const int RasterDpi = 300;
+	const int BandPixels = 4 << 20;
+
+	IntPtr hdc;
+	int dpiX = 96, dpiY = 96;
+	DrawingGroup page;
+	DrawingContext dc;
+
+	public int DpiX { get { return dpiX; } }
+	public int DpiY { get { return dpiY; } }
+
+	/* ---- the GDI job ---- */
+
+	public int StartDocument(string printerName, string jobName, string filename, byte[] deviceMode)
+	{
+		if (printerName == null) throw new ArgumentNullException("printerName");
+		CreateDeviceContext(printerName, jobName, deviceMode);
+		StartDocumentWithoutCreatingDC(printerName, jobName, filename);
+		return jobId;
+	}
+
+	int jobId;
+
+	public void StartDocumentWithoutCreatingDC(string printerName, string jobName, string filename)
+	{
+		var info = new DOCINFOW();
+		info.cbSize = Marshal.SizeOf(typeof(DOCINFOW));
+		info.lpszDocName = jobName ?? string.Empty;
+		info.lpszOutput = filename;
+		jobId = StartDocW(hdc, ref info);
+		if (jobId <= 0) ThrowLastError();
+	}
+
+	public void EndDocument()
+	{
+		if (hdc == IntPtr.Zero) return;
+		bool ok = EndDoc(hdc) > 0;
+		int error = Marshal.GetLastWin32Error();
+		DeleteDeviceContext();
+		if (!ok) Throw(error);
+	}
+
+	public void CreateDeviceContext(string printerName, string jobName, byte[] deviceMode)
+	{
+		if (printerName == null) throw new ArgumentNullException("printerName");
+		hdc = CreateDCW(null, printerName, null, deviceMode);
+		if (hdc == IntPtr.Zero) ThrowLastError();
+		dpiX = GetDeviceCaps(hdc, LOGPIXELSX);
+		dpiY = GetDeviceCaps(hdc, LOGPIXELSY);
+		if (dpiX <= 0) dpiX = 96;
+		if (dpiY <= 0) dpiY = 96;
+	}
+
+	public void DeleteDeviceContext()
+	{
+		if (hdc != IntPtr.Zero) DeleteDC(hdc);
+		hdc = IntPtr.Zero;
+	}
+
+	/* MXDW's escapes: no Microsoft XPS Document Writer here */
+	public string ExtEscGetName()
+	{
+		return null;
+	}
+
+	public bool ExtEscMXDWPassThru()
+	{
+		return false;
+	}
+
+	public void StartPage(byte[] deviceMode, int rasterizationDPI)
+	{
+		if (hdc == IntPtr.Zero) return;
+		if (deviceMode != null) ResetDCW(hdc, deviceMode);
+		if (StartPage(hdc) <= 0) ThrowLastError();
+		page = new DrawingGroup();
+		dc = page.Open();
+	}
+
+	public void EndPage()
+	{
+		if (hdc == IntPtr.Zero) return;
+		if (dc != null)
+		{
+			dc.Close();
+			dc = null;
+			SendPage(page);
+			page = null;
+		}
+		if (EndPage(hdc) <= 0) ThrowLastError();
+	}
+
+	/* ---- the page's primitives, as the flattener gives them ---- */
+
+	public void PushClip(Geometry clipGeometry)
+	{
+		if (dc != null) dc.PushClip(clipGeometry);
+	}
+
+	public void PopClip()
+	{
+		if (dc != null) dc.Pop();
+	}
+
+	public void PushTransform(Matrix transform)
+	{
+		if (dc != null) dc.PushTransform(new MatrixTransform(transform));
+	}
+
+	public void PopTransform()
+	{
+		if (dc != null) dc.Pop();
+	}
+
+	public void DrawGeometry(Brush brush, Pen pen, Brush strokeBrush, Geometry geometry)
+	{
+		if (dc == null || geometry == null) return;
+		if (pen != null && strokeBrush != null && pen.Brush != strokeBrush)
+		{
+			pen = pen.CloneCurrentValue();
+			pen.Brush = strokeBrush;
+		}
+		dc.DrawGeometry(brush, pen, geometry);
+	}
+
+	public void DrawImage(BitmapSource source, byte[] buffer, Rect rect)
+	{
+		if (dc != null && source != null) dc.DrawImage(source, rect);
+	}
+
+	public void DrawGlyphRun(Brush brush, GlyphRun glyphRun)
+	{
+		if (dc != null && glyphRun != null) dc.DrawGlyphRun(brush, glyphRun);
+	}
+
+	public void Comment(string message)
+	{
+	}
+
+	/* ---- the page to the printer ---- */
+
+	void SendPage(DrawingGroup drawing)
+	{
+#if SG_MUTANT_GDI_NO_PAGE
+		return;
