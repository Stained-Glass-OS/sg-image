+	void InitializeSequences()
+	{
+		_printTicketSequences = new ArrayList();
+		for (int i = 0; i <= (int)PrintTicketLevel.FixedPagePrintTicket; i++) _printTicketSequences.Add(1);
+		_writingProgressSequences = new ArrayList();
+		for (int i = 0; i <= (int)XpsWritingProgressChangeLevel.FixedPageWritingProgress; i++) _writingProgressSequences.Add(1);
+	}
