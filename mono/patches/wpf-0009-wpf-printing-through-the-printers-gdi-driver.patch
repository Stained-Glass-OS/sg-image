+	bool BeginWrite(bool batchMode, bool asyncMode, bool setPrintTicketHandler, PrintTicket printTicket, PrintTicketLevel printTicketLevel)
+	{
+		switch (currentState)
+		{
+		case DocumentWriterState.kBatchMode:
+			XpsWriterException.ThrowException("XPSWriter.BatchMode");
+			return false;
+		case DocumentWriterState.kCancelled:
+		case DocumentWriterState.kDone:
+			XpsWriterException.ThrowException("XPSWriter.DoneWriting");
+			return false;
+		}
+		try
+		{
+			if (!asyncMode)
+			{
+				_manager = destinationPrintQueue != null
+					? destinationPrintQueue.CreateSerializationManager(batchMode, false, printTicket)
+					: destinationDocument.CreateSerializationManager(batchMode);
+			}
+			else
+			{
+				_manager = destinationPrintQueue != null
+					? destinationPrintQueue.CreateAsyncSerializationManager(batchMode, false, printTicket)
+					: destinationDocument.CreateAsyncSerializationManager(batchMode);
+				SetCompletionEventHandler(_manager, null);
+			}
+		}
+		catch (PrintingCanceledException exception)
+		{
+			OnWritingCanceled(this, exception);
+			return false;
+		}
+		currentWriteLevel = printTicketLevel;
+		currentUserPrintTicket = printTicket;
+		if (setPrintTicketHandler)
+		{
+			AddPrintTicketHandler(_manager, _isDocumentCloned
+				? new XpsSerializationPrintTicketRequiredEventHandler(CloneSourcePrintTicket)
+				: new XpsSerializationPrintTicketRequiredEventHandler(ForwardUserPrintTicket));
+		}
+		SetProgressChangedEventHandler(_manager, null);
+		return true;
+	}
+
+	void EndWrite(bool disposeManager)
+	{
+		EndWrite(disposeManager, false);
+	}
+
+	void EndWrite(bool disposeManager, bool abort)
+	{
+		try
+		{
+			if (disposeManager)
+			{
+				if (destinationPrintQueue != null) destinationPrintQueue.DisposeSerializationManager(abort);
+				else destinationDocument.DisposeSerializationManager();
+			}
+			currentState = DocumentWriterState.kDone;
+		}
+		catch (PrintingCanceledException exception)
+		{
+			OnWritingCanceled(this, exception);
+		}
+	}
+
+	internal void OnWritingPrintTicketRequired(object sender, WritingPrintTicketRequiredEventArgs args)
+	{
+		raise_WritingPrintTicketRequired(sender, args);
+	}
+
+	void SaveAsXaml(object serializedObject, bool isSync)
+	{
+		bool abort = false;
+		try
+		{
+			_manager.SaveAsXaml(serializedObject);
+		}
+		catch (PrintingCanceledException exception)
+		{
+			abort = true;
+			OnWritingCanceled(this, exception);
+		}
+		finally
+		{
+			EndWrite(isSync, abort);
+		}
+	}
+
+	internal bool OnWritingCanceled(object sender, Exception exception)
+	{
+		if (_writingCancelledEventHandlersCount > 0)
+			raise_WritingCancelled(sender, new WritingCancelledEventArgs(exception));
+		return _writingCancelledEventHandlersCount > 0;
+	}
+
+	void VerifyAccess()
+	{
+		if (accessVerifier == null) accessVerifier = new PrintSystemDispatcherObject();
+		accessVerifier.VerifyThreadLocality();
