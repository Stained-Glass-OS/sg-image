+		else if (manager is NgcSerializationManager) ((NgcSerializationManager)manager).XpsSerializationPrintTicketRequired += handler;
+		else if (manager is NgcSerializationManagerAsync) ((NgcSerializationManagerAsync)manager).XpsSerializationPrintTicketRequired += handler;
+	}
