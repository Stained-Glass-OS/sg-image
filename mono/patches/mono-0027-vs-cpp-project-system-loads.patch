+#ifndef SG_MUTANT_CCW_DEAD_OBJECT_CRASHES
+	/* Stained Glass OS (mono-0027): a native caller using a wrapper whose object is gone
+	 * (released to no reference, then collected) gets an error HRESULT from the wrapper (its
+	 * managed call throws on the null object and the wrapper's catch turns that into the
+	 * HRESULT) instead of Mono reading through NULL here. Visual Studio crashed in
