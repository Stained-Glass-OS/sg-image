 				UpdateNativeCustomAttributes (this);
 		}
 
+		/* Stained Glass OS (mono-0027): does this assembly carry
+		 * [IgnoresAccessChecksTo("<a's name>")] (a type the program defines itself)? */
+		internal bool IgnoresAccessChecksTo (Assembly a)
+		{
+			if (cattrs == null || a == null)
+				return false;
+			string name = a.GetName ().Name;
+			foreach (CustomAttributeBuilder cb in cattrs) {
+				if (cb.Ctor == null || cb.Ctor.DeclaringType == null ||
+				    cb.Ctor.DeclaringType.FullName != "System.Runtime.CompilerServices.IgnoresAccessChecksToAttribute")
+					continue;
+				string arg;
+				try {
+					arg = cb.string_arg ();
+				} catch {
+					continue;
+				}
+				if (arg != null && String.Equals (arg, name, StringComparison.OrdinalIgnoreCase))
+					return true;
+			}
+			return false;
+		}
