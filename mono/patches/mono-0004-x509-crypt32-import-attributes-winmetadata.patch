diff --git a/mcs/class/System/System.Security.Cryptography.X509Certificates/X509ChainImplCrypt32.cs b/mcs/class/System/System.Security.Cryptography.X509Certificates/X509ChainImplCrypt32.cs
new file mode 100644
index 0000000..ccd1868
--- /dev/null
+++ b/mcs/class/System/System.Security.Cryptography.X509Certificates/X509ChainImplCrypt32.cs
@@ -0,0 +1,247 @@
+//
+// X509ChainImplCrypt32.cs: X509Chain built by crypt32, as .NET Framework's is
+//
+// Stained Glass OS. .NET Framework builds a chain with CertGetCertificateChain
+// and judges it with CertVerifyCertificateChainPolicy (the base policy, the
+// chain policy's VerificationFlags being CERT_CHAIN_POLICY_IGNORE_* flags), so
+// a program sees the system's own trust: its root stores, its revocation
+// checking (CRLs fetched by cryptnet) and its time. Mono's managed chain
+// threw NotImplementedException from the certificate store's CRL list the
+// moment revocation was asked for, and Visual Studio's installer, which checks
+// every manifest it downloads that way, stopped at "Certificate is invalid"
+// (0x80096004).
+//
+// SG_MONO_CHAIN=mono in the environment gives Mono's managed chain instead.
+//
+// Copyright (C) 2026 Stained Glass OS contributors
+// Licensed under the MIT license, as Mono's class libraries.
+//
+
+#if SECURITY_DEP
+
+using System.Runtime.InteropServices;
+
+namespace System.Security.Cryptography.X509Certificates
+{
+	internal class X509ChainImplCrypt32 : X509ChainImpl
+	{
+		const uint X509_ASN_ENCODING = 0x1, PKCS_7_ASN_ENCODING = 0x10000;
+		const uint CERT_STORE_PROV_MEMORY = 2, CERT_STORE_ADD_ALWAYS = 4;
+		const uint CERT_CHAIN_REVOCATION_CHECK_END_CERT = 0x10000000;
+		const uint CERT_CHAIN_REVOCATION_CHECK_CHAIN = 0x20000000;
+		const uint CERT_CHAIN_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT = 0x40000000;
+		const uint CERT_CHAIN_REVOCATION_CHECK_CACHE_ONLY = 0x80000000;
+		const uint USAGE_MATCH_TYPE_AND = 0;
+		static readonly IntPtr CERT_CHAIN_POLICY_BASE = (IntPtr) 1;
+
+		[StructLayout (LayoutKind.Sequential)]
+		struct CERT_USAGE_MATCH {
+			public uint dwType;
+			public uint cUsageIdentifier;
+			public IntPtr rgpszUsageIdentifier;
+		}
+
+		[StructLayout (LayoutKind.Sequential)]
+		struct CERT_CHAIN_PARA {
+			public uint cbSize;
+			public CERT_USAGE_MATCH RequestedUsage;
+			public CERT_USAGE_MATCH RequestedIssuancePolicy;
+			public uint dwUrlRetrievalTimeout;
+			public int fCheckRevocationFreshnessTime;
+			public uint dwRevocationFreshnessTime;
+			public IntPtr pftCacheResync;
+		}
+
+		[StructLayout (LayoutKind.Sequential)]
+		struct CERT_CHAIN_POLICY_PARA {
+			public uint cbSize;
+			public uint dwFlags;
+			public IntPtr pvExtraPolicyPara;
+		}
+
+		[StructLayout (LayoutKind.Sequential)]
+		struct CERT_CHAIN_POLICY_STATUS {
+			public uint cbSize;
+			public uint dwError;
+			public int lChainIndex;
+			public int lElementIndex;
+			public IntPtr pvExtraPolicyStatus;
+		}
+
+		[DllImport ("crypt32.dll", SetLastError = true)]
+		static extern IntPtr CertCreateCertificateContext (uint dwCertEncodingType, byte[] pbCertEncoded, uint cbCertEncoded);
+		[DllImport ("crypt32.dll")]
+		static extern bool CertFreeCertificateContext (IntPtr pCertContext);
+		[DllImport ("crypt32.dll", SetLastError = true)]
+		static extern IntPtr CertOpenStore (IntPtr lpszStoreProvider, uint dwEncodingType, IntPtr hCryptProv, uint dwFlags, IntPtr pvPara);
+		[DllImport ("crypt32.dll")]
+		static extern bool CertCloseStore (IntPtr hCertStore, uint dwFlags);
+		[DllImport ("crypt32.dll", SetLastError = true)]
+		static extern bool CertAddEncodedCertificateToStore (IntPtr hCertStore, uint dwCertEncodingType, byte[] pbCertEncoded, uint cbCertEncoded, uint dwAddDisposition, IntPtr ppCertContext);
+		[DllImport ("crypt32.dll", SetLastError = true)]
+		static extern bool CertGetCertificateChain (IntPtr hChainEngine, IntPtr pCertContext, ref long pTime, IntPtr hAdditionalStore, ref CERT_CHAIN_PARA pChainPara, uint dwFlags, IntPtr pvReserved, out IntPtr ppChainContext);
+		[DllImport ("crypt32.dll")]
+		static extern void CertFreeCertificateChain (IntPtr pChainContext);
+		[DllImport ("crypt32.dll", SetLastError = true)]
+		static extern bool CertVerifyCertificateChainPolicy (IntPtr pszPolicyOID, IntPtr pChainContext, ref CERT_CHAIN_POLICY_PARA pPolicyPara, ref CERT_CHAIN_POLICY_STATUS pPolicyStatus);
+
+		static X509ChainStatus[] Empty = new X509ChainStatus [0];
+
+		readonly bool machine;
+		X509ChainElementCollection elements = new X509ChainElementCollection ();
+		X509ChainPolicy policy = new X509ChainPolicy ();
+		X509ChainStatus[] status;
+		IntPtr context;
+
+		public X509ChainImplCrypt32 (bool useMachineContext)
+		{
+			machine = useMachineContext;
+		}
+
+		public override bool IsValid {
+			get { return true; }
+		}
+
+		public override IntPtr Handle {
+			get { return context; }
+		}
+
+		public override X509ChainElementCollection ChainElements {
+			get { return elements; }
+		}
+
+		public override X509ChainPolicy ChainPolicy {
+			get { return policy; }
+			set { policy = value; }
+		}
+
+		public override X509ChainStatus[] ChainStatus {
+			get { return status ?? Empty; }
+		}
+
+		public override void AddStatus (X509ChainStatusFlags errorCode)
+		{
+		}
+
+		static X509ChainStatus[] StatusOf (uint flags)
+		{
+			// X509ChainStatusFlags are CERT_TRUST_* error bits, value for value
+			var e = new X509ChainElement (null);
+			e.StatusFlags = (X509ChainStatusFlags) flags;
+			e.UncompressFlags ();
+			return e.ChainElementStatus;
+		}
+
+		public override bool Build (X509Certificate2 certificate)
+		{
+			if (certificate == null)
+				throw new ArgumentException ("certificate");
+			Reset ();
+
+			byte[] raw = certificate.RawData;
+			IntPtr cert = CertCreateCertificateContext (X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, raw, (uint) raw.Length);
+			if (cert == IntPtr.Zero)
+				throw new ArgumentException ("certificate", new CryptographicException (Marshal.GetLastWin32Error ()));
+			IntPtr extra = IntPtr.Zero;
+			var oids = new IntPtr [policy.ApplicationPolicy.Count];
+			GCHandle pin = default (GCHandle);
+			try {
+				if (policy.ExtraStore.Count > 0) {
+					extra = CertOpenStore ((IntPtr) CERT_STORE_PROV_MEMORY, 0, IntPtr.Zero, 0, IntPtr.Zero);
+					foreach (X509Certificate2 c in policy.ExtraStore) {
+						byte[] r = c.RawData;
+						CertAddEncodedCertificateToStore (extra, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, r, (uint) r.Length, CERT_STORE_ADD_ALWAYS, IntPtr.Zero);
+					}
+				}
+				for (int i = 0; i < oids.Length; i++)
+					oids [i] = Marshal.StringToHGlobalAnsi (policy.ApplicationPolicy [i].Value);
+				pin = GCHandle.Alloc (oids, GCHandleType.Pinned);
+
+				var para = new CERT_CHAIN_PARA ();
+				para.cbSize = (uint) Marshal.SizeOf (typeof (CERT_CHAIN_PARA));
+				para.RequestedUsage.dwType = USAGE_MATCH_TYPE_AND;
+				para.RequestedUsage.cUsageIdentifier = (uint) oids.Length;
+				para.RequestedUsage.rgpszUsageIdentifier = oids.Length > 0 ? pin.AddrOfPinnedObject () : IntPtr.Zero;
+				para.dwUrlRetrievalTimeout = (uint) policy.UrlRetrievalTimeout.TotalMilliseconds;
+
+				uint flags = 0;
+				if (policy.RevocationMode != X509RevocationMode.NoCheck) {
+					switch (policy.RevocationFlag) {
+					case X509RevocationFlag.EndCertificateOnly: flags |= CERT_CHAIN_REVOCATION_CHECK_END_CERT; break;
+					case X509RevocationFlag.EntireChain: flags |= CERT_CHAIN_REVOCATION_CHECK_CHAIN; break;
+					default: flags |= CERT_CHAIN_REVOCATION_CHECK_CHAIN_EXCLUDE_ROOT; break;
+					}
+					if (policy.RevocationMode == X509RevocationMode.Offline)
+						flags |= CERT_CHAIN_REVOCATION_CHECK_CACHE_ONLY;
+				}
+				long when = policy.VerificationTime.ToFileTime ();
+				// HCCE_CURRENT_USER is 0, HCCE_LOCAL_MACHINE 1
+				if (!CertGetCertificateChain (machine ? (IntPtr) 1 : IntPtr.Zero, cert, ref when, extra, ref para, flags, IntPtr.Zero, out context))
+					throw new CryptographicException (Marshal.GetLastWin32Error ());
+			} finally {
+				if (pin.IsAllocated)
+					pin.Free ();
+				foreach (IntPtr o in oids)
+					if (o != IntPtr.Zero)
+						Marshal.FreeHGlobal (o);
+				if (extra != IntPtr.Zero)
+					CertCloseStore (extra, 0);
+				CertFreeCertificateContext (cert);
+			}
+
+			// CERT_CHAIN_CONTEXT: cbSize, TrustStatus (two DWORDs), cChain, rgpChain
+			int p = IntPtr.Size;
+			uint total = (uint) Marshal.ReadInt32 (context, 4);
+			if (Marshal.ReadInt32 (context, 12) > 0) {
+				IntPtr simple = Marshal.ReadIntPtr (Marshal.ReadIntPtr (context, 16));
+				// CERT_SIMPLE_CHAIN: cbSize, TrustStatus, cElement, rgpElement
+				int n = Marshal.ReadInt32 (simple, 12);
+				IntPtr list = Marshal.ReadIntPtr (simple, 16);
+				for (int i = 0; i < n; i++) {
+					// CERT_CHAIN_ELEMENT: cbSize, pCertContext, TrustStatus
+					IntPtr element = Marshal.ReadIntPtr (list, i * p);
+					IntPtr cc = Marshal.ReadIntPtr (element, p);
+					// CERT_CONTEXT: dwCertEncodingType, pbCertEncoded, cbCertEncoded
+					var der = new byte [Marshal.ReadInt32 (cc, 2 * p)];
+					Marshal.Copy (Marshal.ReadIntPtr (cc, p), der, 0, der.Length);
+					elements.Add (new X509Certificate2 (der));
+					X509ChainElement ce = elements [elements.Count - 1];
+					ce.StatusFlags = (X509ChainStatusFlags) (uint) Marshal.ReadInt32 (element, 2 * p);
+					ce.UncompressFlags ();
+				}
+			}
+			status = StatusOf (total);
+
+			var ppara = new CERT_CHAIN_POLICY_PARA ();
+			ppara.cbSize = (uint) Marshal.SizeOf (typeof (CERT_CHAIN_POLICY_PARA));
+			ppara.dwFlags = (uint) policy.VerificationFlags;   // CERT_CHAIN_POLICY_IGNORE_* bit for bit
+			var pstatus = new CERT_CHAIN_POLICY_STATUS ();
+			pstatus.cbSize = (uint) Marshal.SizeOf (typeof (CERT_CHAIN_POLICY_STATUS));
+			if (!CertVerifyCertificateChainPolicy (CERT_CHAIN_POLICY_BASE, context, ref ppara, ref pstatus))
+				return false;
+			return pstatus.dwError == 0;
+		}
+
+		public override void Reset ()
+		{
+			status = null;
+			if (elements.Count > 0)
+				elements.Clear ();
+			if (context != IntPtr.Zero) {
+				CertFreeCertificateChain (context);
+				context = IntPtr.Zero;
+			}
+		}
+
+		protected override void Dispose (bool disposing)
+		{
+			if (context != IntPtr.Zero) {
+				CertFreeCertificateChain (context);
+				context = IntPtr.Zero;
+			}
+			base.Dispose (disposing);
+		}
+	}
+}
+
+#endif
