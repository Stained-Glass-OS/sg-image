+	/* the printer DC's font for the run's typeface, at its device size
+	   (GDIExporter's CreateFont); IntPtr.Zero if GDI's font is not the same
+	   font (other glyphs, other widths): that run stays in the image */
+	IntPtr CreateRunFont(TextRun run)
+	{
+		var face = run.Run.GlyphTypeface;
+		string family = English(face.Win32FamilyNames), style = English(face.Win32FaceNames);
+		if (string.IsNullOrEmpty(family)) return IntPtr.Zero;
+		double size = run.Run.FontRenderingEmSize * run.Transform.M22 * dpiY / 96.0;
+		if (size < 1) return IntPtr.Zero;
+		var lf = new LOGFONTW();
+		lf.lfHeight = -(int)Math.Round(size);
+		lf.lfWeight = face.Weight.ToOpenTypeWeight();
+		lf.lfItalic = (byte)(face.Style != FontStyles.Normal ? 1 : 0);
+		lf.lfCharSet = (byte)(face.Symbol ? SYMBOL_CHARSET : DEFAULT_CHARSET);
+		lf.lfOutPrecision = (byte)(face.Symbol ? OUT_OUTLINE_PRECIS : OUT_TT_PRECIS);
+		lf.lfQuality = PROOF_QUALITY;
+		var sim = face.StyleSimulations;
+		if ((sim & StyleSimulations.ItalicSimulation) != 0)
+		{
+			if (lf.lfItalic != 0) return IntPtr.Zero;
+			lf.lfItalic = 1;
+		}
+		if ((sim & StyleSimulations.BoldSimulation) != 0)
+		{
+			lf.lfWeight += 300;
+			if (lf.lfWeight > 900) return IntPtr.Zero;
+		}
+		/* a style GDI names as its own family ("Segoe UI Semibold") */
+		string[] names = string.IsNullOrEmpty(style) || style == "Regular" || style == "Bold" ||
+			style == "Italic" || style == "Bold Italic" ? new[] { family } : new[] { family, family + " " + style };
+		foreach (var name in names)
+		{
+			lf.lfFaceName = name.Length < 32 ? name : name.Substring(0, 31);
