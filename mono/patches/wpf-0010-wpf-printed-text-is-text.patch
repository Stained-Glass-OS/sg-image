+	/* GDIExporter's RenderUnicode: characters when they map to the run's
+	   glyphs through the font's own cmap (what GDI will do), else glyph indices */
+	static bool RenderCharacters(GlyphRun run)
+	{
+		var chars = run.Characters;
+		var glyphs = run.GlyphIndices;
+		if (chars == null || chars.Count != glyphs.Count || run.GlyphTypeface.Symbol) return false;
+		var map = run.GlyphTypeface.CharacterToGlyphMap;
+		for (int i = 0; i < chars.Count; i++)
+		{
+			ushort g;
+			if (glyphs[i] == 0 || char.IsSurrogate(chars[i]) || !map.TryGetValue(chars[i], out g) || g != glyphs[i])
+				return false;
+		}
+		return true;
+	}
+
+	/* GDIExporter's RenderGlyphRun, left to right: runs of glyphs with the same
+	   vertical offset, each at its rounded device position */
+	void RenderGlyphRun(GlyphRun run, Point translate, Point scale)
+	{
+		bool characters = RenderCharacters(run);
+		int count = run.GlyphIndices.Count;
+		var text = new char[count];
+		for (int i = 0; i < count; i++) text[i] = characters ? run.Characters[i] : (char)run.GlyphIndices[i];
+		var dx = new int[count];
+		var offsets = run.GlyphOffsets;
+		var advances = run.AdvanceWidths;
+		double baselineX = translate.X + run.BaselineOrigin.X * scale.X;
+		double baselineY = translate.Y + run.BaselineOrigin.Y * scale.Y;
+		double position = 0;
+		for (int i = 0; i < count; )
+		{
+			int j = i + 1;
+			Point offset = offsets != null ? offsets[i] : new Point();
+			int x = (int)Math.Round(baselineX + (offset.X + position) * scale.X);
+			int y = (int)Math.Round(baselineY - offset.Y * scale.Y);
+			int last = x;
+			position += advances[i];
+			for (; j < count; j++)
+			{
+				Point o = offsets != null ? offsets[j] : new Point();
+				if (Math.Abs(o.Y - offset.Y) > 1e-9) break;
+				int cur = (int)Math.Round(baselineX + (o.X + position) * scale.X);
+				dx[j - 1] = cur - last;
+				last = cur;
+				position += advances[j];
+			}
+			dx[j - 1] = 0;
+			var piece = new char[j - i];
+			var pieceDx = new int[j - i];
+			Array.Copy(text, i, piece, 0, j - i);
+			Array.Copy(dx, i, pieceDx, 0, j - i);
+			ExtTextOutW(hdc, x, y, characters ? 0 : ETO_GLYPH_INDEX, IntPtr.Zero, piece, j - i, j - i > 1 ? pieceDx : null);
+			i = j;
+		}
+	}
