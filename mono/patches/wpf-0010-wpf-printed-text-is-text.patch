+	/* the DC's font has the typeface's glyphs: as many glyphs, the same
+	   advances for the run's glyphs (to a device unit) */
+	bool SameFont(IntPtr font, TextRun run)
+	{
+		IntPtr old = SelectObject(hdc, font);
+		try
+		{
+			var face = run.Run.GlyphTypeface;
+			var maxp = new byte[6];
+			if (GetFontData(hdc, 0x7078616d /* 'maxp' */, 0, maxp, 6) != 6) return false;
+			if (((maxp[4] << 8) | maxp[5]) != face.GlyphCount) return false;
+			var glyphs = run.Run.GlyphIndices;
+			var widths = face.AdvanceWidths;
+			double em = run.Run.FontRenderingEmSize * run.Transform.M22 * dpiY / 96.0;
+			int checks = Math.Min(glyphs.Count, 32);
+			for (int i = 0; i < checks; i++)
+			{
+				var g = new ushort[] { glyphs[i] };
+				int[] abc = new int[3];
+				double want;
+				if (!widths.TryGetValue(glyphs[i], out want)) return false;
+				if (!GetCharABCWidthsI(hdc, 0, 1, g, abc)) return false;
+				if (Math.Abs(abc[0] + abc[1] + abc[2] - want * em) > 1.5 + em * 0.01) return false;
+			}
+			return true;
+		}
+		finally
+		{
+			SelectObject(hdc, old);
+		}
 	}
 
