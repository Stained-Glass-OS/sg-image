+	static bool IsScaleOffset(Matrix m)
+	{
+		return m.M12 == 0 && m.M21 == 0;
+	}
+
+	/* what the printer's font calls can print as WPF draws it (GDIExporter's
+	   RenderTextThroughGDI conditions; no world transform: scale and offset only) */
+	bool TextAsText(SolidColorBrush brush, GlyphRun run, Rect ink)
+	{
+#if SG_MUTANT_GDI_TEXT_RASTER
+		return false;
+#endif
+		if (brush == null || brush.Opacity < 1 || brush.Color.A != 255) return false;
+		if (run.GlyphIndices == null || run.GlyphIndices.Count == 0 || run.GlyphTypeface == null) return false;
+		if (run.IsSideways || (run.BidiLevel & 1) != 0) return false;
+		if (!IsScaleOffset(transform) || transform.M11 <= 0 || transform.M22 <= 0 ||
+		    Math.Abs(transform.M11 - transform.M22) > 1e-6 * transform.M22) return false;
+		if (ink.IsEmpty) return false;
+		if (clips.Count > 0)
+		{
+			/* clipped text stays in the image, unless the clip leaves it whole */
+			Rect? clip = clips.Peek();
+			Rect b = ink;
+			b.Transform(transform);
+			if (clip == null || !clip.Value.Contains(b)) return false;
+		}
+		return true;
+	}
