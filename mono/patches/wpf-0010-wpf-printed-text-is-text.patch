+	static string English(IDictionary<CultureInfo, string> names)
+	{
+		string name;
+		if (names == null || names.Count == 0) return null;
+		if (names.TryGetValue(CultureInfo.GetCultureInfo("en-us"), out name)) return name;
+		foreach (var pair in names) return pair.Value;
+		return null;
+	}
