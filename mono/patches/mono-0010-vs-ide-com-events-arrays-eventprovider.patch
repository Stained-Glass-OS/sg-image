+		return NULL;
+	attr_class = mono_class_try_load_from_name (mono_defaults.corlib, "System.Runtime.InteropServices", "ComEventInterfaceAttribute");
+	if (!attr_class)
+		return NULL;
+	cinfo = mono_custom_attrs_from_class_checked (itf, error);
+	if (!is_ok (error) || !cinfo) {
+		mono_error_cleanup (error);
+		return NULL;
+	}
+	attr = mono_custom_attrs_get_attr_checked (cinfo, attr_class, error);
+	if (!cinfo->cached)
+		mono_custom_attrs_free (cinfo);
+	if (!is_ok (error) || !attr) {
+		mono_error_cleanup (error);
+		return NULL;
+	}
+	field = mono_class_get_field_from_name_full (attr_class, "_EventProvider", NULL);
