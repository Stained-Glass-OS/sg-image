+/* Stained Glass OS: arrays of COM interfaces between native and managed code
+ * ([MarshalAs(LPArray, ArraySubType = Interface)] IFoo[]). A managed
+ * enumerator's Next(celt, [Out] IVsWindowFrame[] rgelt, out fetched), called
+ * from Visual Studio's msenv, returned S_OK with rgelt[0] still NULL (an
+ * interface counted as a blittable type of size 0), and msenv crashed on it. */
+gboolean
+mono_cominterop_is_itf_array_elem (MonoClass *eklass, MonoMarshalSpec *spec)
+{
+	if (!eklass)
+		return FALSE;
+	if (mono_class_is_interface (eklass))
+		return TRUE;
+	if (eklass == mono_defaults.object_class && spec && spec->native == MONO_NATIVE_LPARRAY) {
+		MonoMarshalNative e = spec->data.array_data.elem_type;
+		return e == MONO_NATIVE_INTERFACE || e == MONO_NATIVE_IUNKNOWN || e == MONO_NATIVE_IDISPATCH;
+	}
+	return FALSE;
+}
+
+/* native interface pointers into the managed array: our own CCWs give back
+ * their object, other pointers a runtime callable wrapper */
+void
+mono_cominterop_itf_array_from_native (MonoArray *arr, gpointer *src)
+{
+	ERROR_DECL (error);
+	static MonoMethod *get_object;
+	uintptr_t i, len;
+
+	if (!arr || !src)
+		return;
+	if (!get_object) {
+		get_object = mono_class_get_method_from_name_checked (mono_defaults.marshal_class, "GetObjectForIUnknown", 1, 0, error);
+		mono_error_assert_ok (error);
+	}
+	len = mono_array_length_internal (arr);
+	for (i = 0; i < len; i++) {
+		MonoObject *obj = NULL;
+		gpointer p = src [i];
+		if (p) {
+			obj = cominterop_get_ccw_object ((MonoCCWInterface *)p, TRUE);
+			if (!obj) {
+				gpointer args [1] = { &p };
+				obj = mono_runtime_invoke_checked (get_object, NULL, args, error);
+				if (!is_ok (error)) {
+					mono_error_set_pending_exception (error);
+					return;
+				}
+			}
+		}
+		mono_array_setref_internal (arr, i, obj);
+	}
+}
+
+/* the managed array's objects as interface pointers the caller owns (one
+ * reference each), as .NET hands them out */
+void
+mono_cominterop_itf_array_to_native (MonoArray *arr, gpointer *dest, MonoClass *eklass)
+{
+	ERROR_DECL (error);
+	uintptr_t i, len;
+	MonoClass *ic = (eklass && mono_class_is_interface (eklass)) ? eklass : mono_class_get_iunknown_class ();
+
+	if (!arr || !dest)
+		return;
+	len = mono_array_length_internal (arr);
+	for (i = 0; i < len; i++) {
+		MonoObject *obj = mono_array_get_internal (arr, MonoObject*, i);
+		gpointer p = NULL;
+		if (obj) {
+			p = mono_cominterop_get_com_interface (obj, ic, error);
+			if (!is_ok (error)) {
+				mono_error_set_pending_exception (error);
+				return;
+			}
+			if (p)
+				mono_IUnknown_AddRef ((MonoIUnknown *)p);
+		}
+		dest [i] = p;
+	}
+}
