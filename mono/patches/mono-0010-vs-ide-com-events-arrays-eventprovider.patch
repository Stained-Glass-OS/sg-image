+//
+// System.Diagnostics.Eventing.EventProvider and EventDescriptor (System.Core),
+// for Stained Glass OS's Wine Mono.
+//
+// Programs built for .NET Framework keep an EventProvider for their ETW tracing
+// (Visual Studio's Team Foundation trace settings, so its source control
+// package); Mono had no such type and the class holding one failed to load.
+// The provider is registered with no ETW session listening, as on a Windows
+// machine where nobody traces: IsEnabled is false and a write succeeds with
+// nothing to deliver.
+//
+// Copyright (C) 2026 Stained Glass OS contributors. MIT licence, as Wine Mono.
+//
+using System;
+using System.Runtime.InteropServices;
+
+namespace System.Diagnostics.Eventing
+{
+	[StructLayout (LayoutKind.Explicit, Size = 16)]
+	public struct EventDescriptor
+	{
+		[FieldOffset (0)] ushort id;
+		[FieldOffset (2)] byte version;
+		[FieldOffset (3)] byte channel;
+		[FieldOffset (4)] byte level;
+		[FieldOffset (5)] byte opcode;
+		[FieldOffset (6)] ushort task;
+		[FieldOffset (8)] long keywords;
+
+		public EventDescriptor (int id, byte version, byte channel, byte level, byte opcode, int task, long keywords)
+		{
+			if (id < 0)
+				throw new ArgumentOutOfRangeException ("id", "Non-negative number required.");
+			if (id > ushort.MaxValue)
+				throw new ArgumentOutOfRangeException ("id", "The ID parameter must be in the range 1 through 65535.");
+			if (task < 0)
+				throw new ArgumentOutOfRangeException ("task", "Non-negative number required.");
+			if (task > ushort.MaxValue)
+				throw new ArgumentOutOfRangeException ("task", "The ID parameter must be in the range 1 through 65535.");
+			this.id = (ushort) id;
+			this.version = version;
+			this.channel = channel;
+			this.level = level;
+			this.opcode = opcode;
+			this.task = (ushort) task;
+			this.keywords = keywords;
+		}
+
+		public int EventId { get { return id; } }
+		public byte Version { get { return version; } }
+		public byte Channel { get { return channel; } }
+		public byte Level { get { return level; } }
+		public byte Opcode { get { return opcode; } }
+		public int Task { get { return task; } }
+		public long Keywords { get { return keywords; } }
+	}
+
+	public class EventProvider : IDisposable
+	{
+		public enum WriteEventErrorCode : int
+		{
+			NoError = 0,
+			NoFreeBuffers = 1,
+			EventTooBig = 2
+		}
+
+		public EventProvider (Guid providerGuid)
+		{
+		}
+
+		public void Dispose ()
+		{
+			Dispose (true);
+			GC.SuppressFinalize (this);
+		}
+
+		protected virtual void Dispose (bool disposing)
+		{
+		}
+
+		public virtual void Close ()
+		{
+			Dispose ();
+		}
+
+		~EventProvider ()
+		{
+			Dispose (false);
+		}
+
+		/* no ETW session enables the provider */
+		public bool IsEnabled ()
+		{
+			return false;
+		}
+
+		public bool IsEnabled (byte level, long keywords)
+		{
+			return false;
+		}
+
+		public static WriteEventErrorCode GetLastWriteEventError ()
+		{
+			return WriteEventErrorCode.NoError;
+		}
+
+		public bool WriteMessageEvent (string eventMessage, byte eventLevel, long eventKeywords)
+		{
+			if (eventMessage == null)
+				throw new ArgumentNullException ("eventMessage");
+			return true;
+		}
+
+		public bool WriteMessageEvent (string eventMessage)
+		{
+			return WriteMessageEvent (eventMessage, 0, 0);
+		}
+
+		public bool WriteEvent (ref EventDescriptor eventDescriptor, params object[] eventPayload)
+		{
+			return true;
+		}
+
+		public bool WriteEvent (ref EventDescriptor eventDescriptor, string data)
+		{
+			if (data == null)
+				throw new ArgumentNullException ("dataString");
+			return true;
+		}
+
+		protected bool WriteEvent (ref EventDescriptor eventDescriptor, int dataCount, IntPtr data)
+		{
+			return true;
+		}
+
+		public bool WriteTransferEvent (ref EventDescriptor eventDescriptor, Guid relatedActivityId, params object[] eventPayload)
+		{
+			return true;
+		}
+
+		protected bool WriteTransferEvent (ref EventDescriptor eventDescriptor, Guid relatedActivityId, int dataCount, IntPtr data)
+		{
+			return true;
+		}
+
+		public static void SetActivityId (ref Guid id)
+		{
+			Trace.CorrelationManager.ActivityId = id;
+		}
+
+		public static Guid CreateActivityId ()
+		{
+			return Guid.NewGuid ();
+		}
+	}
+}
