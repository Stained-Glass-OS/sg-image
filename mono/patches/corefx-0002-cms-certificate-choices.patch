+
+        [ExpectedTag(1)]
+        [AnyValue]
+        public ReadOnlyMemory<byte>? AttributeCertificateV1;
+
+        [ExpectedTag(2)]
+        [AnyValue]
+        public ReadOnlyMemory<byte>? AttributeCertificateV2;
+
+        [ExpectedTag(3)]
+        [AnyValue]
+        public ReadOnlyMemory<byte>? OtherCertificateFormat;
     }
 }
