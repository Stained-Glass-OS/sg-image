+			 * a SAFEARRAY of VT_UNKNOWN/VT_DISPATCH/VT_RECORD) and the image it is named in */
+			char *sg_udt_name;
+			MonoImage *sg_udt_image;
 		} safearray_data;
 	} data;
 } MonoMarshalSpec;
