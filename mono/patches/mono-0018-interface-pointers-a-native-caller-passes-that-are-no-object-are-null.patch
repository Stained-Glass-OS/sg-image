+			mono_mb_emit_ldarg (mb, argnum);
+			mono_mb_emit_ptr (mb, site);
+			mono_mb_emit_native_call (mb, guard_sig, sg_itf_ptr_usable);
+			pos_unusable = mono_mb_emit_short_branch (mb, CEE_BRFALSE_S);
+		}
+#endif
