--- a/mono/metadata/cominterop.c
+++ b/mono/metadata/cominterop.c
@@ -1456,6 +1456,49 @@
 	return AddRef;
 }
 
+#if defined(HOST_WIN32) && !defined(SG_MUTANT_ITF_GUARD_OFF)
+/* Stained Glass OS: is this a pointer to something with a readable vtable? An interface
+ * pointer a native caller passes to a managed method is called through at once, so a value
+ * that cannot be one (misaligned, or its object or vtable not readable memory) is taken as
+ * null instead. Real objects are aligned and readable: valid calls see no change. */
+typedef struct { gboolean logged; char *where; } SgItfGuardSite;
+
+static gboolean
+sg_readable (gconstpointer p, gsize size)
+{
+	MEMORY_BASIC_INFORMATION mbi;
+	const DWORD readable = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+		PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+	gsize start = (gsize)p, end = start + size;
+
+	while (start < end) {
+		if (!VirtualQuery ((LPCVOID)start, &mbi, sizeof (mbi)) || mbi.State != MEM_COMMIT ||
+		    !(mbi.Protect & readable) || (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS)))
+			return FALSE;
+		start = (gsize)mbi.BaseAddress + mbi.RegionSize;
+	}
+	return TRUE;
+}
+
+static int
+sg_itf_ptr_usable (gpointer p, SgItfGuardSite *site)
+{
+	gboolean ok = !((gsize)p & (sizeof (gpointer) - 1)) && sg_readable (p, sizeof (gpointer));
+
+	if (ok) {
+		gpointer vtable = *(gpointer *)p;
+		/* the vtable: aligned and readable for IUnknown's three slots */
+		ok = !((gsize)vtable & (sizeof (gpointer) - 1)) && sg_readable (vtable, 3 * sizeof (gpointer));
+	}
+	if (!ok && !site->logged) {
+		site->logged = TRUE;
+		g_warning ("%s: a native caller passed %p for an interface parameter, which is no object; it is taken as null "
+			   "(a caller passing fewer arguments than the managed declaration has?)", site->where, p);
+	}
+	return ok;
+}
+#endif
+
