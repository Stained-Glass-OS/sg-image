diff --git a/src/Microsoft.DotNet.Wpf/src/System.Printing/System.Printing/SgSpooler.cs b/src/Microsoft.DotNet.Wpf/src/System.Printing/System.Printing/SgSpooler.cs
new file mode 100644
index 0000000..27a9723
--- /dev/null
+++ b/src/Microsoft.DotNet.Wpf/src/System.Printing/System.Printing/SgSpooler.cs
@@ -0,0 +1,158 @@
+// Stained Glass OS: the local print spooler for System.Printing, through
+// winspool.drv (OpenPrinter, GetPrinter, EnumPrinters, GetDefaultPrinter).
+// Our own code. Wine Mono's System.Printing threw NotImplementedException
+// from every member, LocalPrintServer's constructor included, so programs
+// that look at their printers through it (DYMO Connect's label printer
+// discovery) stopped there.
+using System;
+using System.Collections.Generic;
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace System.Printing {
+
+internal sealed class SgPrinterInfo
+{
+	public string ServerName, PrinterName, ShareName, PortName, DriverName;
+	public string Comment, Location, SepFile, PrintProcessor, Datatype, Parameters;
+	public int Attributes, Priority, DefaultPriority, StartTime, UntilTime, Status, Jobs, AveragePPM;
+}
+
+internal sealed class SgJobInfo
+{
+	public int JobId, Status, Priority, Position, TotalPages, PagesPrinted;
+	public string PrinterName, MachineName, UserName, Document, Datatype, StatusText;
+	public DateTime Submitted;
+}
+
+internal static class SgSpooler
+{
+	const int PRINTER_ENUM_LOCAL = 0x2;
+	const int PRINTER_ENUM_CONNECTIONS = 0x4;
+	const int ERROR_INSUFFICIENT_BUFFER = 122;
+
+	[DllImport("winspool.drv", CharSet = CharSet.Unicode, SetLastError = true)]
+	static extern bool EnumPrintersW(int flags, string name, int level, IntPtr buffer, int size, out int needed, out int returned);
+
+	[DllImport("winspool.drv", CharSet = CharSet.Unicode, SetLastError = true)]
+	static extern bool OpenPrinterW(string name, out IntPtr handle, IntPtr defaults);
+
+	[DllImport("winspool.drv", SetLastError = true)]
+	static extern bool GetPrinterW(IntPtr handle, int level, IntPtr buffer, int size, out int needed);
+
+	[DllImport("winspool.drv", SetLastError = true)]
+	static extern bool ClosePrinter(IntPtr handle);
+
+	[DllImport("winspool.drv", CharSet = CharSet.Unicode, SetLastError = true)]
+	static extern bool GetDefaultPrinterW(StringBuilder buffer, ref int size);
+
+	/* PRINTER_INFO_2W: 13 pointers (one of them pDevMode, one pSecurityDescriptor), then 8 DWORDs. */
+	static SgPrinterInfo Read(IntPtr p)
+	{
+		int ps = IntPtr.Size;
+		Func<int, string> str = i => Marshal.PtrToStringUni(Marshal.ReadIntPtr(p, i * ps));
+		int dw = 13 * ps;
+		return new SgPrinterInfo {
+			ServerName = str(0), PrinterName = str(1), ShareName = str(2), PortName = str(3),
+			DriverName = str(4), Comment = str(5), Location = str(6), SepFile = str(8),
+			PrintProcessor = str(9), Datatype = str(10), Parameters = str(11),
+			Attributes = Marshal.ReadInt32(p, dw), Priority = Marshal.ReadInt32(p, dw + 4),
+			DefaultPriority = Marshal.ReadInt32(p, dw + 8), StartTime = Marshal.ReadInt32(p, dw + 12),
+			UntilTime = Marshal.ReadInt32(p, dw + 16), Status = Marshal.ReadInt32(p, dw + 20),
+			Jobs = Marshal.ReadInt32(p, dw + 24), AveragePPM = Marshal.ReadInt32(p, dw + 28),
+		};
+	}
+
+	/* The printer's PRINTER_INFO_2, or null when there is no such printer. */
+	public static SgPrinterInfo GetPrinter(string name)
+	{
+		IntPtr h, buf = IntPtr.Zero;
+		int needed;
+		if (!OpenPrinterW(name, out h, IntPtr.Zero)) return null;
+		try {
+			GetPrinterW(h, 2, IntPtr.Zero, 0, out needed);
+			if (needed <= 0) return null;
+			buf = Marshal.AllocHGlobal(needed);
+			if (!GetPrinterW(h, 2, buf, needed, out needed)) return null;
+			return Read(buf);
+		} finally {
+			if (buf != IntPtr.Zero) Marshal.FreeHGlobal(buf);
+			ClosePrinter(h);
+		}
+	}
+
+	public static List<SgPrinterInfo> EnumPrinters(bool local, bool connections)
+	{
+		var list = new List<SgPrinterInfo>();
+		int flags = (local ? PRINTER_ENUM_LOCAL : 0) | (connections ? PRINTER_ENUM_CONNECTIONS : 0);
+		int needed, count;
+		if (flags == 0) return list;
+		if (EnumPrintersW(flags, null, 2, IntPtr.Zero, 0, out needed, out count) || needed <= 0) return list;
+		IntPtr buf = Marshal.AllocHGlobal(needed);
+		try {
+			if (!EnumPrintersW(flags, null, 2, buf, needed, out needed, out count)) return list;
+			int size = 13 * IntPtr.Size + 8 * 4;
+			if (IntPtr.Size == 8) size = (size + 7) & ~7;
+			for (int i = 0; i < count; i++)
+				list.Add(Read(buf + i * size));
+		} finally {
+			Marshal.FreeHGlobal(buf);
+		}
+		return list;
+	}
+
+	[DllImport("winspool.drv", SetLastError = true)]
+	static extern bool EnumJobsW(IntPtr printer, int first, int count, int level, IntPtr buffer, int size, out int needed, out int returned);
+
+	/* JOB_INFO_1W: DWORD JobId, 6 pointers, 5 DWORDs, SYSTEMTIME Submitted. */
+	public static List<SgJobInfo> EnumJobs(string printerName)
+	{
+		var list = new List<SgJobInfo>();
+		IntPtr h, buf = IntPtr.Zero;
+		int needed, count;
+		if (!OpenPrinterW(printerName, out h, IntPtr.Zero)) return list;
+		try {
+			if (EnumJobsW(h, 0, 0x7fff, 1, IntPtr.Zero, 0, out needed, out count) || needed <= 0) return list;
+			buf = Marshal.AllocHGlobal(needed);
+			if (!EnumJobsW(h, 0, 0x7fff, 1, buf, needed, out needed, out count)) return list;
+			int ps = IntPtr.Size, first = ps;           /* JobId padded to a pointer */
+			int dw = first + 6 * ps;
+			int size = dw + 5 * 4 + 16;
+			size = (size + ps - 1) & ~(ps - 1);
+			for (int i = 0; i < count; i++)
+			{
+				IntPtr p = buf + i * size;
+				Func<int, string> str = k => Marshal.PtrToStringUni(Marshal.ReadIntPtr(p, first + k * ps));
+				var j = new SgJobInfo {
+					JobId = Marshal.ReadInt32(p, 0), PrinterName = str(0), MachineName = str(1),
+					UserName = str(2), Document = str(3), Datatype = str(4), StatusText = str(5),
+					Status = Marshal.ReadInt32(p, dw), Priority = Marshal.ReadInt32(p, dw + 4),
+					Position = Marshal.ReadInt32(p, dw + 8), TotalPages = Marshal.ReadInt32(p, dw + 12),
+					PagesPrinted = Marshal.ReadInt32(p, dw + 16),
+				};
+				int st = dw + 20;
+				try {
+					j.Submitted = new DateTime(Marshal.ReadInt16(p, st), Marshal.ReadInt16(p, st + 2), Marshal.ReadInt16(p, st + 6),
+						Marshal.ReadInt16(p, st + 8), Marshal.ReadInt16(p, st + 10), Marshal.ReadInt16(p, st + 12),
+						Marshal.ReadInt16(p, st + 14), DateTimeKind.Utc);
+				} catch (ArgumentException) { }
+				list.Add(j);
+			}
+		} finally {
+			if (buf != IntPtr.Zero) Marshal.FreeHGlobal(buf);
+			ClosePrinter(h);
+		}
+		return list;
+	}
+
+	public static string GetDefaultPrinter()
+	{
+		int size = 0;
+		GetDefaultPrinterW(null, ref size);
+		if (size <= 0) return null;
+		var sb = new StringBuilder(size);
+		return GetDefaultPrinterW(sb, ref size) ? sb.ToString() : null;
+	}
+}
+}
