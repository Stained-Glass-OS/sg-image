+
+/*
+ * Stained Glass OS: whether two virtual methods have the same signature when one of them names
+ * a type that cannot be loaded (its assembly is not there). The CLR matches overrides and
+ * interface implementations by their metadata signatures and loads the types only when code
+ * using them is compiled; Mono needed every type and failed the whole class ("Could not resolve
+ * the signature of a virtual method"): Playnite died at start, its PowerShellRuntime naming
+ * System.Management.Automation's types. Here the two signatures are compared as metadata: the
+ * same element types, classes by namespace, name and enclosing class.
+ */
+static char *
+sg_typedeforref_name (MonoImage *image, guint32 coded)
+{
+	guint32 rid = coded >> 2, cols [MONO_TYPEREF_SIZE];
+	switch (coded & 3) {
+	case 0: { /* TypeDef */
+		guint32 tcols [MONO_TYPEDEF_SIZE], enclosing;
+		if (!rid || rid > mono_table_info_get_rows (&image->tables [MONO_TABLE_TYPEDEF]))
+			return NULL;
+		mono_metadata_decode_row (&image->tables [MONO_TABLE_TYPEDEF], rid - 1, tcols, MONO_TYPEDEF_SIZE);
+		enclosing = mono_metadata_nested_in_typedef (image, MONO_TOKEN_TYPE_DEF | rid);
+		if (enclosing) {
+			char *outer = sg_typedeforref_name (image, (mono_metadata_token_index (enclosing) << 2) | 0);
+			char *r = outer ? g_strdup_printf ("%s/%s", outer, mono_metadata_string_heap (image, tcols [MONO_TYPEDEF_NAME])) : NULL;
+			g_free (outer);
+			return r;
+		}
+		return g_strdup_printf ("%s.%s", mono_metadata_string_heap (image, tcols [MONO_TYPEDEF_NAMESPACE]),
+					mono_metadata_string_heap (image, tcols [MONO_TYPEDEF_NAME]));
+	}
+	case 1: { /* TypeRef */
+		guint32 scope;
+		if (!rid || rid > mono_table_info_get_rows (&image->tables [MONO_TABLE_TYPEREF]))
+			return NULL;
+		mono_metadata_decode_row (&image->tables [MONO_TABLE_TYPEREF], rid - 1, cols, MONO_TYPEREF_SIZE);
+		scope = cols [MONO_TYPEREF_SCOPE];
+		if ((scope & MONO_RESOLUTION_SCOPE_MASK) == MONO_RESOLUTION_SCOPE_TYPEREF) {
+			char *outer = sg_typedeforref_name (image, ((scope >> MONO_RESOLUTION_SCOPE_BITS) << 2) | 1);
+			char *r = outer ? g_strdup_printf ("%s/%s", outer, mono_metadata_string_heap (image, cols [MONO_TYPEREF_NAME])) : NULL;
+			g_free (outer);
+			return r;
+		}
+		return g_strdup_printf ("%s.%s", mono_metadata_string_heap (image, cols [MONO_TYPEREF_NAMESPACE]),
+					mono_metadata_string_heap (image, cols [MONO_TYPEREF_NAME]));
+	}
+	default:
+		return NULL;
+	}
+}
+
+static gboolean sg_sig_type_equal (MonoImage *ia, const char *a, const char **enda, MonoImage *ib, const char *b, const char **endb, int depth);
+
+static gboolean
+sg_sig_typedeforref_equal (MonoImage *ia, guint32 ca, MonoImage *ib, guint32 cb, int depth)
+{
+	if ((ca & 3) == 2 || (cb & 3) == 2) { /* TypeSpec: compare its signatures */
+		const char *pa, *pb;
+		guint32 ra = ca >> 2, rb = cb >> 2, cols [MONO_TYPESPEC_SIZE];
+		if ((ca & 3) != 2 || (cb & 3) != 2 || !ra || !rb ||
+		    ra > mono_table_info_get_rows (&ia->tables [MONO_TABLE_TYPESPEC]) || rb > mono_table_info_get_rows (&ib->tables [MONO_TABLE_TYPESPEC]))
+			return FALSE;
+		mono_metadata_decode_row (&ia->tables [MONO_TABLE_TYPESPEC], ra - 1, cols, MONO_TYPESPEC_SIZE);
+		pa = mono_metadata_blob_heap (ia, cols [MONO_TYPESPEC_SIGNATURE]);
+		mono_metadata_decode_blob_size (pa, &pa);
+		mono_metadata_decode_row (&ib->tables [MONO_TABLE_TYPESPEC], rb - 1, cols, MONO_TYPESPEC_SIZE);
+		pb = mono_metadata_blob_heap (ib, cols [MONO_TYPESPEC_SIGNATURE]);
+		mono_metadata_decode_blob_size (pb, &pb);
+		return sg_sig_type_equal (ia, pa, &pa, ib, pb, &pb, depth + 1);
+	}
+	if (ia == ib && ca == cb)
+		return TRUE;
+	char *na = sg_typedeforref_name (ia, ca), *nb = sg_typedeforref_name (ib, cb);
+	gboolean eq = na && nb && !strcmp (na, nb);
+	g_free (na);
+	g_free (nb);
+	return eq;
+}
+
+static gboolean
+sg_sig_type_equal (MonoImage *ia, const char *a, const char **enda, MonoImage *ib, const char *b, const char **endb, int depth)
+{
+	guint32 i, n, m;
+	if (depth > 32)
+		return FALSE;
+	/* custom modifiers are not compared */
+	while (*a == MONO_TYPE_CMOD_REQD || *a == MONO_TYPE_CMOD_OPT) { a++; mono_metadata_decode_value (a, &a); }
+	while (*b == MONO_TYPE_CMOD_REQD || *b == MONO_TYPE_CMOD_OPT) { b++; mono_metadata_decode_value (b, &b); }
+	if (*a != *b)
+		return FALSE;
+	guint8 et = (guint8)*a;
+	a++; b++;
+	switch (et) {
+	case MONO_TYPE_VOID: case MONO_TYPE_BOOLEAN: case MONO_TYPE_CHAR: case MONO_TYPE_I1: case MONO_TYPE_U1:
+	case MONO_TYPE_I2: case MONO_TYPE_U2: case MONO_TYPE_I4: case MONO_TYPE_U4: case MONO_TYPE_I8: case MONO_TYPE_U8:
+	case MONO_TYPE_R4: case MONO_TYPE_R8: case MONO_TYPE_STRING: case MONO_TYPE_TYPEDBYREF: case MONO_TYPE_I:
+	case MONO_TYPE_U: case MONO_TYPE_OBJECT:
+		break;
+	case MONO_TYPE_PTR: case MONO_TYPE_BYREF: case MONO_TYPE_SZARRAY: case MONO_TYPE_PINNED:
+		if (!sg_sig_type_equal (ia, a, &a, ib, b, &b, depth + 1))
+			return FALSE;
+		break;
+	case MONO_TYPE_VALUETYPE: case MONO_TYPE_CLASS:
+		n = mono_metadata_decode_value (a, &a);
+		m = mono_metadata_decode_value (b, &b);
+		if (!sg_sig_typedeforref_equal (ia, n, ib, m, depth))
+			return FALSE;
+		break;
+	case MONO_TYPE_VAR: case MONO_TYPE_MVAR:
+		if (mono_metadata_decode_value (a, &a) != mono_metadata_decode_value (b, &b))
+			return FALSE;
+		break;
+	case MONO_TYPE_ARRAY:
+		if (!sg_sig_type_equal (ia, a, &a, ib, b, &b, depth + 1))
+			return FALSE;
+		if (mono_metadata_decode_value (a, &a) != mono_metadata_decode_value (b, &b)) /* rank */
+			return FALSE;
+		n = mono_metadata_decode_value (a, &a);
+		if (n != mono_metadata_decode_value (b, &b))
+			return FALSE;
+		for (i = 0; i < n; i++)
+			if (mono_metadata_decode_value (a, &a) != mono_metadata_decode_value (b, &b))
+				return FALSE;
+		n = mono_metadata_decode_value (a, &a);
+		if (n != mono_metadata_decode_value (b, &b))
+			return FALSE;
+		for (i = 0; i < n; i++)
+			if (mono_metadata_decode_signed_value (a, &a) != mono_metadata_decode_signed_value (b, &b))
+				return FALSE;
+		break;
+	case MONO_TYPE_GENERICINST:
+		if (!sg_sig_type_equal (ia, a, &a, ib, b, &b, depth + 1))
+			return FALSE;
+		n = mono_metadata_decode_value (a, &a);
+		if (n != mono_metadata_decode_value (b, &b))
+			return FALSE;
+		for (i = 0; i < n; i++)
+			if (!sg_sig_type_equal (ia, a, &a, ib, b, &b, depth + 1))
+				return FALSE;
+		break;
+	default: /* function pointers and anything else: not compared */
+		return FALSE;
+	}
+	*enda = a;
+	*endb = b;
+	return TRUE;
+}
+
+static gboolean
+sg_method_metadata_signature_equal (MonoMethod *ma, MonoMethod *mb)
+{
+	MonoImage *ia = m_class_get_image (ma->klass), *ib = m_class_get_image (mb->klass);
+	guint32 cols [MONO_METHOD_SIZE], i, n;
+	const char *a, *b;
+
+	if (ma->is_inflated || mb->is_inflated || image_is_dynamic (ia) || image_is_dynamic (ib) ||
+	    mono_metadata_token_table (ma->token) != MONO_TABLE_METHOD || mono_metadata_token_table (mb->token) != MONO_TABLE_METHOD)
+		return FALSE;
+	mono_metadata_decode_row (&ia->tables [MONO_TABLE_METHOD], mono_metadata_token_index (ma->token) - 1, cols, MONO_METHOD_SIZE);
+	a = mono_metadata_blob_heap (ia, cols [MONO_METHOD_SIGNATURE]);
+	mono_metadata_decode_blob_size (a, &a);
+	mono_metadata_decode_row (&ib->tables [MONO_TABLE_METHOD], mono_metadata_token_index (mb->token) - 1, cols, MONO_METHOD_SIZE);
+	b = mono_metadata_blob_heap (ib, cols [MONO_METHOD_SIGNATURE]);
+	mono_metadata_decode_blob_size (b, &b);
+
+	if (*a != *b) /* calling convention, HASTHIS, GENERIC */
+		return FALSE;
+	if (*a++ & 0x10) { /* generic: number of type parameters */
+		b++;
+		if (mono_metadata_decode_value (a, &a) != mono_metadata_decode_value (b, &b))
+			return FALSE;
+	} else {
+		b++;
+	}
+	n = mono_metadata_decode_value (a, &a);
+	if (n != mono_metadata_decode_value (b, &b))
+		return FALSE;
+	for (i = 0; i <= n; i++) /* the return type, then each parameter */
+		if (!sg_sig_type_equal (ia, a, &a, ib, b, &b, 0))
+			return FALSE;
+	return TRUE;
+}
+
+/* the two methods' signatures are equal; *unresolved: a type of one of them could not be loaded */
+static gboolean
+sg_virtual_signature_equal (MonoMethod *ma, MonoMethod *mb, gboolean *unresolved)
+{
+	ERROR_DECL (ea);
+	ERROR_DECL (eb);
+	MonoMethodSignature *sa = mono_method_signature_checked (ma, ea);
+	MonoMethodSignature *sb = mono_method_signature_checked (mb, eb);
+	*unresolved = FALSE;
+	if (sa && sb)
+		return mono_metadata_signature_equal (sa, sb);
+	mono_error_cleanup (ea);
+	mono_error_cleanup (eb);
+	*unresolved = TRUE;
+#ifdef SG_MUTANT_VTABLE_SIG_EAGER
+	return FALSE;
+#else
+	return sg_method_metadata_signature_equal (ma, mb);
+#endif
+}
