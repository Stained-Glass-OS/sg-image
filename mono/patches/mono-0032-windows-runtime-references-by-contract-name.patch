+#ifndef SG_MUTANT_WINRT_CONTRACTS_UNRESOLVED
+		if (!result && strcmp (aname->name, "Windows")) {
+			fullpath = g_build_filename (mono_assembly_getrootdir (), "mono", "4.5", "WinMetadata", "Windows.winmd", (const char*)NULL);
+			result = mono_assembly_request_open (fullpath, &req, status);
+			g_free (fullpath);
+		}
+#endif
 		if (result) {
