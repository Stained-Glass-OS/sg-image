 		result = mono_assembly_request_open (fullpath, &req, status);
 		g_free (fullpath);
+		/* The CLR finds a Windows Runtime type by its namespace in the
+		 * system's metadata (RoResolveNamespace), whatever assembly name the
+		 * reference has: programs built against the Windows SDK's contract
+		 * assemblies (Microsoft.Windows.SDK.Contracts) name
+		 * "Windows.Foundation.UniversalApiContract, Version=14.0.0.0",
+		 * "Windows.Foundation.FoundationContract",
+		 * "Windows.Services.Store.StoreContract" and so on. Our system
