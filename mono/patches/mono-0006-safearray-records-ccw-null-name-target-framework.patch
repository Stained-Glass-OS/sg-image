+/* The IRecordInfo of a blittable structure, which a SAFEARRAY(VT_RECORD) of it carries: oleaut32 sizes,
+ * copies and clears the elements through it, and the receiver can ask the record's GUID and name. */
+typedef struct {
+	IRecordInfo iface;
+	LONG ref;
+	ULONG size;
+	GUID guid;
+	gunichar2 *name;
+} MonoRecordInfo;
+
+static const IID record_info_iid_unknown = {0x00000000, 0x0000, 0x0000, {0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46}};
+static const IID record_info_iid = {0x0000002F, 0x0000, 0x0000, {0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46}};
+
+static MonoRecordInfo *
+record_info_impl (IRecordInfo *iface)
+{
+	return (MonoRecordInfo *)iface;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_QueryInterface (IRecordInfo *iface, REFIID riid, void **obj)
+{
+	if (!memcmp (riid, &record_info_iid_unknown, sizeof (IID)) || !memcmp (riid, &record_info_iid, sizeof (IID))) {
+		*obj = iface;
+		iface->lpVtbl->AddRef (iface);
+		return S_OK;
+	}
+	*obj = NULL;
+	return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE
+record_info_AddRef (IRecordInfo *iface)
+{
+	return InterlockedIncrement (&record_info_impl (iface)->ref);
+}
+
+static ULONG STDMETHODCALLTYPE
+record_info_Release (IRecordInfo *iface)
+{
+	MonoRecordInfo *info = record_info_impl (iface);
+	ULONG ref = InterlockedDecrement (&info->ref);
+	if (!ref) {
+		g_free (info->name);
+		g_free (info);
+	}
+	return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_RecordInit (IRecordInfo *iface, PVOID data)
+{
+	if (!data)
+		return E_INVALIDARG;
+	memset (data, 0, record_info_impl (iface)->size);
+	return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_RecordClear (IRecordInfo *iface, PVOID data)
+{
+	/* a blittable structure holds nothing to release */
+	return data ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_RecordCopy (IRecordInfo *iface, PVOID src, PVOID dst)
+{
+	if (!src || !dst)
