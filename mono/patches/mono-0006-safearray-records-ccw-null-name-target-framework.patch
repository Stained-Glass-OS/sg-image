+static IRecordInfo *
+record_info_new (MonoClass *klass)
+{
+	MonoRecordInfo *info = g_new0 (MonoRecordInfo, 1);
+	info->iface.lpVtbl = &record_info_vtbl;
+	info->ref = 1;
+	info->size = mono_class_value_size (klass, NULL);
