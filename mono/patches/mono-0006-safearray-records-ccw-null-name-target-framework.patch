+	memmove (dst, src, record_info_impl (iface)->size);
+	return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_GetGuid (IRecordInfo *iface, GUID *guid)
+{
+	if (!guid)
+		return E_INVALIDARG;
+	*guid = record_info_impl (iface)->guid;
+	return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_GetName (IRecordInfo *iface, BSTR *name)
+{
+	if (!name)
+		return E_INVALIDARG;
+	*name = SysAllocString ((OLECHAR *)record_info_impl (iface)->name);
+	return *name ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_GetSize (IRecordInfo *iface, ULONG *size)
+{
+	if (!size)
+		return E_INVALIDARG;
+	*size = record_info_impl (iface)->size;
+	return S_OK;
+}
+
