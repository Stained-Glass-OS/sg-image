+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_PutFieldNoCopy (IRecordInfo *iface, ULONG flags, PVOID data, LPCOLESTR name, VARIANT *field)
+{
+	return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_GetFieldNames (IRecordInfo *iface, ULONG *count, BSTR *names)
+{
+	return E_NOTIMPL;
+}
+
+static BOOL STDMETHODCALLTYPE
+record_info_IsMatchingType (IRecordInfo *iface, IRecordInfo *other)
+{
+	GUID guid;
+	if (!other)
+		return FALSE;
+	if (other == iface)
+		return TRUE;
+	return SUCCEEDED (other->lpVtbl->GetGuid (other, &guid)) && !memcmp (&guid, &record_info_impl (iface)->guid, sizeof (GUID));
+}
+
+static PVOID STDMETHODCALLTYPE
+record_info_RecordCreate (IRecordInfo *iface)
+{
+	PVOID data = CoTaskMemAlloc (record_info_impl (iface)->size);
+	if (data)
+		record_info_RecordInit (iface, data);
+	return data;
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_RecordCreateCopy (IRecordInfo *iface, PVOID src, PVOID *dst)
+{
+	if (!src || !dst)
+		return E_INVALIDARG;
+	if (!(*dst = record_info_RecordCreate (iface)))
+		return E_OUTOFMEMORY;
+	return record_info_RecordCopy (iface, src, *dst);
+}
+
+static HRESULT STDMETHODCALLTYPE
+record_info_RecordDestroy (IRecordInfo *iface, PVOID data)
+{
+	CoTaskMemFree (data);
+	return S_OK;
+}
