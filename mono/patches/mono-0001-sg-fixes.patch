diff --git a/mcs/class/corlib/System/Environment.cs b/mcs/class/corlib/System/Environment.cs
index aac713c4..d5f9da95 100644
--- a/mcs/class/corlib/System/Environment.cs
+++ b/mcs/class/corlib/System/Environment.cs
@@ -350,8 +350,38 @@ public static string UserDomainName {
 		/// Gets a flag indicating whether the process is in interactive mode
 		/// </summary>
 		[MonoTODO ("Currently always returns false, regardless of interactive state")]
+		// Stained Glass OS: as .NET decides it on Windows -- false when the
+		// process's window station is not visible (a service's). A .NET
+		// service that runs as a console program when UserInteractive
+		// (athenaNet Device Manager's) otherwise waited for a key it never
+		// got and stopped.
+		[StructLayout (LayoutKind.Sequential)]
+		struct USEROBJECTFLAGS {
+			public int fInherit;
+			public int fReserved;
+			public int dwFlags;
+		}
+
+		[DllImport ("user32.dll")]
+		static extern IntPtr GetProcessWindowStation ();
+
+		[DllImport ("user32.dll")]
+		static extern bool GetUserObjectInformationW (IntPtr hObj, int nIndex, ref USEROBJECTFLAGS pvInfo, int nLength, out int lpnLengthNeeded);
+
 		public static bool UserInteractive {
 			get {
+				const int UOI_FLAGS = 1, WSF_VISIBLE = 1;
+				if (!IsRunningOnWindows)
+					return true;
+				try {
+					IntPtr winsta = GetProcessWindowStation ();
+					USEROBJECTFLAGS flags = new USEROBJECTFLAGS ();
+					int needed;
+					if (winsta != IntPtr.Zero &&
+					    GetUserObjectInformationW (winsta, UOI_FLAGS, ref flags, Marshal.SizeOf (flags), out needed))
+						return (flags.dwFlags & WSF_VISIBLE) != 0;
+				} catch (Exception) {
+				}
 				return true;
 			}
 		}
