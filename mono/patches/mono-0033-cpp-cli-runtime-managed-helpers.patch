diff --git a/mcs/class/corlib/Mono.Interop/CrtImplementationDetails.cs b/mcs/class/corlib/Mono.Interop/CrtImplementationDetails.cs
new file mode 100644
--- /dev/null
+++ b/mcs/class/corlib/Mono.Interop/CrtImplementationDetails.cs
@@ -0,0 +1,115 @@
+//
+// Stained Glass OS: the managed half of the C++/CLI runtime (msvcm80/msvcm90)
+// a mixed-mode assembly built by Visual C++ 2005/2008 (/clr) calls. Its
+// module initialization code imports these from msvcm80/90.dll:
+//
+//   <CrtImplementationDetails>::RegisterModuleUninitializer(EventHandler^)
+//   <CrtImplementationDetails>::ThrowModuleLoadException(String^[, Exception^])
+//   <CrtImplementationDetails>::ThrowNestedModuleLoadException(Exception^, Exception^)
+//
+// On Windows those are managed functions of msvcm80/90 (a mixed-mode
+// assembly); Wine's msvcm80/90 are native and cannot take a managed handler
+// or raise a managed exception. The runtime (marshal.c) calls these instead,
+// as the CLR would reach msvcm's own:
+//   - a module's uninitializer (its C++ static destructors) is run once when
+//     the application domain unloads or the process exits, the modules
+//     registered last first;
+//   - a module whose initialization failed raises ModuleLoadException, with
+//     the error that caused it.
+//
+// Copyright (C) 2026 Stained Glass OS contributors. MIT license, as Wine Mono.
+//
+
+using System;
+using System.Collections.Generic;
+using System.Runtime.CompilerServices;
+
+namespace Mono.Interop
+{
+	internal static class CrtImplementationDetails
+	{
+		// per application domain, as each domain initializes its own copy
+		// of a mixed-mode module
+		static List<EventHandler> uninitializers;
+		static readonly object sync = new object ();
+
+		internal static void RegisterModuleUninitializer (EventHandler handler)
+		{
+			lock (sync) {
+				if (uninitializers == null) {
+					uninitializers = new List<EventHandler> ();
+					AppDomain.CurrentDomain.DomainUnload += RunUninitializers;
+					AppDomain.CurrentDomain.ProcessExit += RunUninitializers;
+				}
+				RuntimeHelpers.PrepareDelegate (handler);
+				uninitializers.Add (handler);
+			}
+		}
+
+		static void RunUninitializers (object source, EventArgs arguments)
+		{
+			EventHandler[] handlers;
+			lock (sync) {
+				if (uninitializers == null || uninitializers.Count == 0)
+					return;
+				handlers = uninitializers.ToArray ();
+				uninitializers.Clear ();
+				Array.Reverse (handlers); /* the last registered first */
+			}
+			foreach (EventHandler h in handlers)
+				h (source, arguments);
+		}
+
+		internal static void ThrowModuleLoadException (string errorMessage)
+		{
+			throw new ModuleLoadException (errorMessage);
+		}
+
+		internal static void ThrowModuleLoadException (string errorMessage, Exception innerException)
+		{
+			throw new ModuleLoadException (errorMessage, innerException);
+		}
+
+		internal static void ThrowNestedModuleLoadException (Exception innerException, Exception nestedException)
+		{
+			throw new ModuleLoadExceptionHandlerException (
+				"A nested exception occurred after the primary exception that caused the C++ module to fail to load.\n",
+				innerException, nestedException);
+		}
+	}
+
+	// <CrtImplementationDetails>.ModuleLoadException in msvcm80/90
+	[Serializable]
+	internal class ModuleLoadException : Exception
+	{
+		public const string Nested = "A nested exception occurred after the primary exception that caused the C++ module to fail to load.\n";
+
+		public ModuleLoadException (string message) : base (message)
+		{
+		}
+
+		public ModuleLoadException (string message, Exception innerException) : base (message, innerException)
+		{
+		}
+	}
+
+	// <CrtImplementationDetails>.ModuleLoadExceptionHandlerException
+	[Serializable]
+	internal sealed class ModuleLoadExceptionHandlerException : ModuleLoadException
+	{
+		public ModuleLoadExceptionHandlerException (string message, Exception innerException, Exception nestedException)
+			: base (message, innerException)
+		{
+			NestedException = nestedException;
+		}
+
+		public Exception NestedException { get; set; }
+
+		public override string ToString ()
+		{
+			string inner = InnerException != null ? InnerException.ToString () : string.Empty;
+			string nested = NestedException != null ? NestedException.ToString () : string.Empty;
+			return GetType ().ToString () + ": " + Message + "\n" + inner + "\n" + nested;
+		}
+	}
+}
