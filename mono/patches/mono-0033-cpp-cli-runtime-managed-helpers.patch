  */
+/*
+ * Stained Glass OS: the C++/CLI runtime's managed helpers. A mixed-mode
+ * assembly built by Visual C++ 2005/2008 (/clr) imports
+ * <CrtImplementationDetails>::RegisterModuleUninitializer(EventHandler^),
+ * ThrowModuleLoadException(String^[, Exception^]) and
+ * ThrowNestedModuleLoadException(Exception^, Exception^) from msvcm80/90.dll
+ * as native methods of its <Module>. They are managed functions of msvcm on
+ * Windows; Wine's msvcm80/90 are native, could only drop the handler and
+ * cannot raise the exception, so a call goes to corlib's
+ * Mono.Interop.CrtImplementationDetails with the managed arguments as they are.
+ */
+static MonoMethod *
+sg_crt_implementation_details_method (MonoMethod *method)
+{
+#ifndef SG_MUTANT_MSVCM_HELPERS_NATIVE
+	static const char prefix[] = "<CrtImplementationDetails>.";
+	MonoMethodSignature *sig;
+	MonoClass *klass;
+	const char *name;
+	gpointer iter = NULL;
+	MonoMethod *m;
+
+	/* a global method of the module (its native code is an import of msvcm) */
+	if (!(method->flags & METHOD_ATTRIBUTE_PINVOKE_IMPL) || m_class_get_type_token (method->klass) != (MONO_TOKEN_TYPE_DEF | 1))
+		return NULL;
+	if (strncmp (method->name, prefix, sizeof (prefix) - 1))
+		return NULL;
+	name = method->name + sizeof (prefix) - 1;
+	if (strcmp (name, "RegisterModuleUninitializer") && strcmp (name, "ThrowModuleLoadException") &&
+	    strcmp (name, "ThrowNestedModuleLoadException"))
+		return NULL;
+	sig = mono_method_signature_internal (method);
+	if (!sig || sig->hasthis || sig->ret->type != MONO_TYPE_VOID)
+		return NULL;
+	klass = mono_class_try_load_from_name (mono_defaults.corlib, "Mono.Interop", "CrtImplementationDetails");
+	if (!klass)
+		return NULL;
+	while ((m = mono_class_get_methods (klass, &iter))) {
+		MonoMethodSignature *msig = mono_method_signature_internal (m);
+		int i;
+		if (strcmp (m->name, name) || !msig || msig->param_count != sig->param_count)
+			continue;
+		for (i = 0; i < sig->param_count; i++)
+			if (mono_class_from_mono_type_internal (sig->params [i]) != mono_class_from_mono_type_internal (msig->params [i]))
+				break;
+		if (i == sig->param_count)
+			return m;
+	}
+#endif
+	return NULL;
+}
