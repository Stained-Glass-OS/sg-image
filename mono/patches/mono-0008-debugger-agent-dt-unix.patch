diff --git a/mono/mini/debugger-agent.c b/mono/mini/debugger-agent.c
index a9a24e6e..5b5628fb 100644
--- a/mono/mini/debugger-agent.c
+++ b/mono/mini/debugger-agent.c
@@ -1470,6 +1470,151 @@ register_socket_fd_transport (void)
 
 #endif /* DISABLE_SOCKET_TRANSPORT */
 
+#ifdef HOST_WIN32
+/*
+ * Stained Glass OS: the 'dt_unix' transport (Wine Mono under wine-sg 7791).
+ *
+ * The agent runs whatever the debugger asks in this process, so only the
+ * user's own processes may reach it. Wine's sgdbgsock.dll gives it a Unix
+ * socket in the user's runtime directory ($XDG_RUNTIME_DIR/wine-mono-debug/
+ * ADDRESS.sock), the user's alone (0700/0600), on which each end takes a
+ * connection from the same user only (SO_PEERCRED). It is the only transport
+ * of this build: no TCP, not even on loopback, which every local user can
+ * reach. ADDRESS is a name (letters, digits, '-', '_'): Wine's mscoree gives
+ * the process id for a server.
+ */
+typedef BOOL (WINAPI *SgDbgListenFunc) (const char *name, guint64 *listener);
+typedef BOOL (WINAPI *SgDbgAcceptFunc) (guint64 listener, guint64 *conn);
+typedef BOOL (WINAPI *SgDbgConnectFunc) (const char *name, guint64 *conn);
+typedef int (WINAPI *SgDbgSendFunc) (guint64 conn, const void *buf, int len);
+typedef int (WINAPI *SgDbgRecvFunc) (guint64 conn, void *buf, int len);
+typedef void (WINAPI *SgDbgShutdownFunc) (guint64 conn, int how);
+typedef void (WINAPI *SgDbgCloseFunc) (guint64 conn);
+
+static SgDbgListenFunc sgdbg_listen;
+static SgDbgAcceptFunc sgdbg_accept;
+static SgDbgConnectFunc sgdbg_connect;
+static SgDbgSendFunc sgdbg_send;
+static SgDbgRecvFunc sgdbg_recv;
+static SgDbgShutdownFunc sgdbg_shutdown;
+static SgDbgCloseFunc sgdbg_close;
+static guint64 unix_conn, unix_listener;
+static gboolean unix_connected, unix_listening;
+
+/* present in a Wine Mono that has the dt_unix transport (mscoree asks before using it) */
+MONO_API int
+mono_sg_debugger_unix_transport (void);
+
+int
+mono_sg_debugger_unix_transport (void)
+{
+	return 1;
+}
+
+static gboolean
+unix_transport_load (void)
+{
+	HMODULE dll = LoadLibraryW (L"sgdbgsock.dll");
+
+	if (!dll)
+		return FALSE;
+	sgdbg_listen = (SgDbgListenFunc) GetProcAddress (dll, "SgDbgListen");
+	sgdbg_accept = (SgDbgAcceptFunc) GetProcAddress (dll, "SgDbgAccept");
+	sgdbg_connect = (SgDbgConnectFunc) GetProcAddress (dll, "SgDbgConnect");
+	sgdbg_send = (SgDbgSendFunc) GetProcAddress (dll, "SgDbgSend");
+	sgdbg_recv = (SgDbgRecvFunc) GetProcAddress (dll, "SgDbgRecv");
+	sgdbg_shutdown = (SgDbgShutdownFunc) GetProcAddress (dll, "SgDbgShutdown");
+	sgdbg_close = (SgDbgCloseFunc) GetProcAddress (dll, "SgDbgClose");
+	return sgdbg_listen && sgdbg_accept && sgdbg_connect && sgdbg_send && sgdbg_recv && sgdbg_shutdown && sgdbg_close;
+}
+
+static void
+unix_transport_connect (const char *address)
+{
+	guint64 listener;
+
+	if (!address || !address [0]) {
+		PRINT_ERROR_MSG ("debugger-agent: the dt_unix transport needs an address (a socket name).\n");
+		exit (1);
+	}
+	if (!unix_transport_load ()) {
+		PRINT_ERROR_MSG ("debugger-agent: sgdbgsock.dll is missing: no dt_unix transport.\n");
+		exit (1);
+	}
+	if (agent_config.server) {
+		PRINT_DEBUG_MSG (1, "Listening on the user's socket '%s'...\n", address);
+		if (!sgdbg_listen (address, &listener)) {
+			PRINT_ERROR_MSG ("debugger-agent: cannot listen on the user's socket '%s'.\n", address);
+			exit (1);
+		}
+		if (agent_config.defer) {
+			/* server=y,suspend=n: the program runs, the debugger thread waits for an attach */
+			unix_listener = listener;
+			unix_listening = TRUE;
+			return;
+		}
+		/* blocks; another user's connection is closed unanswered */
+		if (!sgdbg_accept (listener, &unix_conn)) {
+			PRINT_ERROR_MSG ("debugger-agent: accept on '%s' failed.\n", address);
+			exit (1);
+		}
+	} else if (!sgdbg_connect (address, &unix_conn)) {
+		PRINT_ERROR_MSG ("debugger-agent: cannot connect to the debugger's socket '%s'.\n", address);
+		exit (1);
+	}
+	unix_connected = TRUE;
+	PRINT_DEBUG_MSG (1, "Accepted connection on the user's socket.\n");
+	if (!transport_handshake ())
+		exit (1);
+}
+
+static gboolean
+unix_transport_send (void *buf, int len)
+{
+	return unix_connected && sgdbg_send (unix_conn, buf, len) == len;
+}
+
+static int
+unix_transport_recv (void *buf, int len)
+{
+	if (!unix_connected)
+		return -1;
+	return sgdbg_recv (unix_conn, buf, len);
+}
+
+static void
+unix_transport_close1 (void)
+{
+	if (unix_connected)
+		sgdbg_shutdown (unix_conn, 0);
+}
+
+static void
+unix_transport_close2 (void)
+{
+	if (!unix_connected)
+		return;
+	unix_connected = FALSE;
+	sgdbg_shutdown (unix_conn, 2);
+	sgdbg_close (unix_conn);
+}
+
+static void
+register_unix_transport (void)
+{
+	DebuggerTransport trans;
+
+	trans.name = "dt_unix";
+	trans.connect = unix_transport_connect;
+	trans.close1 = unix_transport_close1;
+	trans.close2 = unix_transport_close2;
+	trans.send = unix_transport_send;
+	trans.recv = unix_transport_recv;
+
+	register_transport (&trans);
+}
+#endif /* HOST_WIN32 */
+
 /*
  * TRANSPORT CODE
  */
@@ -1504,7 +1649,11 @@ transport_init (void)
 {
 	int i;
 
-#ifndef DISABLE_SOCKET_TRANSPORT
+#ifdef HOST_WIN32
+	/* Stained Glass OS: Wine Mono's one transport is the user's own Unix
+	 * socket; TCP is never offered (wine-sg 7791) */
+	register_unix_transport ();
+#elif !defined(DISABLE_SOCKET_TRANSPORT)
 	register_socket_transport ();
 	register_socket_fd_transport ();
 #endif
@@ -10097,6 +10246,19 @@ cmd_to_string (CommandSet set, int command)
 static gboolean
 wait_for_attach (void)
 {
+#ifdef HOST_WIN32
+	/* Stained Glass OS: dt_unix (wine-sg 7791) */
+	if (unix_listening) {
+		unix_listening = FALSE;
+		if (!sgdbg_accept (unix_listener, &unix_conn)) {
+			PRINT_DEBUG_MSG (1, "[dbg] accept on the user's socket failed\n");
+			return FALSE;
+		}
+		unix_connected = TRUE;
+		PRINT_DEBUG_MSG (1, "Accepted connection on the user's socket.\n");
+	} else
+#endif
+	{
 #ifndef DISABLE_SOCKET_TRANSPORT
 	if (listen_fd == -1) {
 		PRINT_DEBUG_MSG (1, "[dbg] Invalid listening socket\n");
@@ -10114,6 +10276,7 @@ wait_for_attach (void)
 #else
 	g_assert_not_reached ();
 #endif
+	}
 
 	/* Handshake */
 	disconnected = !transport_handshake ();
