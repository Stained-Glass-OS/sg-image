+	[Guid ("9de1c534-6ae1-11e0-84e1-18a905bcc53f")]
+	public delegate void TypedEventHandler<TSender, TResult> (TSender sender, TResult args);
+
+	// a system asynchronous operation (IAsyncOperation<T> + IAsyncInfo)
+	// seen as the projected interface; result turns the result pointer the
+	// operation gives into its projected value
+	internal sealed class NativeAsyncOperation<TResult> : IAsyncOperation<TResult>
+	{
+		readonly RtRef op;
+		readonly Guid handlerIid;
+		readonly Func<IntPtr, TResult> result;
+		AsyncOperationCompletedHandler<TResult> completed;
+
+		// resultSig: the Windows Runtime type signature of TResult
+		internal NativeAsyncOperation (IntPtr ptr, string resultSig, Func<IntPtr, TResult> result)
+		{
+			op = new RtRef (ptr);
+			handlerIid = Rt.ParameterizedIid (Rt.PInterface (Rt.AsyncOperationCompletedHandler1, resultSig));
+			this.result = result;
+		}
+
+		public AsyncOperationCompletedHandler<TResult> Completed {
+			get { return completed; }
+			set {
+				// as on Windows, a completion handler may be set only once
+				if (completed != null)
+					throw Rt.ExceptionFor (unchecked ((int)0x80000018));
+				completed = value;
+				if (value == null)
+					return;
+				IntPtr h = NativeDelegate.ForStatus (handlerIid, (info, status) => value (this, (AsyncStatus)status));
+				try {
+					Rt.CallP (op.Ptr, Rt.First, h);
+				} finally {
+					Marshal.Release (h);
+				}
+			}
+		}
+
+		public TResult GetResults ()
+		{
+			return result (Rt.GetP (op.Ptr, Rt.First + 2));
+		}
+
+		public Exception ErrorCode {
+			get {
+				int hr = Rt.With (op, Rt.IID_IAsyncInfo, i => Rt.GetInt (i, Rt.First + 2));
+				return hr < 0 ? Rt.ExceptionFor (hr) : null;
+			}
+		}
+
+		public uint Id {
+			get { return (uint)Rt.With (op, Rt.IID_IAsyncInfo, i => Rt.GetInt (i, Rt.First)); }
+		}
+
+		public AsyncStatus Status {
+			get { return (AsyncStatus)Rt.With (op, Rt.IID_IAsyncInfo, i => Rt.GetInt (i, Rt.First + 1)); }
+		}
+
+		public void Cancel ()
+		{
+			Rt.With (op, Rt.IID_IAsyncInfo, i => Rt.Call (i, Rt.First + 3));
+		}
+
+		public void Close ()
+		{
+			Rt.With (op, Rt.IID_IAsyncInfo, i => Rt.Call (i, Rt.First + 4));
+		}
+	}
+}
