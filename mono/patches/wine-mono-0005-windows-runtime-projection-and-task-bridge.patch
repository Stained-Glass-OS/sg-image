@@ -0,0 +1,12 @@
+// Stained Glass OS: the asynchronous operation's own error, as it is: Wine's
+// operations set no restricted error information on the thread.
+namespace System.Runtime.InteropServices.WindowsRuntime
+{
+	internal static class RestrictedErrorInfoHelper
+	{
+		internal static Exception AttachRestrictedErrorInfo (Exception e)
+		{
+			return e;
+		}
+	}
+}
