diff --git a/sg-winmd/System.Runtime.WindowsRuntime/AssemblyInfo.cs b/sg-winmd/System.Runtime.WindowsRuntime/AssemblyInfo.cs
new file mode 100644
--- /dev/null
+++ b/sg-winmd/System.Runtime.WindowsRuntime/AssemblyInfo.cs
@@ -0,0 +1,12 @@
+// Stained Glass OS: System.Runtime.WindowsRuntime for .NET Framework programs
+// that call Windows Runtime asynchronous methods (AsTask, await on
+// IAsyncOperation, AsAsyncAction): .NET Framework's assembly of that name,
+// built from corefx's sources (MIT) against our Windows.winmd. Strong-named
+// with the ECMA key, as Mono's framework assemblies, so mscorlib's
+// InternalsVisibleTo applies and programs' references bind to it.
+using System.Reflection;
+[assembly: AssemblyVersion ("4.0.0.0")]
+[assembly: AssemblyFileVersion ("4.0.0.0")]
+[assembly: AssemblyTitle ("System.Runtime.WindowsRuntime")]
+[assembly: AssemblyDelaySign (true)]
+[assembly: System.CLSCompliant (true)]
