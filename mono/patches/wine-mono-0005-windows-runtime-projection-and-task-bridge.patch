diff --git a/sg-winmd/WinRT.Interop.cs b/sg-winmd/WinRT.Interop.cs
new file mode 100644
--- /dev/null
+++ b/sg-winmd/WinRT.Interop.cs
@@ -0,0 +1,590 @@
+// Stained Glass OS: how the types of the "Windows" metadata assembly reach
+// the system's Windows Runtime classes. On Windows the CLR projects a Windows
+// Runtime class as a runtime callable wrapper over the object the system
+// activates (RoGetActivationFactory / RoActivateInstance in combase); a
+// method call is a call through one of the object's interfaces, an HRESULT
+// becomes an exception, an HSTRING a string, a delegate passed for an event
+// or a completion a COM object the system calls back. Mono has no Windows
+// Runtime projection, so this assembly's classes do the same by hand: each
+// wraps the system object's interface pointer and calls its vtable.
+//
+// Copyright (C) 2026 Stained Glass OS contributors. MIT license, as Wine Mono.
+
+using System;
+using System.Collections.Generic;
+using System.Runtime.InteropServices;
+using System.Runtime.InteropServices.WindowsRuntime;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace Windows.Internal
+{
+	// a reference to a Windows Runtime object's default interface, held by
+	// the projected class that wraps it and released when that is collected
+	internal sealed class RtRef
+	{
+		internal IntPtr Ptr;
+
+		internal RtRef (IntPtr ptr)
+		{
+			Ptr = ptr;
+		}
+
+		~RtRef ()
+		{
+			IntPtr p = Ptr;
+			Ptr = IntPtr.Zero;
+			if (p != IntPtr.Zero)
+				Marshal.Release (p);
+		}
+
+		// another interface of the object (AddRef'd), or zero when it has none
+		internal IntPtr As (Guid iid)
+		{
+			IntPtr r;
+			return Marshal.QueryInterface (Ptr, ref iid, out r) == 0 ? r : IntPtr.Zero;
+		}
+
+		// another interface the object must have: InvalidCastException
+		// otherwise, as a cast of a runtime callable wrapper that fails
+		internal IntPtr Must (Guid iid)
+		{
+			IntPtr r = As (iid);
+			if (r == IntPtr.Zero)
+				throw new InvalidCastException (string.Format (
+					"Unable to cast the Windows Runtime object to an interface it does not have ({0}).",
+					iid.ToString ("B")));
+			return r;
+		}
+	}
+
+	internal static class Rt
+	{
+		internal const int S_OK = 0;
+		internal const int E_NOINTERFACE = unchecked ((int)0x80004002);
+		internal const int CO_E_NOTINITIALIZED = unchecked ((int)0x800401F0);
+		internal const int REGDB_E_CLASSNOTREG = unchecked ((int)0x80040154);
+		internal static readonly Guid IID_IUnknown = new Guid ("00000000-0000-0000-C000-000000000046");
+		internal static readonly Guid IID_IInspectable = new Guid ("AF86E2E0-B12D-4c6a-9C5A-D7AA65101E90");
+		internal static readonly Guid IID_IAgileObject = new Guid ("94ea2b94-e9cc-49e0-c0ff-ee64ca8f5b90");
+		internal static readonly Guid IID_IActivationFactory = new Guid ("00000035-0000-0000-C000-000000000046");
+		internal static readonly Guid IID_IAsyncInfo = new Guid ("00000036-0000-0000-C000-000000000046");
+
+		// the first method after IUnknown's and IInspectable's
+		internal const int First = 6;
+
+		[DllImport ("combase.dll")]
+		static extern int RoGetActivationFactory (IntPtr activatableClassId, ref Guid iid, out IntPtr factory);
+		[DllImport ("combase.dll")]
+		static extern int RoActivateInstance (IntPtr activatableClassId, out IntPtr instance);
+		[DllImport ("combase.dll", CharSet = CharSet.Unicode)]
+		static extern int WindowsCreateString (string sourceString, int length, out IntPtr hstring);
+		[DllImport ("combase.dll")]
+		static extern int WindowsDeleteString (IntPtr hstring);
+		[DllImport ("combase.dll")]
+		static extern IntPtr WindowsGetStringRawBuffer (IntPtr hstring, out int length);
+		[DllImport ("ole32.dll")]
+		static extern int CoInitializeEx (IntPtr reserved, int coinit);
+
+		// ---- HSTRINGs ----
+
+		internal static IntPtr HString (string s)
+		{
+			if (string.IsNullOrEmpty (s))
+				return IntPtr.Zero;
+			IntPtr h;
+			Check (WindowsCreateString (s, s.Length, out h));
+			return h;
+		}
+
+		internal static void Free (IntPtr hstring)
+		{
+			if (hstring != IntPtr.Zero)
+				WindowsDeleteString (hstring);
+		}
+
+		// an HSTRING the callee gave us: read and deleted
+		internal static string TakeString (IntPtr hstring)
+		{
+			if (hstring == IntPtr.Zero)
+				return string.Empty;
+			int len;
+			IntPtr buf = WindowsGetStringRawBuffer (hstring, out len);
+			string s = buf == IntPtr.Zero ? string.Empty : Marshal.PtrToStringUni (buf, len);
+			WindowsDeleteString (hstring);
+			return s;
+		}
+
+		// ---- activation ----
+
+		// a thread that has not initialized COM gets the multithreaded
+		// apartment, as the CLR gives a thread at its first COM call
+		static int Retry (int hr)
+		{
+			if (hr == CO_E_NOTINITIALIZED)
+				CoInitializeEx (IntPtr.Zero, 0 /* COINIT_MULTITHREADED */);
+			return hr;
+		}
+
+		internal static IntPtr Factory (string className, Guid iid)
+		{
+			IntPtr h = HString (className), f;
+			try {
+				int hr = RoGetActivationFactory (h, ref iid, out f);
+				if (Retry (hr) == CO_E_NOTINITIALIZED)
+					hr = RoGetActivationFactory (h, ref iid, out f);
+				Check (hr);
+				return f;
+			} finally {
+				Free (h);
+			}
+		}
+
+		internal static IntPtr Activate (string className)
+		{
+			IntPtr h = HString (className), o;
+			try {
+				int hr = RoActivateInstance (h, out o);
+				if (Retry (hr) == CO_E_NOTINITIALIZED)
+					hr = RoActivateInstance (h, out o);
+				Check (hr);
+				return o;
+			} finally {
+				Free (h);
+			}
+		}
+
+		internal static IntPtr QI (IntPtr p, Guid iid)
+		{
+			IntPtr r;
+			return p != IntPtr.Zero && Marshal.QueryInterface (p, ref iid, out r) == 0 ? r : IntPtr.Zero;
+		}
+
+		// ---- HRESULTs: the CLR's mapping, with the Windows Runtime's codes ----
+
+		sealed class RtInvalidOperationException : InvalidOperationException
+		{
+			public RtInvalidOperationException (string message, int hr) : base (message) { HResult = hr; }
+		}
+
+		sealed class RtObjectDisposedException : ObjectDisposedException
+		{
+			public RtObjectDisposedException (string message, int hr) : base (null, message) { HResult = hr; }
+		}
+
+		sealed class RtArgumentOutOfRangeException : ArgumentOutOfRangeException
+		{
+			public RtArgumentOutOfRangeException (string message, int hr) : base (null, message) { HResult = hr; }
+		}
+
+		internal static Exception ExceptionFor (int hr)
+		{
+			string msg = string.Format ("Exception from HRESULT: 0x{0:X8}", hr);
+#if SG_MUTANT_WINRT_HRESULTS_AS_COMEXCEPTION
+			return new COMException (msg, hr);
+#endif
+			switch ((uint)hr) {
+			case 0x80073D54: /* APPMODEL_ERROR_NO_PACKAGE */
+				return new RtInvalidOperationException ("The process has no package identity. (" + msg + ")", hr);
+			case 0x8000000D: /* E_ILLEGAL_STATE_CHANGE */
+			case 0x8000000E: /* E_ILLEGAL_METHOD_CALL */
+			case 0x80000018: /* E_ILLEGAL_DELEGATE_ASSIGNMENT */
+				return new RtInvalidOperationException (msg, hr);
+			case 0x80000013: /* RO_E_CLOSED */
+				return new RtObjectDisposedException (msg, hr);
+			case 0x8000000B: /* E_BOUNDS */
+				return new RtArgumentOutOfRangeException (msg, hr);
+			}
+			return Marshal.GetExceptionForHR (hr) ?? new COMException (msg, hr);
+		}
+
+		internal static void Check (int hr)
+		{
+			if (hr < 0)
+				throw ExceptionFor (hr);
+		}
+
+		// ---- vtable calls (slot numbers count IUnknown's and IInspectable's) ----
+
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int F0 (IntPtr self);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FP (IntPtr self, IntPtr a);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPP (IntPtr self, IntPtr a, IntPtr b);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPPP (IntPtr self, IntPtr a, IntPtr b, IntPtr c);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FB (IntPtr self, byte a);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FI (IntPtr self, int a);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FL (IntPtr self, long a);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FOP (IntPtr self, out IntPtr r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FOB (IntPtr self, out byte r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FOI (IntPtr self, out int r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FOL (IntPtr self, out long r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPOP (IntPtr self, IntPtr a, out IntPtr r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPOB (IntPtr self, IntPtr a, out byte r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPOL (IntPtr self, IntPtr a, out long r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPPOB (IntPtr self, IntPtr a, IntPtr b, out byte r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPPOI (IntPtr self, IntPtr a, IntPtr b, out int r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPPPOI (IntPtr self, IntPtr a, IntPtr b, IntPtr c, out int r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPIOB (IntPtr self, IntPtr a, int b, out byte r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPPIOB (IntPtr self, IntPtr a, IntPtr b, int c, out byte r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPIIOB (IntPtr self, IntPtr a, int b, int c, out byte r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FPLOP (IntPtr self, IntPtr a, long b, out IntPtr r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FLOP (IntPtr self, long a, out IntPtr r);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] internal delegate int FIOP (IntPtr self, int a, out IntPtr r);
+
+		internal static T Fn<T> (IntPtr itf, int slot) where T : class
+		{
+			if (itf == IntPtr.Zero)
+				throw new NullReferenceException ();
+			IntPtr vtbl = Marshal.ReadIntPtr (itf);
+			IntPtr fn = Marshal.ReadIntPtr (vtbl, slot * IntPtr.Size);
+			return Marshal.GetDelegateForFunctionPointer<T> (fn);
+		}
+
+		internal static void Call (IntPtr itf, int slot)
+		{
+			Check (Fn<F0> (itf, slot) (itf));
+		}
+
+		internal static void CallP (IntPtr itf, int slot, IntPtr a)
+		{
+			Check (Fn<FP> (itf, slot) (itf, a));
+		}
+
+		internal static IntPtr GetP (IntPtr itf, int slot)
+		{
+			IntPtr r;
+			Check (Fn<FOP> (itf, slot) (itf, out r));
+			return r;
+		}
+
+		internal static bool GetBool (IntPtr itf, int slot)
+		{
+			byte r;
+			Check (Fn<FOB> (itf, slot) (itf, out r));
+			return r != 0;
+		}
+
+		internal static int GetInt (IntPtr itf, int slot)
+		{
+			int r;
+			Check (Fn<FOI> (itf, slot) (itf, out r));
+			return r;
+		}
+
+		internal static long GetLong (IntPtr itf, int slot)
+		{
+			long r;
+			Check (Fn<FOL> (itf, slot) (itf, out r));
+			return r;
+		}
+
+		internal static string GetString (IntPtr itf, int slot)
+		{
+			return TakeString (GetP (itf, slot));
+		}
+
+		internal static void PutString (IntPtr itf, int slot, string value)
+		{
+			IntPtr h = HString (value);
+			try {
+				CallP (itf, slot, h);
+			} finally {
+				Free (h);
+			}
+		}
+
+		internal static void PutBool (IntPtr itf, int slot, bool value)
+		{
+			Check (Fn<FB> (itf, slot) (itf, (byte)(value ? 1 : 0)));
+		}
+
+		// a call through another interface of the object, released after
+		internal static void With (RtRef o, Guid iid, Action<IntPtr> call)
+		{
+			IntPtr itf = o.Must (iid);
+			try {
+				call (itf);
+			} finally {
+				Marshal.Release (itf);
+			}
+		}
+
+		internal static T With<T> (RtRef o, Guid iid, Func<IntPtr, T> call)
+		{
+			IntPtr itf = o.Must (iid);
+			try {
+				return call (itf);
+			} finally {
+				Marshal.Release (itf);
+			}
+		}
+
+		// ---- wrappers: one per system object, as the CLR keeps one RCW per identity ----
+
+		static readonly Dictionary<IntPtr, WeakReference> wrappers = new Dictionary<IntPtr, WeakReference> ();
+
+		// ptr: a reference the caller hands over (kept by the wrapper, or released)
+		internal static T Wrap<T> (IntPtr ptr, Func<RtRef, T> make) where T : class
+		{
+			if (ptr == IntPtr.Zero)
+				return null;
+			IntPtr id = QI (ptr, IID_IUnknown);
+			if (id == IntPtr.Zero)
+				return make (new RtRef (ptr));
+			Marshal.Release (id); /* the identity lives as long as ptr does */
+			lock (wrappers) {
+				WeakReference w;
+				T old;
+				if (wrappers.TryGetValue (id, out w) && (old = w.Target as T) != null) {
+					Marshal.Release (ptr);
+					return old;
+				}
+				T made = make (new RtRef (ptr));
+				wrappers [id] = new WeakReference (made);
+				if (wrappers.Count > 256)
+					Prune ();
+				return made;
+			}
+		}
+
+		// a wrapper made by a constructor (activated or made by a factory)
+		internal static void Register (object wrapper, IntPtr ptr)
+		{
+			IntPtr id = QI (ptr, IID_IUnknown);
+			if (id == IntPtr.Zero)
+				return;
+			Marshal.Release (id);
+			lock (wrappers)
+				wrappers [id] = new WeakReference (wrapper);
+		}
+
+		static void Prune ()
+		{
+			var dead = new List<IntPtr> ();
+			foreach (var kv in wrappers)
+				if (!kv.Value.IsAlive)
+					dead.Add (kv.Key);
+			foreach (var k in dead)
+				wrappers.Remove (k);
+		}
+
+		// a wrapper's own reference, AddRef'd for a native caller
+		internal static IntPtr Ref (RtRef o)
+		{
+			if (o == null)
+				return IntPtr.Zero;
+			Marshal.AddRef (o.Ptr);
+			return o.Ptr;
+		}
+
+		// ---- Windows.Foundation.DateTime: 100 ns since 1601 (UTC), as a FILETIME ----
+
+		internal static DateTimeOffset ToDateTimeOffset (long winrtTime)
+		{
+			return DateTimeOffset.FromFileTime (winrtTime);
+		}
+
+		internal static long FromDateTimeOffset (DateTimeOffset value)
+		{
+			return value.UtcDateTime.ToFileTimeUtc ();
+		}
+
+		// ---- EventRegistrationToken: a 64-bit value the event source hands out ----
+
+		internal static unsafe EventRegistrationToken Token (long value)
+		{
+			EventRegistrationToken t = default (EventRegistrationToken);
+			*(long*)&t = value;
+			return t;
+		}
+
+		internal static unsafe long TokenValue (EventRegistrationToken t)
+		{
+			return *(long*)&t;
+		}
+
+		// ---- parameterized interface ids (the Windows Runtime's type signatures) ----
+
+		static readonly byte[] pinterfaceNamespace = { 0x11, 0xf4, 0x7a, 0xd5, 0x7b, 0x73, 0x42, 0xc0, 0xab, 0xae, 0x87, 0x8b, 0x1e, 0x16, 0xad, 0xee };
+
+		internal static Guid ParameterizedIid (string signature)
+		{
+			byte[] sig = Encoding.UTF8.GetBytes (signature);
+			byte[] data = new byte [pinterfaceNamespace.Length + sig.Length];
+			Buffer.BlockCopy (pinterfaceNamespace, 0, data, 0, pinterfaceNamespace.Length);
+			Buffer.BlockCopy (sig, 0, data, pinterfaceNamespace.Length, sig.Length);
+			byte[] h;
+			using (var sha = SHA1.Create ())
+				h = sha.ComputeHash (data);
+#if !SG_MUTANT_WINRT_PIID_NO_VERSION
+			h [6] = (byte)((h [6] & 0x0f) | 0x50);
+			h [8] = (byte)((h [8] & 0x3f) | 0x80);
+#endif
+			return new Guid ((h [0] << 24) | (h [1] << 16) | (h [2] << 8) | h [3], (short)((h [4] << 8) | h [5]),
+				(short)((h [6] << 8) | h [7]), h [8], h [9], h [10], h [11], h [12], h [13], h [14], h [15]);
+		}
+
+		internal static string Sig (Guid g)
+		{
+			return g.ToString ("B").ToLowerInvariant ();
+		}
+
+		// rc(Class;{default interface})
+		internal static string ClassSig (string name, Guid defaultIid)
+		{
+			return "rc(" + name + ";" + Sig (defaultIid) + ")";
+		}
+
+		internal static string PInterface (Guid generic, params string[] args)
+		{
+			return "pinterface(" + Sig (generic) + ";" + string.Join (";", args) + ")";
+		}
+
+		internal const string InspectableSig = "cinterface(IInspectable)";
+		internal static readonly Guid TypedEventHandler2 = new Guid ("9de1c534-6ae1-11e0-84e1-18a905bcc53f");
+		internal static readonly Guid IAsyncOperation1 = new Guid ("9fc2b0bb-e446-44e2-aa61-9cab8f636af2");
+		internal static readonly Guid AsyncOperationCompletedHandler1 = new Guid ("fcdcf02c-e5d8-4478-915a-4d90b74b83a5");
+		internal static readonly Guid IVectorView1 = new Guid ("bbe1fa4c-b0e3-4583-baef-1f1b2e483e56");
+		internal static readonly Guid IReference1 = new Guid ("61c17706-2d65-11e0-9ae8-d48564015472");
+		internal static readonly Guid IID_IAsyncAction = new Guid ("5a648006-843a-4da9-865b-9d26e5dfad7b");
+		internal static readonly Guid IID_AsyncActionCompletedHandler = new Guid ("a4ed5c81-76c9-40bd-8be6-b1d90fb20ae7");
+
+		// ---- IVectorView<T>: GetAt, get_Size, IndexOf, GetMany ----
+
+		internal static List<T> ReadVectorView<T> (IntPtr view, Func<IntPtr, T> item)
+		{
+			var list = new List<T> ();
+			if (view == IntPtr.Zero)
+				return list;
+			try {
+				int n = GetInt (view, First + 1);
+				var getAt = Fn<FIOP> (view, First);
+				for (int i = 0; i < n; i++) {
+					IntPtr p;
+					Check (getAt (view, i, out p));
+					list.Add (item (p));
+				}
+			} finally {
+				Marshal.Release (view);
+			}
+			return list;
+		}
+	}
+
+	// A delegate handed to the system as a Windows Runtime delegate: a COM
+	// object with IUnknown and Invoke, answering the delegate's interface id
+	// (and IAgileObject: it may be called from any thread, as the CLR's
+	// delegate wrappers may).
+	internal sealed class NativeDelegate
+	{
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] delegate int QIFn (IntPtr self, ref Guid iid, out IntPtr obj);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] delegate int RefFn (IntPtr self);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] delegate int InvokePP (IntPtr self, IntPtr a, IntPtr b);
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)] delegate int InvokePI (IntPtr self, IntPtr a, int b);
+
+		static readonly QIFn qi = QueryInterface;
+		static readonly RefFn addref = AddRef, release = Release;
+		static readonly InvokePP invokePP = InvokeObjects;
+		static readonly InvokePI invokePI = InvokeStatus;
+		static readonly IntPtr vtblPP = MakeVtbl (Marshal.GetFunctionPointerForDelegate (invokePP));
+		static readonly IntPtr vtblPI = MakeVtbl (Marshal.GetFunctionPointerForDelegate (invokePI));
+
+		// layout: vtbl, refcount, GCHandle of the managed callback, the interface id
+		const int OffRef = 1, OffHandle = 2;
+		static int OffIid { get { return 3 * IntPtr.Size; } }
+
+		static IntPtr MakeVtbl (IntPtr invoke)
+		{
+			IntPtr v = Marshal.AllocHGlobal (4 * IntPtr.Size);
+			Marshal.WriteIntPtr (v, 0, Marshal.GetFunctionPointerForDelegate (qi));
+			Marshal.WriteIntPtr (v, IntPtr.Size, Marshal.GetFunctionPointerForDelegate (addref));
+			Marshal.WriteIntPtr (v, 2 * IntPtr.Size, Marshal.GetFunctionPointerForDelegate (release));
+			Marshal.WriteIntPtr (v, 3 * IntPtr.Size, invoke);
+			return v;
+		}
+
+		static IntPtr Make (IntPtr vtbl, Guid iid, object callback)
+		{
+			IntPtr p = Marshal.AllocHGlobal (3 * IntPtr.Size + 16);
+			Marshal.WriteIntPtr (p, 0, vtbl);
+			Marshal.WriteIntPtr (p, OffRef * IntPtr.Size, new IntPtr (1));
+			Marshal.WriteIntPtr (p, OffHandle * IntPtr.Size, GCHandle.ToIntPtr (GCHandle.Alloc (callback)));
+			Marshal.Copy (iid.ToByteArray (), 0, p + OffIid, 16);
+			return p;
+		}
+
+		// Invoke(sender, args): two objects (TypedEventHandler)
+		internal static IntPtr ForObjects (Guid iid, Action<IntPtr, IntPtr> callback)
+		{
+			return Make (vtblPP, iid, callback);
+		}
+
+		// Invoke(asyncInfo, status): an object and an AsyncStatus (completion handlers)
+		internal static IntPtr ForStatus (Guid iid, Action<IntPtr, int> callback)
+		{
+			return Make (vtblPI, iid, callback);
+		}
+
+		static object Target (IntPtr self)
+		{
+			return GCHandle.FromIntPtr (Marshal.ReadIntPtr (self, OffHandle * IntPtr.Size)).Target;
+		}
+
+		static int QueryInterface (IntPtr self, ref Guid iid, out IntPtr obj)
+		{
+			byte[] mine = new byte [16];
+			Marshal.Copy (self + OffIid, mine, 0, 16);
+			if (iid == Rt.IID_IUnknown || iid == Rt.IID_IAgileObject || iid == new Guid (mine)) {
+				AddRef (self);
+				obj = self;
+				return 0;
+			}
+			obj = IntPtr.Zero;
+			return Rt.E_NOINTERFACE;
+		}
+
+		static int AddRef (IntPtr self)
+		{
+			lock (vtblPP_lock) {
+				int n = (int)Marshal.ReadIntPtr (self, OffRef * IntPtr.Size) + 1;
+				Marshal.WriteIntPtr (self, OffRef * IntPtr.Size, new IntPtr (n));
+				return n;
+			}
+		}
+
+		static readonly object vtblPP_lock = new object ();
+
+		static int Release (IntPtr self)
+		{
+			int n;
+			lock (vtblPP_lock) {
+				n = (int)Marshal.ReadIntPtr (self, OffRef * IntPtr.Size) - 1;
+				Marshal.WriteIntPtr (self, OffRef * IntPtr.Size, new IntPtr (n));
+			}
+			if (n == 0) {
+				GCHandle.FromIntPtr (Marshal.ReadIntPtr (self, OffHandle * IntPtr.Size)).Free ();
+				Marshal.FreeHGlobal (self);
+			}
+			return n;
+		}
+
+		static int InvokeObjects (IntPtr self, IntPtr a, IntPtr b)
+		{
+			try {
+				((Action<IntPtr, IntPtr>)Target (self)) (a, b);
+				return 0;
+			} catch (Exception e) {
+				return e.HResult < 0 ? e.HResult : unchecked ((int)0x80004005);
+			}
+		}
+
+		static int InvokeStatus (IntPtr self, IntPtr a, int b)
+		{
+			try {
+				((Action<IntPtr, int>)Target (self)) (a, b);
+				return 0;
+			} catch (Exception e) {
+				return e.HResult < 0 ? e.HResult : unchecked ((int)0x80004005);
+			}
+		}
+	}
+}
