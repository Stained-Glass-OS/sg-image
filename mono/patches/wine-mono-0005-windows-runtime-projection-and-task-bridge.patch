diff --git a/sg-winmd.make b/sg-winmd.make
--- a/sg-winmd.make
+++ b/sg-winmd.make
@@ -1,22 +1,35 @@
 # Stained Glass OS: the "Windows" metadata assembly (sg-winmd/), our own
-# implementation of Windows Runtime types .NET Framework programs call. The
-# runtime looks for a reference marked WindowsRuntime in
-# lib/mono/4.5/WinMetadata/<name>.winmd (mono/metadata/assembly.c), as the
-# CLR in System32\WinMetadata.
+# projection of the Windows Runtime classes .NET Framework programs call onto
+# the system's classes, and System.Runtime.WindowsRuntime (its task bridge,
+# corefx's sources). The runtime looks for a reference marked WindowsRuntime
+# in lib/mono/4.5/WinMetadata/<name>.winmd, and for any other name (the
+# Windows SDK's contract assemblies) in WinMetadata/Windows.winmd
+# (mono/metadata/assembly.c), as the CLR resolves them in
+# System32\WinMetadata. Built with csc: mcs cannot compile an assembly that is
+# itself marked ContentType=WindowsRuntime.
 SG_WINMD_SRCS=$(wildcard $(SRCDIR)/sg-winmd/*.cs)
+SG_SRWR_DIR=$(SRCDIR)/mono/external/corefx/src/System.Runtime.WindowsRuntime/src
+SG_SRWR_SRCS=$(addprefix $(SG_SRWR_DIR)/,$(shell cat $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime/sources)) $(wildcard $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime/*.cs)
 
 $(SRCDIR)/sg-winmd/Windows.winmd: $(BUILDDIR)/mono-unix/.installed $(SG_WINMD_SRCS)
-	$(MONO_ENV) mcs -target:library -noconfig -r:mscorlib.dll -r:System.dll -r:System.Core.dll -out:$@ $(SG_WINMD_SRCS)
+	$(MONO_ENV) csc -nologo -noconfig -target:library -unsafe -r:mscorlib.dll -r:System.dll -r:System.Core.dll -out:$@ $(SG_WINMD_SRCS)
 
-IMAGEDIR_BUILD_TARGETS += $(SRCDIR)/sg-winmd/Windows.winmd
+$(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime.dll: $(SRCDIR)/sg-winmd/Windows.winmd $(SG_SRWR_SRCS) $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime/sources
+	$(MONO_ENV) csc -nologo -noconfig -target:library -unsafe -nowarn:1698,0436 -keyfile:$(SRCDIR)/mono/mcs/class/ecma.pub -delaysign+ -r:mscorlib.dll -r:System.dll -r:System.Core.dll -r:$(SRCDIR)/sg-winmd/Windows.winmd -out:$@ $(SG_SRWR_SRCS)
 
-Windows.winmd: $(SRCDIR)/sg-winmd/Windows.winmd
-	mkdir -p $(IMAGEDIR)/lib/mono/4.5/WinMetadata
+IMAGEDIR_BUILD_TARGETS += $(SRCDIR)/sg-winmd/Windows.winmd $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime.dll
+
+SG_SRWR_GAC=$(IMAGEDIR)/lib/mono/gac/System.Runtime.WindowsRuntime/4.0.0.0__b77a5c561934e089
+
+Windows.winmd: $(SRCDIR)/sg-winmd/Windows.winmd $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime.dll
+	mkdir -p $(IMAGEDIR)/lib/mono/4.5/WinMetadata $(SG_SRWR_GAC)
 	cp $(SRCDIR)/sg-winmd/Windows.winmd $(IMAGEDIR)/lib/mono/4.5/WinMetadata/Windows.winmd
+	cp $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime.dll $(SG_SRWR_GAC)/System.Runtime.WindowsRuntime.dll
+	cp $(SRCDIR)/sg-winmd/System.Runtime.WindowsRuntime.dll $(IMAGEDIR)/lib/mono/4.5/System.Runtime.WindowsRuntime.dll
 .PHONY: Windows.winmd
 imagedir-targets: Windows.winmd
 
 clean-sg-winmd:
-	rm -f $(SRCDIR)/sg-winmd/Windows.winmd
