+    // Stained Glass OS: what WMI calls with an event query's results -- an
+    // IWbemObjectSink -- handing them to the watcher's own sink.
+    internal sealed class SgEventSinkStub : IWbemObjectSink
+    {
+        readonly IWmiEventSource source;
+
+        internal SgEventSinkStub(IWmiEventSource source)
+        {
+            this.source = source;
+        }
+
+        public int Indicate_(int lObjectCount, IntPtr[] apObjArray)
+        {
+            for (int i = 0; i < lObjectCount && apObjArray != null && i < apObjArray.Length; i++)
+                source.Indicate(apObjArray[i]);
+            return 0;
+        }
+
+        public int SetStatus_(int lFlags, int hResult, string strParam, IntPtr pObjParam)
+        {
+            source.SetStatus(lFlags, hResult, strParam, pObjParam);
+            return 0;
