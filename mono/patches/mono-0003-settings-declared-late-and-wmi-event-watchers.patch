@@ -256,7 +256,20 @@ namespace System.Configuration {
 			if (propertyValues == null)
 				InitializeSettings (Properties);
 
-			if (PropertyValues [ propertyName ] == null)
+			/* Stained Glass OS: a value the provider loaded for a setting
+			 * the file had but the class did not declare carries an
+			 * untyped property of its own. Once the setting is declared
+			 * (a program adds it to Properties at run time), its value is
+			 * loaded again for the declared property -- the untyped one
+			 * could not be deserialized and read as null (DYMO Connect
+			 * stopped on its second start). */
+			SettingsPropertyValue cached = PropertyValues [ propertyName ];
+			if (cached != null && cached.Property != prop && cached.Property.PropertyType == null) {
+				PropertyValues.Remove (propertyName);
+				cached = null;
+			}
+
+			if (cached == null)
 				CacheValuesByProvider (prop.Provider);
 
 			return PropertyValues [ propertyName ].PropertyValue;
