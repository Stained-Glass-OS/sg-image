+/* Stained Glass OS: the preemptive suspend of a thread in a blocking (GC-safe) region failed --
+ * Wine could not reach the thread (in a shared prefix the machine's server stops a user's threads
+ * through that user's process agent; with the agent gone SuspendThread/GetThreadContext fail).
+ * Aborting the request put the thread back to RUNNING although it was BLOCKING: when it left its
+ * native call Mono found "Cannot transition ... from RUNNING with DONE_BLOCKING" and the program
+ * spun forever. Instead the request stays and the thread is treated as suspended at the state it
+ * saved on entering the blocking region, as full cooperative suspend does: it cannot leave that
+ * region without suspending itself. It is marked cooperative-suspend aware, so later collections
+ * do the same rather than preempt it again. */
+static gboolean
+sg_blocking_preempt_failed (MonoThreadInfo *info)
+{
+#ifndef SG_MUTANT_PREEMPT_FAIL_ABORTS
+	if (mono_threads_is_hybrid_suspension_enabled () &&
+	    mono_thread_info_current_state (info) == STATE_BLOCKING_SUSPEND_REQUESTED) {
+		mono_atomic_store_i32 (&info->coop_aware_thread, TRUE);
+		info->suspend_can_continue = TRUE;
+		THREADS_SUSPEND_DEBUG ("\tpreempt failed, blocking thread %p counts as suspended\n", mono_thread_info_get_tid (info));
+		return TRUE;
+	}
+#endif
+	return FALSE;
+}
+
