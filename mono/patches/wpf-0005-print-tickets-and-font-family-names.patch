+	public static MemoryStream GetPrintCapabilities(string printerName, PrintTicket ticket)
+	{
+		IntPtr provider = IntPtr.Zero;
+		try {
+			if (PTOpenProvider(printerName, 1, out provider) != 0) return null;
+			IStream input = ToIStream((ticket ?? new PrintTicket()).GetXmlStream()), caps;
+			if (input == null || CreateStreamOnHGlobal(IntPtr.Zero, true, out caps) != 0) return null;
+			if (PTGetPrintCapabilities(provider, input, caps, IntPtr.Zero) != 0) return null;
+			return FromIStream(caps);
+		} catch (Exception) {
+			return null;
+		} finally {
+			if (provider != IntPtr.Zero) PTCloseProvider(provider);
+		}
+	}
