+	static IStream ToIStream(Stream data)
+	{
+		IStream stream;
+		if (CreateStreamOnHGlobal(IntPtr.Zero, true, out stream) != 0) return null;
+		var buffer = new byte[4096];
+		int n;
+		data.Position = 0;
+		while ((n = data.Read(buffer, 0, buffer.Length)) > 0) stream.Write(buffer, n, IntPtr.Zero);
+		stream.Seek(0, 0, IntPtr.Zero);
+		return stream;
+	}
+
+	static MemoryStream FromIStream(IStream stream)
+	{
+		var bytes = new MemoryStream();
+		var chunk = new byte[4096];
+		IntPtr read = Marshal.AllocHGlobal(4);
+		try {
+			stream.Seek(0, 0, IntPtr.Zero);
+			for (;;) {
+				stream.Read(chunk, chunk.Length, read);
+				int n = Marshal.ReadInt32(read);
+				if (n <= 0) break;
+				bytes.Write(chunk, 0, n);
+			}
+		} finally {
+			Marshal.FreeHGlobal(read);
+		}
+		bytes.Position = 0;
+		return bytes;
+	}
