+	/* The printer's print ticket, from its default DEVMODE (prntvpt), as the
+	 * spooler has it; a ticket of WPF's defaults when that fails. */
+	public static PrintTicket GetPrintTicket(string printerName)
+	{
+		IntPtr h = IntPtr.Zero, dm = IntPtr.Zero, provider = IntPtr.Zero;
+		try {
+			if (!OpenPrinterW(printerName, out h, IntPtr.Zero)) return new PrintTicket();
+			int size = DocumentPropertiesW(IntPtr.Zero, h, printerName, IntPtr.Zero, IntPtr.Zero, 0);
+			if (size <= 0) return new PrintTicket();
+			dm = Marshal.AllocHGlobal(size);
+			if (DocumentPropertiesW(IntPtr.Zero, h, printerName, dm, IntPtr.Zero, 2 /* DM_OUT_BUFFER */) < 0) return new PrintTicket();
+			if (PTOpenProvider(printerName, 1, out provider) != 0) return new PrintTicket();
+			IStream stream;
+			if (CreateStreamOnHGlobal(IntPtr.Zero, true, out stream) != 0) return new PrintTicket();
+			if (PTConvertDevModeToPrintTicket(provider, size, dm, 2 /* kPTJobScope */, stream) != 0) return new PrintTicket();
+			var bytes = new MemoryStream();
+			var chunk = new byte[4096];
+			IntPtr read = Marshal.AllocHGlobal(4);
+			try {
+				stream.Seek(0, 0, IntPtr.Zero);
+				for (;;) {
+					stream.Read(chunk, chunk.Length, read);
+					int n = Marshal.ReadInt32(read);
+					if (n <= 0) break;
+					bytes.Write(chunk, 0, n);
+				}
+			} finally {
+				Marshal.FreeHGlobal(read);
+			}
+			bytes.Position = 0;
+			return bytes.Length > 0 ? new PrintTicket(bytes) : new PrintTicket();
+		} catch (Exception) {
+			return new PrintTicket();
+		} finally {
+			if (provider != IntPtr.Zero) PTCloseProvider(provider);
+			if (dm != IntPtr.Zero) Marshal.FreeHGlobal(dm);
+			if (h != IntPtr.Zero) ClosePrinter(h);
+		}
+	}
+
