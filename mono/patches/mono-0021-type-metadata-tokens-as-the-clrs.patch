+#ifndef SG_MUTANT_TYPE_TOKEN_ZERO
+		/* As the CLR's RuntimeTypeHandle::GetToken: an array, a pointer or a byref has no TypeDef
+		 * row of its own and is the nil TypeDef token (Mono said 0 for arrays and pointers, and
+		 * the element's token for a byref); a generic parameter is its GenericParam row (Mono
