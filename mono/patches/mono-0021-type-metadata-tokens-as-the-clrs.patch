+		if (type->type == MONO_TYPE_VAR || type->type == MONO_TYPE_MVAR) {
+			MonoClass *gp = mono_class_from_mono_type_internal (type);
+			token = m_class_get_sizes (gp).generic_param_token;
+			return token ? token : MONO_TOKEN_GENERIC_PARAM;
+		}
+#endif
 		MonoClass *mc = mono_class_from_mono_type_internal (type);
