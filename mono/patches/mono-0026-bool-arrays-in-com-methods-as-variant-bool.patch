+/*
+ * Stained Glass OS (mono-0026): in COM interface methods a bool array element with no
+ * ArraySubType is a VARIANT_BOOL (as in .NET); marshal-ilgen.c reads the element type from here.
+ * Built with -DSG_MUTANT_COM_BOOL_ARRAY_BOOL (gate mutant) it keeps the 4-byte BOOL.
+ */
+static void
+sg_com_bool_array_default (MonoType *t, MonoMarshalSpec *spec)
+{
+	if (!spec || spec->native != MONO_NATIVE_LPARRAY || t->type != MONO_TYPE_SZARRAY ||
+	    t->data.klass != mono_defaults.boolean_class)
+		return;
+	switch (spec->data.array_data.elem_type) {
+	case MONO_NATIVE_I1:
+	case MONO_NATIVE_U1:
+	case MONO_NATIVE_VARIANTBOOL:
+	case MONO_NATIVE_BOOLEAN:
+		return;
+	default:
+#ifndef SG_MUTANT_COM_BOOL_ARRAY_BOOL
+		spec->data.array_data.elem_type = MONO_NATIVE_VARIANTBOOL;
+#endif
+		break;
+	}
+}
