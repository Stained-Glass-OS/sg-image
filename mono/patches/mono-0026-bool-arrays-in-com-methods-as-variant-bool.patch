+/*
+ * Stained Glass OS (mono-0026): bool array elements. Mono marshalled every bool element of an
+ * LPArray as a 4-byte BOOL and ignored ArraySubType. .NET honours ArraySubType (I1/U1 = 1 byte,
+ * VariantBool = 2 bytes with -1 for true, Bool = 4 bytes) and, in COM interface methods, uses
+ * VARIANT_BOOL by default (cominterop.c sets that default in the spec). Visual Studio's
+ * IVsAppQueryLoad2.QueryLoadComponentAssemblies fills a VARIANT_BOOL array: read as 4-byte BOOLs
+ * only the first half of the component assemblies were approved, so the editor's MEF parts were
+ * never scanned.
+ */
+static int
+sg_bool_array_elem_size (MonoMarshalSpec *spec)
+{
+	if (spec && spec->native == MONO_NATIVE_LPARRAY) {
+		switch (spec->data.array_data.elem_type) {
+		case MONO_NATIVE_I1:
+		case MONO_NATIVE_U1:
+			return 1;
+		case MONO_NATIVE_VARIANTBOOL:
+			return 2;
+		default:
+			break;
+		}
+	}
+	return 4;
+}
+
+/* stack: native element address, managed bool (u1) -> stores the native value */
+static void
+sg_emit_bool_elem_to_native (MonoMethodBuilder *mb, int size)
+{
+	mono_mb_emit_byte (mb, CEE_LDC_I4_0);
+	mono_mb_emit_byte (mb, CEE_PREFIX1);
+	mono_mb_emit_byte (mb, CEE_CGT_UN);
+	if (size == 2)
+		mono_mb_emit_byte (mb, CEE_NEG);
+	mono_mb_emit_byte (mb, size == 1 ? CEE_STIND_I1 : size == 2 ? CEE_STIND_I2 : CEE_STIND_I4);
+}
+
+/* stack: managed array, index, native element address -> stores the managed bool */
+static void
+sg_emit_bool_elem_from_native (MonoMethodBuilder *mb, int size)
+{
+	mono_mb_emit_byte (mb, size == 1 ? CEE_LDIND_U1 : size == 2 ? CEE_LDIND_I2 : CEE_LDIND_I4);
+	mono_mb_emit_byte (mb, CEE_LDC_I4_0);
+	mono_mb_emit_byte (mb, CEE_PREFIX1);
+	mono_mb_emit_byte (mb, CEE_CGT_UN);
+	mono_mb_emit_byte (mb, CEE_STELEM_I1);
+}
