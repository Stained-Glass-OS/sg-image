+		/* Stained Glass OS (mono-0029): a VARIANT holding a record (VT_RECORD: the record's data
+		 * and its IRecordInfo) is the managed value type the record describes: one whose GUID
+		 * (GuidAttribute, as type library imports carry) is the record's, or System.Guid for
+		 * oleaut32's GUID record. Visual Studio passes GUIDs so to IVsGuidParserPrivate.
+		 * TryParseGuid, which threw NotImplementedException. */
+		[ComImport, Guid ("0000002F-0000-0000-C000-000000000046"), InterfaceType (ComInterfaceType.InterfaceIsIUnknown)]
+		interface IRecordInfo {
+			[PreserveSig] int RecordInit (IntPtr pvNew);
+			[PreserveSig] int RecordClear (IntPtr pvExisting);
+			[PreserveSig] int RecordCopy (IntPtr pvExisting, IntPtr pvNew);
+			[PreserveSig] int GetGuid (out Guid pguid);
+			[PreserveSig] int GetName ([MarshalAs (UnmanagedType.BStr)] out string pbstrName);
+			[PreserveSig] int GetSize (out uint pcbSize);
+		}
+
+		static System.Collections.Generic.Dictionary<Guid, Type> record_types;
+
+		static Type FindRecordType (Guid guid)
+		{
+			lock (typeof (BRECORD)) {
+				if (record_types == null)
+					record_types = new System.Collections.Generic.Dictionary<Guid, Type> ();
+				Type found;
+				if (record_types.TryGetValue (guid, out found))
+					return found;
+				foreach (var asm in AppDomain.CurrentDomain.GetAssemblies ()) {
+					if (asm.IsDynamic)
+						continue;
+					Type[] types;
+					try {
+						types = asm.GetTypes ();
+					} catch (System.Reflection.ReflectionTypeLoadException e) {
+						types = e.Types;
+					} catch {
+						continue;
+					}
+					foreach (var t in types) {
+						if (t == null || !t.IsValueType || t.IsEnum || !t.IsDefined (typeof (GuidAttribute), false))
+							continue;
+						if (t.GUID == guid) {
+							found = t;
+							break;
+						}
+					}
+					if (found != null)
+						break;
+				}
+				record_types [guid] = found;
+				return found;
+			}
+		}
+
+		static object RecordToObject (IntPtr data, IntPtr recinfo)
+		{
+			if (data == IntPtr.Zero || recinfo == IntPtr.Zero)
+				return null;
+			var info = (IRecordInfo)Marshal.GetObjectForIUnknown (recinfo);
+			Guid guid;
+			Type type = null;
+			if (info.GetGuid (out guid) >= 0)
+				type = FindRecordType (guid);
+			if (type == null) {
+				uint size;
+				string name;
+				if (info.GetName (out name) >= 0 && name != null &&
+				    string.Equals (name, "GUID", StringComparison.OrdinalIgnoreCase) &&
+				    info.GetSize (out size) >= 0 && size == 16)
+					type = typeof (Guid);
+			}
+			if (type == null)
+				throw new NotSupportedException ("VT_RECORD of a record type with no managed value type (" + guid + ")");
+			return Marshal.PtrToStructure (data, type);
+		}
