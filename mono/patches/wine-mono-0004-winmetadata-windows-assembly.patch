diff --git a/sg-winmd.make b/sg-winmd.make
new file mode 100644
index 0000000..c525bbb
--- /dev/null
+++ b/sg-winmd.make
@@ -0,0 +1,22 @@
+# Stained Glass OS: the "Windows" metadata assembly (sg-winmd/), our own
+# implementation of Windows Runtime types .NET Framework programs call. The
+# runtime looks for a reference marked WindowsRuntime in
+# lib/mono/4.5/WinMetadata/<name>.winmd (mono/metadata/assembly.c), as the
+# CLR in System32\WinMetadata.
+SG_WINMD_SRCS=$(wildcard $(SRCDIR)/sg-winmd/*.cs)
+
+$(SRCDIR)/sg-winmd/Windows.winmd: $(BUILDDIR)/mono-unix/.installed $(SG_WINMD_SRCS)
+	$(MONO_ENV) mcs -target:library -noconfig -r:mscorlib.dll -r:System.dll -r:System.Core.dll -out:$@ $(SG_WINMD_SRCS)
+
+IMAGEDIR_BUILD_TARGETS += $(SRCDIR)/sg-winmd/Windows.winmd
+
+Windows.winmd: $(SRCDIR)/sg-winmd/Windows.winmd
+	mkdir -p $(IMAGEDIR)/lib/mono/4.5/WinMetadata
+	cp $(SRCDIR)/sg-winmd/Windows.winmd $(IMAGEDIR)/lib/mono/4.5/WinMetadata/Windows.winmd
+.PHONY: Windows.winmd
+imagedir-targets: Windows.winmd
+
+clean-sg-winmd:
+	rm -f $(SRCDIR)/sg-winmd/Windows.winmd
+.PHONY: clean-sg-winmd
+clean: clean-sg-winmd
