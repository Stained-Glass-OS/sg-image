+using System.Reflection;
+// the version a Windows Runtime reference names ("Windows, Version=255.255.255.255")
+[assembly: AssemblyVersion ("255.255.255.255")]
+[assembly: AssemblyTitle ("Windows")]
diff --git a/sg-winmd/Windows.Networking.Connectivity.cs b/sg-winmd/Windows.Networking.Connectivity.cs
