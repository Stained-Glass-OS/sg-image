+++ b/sg-winmd/Windows.Networking.Connectivity.cs
@@ -0,0 +1,106 @@
+// Stained Glass OS: Windows.Networking.Connectivity for .NET Framework
+// programs, in the "Windows" metadata assembly (WinMetadata/Windows.winmd).
+// On Windows the CLR projects these types from System32\WinMetadata and
+// activates the system's Windows Runtime classes. This assembly is our own
+// implementation of the members programs call, with the system's answers:
+// Visual Studio's installer asks for the internet connection's cost before
+// it downloads (OperatingSystem.ConnectionCostPrivate) and stopped when the
+// "Windows" assembly could not be loaded.
+//
+// Copyright (C) 2026 Stained Glass OS contributors. MIT license, as Wine Mono.
+
+using System.Linq;
+using System.Net.NetworkInformation;
+
+namespace Windows.Networking.Connectivity
+{
+	public enum NetworkCostType
+	{
+		Unknown = 0,
+		Unrestricted = 1,
+		Fixed = 2,
+		Variable = 3,
+	}
+
+	public enum NetworkConnectivityLevel
+	{
+		None = 0,
+		LocalAccess = 1,
+		ConstrainedInternetAccess = 2,
+		InternetAccess = 3,
+	}
+
+	public sealed class ConnectionCost
+	{
+		internal ConnectionCost ()
+		{
+		}
+
+		// what Wine's INetworkCostManager answers (netprofm): no metering known
+		public NetworkCostType NetworkCostType {
+			get { return NetworkCostType.Unrestricted; }
+		}
+
+		public bool Roaming {
+			get { return false; }
+		}
+
+		public bool OverDataLimit {
+			get { return false; }
+		}
+
+		public bool ApproachingDataLimit {
+			get { return false; }
+		}
+
+		public bool BackgroundDataUsageRestricted {
+			get { return false; }
+		}
+	}
+
+	public sealed class ConnectionProfile
+	{
+		readonly string name;
+
+		internal ConnectionProfile (string name)
+		{
+			this.name = name;
+		}
+
+		public string ProfileName {
+			get { return name; }
+		}
+
+		public ConnectionCost GetConnectionCost ()
+		{
+			return new ConnectionCost ();
+		}
+
+		public NetworkConnectivityLevel GetNetworkConnectivityLevel ()
+		{
+			return NetworkConnectivityLevel.InternetAccess;
+		}
+	}
+
+	public static class NetworkInformation
+	{
+		// the profile of the connection to the internet, or null with none:
+		// an interface that is up, not loopback or a tunnel, with a gateway
+		public static ConnectionProfile GetInternetConnectionProfile ()
+		{
+			try {
+				foreach (NetworkInterface ni in NetworkInterface.GetAllNetworkInterfaces ()) {
+					if (ni.OperationalStatus != OperationalStatus.Up)
+						continue;
+					if (ni.NetworkInterfaceType == NetworkInterfaceType.Loopback || ni.NetworkInterfaceType == NetworkInterfaceType.Tunnel)
+						continue;
+					if (ni.GetIPProperties ().GatewayAddresses.Count == 0)
+						continue;
+					return new ConnectionProfile (ni.Name);
+				}
+			} catch (NetworkInformationException) {
+			}
+			return null;
+		}
+	}
+}
