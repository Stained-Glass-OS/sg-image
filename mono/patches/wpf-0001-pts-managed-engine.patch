+        // ------------------------------------------------------------------
+        // Writing directions: WPF uses ES (left to right) and WS (right to left)
+        // ------------------------------------------------------------------
+        internal static unsafe int FsTransformRectangle(uint fswdirIn, ref FSRECT rectPage, ref FSRECT rectTransform, uint fswdirOut,
+            out FSRECT rectOut)
+        {
+            rectOut = rectTransform;
+            uint d = fswdirIn ^ fswdirOut;
+            if ((d & fUDirection) != 0) rectOut.u = 2 * rectPage.u + rectPage.du - rectTransform.u - rectTransform.du;
+            if ((d & fVDirection) != 0) rectOut.v = 2 * rectPage.v + rectPage.dv - rectTransform.v - rectTransform.dv;
+            return fserrNone;
+        }
+
+        internal static unsafe int FsTransformBbox(uint fswdirIn, ref FSRECT rectPage, ref FSBBOX bboxTransform, uint fswdirOut,
+            out FSBBOX bboxOut)
+        {
+            bboxOut = bboxTransform;
+            if (bboxTransform.fDefined != False)
+                FsTransformRectangle(fswdirIn, ref rectPage, ref bboxTransform.fsrc, fswdirOut, out bboxOut.fsrc);
+            return fserrNone;
+        }
+    }
