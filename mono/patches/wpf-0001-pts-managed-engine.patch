+// Stained Glass OS: the PTS formatting engine, in managed code.
+//
+// WPF's flow layout (FlowDocument, RichTextBox, FlowDocumentScrollViewer,
+// FlowDocumentReader) hands its pages, columns and paragraphs to "PTS", a
+// native engine in PresentationNative that Wine Mono does not have: every
+// program showing rich text stopped with EntryPointNotFoundException
+// (PTS.CreateInstalledObjectsInfo) -- Sonos Desktop Controller among them
+// (David 2026-10-02). This is our own engine behind the same interface (the
+// declarations in Pts.cs, the callbacks PtsHost implements): it stacks a
+// segment's paragraphs down a column, breaks text paragraphs into lines
+// through the client's FormatLine, lets the client's container and subpage
+// objects lay out their own children through the subtrack and subpage
+// calls, breaks finite pages between columns and pages, and answers the
+// queries PtsPage and the paragraph clients make to draw and hit-test.
+//
+// Not yet: tables (a table paragraph takes no space), floaters that float
+// (they are placed as blocks, as BlockUIContainer's are), figures, column
+// balancing, text around obstacles, optimal paragraphs (lines are always the
+// client's FormatLine), footnotes. Updates format again from the start.
+//
+// SPDX-License-Identifier: MIT
+
+using System;
+using System.Collections.Generic;
+using MS.Internal.PtsHost;
+
+namespace MS.Internal.PtsHost.UnsafeNativeMethods
+{
+    static internal partial class PTS
+    {
+        // ------------------------------------------------------------------
+        // Handles: what the client holds of ours is an IntPtr into this table.
+        // ------------------------------------------------------------------
+        private static readonly Dictionary<long, object> s_objects = new Dictionary<long, object>();
+        private static readonly object s_lock = new object();
+        private static long s_nextHandle = 0x50000;
+
+        private static IntPtr NewHandle(object o)
+        {
+            lock (s_lock)
+            {
+                long h = ++s_nextHandle;
+                s_objects[h] = o;
+                return new IntPtr(h);
+            }
+        }
+
+        private static T Get<T>(IntPtr h) where T : class
+        {
+            if (h == IntPtr.Zero) return null;
+            lock (s_lock)
+            {
+                object o;
+                s_objects.TryGetValue(h.ToInt64(), out o);
+                return o as T;
+            }
+        }
+
+        private static void FreeHandle(IntPtr h)
+        {
+            if (h == IntPtr.Zero) return;
+            lock (s_lock) { s_objects.Remove(h.ToInt64()); }
+        }
+
+        // a failed callback (its fserr) or our own check: back to the caller as the error
+        private sealed class PtsFail : Exception
+        {
+            internal readonly int Err;
+            internal PtsFail(int err) { Err = err; }
+        }
+
+        private static void Ck(int fserr)
+        {
+            if (fserr != fserrNone) throw new PtsFail(fserr);
+        }
+
+        private static int Fail(Exception e)
+        {
+            PtsFail f = e as PtsFail;
+            if (f != null) return f.Err;
+            if (Environment.GetEnvironmentVariable("SG_PTS_TRACE") != null)
+                Console.Error.WriteLine("sg-pts: " + e);
+            return tserrInternalError;
+        }
+
+        private static void Trace(string s)
+        {
+            if (Environment.GetEnvironmentVariable("SG_PTS_TRACE") != null)
+                Console.Error.WriteLine("sg-pts: " + s);
+        }
+
+        // ------------------------------------------------------------------
+        // The engine's objects
+        // ------------------------------------------------------------------
+        private sealed class Installed
+        {
+            internal FSIMETHODS Subtrack, Subpage;
+        }
+
+        private sealed class HandlerSlot
+        {
+            internal bool HaveFloater, HaveTable;
+            internal FSFLOATERCBK Floater;
+            internal FSTABLEOBJINIT Table;
+        }
+
+        private sealed class Ctx
+        {
+            internal IntPtr Handle, Client, Geometry;
+            internal uint Ffi;
+            internal FSCBK Cb;
+            internal FSIMETHODS[] Methods = new FSIMETHODS[2];   // container (subtrack), subpage
+            internal bool[] HaveMethods = new bool[2];
+            internal IntPtr[] ObjContext = new IntPtr[2];
+            internal bool[] HaveObjContext = new bool[2];
+            internal FSFLOATERCBK Floater;
+            internal bool HaveFloater, TriedFloater;
+            internal int PageLeft;                // the page's left margin, for FormatLine
+        }
+
+        private sealed class Line
+        {
+            internal IntPtr BrIn;                 // the break record this line starts from (ours)
+            internal int DcpFirst, DcpLim, Ur, Dur, UrBBox, DurBBox, Vr, Ascent, Descent, First, Forced;
+        }
+
+        private sealed class TextPara
+        {
+            internal IntPtr Handle;
+            internal uint Fswdir;
+            internal int SuppressTop;
+            internal List<Line> Lines = new List<Line>();
+        }
+
+        private sealed class FloaterPara
+        {
+            internal IntPtr Handle, Name, Content;
+            internal FSRECT Rect;
+            internal FSKUPDATE Upd = FSKUPDATE.fskupdNew;
+        }
+
+        private sealed class Para
+        {
+            internal IntPtr Nmp, Client, Pfspara;
+            internal int Idobj, Vr, DvrUsed, DvrTop;
+            internal FSBBOX BBox;
+            internal FSKUPDATE Upd = FSKUPDATE.fskupdNew;
+        }
+
+        private sealed class Track
+        {
+            internal IntPtr Handle, Nms;
+            internal uint Fswdir;
+            internal FSRECT Rect;
+            internal FSBBOX BBox;
+            internal FSKUPDATE Upd = FSKUPDATE.fskupdNew;
+            internal List<Para> Paras = new List<Para>();
+        }
+
+        private sealed class Section
+        {
+            internal IntPtr Handle, Nms;
+            internal uint Fswdir;
+            internal FSRECT Rect;
+            internal FSBBOX BBox;
+            internal List<Track> Columns = new List<Track>();
+        }
+
+        private sealed class Page
+        {
+            internal Ctx C;
+            internal IntPtr Handle;
+            internal uint Fswdir;
+            internal FSRECT Body, Margin;
+            internal FSBBOX BBox;
+            internal FSKUPDATE Upd = FSKUPDATE.fskupdNew;
+            internal Section Sec;
+        }
+
+        private sealed class Subpage
+        {
+            internal IntPtr Handle, Nms;
+            internal uint Fswdir;
+            internal FSRECT Rect;
+            internal FSBBOX BBox;
+            internal FSKUPDATE Upd = FSKUPDATE.fskupdNew;
+            internal List<Track> Columns = new List<Track>();
+        }
+
+        // where formatting goes on: a paragraph, and where inside it
+        private sealed class Resume
+        {
+            internal IntPtr Nmp;
+            internal int Idobj;
+            internal bool Inside;                 // inside the paragraph (else from its start)
+            internal int Dcp;                     // text: the first character not yet placed
+            internal IntPtr LineBr;               // text: its line break record (ours)
+            internal IntPtr ObjBr;                // an object's break record (the client's)
+        }
+
+        private sealed class PageBreak
+        {
+            internal IntPtr Nms;
+            internal Resume At;
+        }
+
+        private sealed class SegmentBreak     // a subtrack's or subpage's break record
+        {
+            internal Resume At;
+        }
+
+        // ------------------------------------------------------------------
+        // Installed objects, handlers, contexts
+        // ------------------------------------------------------------------
+        internal static int GetFloaterHandlerInfo(ref FSFLOATERINIT pfsfloaterinit, IntPtr pFloaterObjectInfo)
+        {
+            HandlerSlot s = Get<HandlerSlot>(pFloaterObjectInfo);
+            if (s == null) return tserrInvalidParameter;
+            s.Floater = pfsfloaterinit.fsfloatercbk;
+            s.HaveFloater = true;
+            return fserrNone;
+        }
+
+        internal static int GetTableObjHandlerInfo(ref FSTABLEOBJINIT pfstableobjinit, IntPtr pTableObjectInfo)
+        {
+            HandlerSlot s = Get<HandlerSlot>(pTableObjectInfo);
+            if (s == null) return tserrInvalidParameter;
+            s.Table = pfstableobjinit;
+            s.HaveTable = true;
+            return fserrNone;
+        }
+
+        internal static int CreateInstalledObjectsInfo(ref FSIMETHODS fssubtrackparamethods, ref FSIMETHODS fssubpageparamethods,
+            out IntPtr pInstalledObjects, out int cInstalledObjects)
+        {
+            Installed i = new Installed();
+            i.Subtrack = fssubtrackparamethods;
+            i.Subpage = fssubpageparamethods;
+            pInstalledObjects = NewHandle(i);
+            cInstalledObjects = 2;
+            return fserrNone;
+        }
+
+        internal static int DestroyInstalledObjectsInfo(IntPtr pInstalledObjects)
+        {
+            FreeHandle(pInstalledObjects);
+            return fserrNone;
+        }
+
+        internal static int CreateDocContext(ref FSCONTEXTINFO fscontextinfo, out IntPtr pfscontext)
+        {
+            Ctx c = new Ctx();
+            c.Client = fscontextinfo.pfsclient;
+            c.Cb = fscontextinfo.fscbk;
+            c.Ffi = fscontextinfo.fsffi;
+            Installed i = Get<Installed>(fscontextinfo.pInstalledObjects);
+            if (i != null)
+            {
+                c.Methods[0] = i.Subtrack; c.HaveMethods[0] = true;
+                c.Methods[1] = i.Subpage; c.HaveMethods[1] = true;
+            }
+            c.Geometry = NewHandle(new object());
+            c.Handle = NewHandle(c);
+            pfscontext = c.Handle;
+            return fserrNone;
+        }
+
+        internal static int DestroyDocContext(IntPtr pfscontext)
+        {
+            Ctx c = Get<Ctx>(pfscontext);
+            if (c == null) return tserrInvalidPtsContext;
+            int err = fserrNone;
+            for (int i = 0; i < 2; i++)
+            {
+                if (c.HaveObjContext[i])
+                {
+                    int e = c.Methods[i].pfnDestroyContext(c.ObjContext[i]);
+                    if (err == fserrNone) err = e;
+                    c.HaveObjContext[i] = false;
+                }
+            }
+            FreeHandle(c.Geometry);
+            FreeHandle(pfscontext);
+            return err;
+        }
+
+        private static Ctx Context(IntPtr h)
+        {
+            Ctx c = Get<Ctx>(h);
+            if (c == null) throw new PtsFail(tserrInvalidPtsContext);
+            return c;
+        }
+
+        // the installed object (0: container, 1: subpage) a paragraph of this kind is, or -1
+        private static int MethodIndex(int idobj)
+        {
+            if (idobj == PtsHost.ContainerParagraphId) return 0;
+            if (idobj == PtsHost.SubpageParagraphId) return 1;
+            return -1;
+        }
+
+        private static IntPtr ObjContext(Ctx c, int index)
+        {
+            if (!c.HaveObjContext[index])
+            {
+                IntPtr o;
+                Ck(c.Methods[index].pfnCreateContext(c.Client, c.Handle, IntPtr.Zero, c.Ffi,
+                    index == 0 ? PtsHost.ContainerParagraphId : PtsHost.SubpageParagraphId, out o));
+                c.ObjContext[index] = o;
+                c.HaveObjContext[index] = true;
+            }
+            return c.ObjContext[index];
+        }
+
+        private static bool Floaters(Ctx c)
+        {
+            if (!c.TriedFloater)
+            {
+                c.TriedFloater = true;
+                HandlerSlot slot = new HandlerSlot();
+                IntPtr h = NewHandle(slot);
+                try { Ck(c.Cb.cbkobj.pfnGetObjectHandlerInfo(c.Client, PtsHost.FloaterParagraphId, h)); }
+                finally { FreeHandle(h); }
+                if (slot.HaveFloater) { c.Floater = slot.Floater; c.HaveFloater = true; }
+            }
+            return c.HaveFloater;
+        }
+
+        // ------------------------------------------------------------------
+        // Geometry helpers
+        // ------------------------------------------------------------------
+        private static void Union(ref FSBBOX into, FSBBOX b)
+        {
+            if (b.fDefined == False) return;
+            if (into.fDefined == False) { into = b; return; }
+            int u = Math.Min(into.fsrc.u, b.fsrc.u), v = Math.Min(into.fsrc.v, b.fsrc.v);
+            int ur = Math.Max(into.fsrc.u + into.fsrc.du, b.fsrc.u + b.fsrc.du);
+            int vr = Math.Max(into.fsrc.v + into.fsrc.dv, b.fsrc.v + b.fsrc.dv);
+            into.fsrc = new FSRECT(u, v, ur - u, vr - v);
+        }
+
+        private static FSBBOX Box(int u, int v, int du, int dv)
+        {
+            FSBBOX b = new FSBBOX();
+            b.fDefined = True;
+            b.fsrc = new FSRECT(u, v, Math.Max(0, du), Math.Max(0, dv));
+            return b;
+        }
+
+        private static bool EndOfParagraph(FSFLRES r)
+        {
+            return r == FSFLRES.fsflrEndOfParagraph || r == FSFLRES.fsflrEndOfParagraphClearLeft ||
+                   r == FSFLRES.fsflrEndOfParagraphClearRight || r == FSFLRES.fsflrEndOfParagraphClearBoth;
+        }
+
+        // ------------------------------------------------------------------
+        // Break records
+        // ------------------------------------------------------------------
+        private static void DestroyResume(Ctx c, Resume r)
+        {
+            if (r == null) return;
+            if (r.LineBr != IntPtr.Zero) { Ck(c.Cb.cbktxt.pfnDestroyLineBreakRecord(c.Client, r.LineBr)); r.LineBr = IntPtr.Zero; }
+            if (r.ObjBr != IntPtr.Zero)
+            {
+                int m = MethodIndex(r.Idobj);
+                if (m >= 0) Ck(c.Methods[m].pfnDestroyBreakRecord(ObjContext(c, m), r.ObjBr));
+                r.ObjBr = IntPtr.Zero;
+            }
+        }
+
+        private static Resume DuplicateResume(Ctx c, Resume r)
+        {
+            if (r == null) return null;
+            Resume d = new Resume();
+            d.Nmp = r.Nmp; d.Idobj = r.Idobj; d.Inside = r.Inside; d.Dcp = r.Dcp;
+            if (r.LineBr != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDuplicateLineBreakRecord(c.Client, r.LineBr, out d.LineBr));
+            if (r.ObjBr != IntPtr.Zero)
+            {
+                int m = MethodIndex(r.Idobj);
+                if (m >= 0) Ck(c.Methods[m].pfnDuplicateBreakRecord(ObjContext(c, m), r.ObjBr, out d.ObjBr));
+            }
+            return d;
+        }
+
+        // ------------------------------------------------------------------
+        // Destroying what was formatted
+        // ------------------------------------------------------------------
+        private static void DestroyParaContent(Ctx c, Para p)
+        {
+            if (p.Pfspara == IntPtr.Zero) return;
+            if (p.Idobj == fsidobjText)
+            {
+                TextPara tp = Get<TextPara>(p.Pfspara);
+                if (tp != null)
+                    foreach (Line l in tp.Lines)
+                        if (l.BrIn != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDestroyLineBreakRecord(c.Client, l.BrIn));
+                FreeHandle(p.Pfspara);
+            }
+            else if (p.Idobj == PtsHost.FloaterParagraphId)
+            {
+                FloaterPara fp = Get<FloaterPara>(p.Pfspara);
+                if (fp != null && fp.Content != IntPtr.Zero && c.HaveFloater) Ck(c.Floater.pfnDestroyFloaterContent(fp.Content));
+                FreeHandle(p.Pfspara);
+            }
+            else
+            {
+                int m = MethodIndex(p.Idobj);
+                if (m >= 0) Ck(c.Methods[m].pfnDestroyPara(p.Pfspara));
+            }
+            p.Pfspara = IntPtr.Zero;
+        }
+
+        private static void DestroyParas(Ctx c, List<Para> paras)
+        {
+            foreach (Para p in paras)
+            {
+                DestroyParaContent(c, p);
+                if (p.Client != IntPtr.Zero) Ck(c.Cb.cbkgen.pfnDestroyParaclient(c.Client, p.Client));
+                p.Client = IntPtr.Zero;
+            }
+            paras.Clear();
+        }
+
+        private static void DestroyTrack(Ctx c, Track t)
+        {
+            DestroyParas(c, t.Paras);
+            FreeHandle(t.Handle);
+        }
+
+        private static void DestroyColumns(Ctx c, List<Track> columns)
+        {
+            foreach (Track t in columns) DestroyTrack(c, t);
+            columns.Clear();
+        }
+
+        // a new formatting's paragraphs take over the old ones' visuals, then the old go
+        private static void Replace(Ctx c, List<Para> oldParas, List<Para> newParas)
+        {
+            Dictionary<long, Para> old = new Dictionary<long, Para>();
+            foreach (Para p in oldParas) old[p.Nmp.ToInt64()] = p;
+            foreach (Para p in newParas)
+            {
+                Para o;
+                if (!old.TryGetValue(p.Nmp.ToInt64(), out o) || o.Client == IntPtr.Zero) continue;
+                Ck(c.Cb.cbkgen.pfnTransferDisplayInfo(c.Client, o.Client, p.Client));
+                int m = MethodIndex(p.Idobj);
+                if (m >= 0 && o.Idobj == p.Idobj && o.Pfspara != IntPtr.Zero && p.Pfspara != IntPtr.Zero)
+                    Ck(c.Methods[m].pfnTransferDisplayInfoPara(o.Pfspara, p.Pfspara));
+            }
+            DestroyParas(c, oldParas);
+        }
+
+        // ------------------------------------------------------------------
+        // Formatting: a column (track) of paragraphs
+        // ------------------------------------------------------------------
+        private struct FillResult
+        {
+            internal bool Done;           // the segment's paragraphs are all placed
+            internal Resume Next;         // else where they go on (ours)
+            internal IntPtr Mcs;          // the margin state after the last paragraph (passes to the caller)
+            internal int TopSpace;        // the first paragraph's top space
+            internal int Bottom;          // vr below the last paragraph
+        }
+
+        // Fills t (its Rect: where; dv the room when finite) with the segment's
+        // paragraphs from 'from' (null: its first). 'from' stays the caller's.
+        private static FillResult Fill(Ctx c, Track t, Resume from, bool finite, bool emptyOk, bool suppressTop,
+            IntPtr mcsIn, bool fromPreviousPage)
+        {
+            FillResult o = new FillResult();
+            IntPtr nmp;
+            int vr = t.Rect.v, limit = finite ? t.Rect.v + t.Rect.dv : int.MaxValue;
+#if SG_MUTANT_PTS_NO_BREAK
+            limit = int.MaxValue;
+#endif
+            IntPtr mcs = mcsIn;
+            bool ownMcs = false;
+
+            o.Bottom = vr;
+            if (from != null)
+                nmp = from.Nmp;
+            else
+            {
+                int found;
+                Ck(c.Cb.cbkgen.pfnGetFirstPara(c.Client, t.Nms, out found, out nmp));
+                if (found == False) { o.Done = true; return o; }
+            }
+
+            for (int guard = 0; ; guard++)
+            {
+                if (guard > Restrictions.tscLineInParaRestriction) throw new PtsFail(tserrSystemRestrictionsExceeded);
+                FSPAP pap = new FSPAP();
+                Ck(c.Cb.cbkgen.pfnGetParaProperties(c.Client, nmp, ref pap));
+                bool first = t.Paras.Count == 0;
+                Resume inside = (first && from != null && from.Inside && from.Nmp == nmp) ? from : null;
+
+                if (finite && !first && (pap.fBreakPageBefore != False || pap.fBreakColumnBefore != False))
+                {
+                    o.Next = new Resume { Nmp = nmp, Idobj = pap.idobj };
+                    break;
+                }
+
+                IntPtr pc;
+                Ck(c.Cb.cbkgen.pfnCreateParaclient(c.Client, nmp, out pc));
+                Para p = new Para { Nmp = nmp, Client = pc, Idobj = pap.idobj, Vr = vr };
+                IntPtr mcsOut = IntPtr.Zero;
+                Resume next = null;
+                bool placed;
+                bool mayBeEmpty = emptyOk || !first;
+                bool supp = suppressTop && first;
+
+                if (pap.idobj == fsidobjText)
+                    placed = FormatText(c, t, p, inside, finite, limit, mayBeEmpty, supp, mcs, out mcsOut, out next);
+                else if (MethodIndex(pap.idobj) >= 0 && c.HaveMethods[MethodIndex(pap.idobj)])
+                    placed = FormatObject(c, t, p, inside, finite, limit, mayBeEmpty, supp, mcs, fromPreviousPage, out mcsOut, out next);
+                else if (pap.idobj == PtsHost.FloaterParagraphId && Floaters(c))
+                    placed = FormatFloater(c, t, p, finite, limit, mayBeEmpty, supp, mcs, out mcsOut);
+                else
+                {
+                    // a table or a figure: not yet; it takes no space
+                    Trace("paragraph kind " + pap.idobj + " not laid out");
+                    Ck(c.Cb.cbkgen.pfnDestroyParaclient(c.Client, pc));
+                    p = null;
+                    placed = true;
+                }
+
+                if (p != null && !placed)
+                {
+                    Ck(c.Cb.cbkgen.pfnDestroyParaclient(c.Client, pc));
+                    o.Next = inside != null ? DuplicateResume(c, inside) : new Resume { Nmp = nmp, Idobj = pap.idobj };
+                    break;
+                }
+                if (p != null)
+                {
+                    if (first) o.TopSpace = p.DvrTop;
+                    t.Paras.Add(p);
+                    vr += p.DvrUsed;
+                    Union(ref t.BBox, p.BBox);
+                    if (ownMcs && mcs != IntPtr.Zero) Ck(c.Cb.cbkobj.pfnDestroyMcsclient(c.Client, mcs));
+                    mcs = mcsOut;
+                    ownMcs = true;
+                }
+                if (next != null) { o.Next = next; break; }
+
+                int more;
+                IntPtr nmpNext;
+                Ck(c.Cb.cbkgen.pfnGetNextPara(c.Client, t.Nms, nmp, out more, out nmpNext));
+                if (more == False) { o.Done = true; break; }
+                nmp = nmpNext;
+                if (finite && vr >= limit) { o.Next = new Resume { Nmp = nmp }; break; }
+            }
+            o.Bottom = vr;
+            o.Mcs = ownMcs ? mcs : IntPtr.Zero;
+            return o;
+        }
+
+        // A text paragraph: its top space, then lines while they fit.
+        private static bool FormatText(Ctx c, Track t, Para p, Resume inside, bool finite, int limit, bool emptyOk,
+            bool suppressTop, IntPtr mcsIn, out IntPtr mcsOut, out Resume next)
+        {
+            FSTXTPROPS props = new FSTXTPROPS();
+            TextPara tp = new TextPara();
+            int dvrTop = 0, vr, dcp, lastHeight = 0;
+            IntPtr br = IntPtr.Zero, lastLine = IntPtr.Zero;
+            bool ended = false;
+
+            mcsOut = IntPtr.Zero;
+            next = null;
+            Ck(c.Cb.cbktxt.pfnGetTextProperties(c.Client, p.Nmp, 0, ref props));
+            tp.Fswdir = t.Fswdir;
+            tp.SuppressTop = suppressTop ? True : False;
+            if (inside == null)
+                Ck(c.Cb.cbkobj.pfnConvertMcsclient(c.Client, p.Client, p.Nmp, t.Fswdir, mcsIn, suppressTop ? True : False, out dvrTop));
+            vr = p.Vr + dvrTop;
+            dcp = inside != null ? inside.Dcp : props.dcpStartContent;
+            if (inside != null && inside.LineBr != IntPtr.Zero)
+                Ck(c.Cb.cbktxt.pfnDuplicateLineBreakRecord(c.Client, inside.LineBr, out br));
+
+            for (int n = 0; ; n++)
+            {
+                if (n > Restrictions.tscLineInParaRestriction) throw new PtsFail(tserrSystemRestrictionsExceeded);
+                IntPtr line, brOut;
+                int dcpLine, forced, ascent, descent, urBBox, durBBox, dcpDepend, reformat;
+                FSFLRES res;
+                bool firstInPara = inside == null && n == 0;
+                Ck(c.Cb.cbktxt.pfnFormatLine(c.Client, p.Client, p.Nmp, 0, dcp, br, t.Fswdir,
+                    t.Rect.u, t.Rect.du, t.Rect.u, t.Rect.du, c.PageLeft, True, False, False,
+                    firstInPara ? True : False, False, (suppressTop && n == 0) ? True : False,
+                    out line, out dcpLine, out brOut, out forced, out res, out ascent, out descent,
+                    out urBBox, out durBBox, out dcpDepend, out reformat));
+                int height = ascent + descent;
+                if (finite && vr + height > limit && (n > 0 || emptyOk))
+                {
+                    // it does not fit: the next column or page goes on from here
+                    Ck(c.Cb.cbktxt.pfnDestroyLine(c.Client, line));
+                    if (brOut != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDestroyLineBreakRecord(c.Client, brOut));
+                    if (n > 0)
+                    {
+                        next = new Resume { Nmp = p.Nmp, Idobj = fsidobjText, Inside = true, Dcp = dcp, LineBr = br };
+                        br = IntPtr.Zero;
+                    }
+                    break;
+                }
+                if (dcpLine <= 0)
+                {
+                    Ck(c.Cb.cbktxt.pfnDestroyLine(c.Client, line));
+                    if (brOut != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDestroyLineBreakRecord(c.Client, brOut));
+                    throw new PtsFail(tserrInvalidClientOutput);
+                }
+                Line l = new Line();
+                l.BrIn = br; l.DcpFirst = dcp; l.DcpLim = dcp + dcpLine;
+                l.Ur = t.Rect.u; l.Dur = t.Rect.du; l.UrBBox = urBBox; l.DurBBox = durBBox;
+                l.Vr = vr; l.Ascent = ascent; l.Descent = descent;
+                l.First = firstInPara ? True : False; l.Forced = forced;
+                tp.Lines.Add(l);
+                br = brOut;
+                if (lastLine != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDestroyLine(c.Client, lastLine));
+                lastLine = line;
+                lastHeight = height;
+                vr += height;
+                dcp += dcpLine;
+                if (EndOfParagraph(res)) { ended = true; break; }
+                if (finite && (res == FSFLRES.fsflrPageBreak || res == FSFLRES.fsflrColumnBreak))
+                {
+                    next = new Resume { Nmp = p.Nmp, Idobj = fsidobjText, Inside = true, Dcp = dcp, LineBr = br };
+                    br = IntPtr.Zero;
+                    break;
+                }
+            }
+            if (br != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDestroyLineBreakRecord(c.Client, br));
+
+            if (tp.Lines.Count == 0)
+                return false;
+            if (ended)
+                Ck(c.Cb.cbktxt.pfnFormatBottomText(c.Client, p.Client, p.Nmp, 0, t.Fswdir, lastLine, lastHeight, out mcsOut));
+            if (lastLine != IntPtr.Zero) Ck(c.Cb.cbktxt.pfnDestroyLine(c.Client, lastLine));
+
+            p.DvrTop = dvrTop;
+            p.DvrUsed = vr - p.Vr;
+            foreach (Line l in tp.Lines) Union(ref p.BBox, Box(l.UrBBox, l.Vr, l.DurBBox, l.Ascent + l.Descent));
+            tp.Handle = NewHandle(tp);
+            p.Pfspara = tp.Handle;
+            return true;
+        }
+
+        // A container or subpage paragraph: the client lays it out (through the
+        // subtrack and subpage calls below).
+        private static bool FormatObject(Ctx c, Track t, Para p, Resume inside, bool finite, int limit, bool emptyOk,
+            bool suppressTop, IntPtr mcsIn, bool fromPreviousPage, out IntPtr mcsOut, out Resume next)
+        {
+            int m = MethodIndex(p.Idobj);
+            FSIMETHODS meth = c.Methods[m];
+            IntPtr objc = ObjContext(c, m), pfspara;
+            int dvrUsed, dvrTop;
+            FSBBOX bbox;
+            FSKCLEAR kclear;
+
+            next = null;
+            if (!finite)
+            {
+                FSFMTRBL r;
+                int uninterruptible;
+                Ck(meth.pfnFormatParaBottomless(objc, p.Client, p.Nmp, 0, c.Geometry, suppressTop ? True : False, t.Fswdir,
+                    t.Rect.u, t.Rect.du, p.Vr, mcsIn, FSKCLEAR.fskclearNone, False,
+                    out r, out pfspara, out dvrUsed, out bbox, out mcsOut, out kclear, out dvrTop, out uninterruptible));
+            }
+            else
+            {
+                FSFMTR r;
+                IntPtr brOut;
+                int breakInsidePossible;
+                FSRECT fill = new FSRECT(t.Rect.u, p.Vr, t.Rect.du, Math.Max(0, limit - p.Vr));
+                Ck(meth.pfnFormatParaFinite(objc, p.Client, inside != null ? inside.ObjBr : IntPtr.Zero,
+                    (inside != null && fromPreviousPage) ? True : False, p.Nmp, 0, IntPtr.Zero, c.Geometry,
+                    emptyOk ? True : False, suppressTop ? True : False, t.Fswdir, ref fill, mcsIn, FSKCLEAR.fskclearNone,
+                    FSKSUPPRESSHARDBREAKBEFOREFIRSTPARA.fsksuppresshardbreakbeforefirstparaNone, False,
+                    out r, out pfspara, out brOut, out dvrUsed, out bbox, out mcsOut, out kclear, out dvrTop, out breakInsidePossible));
+                if (r.kstop >= FSFMTRKSTOP.fmtrNoProgressOutOfSpace)
+                {
+                    // nothing of it here
+                    if (pfspara != IntPtr.Zero) Ck(meth.pfnDestroyPara(pfspara));
+                    if (brOut != IntPtr.Zero) Ck(meth.pfnDestroyBreakRecord(objc, brOut));
+                    if (mcsOut != IntPtr.Zero) Ck(c.Cb.cbkobj.pfnDestroyMcsclient(c.Client, mcsOut));
+                    mcsOut = IntPtr.Zero;
+                    return false;
+                }
+                if (r.kstop != FSFMTRKSTOP.fmtrGoalReached || brOut != IntPtr.Zero)
+                    next = new Resume { Nmp = p.Nmp, Idobj = p.Idobj, Inside = brOut != IntPtr.Zero, ObjBr = brOut };
+            }
+            p.Pfspara = pfspara;
+            p.DvrUsed = dvrUsed;
+            p.DvrTop = dvrTop;
+            p.BBox = bbox;
+            return true;
+        }
+
+        // A floater: placed as a block (BlockUIContainer is one; a floating one is too, for now).
+        private static bool FormatFloater(Ctx c, Track t, Para p, bool finite, int limit, bool emptyOk, bool suppressTop,
+            IntPtr mcsIn, out IntPtr mcsOut)
+        {
+            FSFLOATERPROPS props;
+            IntPtr content;
+            int dur, dvr, cPolygons, cVertices, dvrTop;
+            FSBBOX bbox;
+
+            mcsOut = IntPtr.Zero;
+            Ck(c.Floater.pfnGetFloaterProperties(c.Client, p.Nmp, t.Fswdir, out props));
+            Ck(c.Cb.cbkobj.pfnConvertMcsclient(c.Client, p.Client, p.Nmp, t.Fswdir, mcsIn, suppressTop ? True : False, out dvrTop));
+            int vr = p.Vr + dvrTop;
+            if (!finite)
+            {
+                FSFMTRBL r;
+                Ck(c.Floater.pfnFormatFloaterContentBottomless(c.Client, p.Client, p.Nmp, suppressTop ? True : False, t.Fswdir,
+                    True, t.Rect.du, MaxPageSize, out r, out content, out dur, out dvr, out bbox, out cPolygons, out cVertices));
+            }
+            else
+            {
+                FSFMTR r;
+                IntPtr br;
+                Ck(c.Floater.pfnFormatFloaterContentFinite(c.Client, p.Client, IntPtr.Zero, False, p.Nmp, IntPtr.Zero,
+                    emptyOk ? True : False, suppressTop ? True : False, t.Fswdir, True, t.Rect.du, Math.Max(0, limit - vr),
+                    FSKSUPPRESSHARDBREAKBEFOREFIRSTPARA.fsksuppresshardbreakbeforefirstparaNone,
+                    out r, out content, out br, out dur, out dvr, out bbox, out cPolygons, out cVertices));
+                if (br != IntPtr.Zero) Ck(c.Floater.pfnDestroyFloaterContentBreakRecord(c.Client, br));
+                if (emptyOk && (r.kstop >= FSFMTRKSTOP.fmtrNoProgressOutOfSpace || vr + dvr > limit))
+                {
+                    if (content != IntPtr.Zero) Ck(c.Floater.pfnDestroyFloaterContent(content));
+                    return false;
+                }
+            }
+            dur = Math.Min(Math.Max(dur, 0), t.Rect.du);
+            int u = t.Rect.u;
+            if (props.fskfloatalignment == FSKFLOATALIGNMENT.fskfloatalignCenter) u += (t.Rect.du - dur) / 2;
+            else if (props.fskfloatalignment == FSKFLOATALIGNMENT.fskfloatalignMax) u += t.Rect.du - dur;
+            FloaterPara fp = new FloaterPara();
+            fp.Name = p.Nmp;
+            fp.Content = content;
+            fp.Rect = new FSRECT(u, vr, dur, Math.Max(0, dvr));
+            fp.Handle = NewHandle(fp);
+            Ck(c.Floater.pfnGetMCSClientAfterFloater(c.Client, p.Client, p.Nmp, t.Fswdir, mcsIn, out mcsOut));
+            p.Pfspara = fp.Handle;
+            p.DvrTop = dvrTop;
+            p.DvrUsed = dvrTop + fp.Rect.dv;
+            p.BBox = Box(fp.Rect.u, fp.Rect.v, fp.Rect.du, fp.Rect.dv);
+            return true;
+        }
+
+        // ------------------------------------------------------------------
+        // Pages
+        // ------------------------------------------------------------------
+        private static Track NewTrack(IntPtr nms, uint fswdir, FSRECT rect)
+        {
+            Track t = new Track();
+            t.Nms = nms;
+            t.Fswdir = fswdir;
+            t.Rect = rect;
+            t.Handle = NewHandle(t);
+            return t;
+        }
+
+        // Lays the page out from 'from' (null: the section's start); returns where the next page goes on.
+        private static Resume FormatPage(Ctx c, Page pg, IntPtr nms, Resume from, bool finite, out bool done)
+        {
+            uint fswdir, secdir;
+            int fHeaderFooter, durPage, dvrPage, fNewPage, fBalance, ccol, cSegAreas, cHeightAreas;
+            FSRECT margin = new FSRECT();
+            IntPtr segment;
+
+            Ck(c.Cb.cbkgen.pfnGetPageDimensions(c.Client, nms, out fswdir, out fHeaderFooter, out durPage, out dvrPage, ref margin));
+            Ck(c.Cb.cbkgen.pfnGetSectionProperties(c.Client, nms, out fNewPage, out secdir, out fBalance, out ccol, out cSegAreas, out cHeightAreas));
+            Ck(c.Cb.cbkgen.pfnGetMainTextSegment(c.Client, nms, out segment));
+            c.PageLeft = margin.u;
+            pg.Fswdir = fswdir;
+            pg.Margin = margin;
+
+            List<FSRECT> columns = new List<FSRECT>();
+            if (finite && ccol > 1)
+            {
+                FSCOLUMNINFO[] info = new FSCOLUMNINFO[ccol];
+                int actual;
+                unsafe
+                {
+                    fixed (FSCOLUMNINFO* pi = info)
+                        Ck(c.Cb.cbkgen.pfnGetSectionColumnInfo(c.Client, nms, secdir, ccol, pi, out actual));
+                }
+                int u = margin.u;
+                for (int i = 0; i < Math.Min(actual, ccol); i++)
+                {
+                    u += info[i].durBefore;
+                    columns.Add(new FSRECT(u, margin.v, info[i].durWidth, margin.dv));
+                    u += info[i].durWidth;
+                }
+            }
+            if (columns.Count == 0) columns.Add(margin);
+
+            Section sec = new Section();
+            sec.Nms = nms;
+            sec.Fswdir = secdir;
+            sec.Rect = margin;
+            Resume at = from, next = null;
+            int bottom = margin.v;
+            done = false;
+            for (int i = 0; i < columns.Count; i++)
+            {
+                Track t = NewTrack(segment, secdir, columns[i]);
+                sec.Columns.Add(t);
+                if (done) continue;
+                FillResult r = Fill(c, t, at, finite, i > 0, (finite && from != null) || i > 0, IntPtr.Zero, true);
+                if (r.Mcs != IntPtr.Zero) Ck(c.Cb.cbkobj.pfnDestroyMcsclient(c.Client, r.Mcs));
+                if (at != from) DestroyResume(c, at);
+                bottom = Math.Max(bottom, r.Bottom);
+                Union(ref sec.BBox, t.BBox);
+                if (!finite) t.Rect.dv = r.Bottom - t.Rect.v;
+                at = r.Next;
+                if (r.Done || at == null) { done = true; at = null; }
+            }
+            next = at;
+            if (!finite)
+            {
+                int bottomMargin = Math.Max(0, dvrPage - margin.v - margin.dv);
+                if (dvrPage >= MaxPageSize || bottomMargin > MaxPageSize / 2) bottomMargin = 0;
+                sec.Rect.dv = bottom - margin.v;
+                pg.Body = new FSRECT(0, 0, durPage, bottom + bottomMargin);
+            }
+            else
+                pg.Body = new FSRECT(0, 0, durPage, dvrPage);
+            pg.BBox = sec.BBox;
+            sec.Handle = NewHandle(sec);
+            pg.Sec = sec;
+            return next;
+        }
+
+        private static void DestroyPageContent(Ctx c, Page pg)
+        {
+            if (pg.Sec == null) return;
+            DestroyColumns(c, pg.Sec.Columns);
+            FreeHandle(pg.Sec.Handle);
+            pg.Sec = null;
+        }
+
+        private static List<Para> AllParas(Page pg)
+        {
+            List<Para> l = new List<Para>();
+            if (pg.Sec != null) foreach (Track t in pg.Sec.Columns) l.AddRange(t.Paras);
+            return l;
+        }
+
+        // the old page's paragraphs give their visuals to the new ones, and go
+        private static void ReplacePage(Ctx c, Page pg, Section old)
+        {
+            if (old == null) return;
+            List<Para> oldParas = new List<Para>();
+            foreach (Track t in old.Columns) oldParas.AddRange(t.Paras);
+            Replace(c, oldParas, AllParas(pg));
+            foreach (Track t in old.Columns) { t.Paras.Clear(); FreeHandle(t.Handle); }
+            FreeHandle(old.Handle);
+        }
+
+        internal static int FsCreatePageFinite(IntPtr pfscontext, IntPtr pfsBRPageStart, IntPtr fsnmSectStart,
+            out FSFMTR pfsfmtrOut, out IntPtr ppfsPageOut, out IntPtr ppfsBRPageOut)
+        {
+            pfsfmtrOut = new FSFMTR();
+            ppfsPageOut = IntPtr.Zero;
+            ppfsBRPageOut = IntPtr.Zero;
+            try
+            {
+                Ctx c = Context(pfscontext);
+                PageBreak br = Get<PageBreak>(pfsBRPageStart);
+                Page pg = new Page { C = c };
+                bool done;
+                Resume next = FormatPage(c, pg, br != null ? br.Nms : fsnmSectStart, br != null ? br.At : null, true, out done);
+                pg.Handle = NewHandle(pg);
+                ppfsPageOut = pg.Handle;
+                pfsfmtrOut.kstop = done ? FSFMTRKSTOP.fmtrGoalReached : FSFMTRKSTOP.fmtrBrokenOutOfSpace;
+                if (!done && next != null)
+                    ppfsBRPageOut = NewHandle(new PageBreak { Nms = br != null ? br.Nms : fsnmSectStart, At = next });
+                return fserrNone;
+            }
+            catch (Exception e) { return Fail(e); }
+        }
+
+        internal static int FsUpdateFinitePage(IntPtr pfscontext, IntPtr pfspage, IntPtr pfsBRPageStart, IntPtr fsnmSectStart,
+            out FSFMTR pfsfmtrOut, out IntPtr ppfsBRPageOut)
+        {
+            pfsfmtrOut = new FSFMTR();
+            ppfsBRPageOut = IntPtr.Zero;
+            try
+            {
+                Ctx c = Context(pfscontext);
+                Page pg = Get<Page>(pfspage);
+                if (pg == null) return tserrInvalidParameter;
+                PageBreak br = Get<PageBreak>(pfsBRPageStart);
+                Section old = pg.Sec;
+                pg.Sec = null;
+                bool done;
+                Resume next = FormatPage(c, pg, br != null ? br.Nms : fsnmSectStart, br != null ? br.At : null, true, out done);
+                ReplacePage(c, pg, old);
+                pg.Upd = FSKUPDATE.fskupdNew;
+                pfsfmtrOut.kstop = done ? FSFMTRKSTOP.fmtrGoalReached : FSFMTRKSTOP.fmtrBrokenOutOfSpace;
+                if (!done && next != null)
+                    ppfsBRPageOut = NewHandle(new PageBreak { Nms = br != null ? br.Nms : fsnmSectStart, At = next });
+                return fserrNone;
+            }
+            catch (Exception e) { return Fail(e); }
+        }
+
+        internal static int FsCreatePageBottomless(IntPtr pfscontext, IntPtr fsnmsect, out FSFMTRBL pfsfmtrbl, out IntPtr ppfspage)
+        {
+            pfsfmtrbl = FSFMTRBL.fmtrblGoalReached;
+            ppfspage = IntPtr.Zero;
+            try
+            {
+                Ctx c = Context(pfscontext);
+                Page pg = new Page { C = c };
+                bool done;
+                FormatPage(c, pg, fsnmsect, null, false, out done);
+                pg.Handle = NewHandle(pg);
+                ppfspage = pg.Handle;
+                return fserrNone;
+            }
