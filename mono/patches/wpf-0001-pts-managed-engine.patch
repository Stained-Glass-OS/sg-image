+            out FSFMTR fsfmtr, out IntPtr pSubPage, out IntPtr pBRSubPageOut, out int dvrUsed, out FSBBOX fsBBox,
+            out IntPtr pfsMcsClient, out int topSpace)
+        {
+            fsfmtr = new FSFMTR();
+            pSubPage = IntPtr.Zero; pBRSubPageOut = IntPtr.Zero; dvrUsed = 0; fsBBox = new FSBBOX(); pfsMcsClient = IntPtr.Zero; topSpace = 0;
+            try
+            {
+                Ctx c = Context(pfsContext);
+                SegmentBreak br = Get<SegmentBreak>(pBRSubPageStart);
+                Subpage sp = new Subpage();
+                sp.Nms = nSeg;
+                sp.Fswdir = fswdir;
+                sp.Rect = rcMargin;
+                bool done, progress;
+                Resume next = FormatSubpage(c, sp, SubpageColumns(rcMargin.u, rcMargin.v, rcMargin.du, rcMargin.dv, cColumns, rgColumnInfo, true),
+                    br != null ? br.At : null, true, fEmptyOk != False, fSuppressTopSpace != False, fFromPreviousPage != False,
+                    out done, out progress, out dvrUsed, out pfsMcsClient, out topSpace);
+                sp.Handle = NewHandle(sp);
