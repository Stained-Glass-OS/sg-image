+        // ------------------------------------------------------------------
+        private static unsafe List<FSRECT> SubpageColumns(int u, int v, int du, int dv, int cColumns, FSCOLUMNINFO* info, bool finite)
+        {
+            List<FSRECT> l = new List<FSRECT>();
+            if (finite && cColumns > 1 && info != null)
+            {
+                for (int i = 0; i < cColumns; i++)
+                {
+                    u += info[i].durBefore;
+                    l.Add(new FSRECT(u, v, info[i].durWidth, dv));
+                    u += info[i].durWidth;
+                }
+            }
+            else
+                l.Add(new FSRECT(u, v, du, dv));
+            return l;
+        }
+
+        private static Resume FormatSubpage(Ctx c, Subpage sp, List<FSRECT> columns, Resume from, bool finite, bool emptyOk,
+            bool suppressTop, bool fromPreviousPage, out bool done, out bool progress, out int dvrUsed, out IntPtr mcsOut, out int topSpace)
+        {
+            Resume at = from;
+            int bottom = sp.Rect.v;
+            done = false;
+            progress = false;
+            mcsOut = IntPtr.Zero;
+            topSpace = 0;
+            for (int i = 0; i < columns.Count; i++)
+            {
+                Track t = NewTrack(sp.Nms, sp.Fswdir, columns[i]);
+                sp.Columns.Add(t);
+                if (done) continue;
+                FillResult r = Fill(c, t, at, finite, emptyOk || i > 0, suppressTop || i > 0, IntPtr.Zero, fromPreviousPage);
+                if (i == 0) topSpace = r.TopSpace;
+                if (t.Paras.Count > 0) progress = true;
+                if (mcsOut != IntPtr.Zero) Ck(c.Cb.cbkobj.pfnDestroyMcsclient(c.Client, mcsOut));
+                mcsOut = r.Mcs;
+                if (at != from) DestroyResume(c, at);
+                bottom = Math.Max(bottom, r.Bottom);
+                Union(ref sp.BBox, t.BBox);
+                if (!finite) t.Rect.dv = r.Bottom - t.Rect.v;
+                at = r.Next;
+                if (r.Done || at == null) { done = true; at = null; }
+            }
+            dvrUsed = bottom - sp.Rect.v;
+            if (!finite) sp.Rect.dv = dvrUsed;
+            return at;
+        }
