+        private static void Shift(Ctx c, Track t, int dv)
+        {
+            t.Rect.v += dv;
+            if (t.BBox.fDefined != False) t.BBox.fsrc.v += dv;
+            foreach (Para p in t.Paras)
+            {
+                p.Vr += dv;
+                if (p.BBox.fDefined != False) p.BBox.fsrc.v += dv;
+                if (p.Idobj == fsidobjText)
+                {
+                    TextPara tp = Get<TextPara>(p.Pfspara);
+                    if (tp != null) foreach (Line l in tp.Lines) l.Vr += dv;
+                }
+                else if (p.Idobj == PtsHost.FloaterParagraphId)
+                {
+                    FloaterPara fp = Get<FloaterPara>(p.Pfspara);
+                    if (fp != null) fp.Rect.v += dv;
+                }
+                else
+                {
+                    int m = MethodIndex(p.Idobj);
+                    if (m >= 0 && p.Pfspara != IntPtr.Zero)
+                        Ck(c.Methods[m].pfnSynchronizeBottomlessPara(p.Pfspara, p.Client, c.Geometry, t.Fswdir, dv));
+                }
+            }
+        }
