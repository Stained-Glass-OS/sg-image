+        private static void BalancingInfo(List<Track> columns, out int lines, out int heights, out int minHeight)
+        {
+            lines = 0; heights = 0; minHeight = 0;
+            foreach (Track t in columns)
+                foreach (Para p in t.Paras)
+                {
+                    TextPara tp = p.Idobj == fsidobjText ? Get<TextPara>(p.Pfspara) : null;
+                    if (tp == null) continue;
+                    foreach (Line l in tp.Lines)
+                    {
+                        int h = l.Ascent + l.Descent;
+                        lines++;
+                        heights += h;
+                        if (minHeight == 0 || h < minHeight) minHeight = h;
+                    }
+                }
+        }
