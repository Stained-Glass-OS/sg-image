#!/bin/bash
# In the initrd, when booted from the Stained Glass ISO (sg.live=iso): find the
# medium, mount it, and attach the root file system image on it to a loop
# device. udev then names that device by its label, which is what
# root=LABEL=SGLIVEROOT waits for; systemd.volatile=overlay puts a RAM overlay
# on top, exactly as the USB stick's live entry does.
#
# The medium is either a block device (a DVD, a stick written with dd: an
# ISO 9660 file system labelled SGLIVE) or, from a multiboot stick such as
# Ventoy or a GRUB loopback entry, the .iso file itself on some partition
# (exFAT, FAT, NTFS, ext4...): searched for when no such device turns up, and
# attached to a loop device. Either way it must be the ISO this initrd came
# from (live/build-id): a Ventoy stick often holds several releases.
#
# It also loop-mounts the medium's EFI system partition image read-only at
# /run/sg-esp: the installer copies the kernels and boot loader from there.
# All mounts live under /run, which carries over into the real system.
#
# SPDX-License-Identifier: AGPL-3.0-or-later
set -u
LOG=/run/initramfs/sg-live-iso.log
mkdir -p /run/initramfs
say() {
    echo "sg-live-iso: $*" >> "$LOG"
    echo "sg-live-iso: $*" > /dev/kmsg 2>/dev/null || echo "sg-live-iso: $*"
}
# How long to look for the medium (seconds): sg.live.timeout= on the kernel
# command line, else 150 -- inside systemd.default_device_timeout_sec (300),
# so the failure screen below is shown before the initrd gives up on the root.
TIMEOUT=150
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in sg.live.timeout=*) TIMEOUT=${w#sg.live.timeout=} ;; esac
done
case "$TIMEOUT" in ''|*[!0-9]*) TIMEOUT=150 ;; esac

for m in cdrom sr_mod isofs loop erofs usb-storage uas virtio_scsi virtio_blk \
         fat vfat exfat ntfs3 nls_cp437 nls_iso8859-1 nls_utf8; do
    # The file systems a multiboot stick uses are not in the image's initrd;
    # build-iso.sh adds them here.
    modprobe -q "$m" 2>/dev/null || insmod /usr/lib/sg-live/modules/"$m".ko* 2>/dev/null || :
done
ID=$(cat /usr/lib/sg-live/build-id 2>/dev/null)

# Is the ISO 9660 file system on $1 this initrd's medium?
ours() {
    local m=/run/sg-probe id
    [ "$(blkid -p -o value -s TYPE "$1" 2>/dev/null)" = iso9660 ] || return 1
    [ "$(blkid -p -o value -s LABEL "$1" 2>/dev/null)" = SGLIVE ] || return 1
    [ -n "$ID" ] || return 0
    mkdir -p "$m"
    mount -t iso9660 -o ro "$1" "$m" 2>/dev/null || return 1
    id=$(cat "$m/live/build-id" 2>/dev/null)
    umount "$m"
    [ "$id" = "$ID" ] && return 0
    say "$1 is a Stained Glass medium from another build ($id); passing it by"
    return 1
}

# A USB stick or a slow optical drive can take a while to appear.
# Probe each block device itself: blkid's cached search passes optical drives by.
find_medium() {
    for b in /sys/class/block/*; do
        d=/dev/${b##*/}
        case "${b##*/}" in loop*) continue ;; esac
        [ -b "$d" ] && ours "$d" && { echo "$d"; return 0; }
    done
    return 1
}

# The .iso file on a partition: each file system is mounted read-only once and
# stays mounted (under /run/initramfs/sg-host) while the file is in use. Sets $dev (not
# run in a subshell: it remembers what it has searched).
searched=" "
find_iso_file() {
    local b d t mp f loop
    for b in /sys/class/block/*; do
        d=/dev/${b##*/}
        case "${b##*/}" in loop*|sr*) continue ;; esac
        [ -b "$d" ] || continue
        case "$searched" in *" $d "*) continue ;; esac
        t=$(blkid -p -o value -s TYPE "$d" 2>/dev/null)
        case "$t" in exfat|vfat|ntfs|ntfs3|ext4|ext3|ext2|btrfs|xfs|f2fs) ;; *) continue ;; esac
        searched="$searched$d "
        [ "$t" = ntfs ] && t=ntfs3
        mp=/run/initramfs/sg-host/${b##*/}
        mkdir -p "$mp"
        mount -t "$t" -o ro "$d" "$mp" 2>/dev/null || { rmdir "$mp"; continue; }
        while IFS= read -r f; do
            loop=$(losetup -r -f --show "$f" 2>/dev/null) || continue
            if ours "$loop"; then
                say "found ${f#"$mp"} on $d"
                dev=$loop; return 0
            fi
            losetup -d "$loop"
        done < <(find "$mp" -maxdepth 4 -type f -iname '*.iso' -size +100M 2>/dev/null)
        umount "$mp"; rmdir "$mp"
    done
    return 1
}

# No medium: say on the screen what was looked for and what was found -- the
# boot otherwise ended in "emergency mode" with nothing to go on (user report
# 2026-11-25) -- and offer to save that as a report on a USB stick.
failed() {
    {
        echo "== sg-live-iso: $1"
        echo "looked for: an ISO 9660 file system labelled SGLIVE with live/build-id $ID,"
        echo "or a .iso file holding one on an exFAT, FAT, NTFS or ext4 partition"
        echo "== block devices (blkid -p):"
        for b in /sys/class/block/*; do
            d=/dev/${b##*/}
            case "${b##*/}" in loop*) continue ;; esac
            echo "$d $(cat "$b/size" 2>/dev/null) sectors: $(blkid -p -o export "$d" 2>/dev/null | grep -E '^(TYPE|LABEL|PTTYPE)=' | tr '\n' ' ')"
        done
        echo "== kernel log (storage):"
        dmesg 2>/dev/null | grep -iE 'usb|sd[a-z]|sr[0-9]|nvme|mmc|ata[0-9]|scsi|blk|I/O error|sg-live' | tail -60
    } >> "$LOG" 2>&1
    # critical: on the console (and a serial console) even with "quiet loglevel=3"
    echo "<2>sg-live-iso: cannot start: $1" > /dev/kmsg 2>/dev/null
    command -v plymouth >/dev/null 2>&1 && plymouth quit 2>/dev/null
    c=/dev/console
    {
        printf '\033[2J\033[H'
        echo "Stained Glass OS cannot start: $1"
        echo
        echo "It looked for its live medium: a DVD, or a USB stick written with an image"
        echo "writer, labelled SGLIVE, from this very build ($ID);"
        echo "or the .iso file on a stick's exFAT, FAT, NTFS or ext4 partition (Ventoy)."
        echo
        echo "Drives found:"
        for b in /sys/class/block/*; do
            d=${b##*/}
            case "$d" in loop*|ram*) continue ;; esac
            [ -e "$b/partition" ] && continue
            echo "  /dev/$d  $(( $(cat "$b/size" 2>/dev/null || echo 0) / 2048 )) MB  $(blkid -p -o value -s TYPE "/dev/$d" 2>/dev/null) $(blkid -p -o value -s LABEL "/dev/$d" 2>/dev/null)"
        done
        grep 'from another build' "$LOG" 2>/dev/null | sed 's/^sg-live-iso: /  /'
        echo
        echo "Try: another USB port (a USB 2 port, not a hub); write the stick again and"
        echo "check its SHA-256; on a Ventoy stick, copy the .iso again (or keep one"
        echo "Stained Glass .iso on it)."
        echo
        echo "Press S to save a report of this for the developers to a USB stick"
        echo "(FAT, exFAT or NTFS: plug it in first), or wait."
    } > "$c" 2>/dev/null
    if read -r -s -n 1 -t 120 key < "$c" 2>/dev/null && { [ "$key" = s ] || [ "$key" = S ]; }; then
        save_report
    fi
}
# The report on the first FAT, exFAT or NTFS file system that can be written.
save_report() {
    local b d t mp=/run/sg-report name
    name="sg-boot-report-initrd-$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now).txt"
    mkdir -p "$mp"
    for b in /sys/class/block/*; do
        d=/dev/${b##*/}
        case "${b##*/}" in loop*|sr*) continue ;; esac
        t=$(blkid -p -o value -s TYPE "$d" 2>/dev/null)
        case "$t" in vfat|exfat) ;; ntfs) t=ntfs3 ;; *) continue ;; esac
        umount "/run/initramfs/sg-host/${b##*/}" 2>/dev/null
        mount -t "$t" -o rw "$d" "$mp" 2>/dev/null || continue
        if { cat "$LOG"; echo "== dmesg"; dmesg; } > "$mp/$name" 2>/dev/null; then
            sync; umount "$mp"
            echo "Saved: $d /$name -- send it to the developers. Continuing in 10 s." > /dev/console
            sleep 10
            return 0
        fi
        umount "$mp"
    done
    echo "Not saved: no FAT, exFAT or NTFS file system that can be written was found." > /dev/console
    sleep 10
}

dev=""
start=$(date +%s)
while :; do
    dev=$(find_medium)
    [ -n "$dev" ] && break
    # A few seconds without one: look for the file too (a stick's partitions
    # appear about as late as the stick does, so keep looking at new ones).
    if [ $(( $(date +%s) - start )) -ge 3 ]; then
        find_iso_file && break
    fi
    [ $(( $(date +%s) - start )) -ge "$TIMEOUT" ] && break
    udevadm settle -t 1 2>/dev/null || :
    sleep 0.5
done
if [ -z "$dev" ]; then
    say "no Stained Glass medium (label SGLIVE, build $ID, or its .iso file on a partition) was found in ${TIMEOUT}s"
    failed "its live medium was not found."
    exit 1
fi

# Everything the root image stands on is mounted under /run/initramfs, which
# systemd leaves alone at shutdown (as it does the initrd's own mounts): the
# running system must not unmount the medium, or on a Ventoy stick the exFAT
# holding the .iso file, from under its root -- that ended in endless erofs
# read errors instead of powering off. /run/sg-iso and /run/sg-esp, which the
# installer uses, point there.
mkdir -p /run/initramfs/sg-iso /run/initramfs/sg-esp
ln -sfn /run/initramfs/sg-iso /run/sg-iso
ln -sfn /run/initramfs/sg-esp /run/sg-esp
mount -t iso9660 -o ro "$dev" /run/initramfs/sg-iso || { say "cannot mount $dev"; failed "its live medium ($dev) cannot be read."; exit 1; }
[ -f /run/sg-iso/live/root.erofs ] || { say "$dev has no live/root.erofs"; failed "its live medium ($dev) has no live/root.erofs."; exit 1; }
loop=$(losetup -r -f --show /run/sg-iso/live/root.erofs) || { say "cannot attach the root image"; failed "the root image on its medium cannot be attached."; exit 1; }
mount -t vfat -o ro /run/sg-iso/boot/efi.img /run/initramfs/sg-esp 2>/dev/null \
    || say "cannot mount the medium's system partition image (installing will not work)"
say "live medium $dev, root image on $loop"
