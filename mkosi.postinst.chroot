#!/bin/sh
# Runs inside the image after packages are installed and extra trees are in.
#
# The .chroot extension is load bearing: it makes mkosi chroot into the image
# before running this. Without it the script executes in mkosi's sandbox, where
# /usr is the *host's* -- systemctl then reports that greetd.service does not
# exist, and every absolute path below silently refers to the wrong system.
set -eu

# --- wine-sg and sg-session -----------------------------------------------
# Staged into an extra tree by the Makefile. Their library dependencies came
# from apt, so dpkg has nothing to resolve here. Both are passed to one dpkg
# invocation so it can order them itself -- sg-session depends on wine-sg.
# See the ExtraTrees note in mkosi.conf for why this is not done through
# mkosi's local package repository.
if [ -d /opt/sg-packages ]; then
    echo "[sg-image] installing staged packages"
    # One version of each package, or dpkg installs whichever it unpacks last.
    dups=$(for d in /opt/sg-packages/*.deb; do basename "$d" | cut -d_ -f1; done | sort | uniq -d)
    if [ -n "$dups" ]; then
        echo "[sg-image] ERROR: more than one version staged of: $dups" >&2
        exit 1
    fi
    dpkg -i /opt/sg-packages/*.deb
    rm -rf /opt/sg-packages
else
    echo "[sg-image] ERROR: /opt/sg-packages missing; run 'make image', not bare mkosi" >&2
    exit 1
fi

# Fail the build rather than the boot if the Wine we depend on is not actually
# here. Without this the image builds happily and the session dies later for a
# reason that takes a boot gate and a screenshot to diagnose.
if [ ! -x /opt/wine-sg/bin/wine ]; then
    echo "[sg-image] ERROR: /opt/wine-sg/bin/wine missing after install" >&2
    exit 1
fi
echo "[sg-image] wine: $(/opt/wine-sg/bin/wine --version 2>/dev/null || echo unknown)"
if [ -d /opt/wine-sg/lib/wine/i386-windows ]; then
    echo "[sg-image] 32-bit PE support present ($(ls /opt/wine-sg/lib/wine/i386-windows | wc -l) files)"
else
    echo "[sg-image] ERROR: no i386-windows tree -- this Wine cannot run 32-bit apps" >&2
    exit 1
fi

# The lab user's password, for the real login screen. Only the hash came into
# the image (make lab-password), and it goes as soon as it is applied, so the
# finished image carries no file with it. Lab machines only -- see the brief's
# "test credentials only" rule.
if [ -f /root/.sg-lab-password-hash ]; then
    usermod -p "$(cat /root/.sg-lab-password-hash)" sguser
    # The lab's session user is an administrator, so elevation (ADR 0012) can be
    # exercised. sg-admins is created by the sg-session package; add the user to
    # it and to the Windows-side prefix group is already handled there.
    getent group sg-admins >/dev/null && adduser sguser sg-admins >/dev/null 2>&1 || true
    rm -f /root/.sg-lab-password-hash
    echo "[sg-image] lab password set for sguser"
else
    echo "[sg-image] ERROR: no lab password hash; run 'make image', not bare mkosi" >&2
    exit 1
fi

# --- os-release: Stained Glass OS (QA B3) --------------------------------------
# The system says what it is: NAME, PRETTY_NAME (the boot menu's and tools'
# name for it), VERSION_ID, and IMAGE_VERSION -- the image build (date and
# sg-image commit, from `make image`). ID_LIKE=debian and VERSION_CODENAME keep
# tools that follow Debian working. Debian's file is diverted, so a base-files
# upgrade writes to /usr/lib/os-release.debian and never over ours.
SG_OS_VERSION=0.1
if [ "$(dpkg-divert --truename /usr/lib/os-release)" = /usr/lib/os-release ]; then
    dpkg-divert --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
fi
. /usr/lib/os-release.debian
cat > /usr/lib/os-release <<OSR
PRETTY_NAME="Stained Glass OS $SG_OS_VERSION"
NAME="Stained Glass OS"
ID=stained-glass
ID_LIKE=debian
VERSION_ID="$SG_OS_VERSION"
VERSION="$SG_OS_VERSION ($VERSION_CODENAME)"
VERSION_CODENAME=$VERSION_CODENAME
IMAGE_ID=stained-glass
IMAGE_VERSION="${IMAGE_VERSION:-unknown}"
DEBIAN_VERSION_ID="$VERSION_ID"
HOME_URL="https://freesoft.page/"
SUPPORT_URL="https://github.com/Stained-Glass-OS/stained-glass"
BUG_REPORT_URL="https://github.com/Stained-Glass-OS/stained-glass/issues"
ANSI_COLOR="1;35"
OSR
ln -sf ../usr/lib/os-release /etc/os-release
echo "[sg-image] os-release: $(. /usr/lib/os-release; echo "$PRETTY_NAME, image $IMAGE_VERSION")"

echo "[sg-image] configuring services"
systemctl enable greetd.service
# greetd owns tty1 (vt = 1 in its config). Nothing else may start a getty there:
# at the handover from the login screen to the session the VT is briefly free,
# systemd starts getty@tty1 (or logind an autovt), the getty takes the VT, and
# the new session's compositor loses it and dies -- straight back to the login
# screen. Autologin never had a handover, so this only appeared with the real
# login screen.
systemctl mask getty@tty1.service autovt@tty1.service
systemctl enable sg-prefix-init.service
# The machine-level wineserver: the Windows system itself, running before any
# login. Enabled explicitly rather than relying on the package's own enable --
# the units this image depends on are listed here so a missing one is a build
# error rather than a machine that boots without its Windows side.
systemctl enable sg-wineserver.service
# The lock screen service (ADR 0009). If it is not running the machine cannot
# be unlocked, so it is enabled explicitly like the others.
systemctl enable sg-lockd.service
# The live session's account and "Install Stained Glass OS" shortcuts. It runs
# on live boots only (ConditionKernelCommandLine), so enabling it everywhere is
# safe, and a machine installed from the stick has the unit but never runs it.
systemctl enable sg-live.service
# Setup's "third-party drivers": runs at boot only while that request is
# pending (ConditionPathExists), so enabling it everywhere is safe.
systemctl enable sg-drivers.service
# Samba's services stay off until a role asks: see
# mkosi.extra/etc/systemd/system-preset/10-sg-image.preset.
# The ssh server starts only when a gate provisioned a key (ssh.service.d);
# a key baked into the image would give its holder root on every install.
if [ -e /root/.ssh/authorized_keys ]; then
    echo "mkosi.postinst: /root/.ssh/authorized_keys is in the image -- refusing to build" >&2
    exit 1
fi
systemctl enable ssh.service
# NetworkManager configures the network (wired DHCP by default, Wi-Fi, static
# addresses through sg-netd); systemd-resolved stays the resolver it feeds.
# networkd must not also manage the same links.
systemctl disable systemd-networkd.service systemd-networkd.socket \
    systemd-networkd-wait-online.service >/dev/null 2>&1 || true
systemctl enable NetworkManager.service NetworkManager-wait-online.service
systemctl enable systemd-resolved.service
systemctl enable sg-netd.socket
systemctl set-default graphical.target

# --- the Wine prefix, built once, here ----------------------------------------
# Building the prefix (wineboot, the registry defaults, the Default User
# profile, Direct3D and the bundled apps) took 77 s of every live boot -- a
# live system's prefix is in memory, so it was rebuilt each time -- and of an
# installed machine's first. It is built here instead, by the same
# sg-prefix-init as the SYSTEM account, and packed with its owners into
# /usr/lib/stained-glass/prefix-seed.tar.zst; at boot sg-prefix-init unpacks
# it into the empty /var/lib/stained-glass in seconds and does only its
# every-boot work. The build's /var is not the image's /var, so the prefix is
# carried in /usr and this build's /var copy is removed.
#
# MachineGuid is left out: advapi32 makes it when missing, so every machine
# gets its own rather than all sharing the image's.
echo "[sg-image] building the Wine prefix"
SEED=/usr/lib/stained-glass/prefix-seed.tar.zst
SG_ROOT=/var/lib/stained-glass
# As root: the build's user namespace maps no other uid (chown and setpriv
# fail), and wine-sg takes root, like the prefix's owner, as the SYSTEM
# account. At boot sg-prefix-init unpacks the seed as sgsystem, so every file
# is sgsystem's there. What is root's own in the prefix -- its profile folder,
# its hive, its ProfileList entry -- is taken out before packing.
mkdir -p "$SG_ROOT" /run/stained-glass /var/log/stained-glass
as_system() {
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME="$SG_ROOT" XDG_RUNTIME_DIR=/run/stained-glass \
        LANG=C.UTF-8 "$@"
}
t0=$(date +%s)
as_system /usr/bin/sg-prefix-init
as_system sh -c '. /usr/lib/stained-glass/sg-common.sh; sg_wine_env;
    wine reg delete "HKLM\Software\Microsoft\Cryptography" /v MachineGuid /f >/dev/null 2>&1 || true
    for k in $(wine reg query "HKLM\Software\Microsoft\Windows NT\CurrentVersion\ProfileList" 2>/dev/null | tr -d "\r" | grep -i "ProfileList\\S-"); do
        wine reg query "$k" /v ProfileImagePath 2>/dev/null | grep -qi "users\\root" && wine reg delete "$k" /f >/dev/null 2>&1
    done
    wineserver -w; wineserver -k 2>/dev/null || true'
rm -rf "$SG_ROOT/prefix/drive_c/users/root" "$SG_ROOT/prefix/user-0.reg"
[ -e "$SG_ROOT/prefix/.sg-initialized" ] || { echo "[sg-image] ERROR: the prefix did not build" >&2; exit 1; }
if grep -q MachineGuid "$SG_ROOT/prefix/system.reg"; then
    echo "[sg-image] ERROR: the prefix still carries a MachineGuid" >&2; exit 1
fi
tar -C "$SG_ROOT" --numeric-owner -c . | zstd -q -3 -T0 -o "$SEED"
# sgsystem unpacks it: readable by the SYSTEM account's group only where the
# build may set the group; a fresh prefix holds nothing secret either way.
if chgrp sgwine "$SEED" 2>/dev/null; then chmod 0640 "$SEED"; else chmod 0644 "$SEED"; fi
echo "[sg-image] prefix built in $(( $(date +%s) - t0 ))s: $(du -sh "$SG_ROOT" | cut -f1) packed into $(du -h "$SEED" | cut -f1)"
rm -rf "${SG_ROOT:?}"/* "${SG_ROOT:?}"/.[!.]* /run/stained-glass /var/log/stained-glass/* /tmp/.wine-* 2>/dev/null || true

echo "[sg-image] done"
