+template <class D, class DI, class LM> bool CCupsFilter<D, DI, LM>::Lock()
+{
+    std::string name = LockName_;
+    if(name.empty())
+    {
+        const char* printer = getenv("PRINTER");
+        name = printer && *printer ? printer : "default";
+    }
+    for(auto& c: name)
+        if(c == '/' || c == '\\' || c == ' ')
+            c = '_';
+    const char* tmp = getenv("TMPDIR");
+    std::string path = std::string(tmp && *tmp ? tmp : "/tmp") + "/dymo-lw-" + name + ".lock";
+
+    LockFd_ = open(path.c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0660);
+    if(LockFd_ == -1)
+    {
+        fprintf(stderr, "ERROR: Unable to open the lock file %s: %s\n", path.c_str(), strerror(errno));
+        return false;
+    }
+    for(int i = 0; i < 300; i++)        // 30 seconds, as before
+    {
+        if(!flock(LockFd_, LOCK_EX | LOCK_NB))
+        {
+            fprintf(stderr, "DEBUG: locked %s\n", path.c_str());
+            return true;
+        }
+        if(errno != EWOULDBLOCK && errno != EINTR)
+            break;
+        usleep(100000);
+    }
+    fprintf(stderr, "ERROR: Unable to get synchronization lock %s: %s\n", path.c_str(), strerror(errno));
+    close(LockFd_);
+    LockFd_ = -1;
+    return false;
+}
