# Stained Glass OS boot splash: the diamond (diamond.png, drawn at image build
# time by splash/make-splash.py) centred on a near-black screen, breathing
# gently while the machine starts.
# SPDX-License-Identifier: AGPL-3.0-or-later
Window.SetBackgroundTopColor(0.063, 0.063, 0.078);
Window.SetBackgroundBottomColor(0.063, 0.063, 0.078);

diamond.image = Image("diamond.png");
diamond.sprite = Sprite(diamond.image);
diamond.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - diamond.image.GetWidth() / 2);
diamond.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - diamond.image.GetHeight() / 2);
diamond.sprite.SetOpacity(0);

tick = 0;
fun refresh_callback ()
{
    tick++;
    if (tick < 25)
        diamond.sprite.SetOpacity(tick / 25);
    else
        diamond.sprite.SetOpacity(0.8 + 0.2 * Math.Cos((tick - 25) / 40));
}
Plymouth.SetRefreshFunction(refresh_callback);

# What the machine is doing, under the diamond, as a PC says it: nothing while
# it starts; "Restarting", "Shutting down"; and while updates install at a
# restart, "Working on updates  45%" and not to turn it off (the offline update
# reports its progress to Plymouth).
status_sprite = Sprite();
note_sprite = Sprite();
fun show_status (text, note)
{
    img = Image.Text(text, 0.92, 0.92, 0.92, 1, "Sans 15");
    status_sprite.SetImage(img);
    status_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2);
    status_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + diamond.image.GetHeight() / 2 + 48);
    nimg = Image.Text(note, 0.7, 0.7, 0.7, 1, "Sans 11");
    note_sprite.SetImage(nimg);
    note_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - nimg.GetWidth() / 2);
    note_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + diamond.image.GetHeight() / 2 + 84);
}
mode = Plymouth.GetMode();
if (mode == "shutdown")
    show_status("Shutting down", "");
else if (mode == "reboot")
    show_status("Restarting", "");
else if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade")
    show_status("Working on updates", "Don't turn off your computer");

fun update_callback (progress)
{
    show_status("Working on updates  " + Math.Int(progress) + "%", "Don't turn off your computer");
}
Plymouth.SetSystemUpdateFunction(update_callback);

# Nothing here asks for a password (no encrypted disks); a message from the
# system (an offline update) is shown under the diamond.
message_sprite = Sprite();
fun message_callback (text)
{
    img = Image.Text(text, 0.85, 0.85, 0.85);
    message_sprite.SetImage(img);
    message_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2);
    message_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + diamond.image.GetHeight() / 2 + 120);
}
Plymouth.SetMessageFunction(message_callback);
